---
import '../styles/global.css';
import '../styles/win98.css';
import interFontUrl from '../assets/fonts/InterVariable.woff2?url';
import NavBar from '../components/NavBar.astro';
import SystemTable from '../components/SystemTable.astro';
import Footer from '../components/Footer.astro';
// The TCPing chart's libraries ship with the site (see vendor/README.md).
import chartJsUrl from '../../vendor/chart.js/chart.umd.js?url';
import chartJsAdapterUrl from '../../vendor/chartjs-adapter-date-fns/chartjs-adapter-date-fns.bundle.min.js?url';

// API base will be auto-detected by client-side script
// Can be overridden by PUBLIC_API_BASE environment variable
const apiBase = import.meta.env.PUBLIC_API_BASE ?? '';
---

<html lang="en" class="dark overflow-x-hidden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href={interFontUrl} as="font" type="font/woff2" crossorigin />
    <meta name="description" content="Pulse Monitor — a lightweight, real-time server monitoring dashboard." />
    <!-- Self-hosted private dashboard: do not index individual instances. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161718" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content="Pulse Monitor" />
    <meta property="og:description" content="Lightweight, real-time server monitoring dashboard." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pulse Monitor" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Pulse Monitor" />
    <meta name="twitter:description" content="Lightweight, real-time server monitoring dashboard." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Home-screen icon and install manifest, as Beszel ships (iOS ignores an SVG touch icon). -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="mask-icon" href="/favicon.svg" color="#24292f" />
    <title>Pulse Monitor</title>
    <!-- View Transitions API styling for smooth theme switching. Global: the
         theme-switching rule has to reach the components' elements too (a
         scoped one only covered this page's own markup). -->
    <style is:global>
      /* View Transitions API support for smooth cross-fade */
      /* The footer waits invisible until the list's first answer (the
         rows would push it down the screen), SystemTable's
         revealTableFrame. */
      html:not(.pulse-list-ready) #page-footer { visibility: hidden; }

      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 0.15s;
        animation-timing-function: ease-in-out;
      }
      
      ::view-transition-old(root) {
        animation-name: fade-out;
      }
      
      ::view-transition-new(root) {
        animation-name: fade-in;
      }
      
      @keyframes fade-out {
        from { opacity: 1; }
        to { opacity: 0; }
      }
      
      @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      
      /* Disable all transitions when theme-switching class is present */
      html.theme-switching *,
      html.theme-switching *::before,
      html.theme-switching *::after {
        transition: none !important;
        animation-duration: 0s !important;
      }
    </style>
    <!-- Preload Chart.js for faster TCPing chart rendering -->
    <link rel="preload" href={chartJsUrl} as="script" crossorigin="anonymous" integrity="sha384-FcQlsUOd0TJjROrBxhJdUhXTUgNJQxTMcxZe6nHbaEfFL1zjQ+bq/uRoBQxb0KMo" />
    <link rel="preload" href={chartJsAdapterUrl} as="script" crossorigin="anonymous" integrity="sha384-cVMg8E3QFwTvGCDuK+ET4PD341jF3W8nO1auiXfuZNQkzbUUiBGLsIQUE+b1mxws" />
    <!-- Site data blocked by the browser: reading localStorage throws, and
         that stopped every script on the page. An in-memory stand-in keeps
         the page working; choices then last until a reload. -->
    <script is:inline>
      (function () {
        try { window.localStorage.getItem('_'); return; } catch (_) {}
        // The login form says so: a session kept here would not reach the next page.
        window.__pulseStorageBlocked = true;
        var mem = {};
        try {
          Object.defineProperty(window, 'localStorage', { configurable: true, value: {
            getItem: function (k) { return Object.prototype.hasOwnProperty.call(mem, k) ? mem[k] : null; },
            setItem: function (k, v) { mem[k] = String(v); },
            removeItem: function (k) { delete mem[k]; },
            clear: function () { mem = {}; },
            key: function (i) { return Object.keys(mem)[i] || null; },
            get length() { return Object.keys(mem).length; }
          } });
        } catch (_) {}
      })();
    </script>
    <!-- Initialize language and theme before page render to prevent FOUC -->
    <script is:inline>
      (function() {
        // Restore the Windows 98 theme before the first paint (NavBar's
        // toggle stores it as localStorage "preferred-ui"). Win98 is a
        // light theme through and through: forcing the theme variable to
        // light here makes every downstream step (html/body classes, the
        // colour scheme, the theme-colour meta) take the light branch with
        // no race against this script's own body-painting retry.
        var win98UI = false;
        try {
          win98UI = localStorage.getItem('preferred-ui') === 'win98';
        } catch (_) {}
        if (win98UI) document.documentElement.classList.add('win98');
        // Get system language (convert to 'zh' or 'en')
        function getSystemLanguage() {
          const sysLang = navigator.language || (navigator.languages && navigator.languages[0]) || 'en';
          // Check if system language is Chinese (zh, zh-CN, zh-TW, etc.)
          if (sysLang.toLowerCase().startsWith('zh')) {
            return 'zh';
          }
          return 'en';
        }
        
        // Get system theme
        function getSystemTheme() {
          if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            return 'dark';
          }
          return 'light';
        }
        
        // Get language preference (use system language as default)
        const storedLang = localStorage.getItem('preferred-language');
        const lang = storedLang || getSystemLanguage();
        document.documentElement.lang = lang;
        
        // Get theme preference (use system theme as default; the Win98
        // theme forces light while it is on)
        const storedTheme = localStorage.getItem('preferred-theme');
        const theme = win98UI ? 'light' : ((storedTheme === 'dark' || storedTheme === 'light') ? storedTheme : getSystemTheme());
        // 'light', 'dark' or 'system' (no stored choice): the theme button's icon.
        document.documentElement.dataset.themePref = (storedTheme === 'dark' || storedTheme === 'light') ? storedTheme : 'system';
        
        // Apply theme immediately to html
        const html = document.documentElement;
        if (theme === 'dark') {
          html.classList.add('dark');
          html.classList.remove('light');
        } else {
          html.classList.add('light');
          html.classList.remove('dark');
        }
        // Browser-drawn parts (form controls, autofill, the phone's address
        // bar) follow the page's theme rather than the OS setting. With the
        // glass appearance on, the address bar takes the wallpaper's tone
        // instead (called again when the glass class arrives and on a theme
        // switch).
        html.style.colorScheme = theme;
        document.querySelectorAll('meta[name="color-scheme"]').forEach(function (m) {
          m.setAttribute('content', theme);
        });
        window.__pulseSyncThemeColor = function () {
          var dark = html.classList.contains('dark');
          var glass = html.classList.contains('glass-enabled');
          var colour = glass ? (dark ? '#12151b' : '#efeeee') : (dark ? '#161718' : '#fafafa');
          document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
            m.removeAttribute('media');
            m.setAttribute('content', colour);
          });
        };
        window.__pulseSyncThemeColor();
        
        // Apply theme to body when it's available
        function applyThemeToBody() {
          const body = document.body;
          if (body) {
            if (theme === 'dark') {
              body.classList.add('dark');
              body.classList.remove('light');
            } else {
              body.classList.add('light');
              body.classList.remove('dark');
            }
          } else {
            // Body not ready yet, try again
            requestAnimationFrame(applyThemeToBody);
          }
        }
        applyThemeToBody();
        
        // Preload navbar config early (non-blocking)
        const apiBase = window.location.origin;
        fetch(`${apiBase}/api/navbar/config`)
          .then(res => res.ok ? res.json() : null)
          .then(config => {
            if (config) {
              // Store config for NavBar component to use
              window.__navbarConfig = config;
              // Update page title with navbar text
              if (config.text) {
                document.title = config.text;
              }
              // Update favicon with custom logo
              if (config.logo && /^(https?:\/\/|\/|data:)/i.test(String(config.logo).trim())) {
                const favicon = document.querySelector('link[rel=\"icon\"]');
                if (favicon) {
                  favicon.href = config.logo;
                  // Auto-detect image type based on URL extension
                  const ext = config.logo.toLowerCase().split('.').pop().split('?')[0];
                  if (ext === 'svg') {
                    favicon.type = 'image/svg+xml';
                  } else if (ext === 'png') {
                    favicon.type = 'image/png';
                  } else if (ext === 'jpg' || ext === 'jpeg') {
                    favicon.type = 'image/jpeg';
                  } else if (ext === 'ico') {
                    favicon.type = 'image/x-icon';
                  } else {
                    // Remove type attribute to let browser auto-detect
                    favicon.removeAttribute('type');
                  }
                }
              }
              // Apply glassmorphism effect if enabled
              if (config.show_glass) {
                document.documentElement.classList.add('glass-enabled');
                if (window.__pulseSyncThemeColor) window.__pulseSyncThemeColor();
              }
              // Optional sticky table header (自定义设置 → 表头吸顶)
              if (config.sticky_header === true) document.documentElement.classList.add('sticky-table-header');
              // Default layout unless the visitor chose one (自定义设置 → 卡片布局)
              if (config.card_layout === true) document.documentElement.classList.add('card-layout');
              // Servers per page (自定义设置 → 分页); 0 is one list
              document.documentElement.dataset.pageSize = String(Number(config.page_size) || 0);
              // The loss band under the TCPing chart (自定义设置 → 丢包时间线), off by default
              document.documentElement.classList.toggle('loss-timeline', config.loss_timeline === true);
              // 自定义设置 → 资源历史 / 延迟视图 (both off by default)
              document.documentElement.classList.toggle('resource-history', config.resource_history === true);
              document.documentElement.classList.toggle('latency-view', config.latency_view === true);
              // 自定义设置 → 资源历史 → 按时段平均 (off by default: every recorded minute)
              document.documentElement.classList.toggle('resource-average', config.resource_average === true);
              // Dispatch event when config is ready
              window.dispatchEvent(new CustomEvent('navbarconfigready', { detail: config }));
            }
          })
          .catch(() => {
            // Silently fail, NavBar will handle defaults
          });
      })();
    </script>
    <!-- Load custom CSS and JS from backend (all users see it) -->
    <script is:inline>
      (function() {
        // Use synchronous XMLHttpRequest to load config BEFORE page renders
        // This ensures external scripts load early enough for DOMContentLoaded
        try {
          var xhr = new XMLHttpRequest();
          xhr.open('GET', '/api/navbar/config', false); // false = synchronous
          xhr.send();
          
          if (xhr.status === 200) {
            var config = JSON.parse(xhr.responseText);
            
            // Apply glassmorphism effect immediately (before render)
            if (config.show_glass) {
              document.documentElement.classList.add('glass-enabled');
              if (window.__pulseSyncThemeColor) window.__pulseSyncThemeColor();
            }
            // Optional sticky table header (自定义设置 → 表头吸顶)
            if (config.sticky_header === true) document.documentElement.classList.add('sticky-table-header');
            // Default layout unless the visitor chose one (自定义设置 → 卡片布局)
            if (config.card_layout === true) document.documentElement.classList.add('card-layout');
            // Servers per page (自定义设置 → 分页); 0 is one list
            document.documentElement.dataset.pageSize = String(Number(config.page_size) || 0);
            // The loss band under the TCPing chart (自定义设置 → 丢包时间线), off by default
            document.documentElement.classList.toggle('loss-timeline', config.loss_timeline === true);
            // 自定义设置 → 资源历史 / 延迟视图 (both off by default)
            document.documentElement.classList.toggle('resource-history', config.resource_history === true);
            document.documentElement.classList.toggle('latency-view', config.latency_view === true);
            // 自定义设置 → 资源历史 → 按时段平均 (off by default: every recorded minute)
            document.documentElement.classList.toggle('resource-average', config.resource_average === true);
            
            // Inject CSS if exists
            if (config.custom_css && config.custom_css.trim()) {
              var style = document.createElement('style');
              style.textContent = config.custom_css;
              document.head.appendChild(style);
            }
            
            // Inject JS if exists
            if (config.custom_js && config.custom_js.trim()) {
              var customJS = config.custom_js;
              
              // Check if it's a complete <script> tag (external or with attributes)
              var scriptTagRegex = /<script([^>]*)>([\s\S]*?)<\/script>/gi;
              var scriptMatches = [];
              var match;
              while ((match = scriptTagRegex.exec(customJS)) !== null) {
                scriptMatches.push({attrs: match[1], content: match[2]});
              }
              
              if (scriptMatches.length > 0) {
                // Has <script> tags - parse and inject each
                scriptMatches.forEach(function(scriptData) {
                  var script = document.createElement('script');
                  // Every attribute as written (data-* for trackers such as Umami's
                  // data-website-id, type, integrity, crossorigin, async/defer...): only
                  // src was copied, and its pattern stopped at a quote inside the URL.
                  var tpl = document.createElement('template');
                  tpl.innerHTML = '<script' + scriptData.attrs + '></scr' + 'ipt>';
                  var parsed = tpl.content.firstElementChild;
                  if (parsed) {
                    for (var ai = 0; ai < parsed.attributes.length; ai++) {
                      script.setAttribute(parsed.attributes[ai].name, parsed.attributes[ai].value);
                    }
                  }
                  if (script.hasAttribute('src')) {
                    // in order, as before, unless the tag itself says async or defer
                    if (!script.hasAttribute('async') && !script.hasAttribute('defer')) script.async = false;
                  } else if (scriptData.content.trim()) {
                    // Inline script
                    script.textContent = scriptData.content;
                  }
                  
                  if (script.src || script.textContent) {
                    document.head.appendChild(script);
                  }
                });
              } else {
                // Plain JS code without tags - inject directly
                var script = document.createElement('script');
                script.textContent = customJS;
                document.head.appendChild(script);
              }
            }
          }
        } catch (err) {
          console.warn('Failed to load custom styles:', err);
        }
      })();
    </script>
  </head>
  <body class="min-h-screen overflow-x-hidden flex flex-col bg-[#fafafa] dark:bg-[#171717] text-[#151515] dark:text-[#f5f5f5]">
    <div id="auth-check" class="hidden min-h-screen flex flex-col">
      <!--
        Windows 98 window chrome (.w98-chrome elements ship display:none and
        only the html.win98 theme shows them; see styles/win98.css). The
        title bar mirrors the navbar's site name, the status bar mirrors the
        live server counts, and the taskbar carries the start menu — the
        sync script is at the bottom of this page.
      -->
      <div class="w98-chrome w98-titlebar" aria-hidden="true">
        <span class="w98-t-ico">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <rect x="1" y="2" width="14" height="4" fill="#c0c0c0" stroke="#000" stroke-width="1"/>
            <rect x="3" y="3.5" width="2" height="1" fill="#00ff00"/>
            <rect x="1" y="7" width="14" height="4" fill="#c0c0c0" stroke="#000" stroke-width="1"/>
            <rect x="3" y="8.5" width="2" height="1" fill="#00ff00"/>
            <rect x="1" y="12" width="14" height="3" fill="#c0c0c0" stroke="#000" stroke-width="1"/>
          </svg>
        </span>
        <span class="w98-t-text" id="w98-title-text">Pulse Monitor</span>
        <button type="button" class="w98-tbtn" tabindex="-1" aria-label="Minimize"><span style="transform:translateY(3px)">_</span></button>
        <button type="button" class="w98-tbtn" tabindex="-1" aria-label="Maximize"><span style="transform:translateY(-1px)">□</span></button>
        <button type="button" class="w98-tbtn" tabindex="-1" aria-label="Close"><span>✕</span></button>
      </div>
      <div class="w98-chrome w98-menubar" aria-hidden="true">
        <span>文件(F)</span>
        <span>查看(V)</span>
        <span>选项(O)</span>
        <span>帮助(H)</span>
      </div>
      <div class="px-4">
        <NavBar />
      </div>
      <main class="flex-1 px-4 pt-4 pb-2 sm:pb-4">
        <SystemTable apiBase={apiBase} />
      </main>
      <div id="page-footer" class="px-4">
        <Footer />
      </div>
      <div class="w98-chrome w98-statusbar" aria-hidden="true">
        <span class="grow">就绪 Ready</span>
        <span id="w98-sb-servers">Total: — servers</span>
        <span>Net Traffic: 实时 SSE</span>
        <span>Status: Dynamic Monitoring <span class="w98-dot"></span></span>
      </div>
      <!-- Taskbar + start menu, Win98 style -->
      <div class="w98-chrome w98-taskbar" aria-hidden="false">
        <button type="button" class="w98-start" id="w98-start-btn" aria-expanded="false" aria-controls="w98-startmenu">
          <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">
            <path fill="#ff0000" d="M1 2l6-1v6H1z"/>
            <path fill="#00ff00" d="M8 1l7 1v5H8z"/>
            <path fill="#0000ff" d="M1 8h6v6l-6-1z"/>
            <path fill="#ffff00" d="M8 8h7v5l-7 1z"/>
          </svg>
          开始
        </button>
        <button type="button" class="w98-taskbtn" tabindex="-1">
          🖥 <span id="w98-task-title">Pulse Monitor</span>
        </button>
        <span class="w98-tray">
          <span id="w98-clock" style="font-variant-numeric: tabular-nums;">--:--</span>
        </span>
      </div>
      <div class="w98-startmenu w98-chrome" id="w98-startmenu" role="menu" aria-label="开始菜单">
        <div class="w98-sm-side"><b>Windows 98</b></div>
        <div class="w98-sm-items">
          <a class="w98-sm-item" role="menuitem" href="/">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
            主页 Home
          </a>
          <a class="w98-sm-item" role="menuitem" href="/admin">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
            管理后台 Admin
          </a>
          <div class="w98-sm-sep"></div>
          <button type="button" class="w98-sm-item" role="menuitem" id="w98-sm-refresh">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
            刷新数据 Refresh
          </button>
          <button type="button" class="w98-sm-item" role="menuitem" id="w98-sm-classic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            退出 Win98 主题 Exit Theme
          </button>
        </div>
      </div>
    </div>
    <!--
      Auth-gate overlay. Positioned `fixed inset-0` with an opaque body-
      matching background so it covers the page while auth resolves, and
      carries a 200 ms opacity transition. When auth passes we don't snap
      it out with `display: none` — that would snap. Instead we set
      `opacity: 0` first, let the fade play, and only THEN apply `hidden`.
      During those 200 ms the page underneath is already in place (no
      entrance animation of its own), so the overlay simply cross-fades
      away. The `z-50` ensures the overlay stays above the main content
      while it fades.
    -->
    <div id="login-redirect" class="fixed inset-0 z-50 flex items-center justify-center bg-[#fafafa] dark:bg-[#171717] transition-opacity duration-200 ease-out">
      <div class="text-center animate-page-in">
        <div class="w-8 h-8 border-[3px] border-[#d4d4d4] dark:border-[#404040] border-t-[#525252] dark:border-t-[#d4d4d4] rounded-full animate-spin-smooth mx-auto mb-4"></div>
        <p id="access-check-text" class="text-sm text-[#595959] dark:text-[#ababab]">Checking access...</p>
        <script is:inline>
          // <head> has set the page language by now; the check speaks it too.
          if ((document.documentElement.lang || '').indexOf('zh') === 0) document.getElementById('access-check-text').textContent = '正在检查访问权限...';
        </script>
      </div>
    </div>
  </body>
</html>

<script>
  // Get API base URL
  function getApiBase() {
    const apiBase = import.meta.env.PUBLIC_API_BASE;
    if (apiBase && apiBase.trim() !== '') {
      return apiBase.trim();
    }
    return window.location.origin;
  }
  
  const apiBase = getApiBase();
  
  // Check privacy mode and authentication on page load
  (async () => {
    const authCheck = document.getElementById('auth-check');
    const loginRedirect = document.getElementById('login-redirect');

    // Reveal the authenticated page with a smooth cross-fade:
    //  1. Un-hide #auth-check: the page is in place at once beneath the
    //     overlay (no entrance animation of its own, as Beszel's).
    //  2. Drop the overlay out of the hit-testing path (`pointer-events:
    //     none`) so during the 200 ms fade the user can already
    //     interact with the NavBar / content underneath — otherwise
    //     the still-present (but fading) overlay sitting at `z-50`
    //     would swallow clicks for that window, which on a slow tap
    //     is user-visible.
    //  3. Set the overlay's opacity to 0 so its 200 ms CSS transition
    //     carries the spinner out while the content fades in.
    //  4. After the fade (220 ms gives a small buffer over the 200 ms
    //     transition to avoid a one-frame flash) apply `.hidden` so
    //     the overlay leaves the layout tree.
    // The overlay is `position: fixed` so step 3's opacity fade does
    // not cause a layout shift below the auth-check content.
    function revealAuthContent() {
      authCheck.classList.remove('hidden');
      loginRedirect.style.pointerEvents = 'none';
      loginRedirect.style.opacity = '0';
      setTimeout(() => loginRedirect.classList.add('hidden'), 220);
    }

    // Get token from URL parameter
    const urlParams = new URLSearchParams(window.location.search);
    const shareToken = urlParams.get('token');
    
    // Check privacy config
    try {
      // Shared with the table (SystemTable), which needs the same answer.
      window.__pulsePrivacyConfig = window.__pulsePrivacyConfig
        || fetch(`${apiBase}/api/privacy/config`, { cache: 'no-store' }).then((r) => (r.ok ? r.json() : null)).catch(() => null);
      const privacyConfig = await window.__pulsePrivacyConfig;
      if (privacyConfig) {
        
        // If privacy is not enabled, allow access
        if (!privacyConfig.enabled) {
          revealAuthContent();
          return;
        }
        
        // Privacy is enabled, check authentication
        // If share token is provided, verify it
        if (shareToken) {
          const verifyRes = await fetch(`${apiBase}/api/privacy/verify-token`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token: shareToken }),
          });
          
          // 429 (verify rate limit behind a shared proxy address), 5xx or a
          // dropped request is not a verdict: fail open like the privacy
          // check itself, only an explicit "invalid" or 401 denies access.
          if (!verifyRes.ok && verifyRes.status !== 401) { revealAuthContent(); return; }
          if (verifyRes.ok) {
            const verifyData = await verifyRes.json();
            if (verifyData.valid) {
              // Token is valid, allow access
              revealAuthContent();
              return;
            }
          }
        }
        
        // Check if user has admin auth token
        const adminToken = localStorage.getItem('admin_auth_token');
        if (adminToken) {
          // Verify admin token
          try {
            const verifyRes = await fetch(`${apiBase}/api/auth/verify`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ token: adminToken }),
            });
            
            if (!verifyRes.ok && verifyRes.status !== 401) { revealAuthContent(); return; }
            if (verifyRes.ok) {
              const verifyData = await verifyRes.json();
              if (verifyData.valid) {
                // Admin token is valid, allow access
                revealAuthContent();
                return;
              }
            }
          } catch (err) {
            // Verification failed, continue to login
          }
        }
        
        // No valid token, redirect to login with redirect parameter (and
        // say so when it was a share link that no longer works)
        // A link to one server (?server=id) opens it after the login.
        try { if (urlParams.get('server')) sessionStorage.setItem('pulse-open-server', urlParams.get('server')); } catch (_) {}
        window.location.href = shareToken ? '/login?redirect=/&reason=link' : '/login?redirect=/';
      } else {
        // Privacy config check failed, allow access (fail open)
        revealAuthContent();
      }
    } catch (err) {
      // Privacy config check failed, allow access (fail open)
      revealAuthContent();
    }
  })();

  // ---- Windows 98 chrome sync (styles/win98.css, html.win98) ----
  // The title bar mirrors the site name (document.title already follows the
  // navbar config), the status bar mirrors the live summary chips, the tray
  // keeps a clock, and the start button opens the menu.
  (function () {
    const titleText = document.getElementById('w98-title-text');
    const taskTitle = document.getElementById('w98-task-title');
    const sbServers = document.getElementById('w98-sb-servers');
    const summary = document.getElementById('systems-summary');
    const startBtn = document.getElementById('w98-start-btn');
    const startMenu = document.getElementById('w98-startmenu');

    const syncTitle = () => {
      const t = (document.title || 'Pulse Monitor').trim();
      if (titleText) titleText.textContent = `${t} - [All Servers]`;
      if (taskTitle) taskTitle.textContent = t;
    };
    syncTitle();
    window.addEventListener('navbarconfigready', syncTitle);

    const syncServers = () => {
      if (!sbServers) return;
      // The header holds two invisible placeholder chips ("000 servers") so
      // nothing moves when the real counts arrive; mirror only real data,
      // one chip per status-bar segment ("1 台服务器 · 1 在线").
      const invisible = !summary || summary.classList.contains('invisible');
      const chips = summary
        ? Array.from(summary.children).map((c) => c.textContent.replace(/\s+/g, ' ').trim()).filter(Boolean)
        : [];
      sbServers.textContent = !invisible && chips.length ? `Total: ${chips.join(' · ')}` : 'Total: — servers';
    };
    syncServers();
    setInterval(syncServers, 3000);

    const clock = document.getElementById('w98-clock');
    const tick = () => {
      if (!clock) return;
      const d = new Date();
      clock.textContent = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
    };
    tick();
    setInterval(tick, 15000);

    if (startBtn && startMenu) {
      startBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = startMenu.classList.toggle('is-open');
        startBtn.classList.toggle('is-open', open);
        startBtn.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', (e) => {
        if (!startMenu.contains(e.target) && e.target !== startBtn) {
          startMenu.classList.remove('is-open');
          startBtn.classList.remove('is-open');
          startBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }
    const refresh = document.getElementById('w98-sm-refresh');
    if (refresh) refresh.addEventListener('click', () => window.location.reload());
    const classic = document.getElementById('w98-sm-classic');
    if (classic) classic.addEventListener('click', () => {
      const btn = document.getElementById('win98-btn');
      if (btn) btn.click();
      else {
        document.documentElement.classList.remove('win98');
        try { localStorage.removeItem('preferred-ui'); } catch (_) {}
      }
      startMenu?.classList.remove('is-open');
    });
  })();
</script>