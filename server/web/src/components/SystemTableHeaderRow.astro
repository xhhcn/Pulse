---
import Icon from './Icon.astro';
---

<!-- Each column name sorts the table, as in Beszel (SystemTable binds
     .sort-header; the view menu sorts the same way). Columns go from who a
     server is (name, location) through its health (CPU, memory, disk,
     network, Beszel's order) to the slower facts (uptime, OS); the rows
     (renderRow), the width tiers and COLUMN_TIERS follow the same order. -->
<div id="system-table-header-row" class="grid items-center gap-1.5 border-b-2 border-[#404040]/50 dark:border-[#2c2c2c]/50 border-[#dadada]/50 dark:bg-[#1f2023] bg-[#f6f7f8] px-3 sm:px-4 md:px-6 py-2 sm:py-3 text-[10px] sm:text-xs font-medium tracking-wide text-[#595959] dark:text-[#ababab]" style="grid-template-columns: minmax(min(var(--first-col-width, 100px), 160px), var(--first-col-width, 100px)) minmax(104px,1fr) minmax(130px,1.8fr) minmax(130px,1.8fr) minmax(130px,1.8fr) minmax(70px,0.9fr) minmax(85px,1fr) minmax(80px,1fr); visibility: hidden; opacity: 0; transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);">
  <div data-col="name" class="h-5 flex items-center gap-1">
    <button type="button" class="sort-header" data-sort="name">
      <Icon name="server" size={14} class="w-3.5 h-3.5 sm:w-[14px] sm:h-[14px]" />
      <span data-translate="system">Server</span>
      <span class="sort-header-arrow" aria-hidden="true"></span>
    </button>
  </div>
  <div data-col="location" class="h-5 flex items-center gap-1">
    <button type="button" class="sort-header" data-sort="location">
      <Icon name="map-pin" size={14} class="w-3.5 h-3.5 sm:w-[14px] sm:h-[14px]" />
      <span data-translate="location">Location</span>
      <span class="sort-header-arrow" aria-hidden="true"></span>
    </button>
  </div>
  <div data-col="cpu" class="h-5 flex items-center gap-1 pr-2 sm:pr-3 min-w-0 w-full">
    <button type="button" class="sort-header" data-sort="cpu">
      <Icon name="cpu" size={14} class="w-3.5 h-3.5 sm:w-[14px] sm:h-[14px]" />
      <span data-translate="cpu">CPU</span>
      <span class="sort-header-arrow" aria-hidden="true"></span>
    </button>
  </div>
  <div data-col="memory" class="h-5 flex items-center gap-1 pr-2 sm:pr-3 min-w-0 w-full">
    <button type="button" class="sort-header" data-sort="memory">
      <Icon name="memory-stick" size={14} class="w-3.5 h-3.5 sm:w-[14px] sm:h-[14px]" />
      <span data-translate="memory">Memory</span>
      <span class="sort-header-arrow" aria-hidden="true"></span>
    </button>
  </div>
  <div data-col="disk" class="h-5 flex items-center gap-1 pr-2 sm:pr-3 min-w-0 w-full">
    <button type="button" class="sort-header" data-sort="disk">
      <Icon name="hard-drive" size={14} class="w-3.5 h-3.5 sm:w-[14px] sm:h-[14px]" />
      <span data-translate="disk">Disk</span>
      <span class="sort-header-arrow" aria-hidden="true"></span>
    </button>
  </div>
  <!-- Download and upload speed added together, said in the tooltip. -->
  <div data-col="net" class="h-5 flex items-center gap-1" data-header-title="netTitle" title="Download + upload speed">
    <button type="button" class="sort-header" data-sort="net">
      <Icon name="ethernet-port" size={14} class="w-3.5 h-3.5 sm:w-[14px] sm:h-[14px]" />
      <span data-translate="net">Net</span>
      <span class="sort-header-arrow" aria-hidden="true"></span>
    </button>
  </div>
  <div data-col="uptime" class="h-5 flex items-center gap-1">
    <button type="button" class="sort-header" data-sort="time">
      <Icon name="clock-arrow-up" size={14} class="w-3.5 h-3.5 sm:w-[14px] sm:h-[14px]" />
      <span data-translate="time">Uptime</span>
      <span class="sort-header-arrow" aria-hidden="true"></span>
    </button>
  </div>
  <div data-col="os" class="h-5 flex items-center gap-1">
    <button type="button" class="sort-header" data-sort="os">
      <Icon name="computer" size={14} class="w-3.5 h-3.5 sm:w-[14px] sm:h-[14px]" />
      <span data-translate="os">OS</span>
      <span class="sort-header-arrow" aria-hidden="true"></span>
    </button>
  </div>
</div>

<script>
  import { getLanguage } from '../utils/i18n.ts';

  const translations = {
    'system': { en: 'Server', zh: '服务器' },
    'time': { en: 'Uptime', zh: '运行时间' },
    'location': { en: 'Location', zh: '位置' },
    'cpu': { en: 'CPU', zh: 'CPU' },
    'memory': { en: 'Memory', zh: '内存' },
    'disk': { en: 'Disk', zh: '磁盘' },
    'net': { en: 'Net', zh: '网络' },
    'netTitle': { en: 'Download + upload speed', zh: '下行 + 上行速度' },
    'os': { en: 'OS', zh: '系统' },
  };
  
  function updateTranslations() {
    const lang = getLanguage();
    document.querySelectorAll('[data-translate]').forEach(el => {
      const key = el.getAttribute('data-translate');
      if (key && translations[key]) {
        el.textContent = translations[key][lang];
      }
    });
    document.querySelectorAll('[data-header-title]').forEach(el => {
      const key = el.getAttribute('data-header-title');
      if (key && translations[key]) el.setAttribute('title', translations[key][lang]);
    });
  }
  
  window.addEventListener('languagechange', updateTranslations);
  window.addEventListener('translate', updateTranslations);
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateTranslations);
  } else {
    updateTranslations();
  }
</script>