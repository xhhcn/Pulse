---
import Icon from './Icon.astro';
---

<div id="system-table-header-row" class="grid items-center gap-1.5 border-b border-[#404040]/50 dark:border-[#404040]/50 border-[#e5e5e5] bg-[#1c1c1c] dark:bg-[#1c1c1c] bg-white px-3 sm:px-4 md:px-6 py-2 sm:py-3 text-[10px] sm:text-xs font-medium tracking-wide text-[#525252] dark:text-[#a3a3a3]" style="grid-template-columns: var(--first-col-width, 100px) minmax(85px,1fr) minmax(90px,1fr) minmax(130px,1.8fr) minmax(130px,1.8fr) minmax(130px,1.8fr) minmax(70px,0.9fr) minmax(70px,0.9fr); display: none; opacity: 0; transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);">
  <div class="h-5 flex items-center gap-1">
    <Icon name="server" size={14} class="w-3.5 h-3.5 sm:w-[14px] sm:h-[14px]" />
    <span data-translate="system">Service</span>
  </div>
  <div class="h-5 flex items-center gap-1">
    <Icon name="clock" size={14} class="w-3.5 h-3.5 sm:w-[14px] sm:h-[14px]" />
    <span data-translate="time">Uptime</span>
  </div>
  <div class="h-5 flex items-center gap-1">
    <Icon name="map-pin" size={14} class="w-3.5 h-3.5 sm:w-[14px] sm:h-[14px]" />
    <span data-translate="location">Location</span>
  </div>
  <div class="h-5 flex items-center gap-1 pr-2 sm:pr-3 min-w-0 w-full">
    <Icon name="cpu" size={14} class="w-3.5 h-3.5 sm:w-[14px] sm:h-[14px]" />
    <span data-translate="cpu">CPU</span>
  </div>
  <div class="h-5 flex items-center gap-1 pr-2 sm:pr-3 min-w-0 w-full">
    <Icon name="memory-stick" size={14} class="w-3.5 h-3.5 sm:w-[14px] sm:h-[14px]" />
    <span data-translate="memory">Memory</span>
  </div>
  <div class="h-5 flex items-center gap-1 pr-2 sm:pr-3 min-w-0 w-full">
    <Icon name="hard-drive" size={14} class="w-3.5 h-3.5 sm:w-[14px] sm:h-[14px]" />
    <span data-translate="disk">Disk</span>
  </div>
  <!-- Download and upload speed added together, said in the tooltip. No
       arrow icon after the label: ⇅ read as a sort control on a header that
       does not sort. -->
  <div class="h-5 flex items-center gap-1" data-header-title="netTitle" title="Download + upload speed">
    <Icon name="network" size={14} class="w-3.5 h-3.5 sm:w-[14px] sm:h-[14px]" />
    <span data-translate="net">Net</span>
  </div>
  <div class="h-5 flex items-center justify-center gap-1">
    <Icon name="computer" size={14} class="w-3.5 h-3.5 sm:w-[14px] sm:h-[14px]" />
    <span data-translate="os">OS</span>
  </div>
</div>

<script>
  import { getLanguage } from '../utils/i18n.ts';

  const translations = {
    'system': { en: 'Service', zh: '服务' },
    'time': { en: 'Uptime', zh: '运行时间' },
    'location': { en: 'Location', zh: '位置' },
    'cpu': { en: 'CPU', zh: 'CPU' },
    'memory': { en: 'Memory', zh: '内存' },
    'disk': { en: 'Disk', zh: '磁盘' },
    'net': { en: 'Net', zh: '网络' },
    'netTitle': { en: 'Download + upload speed', zh: '下行 + 上行速度' },
    'os': { en: 'OS', zh: '系统' },
  };
  
  function updateTranslations() {
    const lang = getLanguage();
    document.querySelectorAll('[data-translate]').forEach(el => {
      const key = el.getAttribute('data-translate');
      if (key && translations[key]) {
        el.textContent = translations[key][lang];
      }
    });
    document.querySelectorAll('[data-header-title]').forEach(el => {
      const key = el.getAttribute('data-header-title');
      if (key && translations[key]) el.setAttribute('title', translations[key][lang]);
    });
  }
  
  window.addEventListener('languagechange', updateTranslations);
  window.addEventListener('translate', updateTranslations);
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateTranslations);
  } else {
    updateTranslations();
  }
</script>