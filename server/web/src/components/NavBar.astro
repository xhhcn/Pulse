---
import Icon from './Icon.astro';

interface Props {
  isAdmin?: boolean;
  // Only the language and theme buttons, in the top right corner (the
  // login page, as Beszel's sign-in page has its theme button there). The
  // logo stays in the page, hidden: the script below fills it in.
  bare?: boolean;
}

const { isAdmin = false, bare = false } = Astro.props;
---

<nav class={bare ? 'fixed right-3 top-3 z-20' : 'glass-nav mx-auto mt-4 max-w-[1568px] flex items-center justify-between rounded-[10.8px] border border-[#404040]/50 bg-[#1c1c1c] dark:border-[#2c2c2c]/60 dark:bg-[#1a1a1a] border-[#d4d4d4]/50 bg-white ps-4 pe-3 sm:px-6 py-0 h-14 md:h-16'}>
  <!-- Logo -->
  <a href="/" id="navbar-home-link" class={bare ? 'hidden' : 'flex items-center gap-1.5 sm:gap-2'}>
    <!-- Logo Container -->
    <span id="navbar-logo-container" class="shrink-0" style="opacity: 0;">
      <svg width="20" height="20" class="sm:w-6 sm:h-6 monitor-icon default-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="--monitor-stroke: #24292f;">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.5 12h2l2-6 3 18 2.5-12h2" style="stroke: var(--monitor-stroke);"></path>
        <path stroke-linecap="round" stroke-width="1.5" opacity="0.8" d="M3 12h2M19 12h2" style="stroke: var(--monitor-stroke);"></path>
        <path stroke-linecap="round" stroke-width="1.5" opacity="0.5" d="M1 12h1M22 12h1" style="stroke: var(--monitor-stroke);"></path>
        <circle cx="12" cy="12" r="9" stroke-width="1.5" opacity="0.3" style="stroke: var(--monitor-stroke);"></circle>
        <circle cx="12" cy="12" r="5" stroke-width="1.5" opacity="0.6" style="stroke: var(--monitor-stroke);"></circle>
      </svg>
    </span>
    <!-- Text Container -->
    <span id="navbar-text" class="text-lg sm:text-xl md:text-2xl font-bold tracking-tight text-[#1d1d20] dark:text-white" style="opacity: 0;">Pulse</span>
  </a>

  <!-- Right Side Icons -->
  <div id="navbar-icons-container" class="flex items-center" style="opacity: 0;">
    <button
      id="language-btn"
      class="inline-flex h-10 w-10 items-center justify-center rounded-[10.8px] text-[#1d1d20] dark:text-[#f5f5f5] transition-colors hover:bg-[#f3efec]/70 dark:hover:bg-[#282828]/70"
      aria-label="Toggle language"
      title="Toggle language"
    >
      <Icon name="languages" size={16} class="w-[1.2rem] h-[1.2rem] transition-transform duration-200" />
    </button>
    <button
      id="theme-btn"
      class="inline-flex h-10 w-10 items-center justify-center rounded-[10.8px] text-[#1d1d20] dark:text-[#f5f5f5] transition-colors hover:bg-[#f3efec]/70 dark:hover:bg-[#282828]/70"
      aria-label="Toggle theme"
      title="Toggle theme"
    >
      <Icon
        name="moon-star"
        size={16}
        class="theme-icon theme-icon-moon w-[1.2rem] h-[1.2rem]"
      />
      <Icon
        name="sun"
        size={16}
        class="theme-icon theme-icon-sun w-[1.2rem] h-[1.2rem]"
      />
      <Icon
        name="sun-moon"
        size={16}
        class="theme-icon theme-icon-system w-[1.35rem] h-[1.35rem]"
      />
    </button>
    {bare ? null : isAdmin ? (
      <a
        id="navbar-home-link"
        href="/"
        class="inline-flex h-10 w-10 items-center justify-center rounded-[10.8px] text-[#1d1d20] dark:text-[#f5f5f5] transition-colors hover:bg-[#f3efec]/70 dark:hover:bg-[#282828]/70"
        aria-label="Home"
        title="Home"
        data-nav-link="home"
      >
        <Icon name="home" size={16} class="w-[1.2rem] h-[1.2rem] transition-transform duration-200" />
      </a>
    ) : (
      <a
        id="navbar-admin-link"
        href="/admin"
        class="inline-flex h-10 w-10 items-center justify-center rounded-[10.8px] text-[#1d1d20] dark:text-[#f5f5f5] transition-colors hover:bg-[#f3efec]/70 dark:hover:bg-[#282828]/70"
        aria-label="Admin"
        title="Admin"
        data-nav-link="admin"
      >
        <Icon name="user" size={16} class="w-[1.2rem] h-[1.2rem] transition-transform duration-200" />
      </a>
    )}
    </div>
  </nav>

<script>
  // Beszel-style tooltips for every icon-only control on the page.
  import '../utils/tooltip.ts';

  // The room the root keeps for a scrollbar (scrollbar-gutter), which the
  // glass wallpaper fades into (global.css): what the page is narrower than
  // the window; 0 where scrollbars overlay the page (phones, macOS).
  {
    const syncGutter = () => {
      const gutter = Math.max(0, Math.round(window.innerWidth - document.documentElement.getBoundingClientRect().width));
      document.documentElement.style.setProperty('--pulse-gutter', `${gutter}px`);
    };
    syncGutter();
    window.addEventListener('resize', syncGutter);
  }

  // A dashboard opened with a share link keeps it on the logo's link home:
  // without it a private dashboard sent the visitor to the login page.
  {
    const shareToken = new URLSearchParams(window.location.search).get('token');
    const homeLink = document.getElementById('navbar-home-link');
    if (shareToken && homeLink) homeLink.setAttribute('href', `/?token=${encodeURIComponent(shareToken)}`);
  }

  /* Navbar logo SVG comes from admin input and ends up in the page.
     Accept only a plain <svg> tree: drop scripts, foreignObject, event
     handler attributes and non-image hrefs. Returns null when anything
     looks off so the logo simply falls back to the default mark.
     Byte-identical copy of the helper in SystemTable.astro and
     AdminDashboard.astro — keep the three in sync. */
  function sanitizedSvgElement(markup) {
    if (!markup || typeof markup !== 'string') return null;
    let doc;
    try { doc = new DOMParser().parseFromString(markup, 'image/svg+xml'); } catch (_) { return null; }
    const root = doc.documentElement;
    if (!root || root.nodeName.toLowerCase() !== 'svg' || doc.querySelector('parsererror')) return null;
    const banned = /^(script|foreignobject|iframe|object|embed|use|style|animate|set|animatetransform|animatemotion)$/i;
    // Every node, not only elements: comments, CDATA sections and processing
    // instructions are dropped as well.
    const walker = doc.createTreeWalker(root, NodeFilter.SHOW_ALL);
    const toRemove = [];
    let node = walker.currentNode;
    while (node) {
      if (node.nodeType !== Node.ELEMENT_NODE) {
        if (node.nodeType !== Node.TEXT_NODE) toRemove.push(node);
      } else if (banned.test(node.nodeName)) toRemove.push(node);
      else {
        Array.from(node.attributes).forEach((attr) => {
          const n = attr.name.toLowerCase(), v = String(attr.value || '');
          if (n.startsWith('on') || (/href|src/.test(n) && !/^#|^data:image\//i.test(v.trim()))) node.removeAttribute(attr.name);
        });
      }
      node = walker.nextNode();
    }
    toRemove.forEach((n) => n.remove());
    // Handed over as nodes. Serialising and assigning innerHTML re-parsed the
    // XML as HTML, where a comment or CDATA section could turn into live markup.
    return document.importNode(root, true);
  }

  (function() {
    // Language management
    function getSystemLanguage() {
      return navigator.language || (navigator.languages && navigator.languages[0]) || 'en';
    }

    function getStoredLanguage() {
      return localStorage.getItem('preferred-language');
    }

    function setLanguage(lang) {
      localStorage.setItem('preferred-language', lang);
      document.documentElement.lang = lang;
      // Trigger language change event for other components
      window.dispatchEvent(new CustomEvent('languagechange', { detail: { language: lang } }));
    }

    function getCurrentLanguage() {
      const stored = getStoredLanguage();
      if (stored) {
        return stored;
      }
      // Default to system language
      const sysLang = getSystemLanguage();
      // Convert system language to 'zh' or 'en'
      if (sysLang.toLowerCase().startsWith('zh')) {
        return 'zh';
      }
      return 'en';
    }

    function toggleLanguage() {
      const current = getCurrentLanguage();
      const newLang = current === 'zh' ? 'en' : 'zh';
      setLanguage(newLang);
      updateLanguageButton();
    }

    function updateLanguageButton() {
      const btn = document.getElementById('language-btn');
      if (btn) {
        // Update tooltip/aria-label based on current language
        const current = getCurrentLanguage();
        btn.setAttribute('aria-label', current === 'zh' ? 'Switch to English' : '切换到中文');
        btn.setAttribute('title', current === 'zh' ? 'Switch to English' : '切换到中文');
      }
    }

    // Theme management
    function getSystemTheme() {
      if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
        return 'dark';
      }
      return 'light';
    }

    function getStoredTheme() {
      return localStorage.getItem('preferred-theme');
    }

    // The choice: 'light', 'dark' or 'system' (follow the system, the
    // default; nothing stored). The button steps through them in that
    // order, as in Beszel.
    function getThemePreference() {
      const stored = getStoredTheme();
      return stored === 'dark' || stored === 'light' ? stored : 'system';
    }

    function setThemePreference(preference) {
      if (preference === 'system') localStorage.removeItem('preferred-theme');
      else localStorage.setItem('preferred-theme', preference);
      document.documentElement.dataset.themePref = preference;
      applyTheme(preference === 'system' ? getSystemTheme() : preference);
    }

    // The theme in effect: the choice, or the system's.
    function getCurrentTheme() {
      const preference = getThemePreference();
      return preference === 'system' ? getSystemTheme() : preference;
    }

    function toggleTheme() {
      const order = ['light', 'dark', 'system'];
      setThemePreference(order[(order.indexOf(getThemePreference()) + 1) % order.length]);
      updateThemeButton();
    }

    // Keep the "home" / "admin" navigation link's tooltip + aria-label
    // localized. Unlike the language and theme buttons, these are plain
    // <a> elements whose label text is static per-page (isAdmin prop
    // decides which one renders), so we only need to re-translate, not
    // reflect any "next action" state.
    function updateNavLinks() {
      const labels = {
        home:  { en: 'Home',  zh: '首页' },
        admin: { en: 'Admin', zh: '管理' },
      };
      const lang = getCurrentLanguage();
      document.querySelectorAll('[data-nav-link]').forEach((el) => {
        const key = el.getAttribute('data-nav-link');
        const entry = labels[key];
        if (!entry) return;
        const value = entry[lang] || entry.en;
        el.setAttribute('title', value);
        el.setAttribute('aria-label', value);
      });
    }

    // Keep the theme button's aria-label / title in sync with what a
    // click will do next, and with the current UI language. Called on
    // every theme toggle and once on initial mount so the tooltip is
    // correct even when the user never clicks the button.
    function updateThemeButton() {
      const btn = document.getElementById('theme-btn');
      if (!btn) return;
      const labels = {
        light: { zh: '切换到深色模式', en: 'Switch to dark mode' },
        dark: { zh: '跟随系统主题', en: 'Use the system theme' },
        system: { zh: '切换到浅色模式', en: 'Switch to light mode' },
      };
      const label = labels[getThemePreference()][getCurrentLanguage() === 'zh' ? 'zh' : 'en'];
      btn.setAttribute('aria-label', label);
      btn.setAttribute('title', label);
    }

    function applyTheme(theme) {
      const html = document.documentElement;
      const body = document.body;
      
      // Function to actually apply theme classes
      const applyThemeClasses = () => {
        if (theme === 'dark') {
          html.classList.add('dark');
          html.classList.remove('light');
          body.classList.add('dark');
          body.classList.remove('light');
        } else {
          html.classList.add('light');
          html.classList.remove('dark');
          body.classList.add('light');
          body.classList.remove('dark');
        }
        // Browser-drawn parts (form controls, autofill, the phone's address
        // bar) follow the page's theme rather than the OS setting.
        html.style.colorScheme = theme;
        document.querySelectorAll('meta[name="color-scheme"]').forEach((m) => {
          m.setAttribute('content', theme);
        });
        // The page head defines this (the glass appearance changes the colour).
        if (window.__pulseSyncThemeColor) window.__pulseSyncThemeColor();
        // Told here, with the classes, so a canvas chart repaints in the same
        // step as the page: inside a view transition this runs after the old
        // page is captured, and the chart is not caught in the new colours
        // on the old background for the length of the cross-fade.
        window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: theme } }));
      };

      // Check if View Transitions API is supported for smooth cross-fade effect
      if (document.startViewTransition) {
        // Use View Transitions API for smooth theme switch with cross-fade.
        // The cross-fade already animates every colour; the elements' own
        // colour transitions would run again after it, one slow frame at a
        // time on a long table (the background stepped to the new colour
        // over ~0.5 s). They stay off until the new state has been captured.
        // Switched off together with the theme change, after the old state
        // has been captured, so it costs no extra style pass before the fade.
        const transition = document.startViewTransition(() => {
          html.classList.add('theme-switching');
          applyThemeClasses();
        });
        const restoreTransitions = () => html.classList.remove('theme-switching');
        transition.ready.then(restoreTransitions, restoreTransitions);
      } else {
        // Fallback: Disable ALL transitions temporarily for instant theme switch
        // Add theme-switching class to disable all transitions via CSS
        html.classList.add('theme-switching');
        
        // Apply theme classes immediately
        applyThemeClasses();
        
        // Force reflow to ensure all changes are applied instantly
        void html.offsetHeight;
        
        // Remove theme-switching class after a short delay to re-enable transitions
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            html.classList.remove('theme-switching');
          });
        });
      }
      
      updateThemeIcon(theme);
    }

    // The button shows the choice: sun, moon, or sun-and-moon for "follow
    // the system". data-theme-pref on <html> (set in the page head) places
    // the icon before the first paint; a change swaps it at once and the new
    // one turns in (theme-icon-in in global.css), as in Beszel. A timed
    // swap waited behind the restyle of a long table.
    let shownThemeIcon = null;
    function updateThemeIcon(theme) {
      const icons = {
        light: document.querySelector('#theme-btn .theme-icon-sun'),
        dark: document.querySelector('#theme-btn .theme-icon-moon'),
        system: document.querySelector('#theme-btn .theme-icon-system'),
      };
      const preference = getThemePreference();
      Object.entries(icons).forEach(([key, icon]) => {
        if (!icon) return;
        icon.style.display = key === preference ? 'block' : 'none';
      });
      const icon = icons[preference];
      if (icon && shownThemeIcon !== null && shownThemeIcon !== preference) {
        icon.classList.remove('theme-icon-in');
        void icon.getBoundingClientRect();
        icon.classList.add('theme-icon-in');
      }
      shownThemeIcon = preference;
      
      // Update monitor icon stroke color based on theme
      const monitorIcon = document.querySelector('.monitor-icon');
      if (monitorIcon) {
        if (theme === 'dark') {
          monitorIcon.style.setProperty('--monitor-stroke', '#c9d1d9');
        } else {
          monitorIcon.style.setProperty('--monitor-stroke', '#24292f');
        }
      }
    }

    // System theme listener removed - we use fixed defaults (English and Dark)

    // The tab's icon is the site's logo when one is set, as Beszel's tab
    // shows its own. A logo given as an address the page head already puts
    // on the tab (every page does, for any URL); one given as SVG code had
    // no icon until now: the tab gets a copy of the checked element in the
    // navbar, its currentColor following the browser's light or dark tab
    // strip. Without a logo the Pulse icon the page head links stays.
    const shippedFavicon = (() => {
      const link = document.querySelector('link[rel~="icon"]');
      return link ? { href: link.getAttribute('href'), type: link.getAttribute('type') } : null;
    })();
    let svgFaviconShown = false;
    function applySiteFavicon(custom) {
      const link = document.querySelector('link[rel~="icon"]');
      if (!link || !shippedFavicon) return;
      if (!custom || custom.tagName === 'IMG') {
        // (an SVG logo replaced later: its copy goes; an address logo is the
        // page head's, set at load)
        if (svgFaviconShown) {
          svgFaviconShown = false;
          if (custom) {
            link.removeAttribute('type');
            link.setAttribute('href', custom.getAttribute('src'));
          } else {
            link.setAttribute('href', shippedFavicon.href);
            if (shippedFavicon.type) link.setAttribute('type', shippedFavicon.type);
            else link.removeAttribute('type');
          }
        }
        return;
      }
      svgFaviconShown = true;
      const copy = custom.cloneNode(true);
      copy.removeAttribute('class');
      copy.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
      copy.setAttribute('width', '32');
      copy.setAttribute('height', '32');
      const style = document.createElementNS('http://www.w3.org/2000/svg', 'style');
      style.textContent = ':root{color:#18181b}@media (prefers-color-scheme:dark){:root{color:#e8eaed}}';
      copy.insertBefore(style, copy.firstChild);
      link.setAttribute('type', 'image/svg+xml');
      link.setAttribute('href', `data:image/svg+xml,${encodeURIComponent(new XMLSerializer().serializeToString(copy))}`);
    }

    // Apply navbar configuration and show content with smooth fade-in animation
    function applyNavbarConfig(config) {
      const navbarText = document.getElementById('navbar-text');
      const logoContainer = document.getElementById('navbar-logo-container');
      const iconsContainer = document.getElementById('navbar-icons-container');
      
      // Update navbar text
      if (navbarText) {
        if (config && config.text) {
          navbarText.textContent = config.text;
        }
      }
      
      // Update navbar logo
      if (logoContainer) {
        if (config && config.logo) {
          // SECURITY: Validate and sanitize logo input to prevent XSS
          const logo = config.logo.trim();
          
          // Check if logo is a URL or SVG code
          if (logo.startsWith('http://') || logo.startsWith('https://') || logo.startsWith('//')) {
            // SECURITY: Validate URL format and escape for HTML attribute
            // Only allow http/https URLs, prevent javascript: and data: URLs
            const logoUrl = logo;
            if (logoUrl.match(/^https?:\/\/[^\s<>"']+$/i) || logoUrl.match(/^\/\/[^\s<>"']+$/i)) {
              // Valid URL format - escape for HTML attribute
              const safeLogoUrl = logoUrl.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
              logoContainer.innerHTML = `<img src="${safeLogoUrl}" alt="Logo" class="w-5 h-5 sm:w-6 sm:h-6 custom-logo-img" style="object-fit: contain; display: block; max-width: 100%; max-height: 100%;" />`;
              
              // Add error handler to fallback to default logo if image fails to load
              const img = logoContainer.querySelector('.custom-logo-img');
              if (img) {
                img.addEventListener('error', function() {
                  logoContainer.innerHTML = `<svg width="20" height="20" class="sm:w-6 sm:h-6 monitor-icon default-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="--monitor-stroke: #24292f;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.5 12h2l2-6 3 18 2.5-12h2" style="stroke: var(--monitor-stroke);"></path><path stroke-linecap="round" stroke-width="1.5" opacity="0.8" d="M3 12h2M19 12h2" style="stroke: var(--monitor-stroke);"></path><path stroke-linecap="round" stroke-width="1.5" opacity="0.5" d="M1 12h1M22 12h1" style="stroke: var(--monitor-stroke);"></path><circle cx="12" cy="12" r="9" stroke-width="1.5" opacity="0.3" style="stroke: var(--monitor-stroke);"></circle><circle cx="12" cy="12" r="5" stroke-width="1.5" opacity="0.6" style="stroke: var(--monitor-stroke);"></circle></svg>`;
                  // Update monitor icon color based on current theme
                  const currentTheme = getCurrentTheme();
                  const monitorIcon = logoContainer.querySelector('.monitor-icon');
                  if (monitorIcon) {
                    if (currentTheme === 'dark') {
                      monitorIcon.style.setProperty('--monitor-stroke', '#c9d1d9');
                    } else {
                      monitorIcon.style.setProperty('--monitor-stroke', '#24292f');
                    }
                  }
                });
              }
            } else {
              // Invalid URL format, reset to default
              const defaultLogo = logoContainer.querySelector('.default-logo');
              if (!defaultLogo) {
                logoContainer.innerHTML = `<svg width="20" height="20" class="sm:w-6 sm:h-6 monitor-icon default-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="--monitor-stroke: #24292f;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.5 12h2l2-6 3 18 2.5-12h2" style="stroke: var(--monitor-stroke);"></path><path stroke-linecap="round" stroke-width="1.5" opacity="0.8" d="M3 12h2M19 12h2" style="stroke: var(--monitor-stroke);"></path><path stroke-linecap="round" stroke-width="1.5" opacity="0.5" d="M1 12h1M22 12h1" style="stroke: var(--monitor-stroke);"></path><circle cx="12" cy="12" r="9" stroke-width="1.5" opacity="0.3" style="stroke: var(--monitor-stroke);"></circle><circle cx="12" cy="12" r="5" stroke-width="1.5" opacity="0.6" style="stroke: var(--monitor-stroke);"></circle></svg>`;
              }
            }
          } else if (logo.startsWith('<svg')) {
            // SECURITY: SVG markup from admin input ends up in the page. The
            // old check was a substring blacklist ('<script', 'javascript:',
            // 'onerror=', 'onload=') plus attribute removal on the ROOT
            // element only, so e.g. `onmouseenter=` on the root, or any
            // handler / <script> / <use href=…> on a CHILD node, walked
            // straight through. Use the shared tree-walking sanitizer
            // instead (same copy as SystemTable.astro / AdminDashboard.astro)
            // and insert the element it returns.
            const safeSvg = sanitizedSvgElement(logo);
            if (safeSvg) {
              logoContainer.replaceChildren(safeSvg);
              // Ensure SVG has proper size classes
              const svg = logoContainer.querySelector('svg');
              if (svg) {
                svg.classList.add('w-5', 'h-5', 'sm:w-6', 'sm:h-6');
                if (!svg.hasAttribute('width')) svg.setAttribute('width', '20');
                if (!svg.hasAttribute('height')) svg.setAttribute('height', '20');
              }
            } else {
              // Unparseable or non-SVG markup, reset to default
              const defaultLogo = logoContainer.querySelector('.default-logo');
              if (!defaultLogo) {
                logoContainer.innerHTML = `<svg width="20" height="20" class="sm:w-6 sm:h-6 monitor-icon default-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="--monitor-stroke: #24292f;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.5 12h2l2-6 3 18 2.5-12h2" style="stroke: var(--monitor-stroke);"></path><path stroke-linecap="round" stroke-width="1.5" opacity="0.8" d="M3 12h2M19 12h2" style="stroke: var(--monitor-stroke);"></path><path stroke-linecap="round" stroke-width="1.5" opacity="0.5" d="M1 12h1M22 12h1" style="stroke: var(--monitor-stroke);"></path><circle cx="12" cy="12" r="9" stroke-width="1.5" opacity="0.3" style="stroke: var(--monitor-stroke);"></circle><circle cx="12" cy="12" r="5" stroke-width="1.5" opacity="0.6" style="stroke: var(--monitor-stroke);"></circle></svg>`;
              }
            }
          }
        } else {
          // Reset to default logo if config.logo is empty
          const defaultLogo = logoContainer.querySelector('.default-logo');
          if (!defaultLogo) {
            // Restore default SVG if it was replaced
            logoContainer.innerHTML = `<svg width="20" height="20" class="sm:w-6 sm:h-6 monitor-icon default-logo" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="--monitor-stroke: #24292f;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.5 12h2l2-6 3 18 2.5-12h2" style="stroke: var(--monitor-stroke);"></path><path stroke-linecap="round" stroke-width="1.5" opacity="0.8" d="M3 12h2M19 12h2" style="stroke: var(--monitor-stroke);"></path><path stroke-linecap="round" stroke-width="1.5" opacity="0.5" d="M1 12h1M22 12h1" style="stroke: var(--monitor-stroke);"></path><circle cx="12" cy="12" r="9" stroke-width="1.5" opacity="0.3" style="stroke: var(--monitor-stroke);"></circle><circle cx="12" cy="12" r="5" stroke-width="1.5" opacity="0.6" style="stroke: var(--monitor-stroke);"></circle></svg>`;
          }
        }
      }
      
      // The sign-in page's mark is the navbar's, as Beszel's sign-in shows
      // its own logo: the site's logo when one is set (a copy of the element
      // made and checked above), else the Pulse mark it ships with.
      const loginMark = document.getElementById('login-mark');
      if (loginMark && logoContainer) {
        if (!loginMark._pulseMark) loginMark._pulseMark = loginMark.innerHTML;
        const custom = logoContainer.querySelector('img.custom-logo-img, svg:not(.default-logo)');
        if (custom) {
          const copy = custom.cloneNode(true);
          copy.setAttribute('class', 'w-8 h-8');
          if (copy.tagName === 'IMG') {
            copy.alt = '';
            copy.style.cssText = 'object-fit: contain; display: block;';
            copy.addEventListener('error', () => { loginMark.innerHTML = loginMark._pulseMark; });
          } else {
            // The navbar keeps its own copy (hidden on this page), and a
            // url(#id) or href="#id" finds the first element with that id:
            // the hidden copy's, where a gradient, mask or clip path draws
            // nothing, so such a logo showed blank here. The copy's ids get
            // a suffix and its references follow them.
            const renamed = new Map();
            [copy, ...copy.querySelectorAll('[id]')].forEach((el) => {
              if (!el.id) return;
              const next = `${el.id}-login`;
              renamed.set(el.id, next);
              el.id = next;
            });
            if (renamed.size) {
              const swap = (v) => v.replace(/url\(\s*(['"]?)#([^'")\s]+)\1\s*\)/g, (m, q, id) => (renamed.has(id) ? `url(#${renamed.get(id)})` : m));
              [copy, ...copy.querySelectorAll('*')].forEach((el) => {
                Array.from(el.attributes).forEach((attr) => {
                  const v = attr.value.trim();
                  const next = /(^|:)href$/i.test(attr.name) && v.startsWith('#') && renamed.has(v.slice(1)) ? `#${renamed.get(v.slice(1))}` : swap(attr.value);
                  if (next !== attr.value) attr.value = next;
                });
              });
            }
          }
          loginMark.replaceChildren(copy);
        } else {
          loginMark.innerHTML = loginMark._pulseMark;
        }
      }

      // and the tab's icon (applySiteFavicon)
      applySiteFavicon(logoContainer ? logoContainer.querySelector('img.custom-logo-img, svg:not(.default-logo)') : null);

      // Update monitor icon stroke color based on current theme
      const currentTheme = getCurrentTheme();
      const monitorIcon = logoContainer?.querySelector('.monitor-icon');
      if (monitorIcon) {
        if (currentTheme === 'dark') {
          monitorIcon.style.setProperty('--monitor-stroke', '#c9d1d9');
        } else {
          monitorIcon.style.setProperty('--monitor-stroke', '#24292f');
        }
      }
      
      // Show the logo, the name and the buttons together now that the
      // site's own are in (they wait hidden so the defaults never flash
      // first): one 150 ms fade (global.css), no entrance of their own, as
      // Beszel's page has none.
      requestAnimationFrame(() => {
        [logoContainer, navbarText, iconsContainer].forEach((el) => { if (el) el.style.opacity = '1'; });
      });
    }

    // Load navbar configuration from backend
    async function loadNavbarConfig() {
      // Check if config was preloaded
      if (window.__navbarConfig) {
        applyNavbarConfig(window.__navbarConfig);
        return;
      }
      
      try {
        const apiBase = window.location.origin;
        const res = await fetch(`${apiBase}/api/navbar/config`);
        if (res.ok) {
          const config = await res.json();
          applyNavbarConfig(config);
        } else {
          // If request failed, show defaults with animation
          applyNavbarConfig(null);
        }
      } catch (err) {
        // Config load failed silently - use defaults and show them with animation
        applyNavbarConfig(null);
      }
    }

    // Initialize on page load
    function init() {
      // Language and theme are already set in head script, just sync UI
      const currentLang = getCurrentLanguage();
      // Only update if different (to avoid unnecessary updates)
      if (document.documentElement.lang !== currentLang) {
        setLanguage(currentLang);
      }
      updateLanguageButton();

      // Theme is already applied, just sync icon
      const currentTheme = getCurrentTheme();
      // Only update if different (to avoid unnecessary updates)
      const htmlHasDark = document.documentElement.classList.contains('dark');
      const shouldBeDark = currentTheme === 'dark';
      if (htmlHasDark !== shouldBeDark) {
        applyTheme(currentTheme);
      } else {
        // Just update the icon without changing theme
        updateThemeIcon(currentTheme);
      }
      
      // Initialize monitor icon color
      const monitorIcon = document.querySelector('.monitor-icon');
      if (monitorIcon) {
        if (currentTheme === 'dark') {
          monitorIcon.style.setProperty('--monitor-stroke', '#c9d1d9');
        } else {
          monitorIcon.style.setProperty('--monitor-stroke', '#24292f');
        }
      }

      // Load navbar configuration (or use preloaded config)
      loadNavbarConfig();
      
      // Listen for preloaded config event
      window.addEventListener('navbarconfigready', (e) => {
        applyNavbarConfig(e.detail);
      });

      // Setup event listeners
      const languageBtn = document.getElementById('language-btn');
      const themeBtn = document.getElementById('theme-btn');

      if (languageBtn) {
        languageBtn.addEventListener('click', toggleLanguage);
      }

      if (themeBtn) {
        themeBtn.addEventListener('click', toggleTheme);
      }

      // Initialize tooltip / aria-label text for both buttons on mount
      // so tooltips reflect the actual next action from the very first
      // hover (before the user has toggled anything). Also react to
      // language changes so that e.g. switching to English refreshes the
      // theme button's "Switch to dark mode" label immediately without
      // a theme toggle.
      updateLanguageButton();
      updateThemeButton();
      updateNavLinks();
      window.addEventListener('languagechange', () => {
        updateLanguageButton();
        updateThemeButton();
        updateNavLinks();
      });

      // With "follow the system" chosen, a change of the system's theme
      // (a schedule, or the user switching it) reaches the open page.
      if (window.matchMedia) {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
          if (getThemePreference() !== 'system') return;
          applyTheme(getSystemTheme());
          updateThemeButton();
        });
      }

      // Pulse's heartbeat as a live signal: the default logo beats once each
      // time fresh data reaches the page (SystemTable's pulse:data, every
      // few seconds while the live stream runs) and stays still when it
      // stops. At most one beat in 1.5 s; none in a background tab or with
      // reduced motion; a custom logo stays still.
      const reducedMotion = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : null;
      let lastBeat = 0;
      window.addEventListener('pulse:data', () => {
        const logo = document.querySelector('#navbar-logo-container .monitor-icon.default-logo');
        if (!logo || typeof logo.animate !== 'function' || document.hidden || (reducedMotion && reducedMotion.matches)) return;
        const now = performance.now();
        if (now - lastBeat < 1500) return;
        lastBeat = now;
        logo.animate([{ opacity: 1 }, { opacity: 0.4, offset: 0.3 }, { opacity: 1 }], { duration: 800, easing: 'ease-out' });
      });
    }

    // Run initialization
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>