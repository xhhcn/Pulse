        if (!systemId) return;

        const container = document.querySelector(`[data-tcping-chart-container="${cssEscape(String(systemId))}"]`);
        const resourceOnly = detailsSection.querySelector('[data-resource-only]');
        const onResource = !!(container && container.querySelector('[data-chart-tab="resource"][aria-selected="true"]'));

        // Tear down the existing chart / tab state first so nothing from
        // the old target set can survive the redraw.
        cleanupTCPingChart(systemId);

        // The teardown also stops the 资源 charts: they come back where they
        // were shown (the card stayed on 资源 with four blank charts, for good).
        if (resourceOnly) {
          openResourcePane(resourceOnly, systemId);
          return;
        }
        if (!container) return;

        if (!fresh || !Array.isArray(fresh.targets) || fresh.targets.length === 0) {
          // Config is now empty — hide the tcping panel entirely.
          container.style.display = 'none';
          return;
        }

        // Config still has targets — rebuild tabs from the fresh list
        // and re-initialise the chart.
        initializeTCPingTabs(systemId).then(() => {
          initializeTCPingChart(systemId);
          if (onResource) showChartPane(container, systemId, 'resource');
        }).catch(() => {
          // Swallow — a missing DOM node simply means the row was
          // collapsed in between the SSE arrival and our async work.
        });
      });
    } finally {
      tcpingConfigUpdatePending = false;
      if (tcpingConfigUpdateAgain) {
        tcpingConfigUpdateAgain = false;
        handleTCPingConfigUpdated();
      }
    }
  }

  // Preload TCPing config on page load
  function preloadTCPingConfig() {
    loadTCPingConfig().then(config => {
      if (config && config.targets && config.targets.length > 0) {
        // Also preload Chart.js if TCPing is configured
        preloadChartJS();
      }
    });
  }
  
  // Chart.js and its date adapter ship with the site (see vendor/README.md),
  // under content-hashed /_astro/ names, so no visitor depends on a public
  // CDN. Each file is still pinned by Subresource Integrity to the npm
  // release it came from.
  const CHARTJS_SRI = {
    [chartJsUrl]: 'sha384-FcQlsUOd0TJjROrBxhJdUhXTUgNJQxTMcxZe6nHbaEfFL1zjQ+bq/uRoBQxb0KMo',
    [chartJsAdapterUrl]: 'sha384-cVMg8E3QFwTvGCDuK+ET4PD341jF3W8nO1auiXfuZNQkzbUUiBGLsIQUE+b1mxws',
  };
  function setChartScriptSource(script, url) {
    script.integrity = CHARTJS_SRI[url];
    script.crossOrigin = 'anonymous';
    script.src = url;
  }

  // Chart.js plugins shared by every Pulse chart (the TCPing chart and the
  // 资源 charts): the cursor's hairline, and the loss band, which draws only
  // on a chart whose options enable it. Registered once.
  function registerPulseChartPlugins(ChartClass) {
    // Register crosshair plugin if not already registered
    // Use a global variable to track if plugin is registered
    if (!window.crosshairPluginRegistered) {
      const crosshairPlugin = {
        id: 'crosshair',
        afterDraw: function(chart) {
          const tooltip = chart.tooltip;
          if (tooltip && tooltip.opacity > 0 && tooltip.dataPoints && tooltip.dataPoints.length > 0) {
            const ctx = chart.ctx;
            const dataPoint = tooltip.dataPoints[0];
            const x = dataPoint.element.x;
            const chartArea = chart.chartArea;
            
            // A solid hairline, quieter than the lines (a dashed one read as
            // a threshold), as Beszel's chart cursor.
            const crosshairColor = cursorLineColor(document.documentElement.classList.contains('dark'));
            
            // Save context state
            ctx.save();
            
            ctx.strokeStyle = crosshairColor;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(x, chartArea.top);
            ctx.lineTo(x, chartArea.bottom);
            ctx.stroke();
            
            // Restore context state
            ctx.restore();
          }
        }
      };
      
      try {
        if (ChartClass.register) {
          ChartClass.register(crosshairPlugin);
          window.crosshairPluginRegistered = true;
        } else if (ChartClass.registry && ChartClass.registry.add) {
          ChartClass.registry.add(crosshairPlugin);
          window.crosshairPluginRegistered = true;
        }
      } catch (e) {
        // Plugin registration failed silently
      }
    }
    
    // The probes under the pointer, for the readout and the hover dots
    // alike: each target's nearest probe within 0.6 of the spacing between
    // its probes (at least 5 px; a timed-out probe counts, its row says so).
    // Chart.js's 'x' mode took probes within 5 px only, so on the 1-hour span
    // the readout dropped out between probes while the 'nearest' hover dots
    // stayed lit, and in a stretch without samples the dots lit up at its far
    // end with no readout.
    const modes = ChartClass.Interaction && ChartClass.Interaction.modes;
    if (modes && !modes.tcpingNear) {
      modes.tcpingNear = (chart, e) => {
        const h = ChartClass.helpers;
        const pos = e && 'native' in e ? { x: e.x, y: e.y } : (h && h.getRelativePosition ? h.getRelativePosition(e, chart) : { x: e.x, y: e.y });
        const reach = tcpingReach(chart);
        const items = [];
        chart.getSortedVisibleDatasetMetas().forEach((meta) => {
          const pts = meta.data;
          if (!pts || !pts.length) return;
          let lo = 0, hi = pts.length - 1;
          while (lo < hi) {
            const mid = (lo + hi) >> 1;
            if (pts[mid].x < pos.x) lo = mid + 1; else hi = mid;
          }
          if (lo > 0 && Math.abs(pts[lo - 1].x - pos.x) <= Math.abs(pts[lo].x - pos.x)) lo -= 1;
          const el = pts[lo];
          if (!el || !Number.isFinite(el.x) || Math.abs(el.x - pos.x) > reach) return;
          items.push({ element: el, datasetIndex: meta.index, index: lo });
        });
        return items;
      };
    }

    // 自定义设置 → 丢包时间线: a band under the plot, red where a shown target
    // lost a probe (the selected target alone while one is picked), each mark
    // as long as one probe interval; "丢包" in the axis column beside it. A
    // gap in the lines reads as lost probes or as no data at a glance.
    if (!window.__pulseLossLaneRegistered && ChartClass.register) {
      ChartClass.register({
        id: 'lossLane',
        afterDraw(chart) {
          const area = chart.chartArea;
          const xs = chart.scales.x;
          const ys = chart.scales.y;
          if (!area || !xs || !ys) return;
          const dark = document.documentElement.classList.contains('dark');
          const top = area.bottom + LOSS_LANE_GAP;
          const c = chart.ctx;
          c.save();
          c.fillStyle = gridLineColor(dark);
          c.fillRect(area.left, top, area.right - area.left, LOSS_LANE_HEIGHT);
          c.fillStyle = '#fb2c36';
          const selected = chart.data.datasets.some((d) => d.role === 'selected');
          chart.data.datasets.forEach((d, i) => {
            if ((selected && d.role !== 'selected') || !chart.isDatasetVisible(i)) return;
            lossRuns(d.data).forEach(([t0, t1]) => {
              const x0 = Math.max(area.left, xs.getPixelForValue(t0));
              const x1 = Math.min(area.right, xs.getPixelForValue(t1));
              if (x1 >= area.left && x0 <= area.right) c.fillRect(x0, top, Math.max(1.5, x1 - x0), LOSS_LANE_HEIGHT);
            });
          });
          const item = ys.getLabelItems ? ys.getLabelItems()[0] : null;
          const right = item && item.options && item.options.translation ? item.options.translation[0] : ys.right - 8;
          c.fillStyle = axisLabelColor(dark);
          c.font = `11px ${ChartClass.defaults.font.family}`;
          c.textAlign = 'right';
          c.textBaseline = 'middle';
          c.fillText(translations.tcpingLossLane[getCurrentLanguage()], right, top + LOSS_LANE_HEIGHT / 2);
          c.restore();
        },
      });
      window.__pulseLossLaneRegistered = true;
    }
  }

  // Preload Chart.js library for faster chart rendering
  function preloadChartJS() {
    // Skip if already loaded or loading
    if (window.Chart || document.querySelector('script[data-chartjs]')) {
      return;
    }
    
    // The matching <link rel="preload" crossorigin="anonymous"> in
    // index.astro warms the cache, but the browser only reuses that
    // response for a script request whose CORS mode matches — so we must
    // set crossorigin on the dynamic <script> too, otherwise Chart.js gets
    // fetched twice. A file that fails to load is removed again, so the
    // loader in updateTCPingChart tries afresh when a row is opened.
    const script = document.createElement('script');
    setChartScriptSource(script, chartJsUrl);
    script.onerror = () => script.remove();
    script.async = true;
    script.setAttribute('data-chartjs', 'true');
    script.onload = () => {
      // Also preload date adapter
      if (!document.querySelector('script[data-chartjs-adapter]')) {
        const adapterScript = document.createElement('script');
        setChartScriptSource(adapterScript, chartJsAdapterUrl);
        adapterScript.async = true;
        adapterScript.setAttribute('data-chartjs-adapter', 'true');
        adapterScript.onload = () => {
          window._chartjsAdapterLoaded = true;
        };
        adapterScript.onerror = () => adapterScript.remove();
        document.head.appendChild(adapterScript);
      }
    };
    document.head.appendChild(script);
  }

  // Load tcping history data.
  //
  // Returns:
  //   - { results: [...], stats: {...} } on success (new server format), or
  //   - [...] on success (legacy array format), or
  //   - { __error: true } on any fetch failure (network error, non-2xx HTTP).
  //
  // The __error sentinel is what lets updateTCPingChart() distinguish a
  // *transient* upstream failure (briefly offline, server restarting, 502
  // from a flaky reverse proxy …) from a *legitimate* "this client has no
  // tcping samples yet" empty response. Without the sentinel both cases
  // looked identical and we used to destroy the existing chart on every
  // hiccup, which the user perceives as the chart "reloading" every few
  // ticks.
  //
  // A row's history can be requested before the row opens (a mouse press or
  // a short hover, see setupRowClickHandlers); the open then takes over that
  // request instead of starting its own, unless a newer sample has been
  // announced since it was sent.
  const TCPING_PREFETCH_TTL_MS = 10000;
  const tcpingHistoryPrefetch = new Map(); // clientID -> { at, sig, promise }
  // How long the last chart creation took on this device (see
  // _updateTCPingChartImpl). Only a device that builds a chart within a
  // frame or two draws one while its section is still sliding open.
  const TCPING_FAST_BUILD_MS = 30;
  let tcpingLastBuildMs = null;
  let tcpingBuildCount = 0;
  // Signature of the samples the newest snapshot announces for a system:
  // an SSE payload can wait up to 80 ms for its render (debouncedRenderData),
  // otherwise currentData keeps the raw snapshot item as `original`.
  function latestTCPingSignature(systemId) {
    const pending = Array.isArray(pendingRenderData)
      ? pendingRenderData.find((item) => item && String(item.id) === systemId) : null;
    if (pending) return computeTCPingSignature(pending);
    const entry = currentData.get(systemId);
    return computeTCPingSignature(entry && entry.original);
  }
  function usableTCPingPrefetch(clientID) {
    const hit = tcpingHistoryPrefetch.get(clientID);
    return hit && Date.now() - hit.at < TCPING_PREFETCH_TTL_MS
      && hit.sig === latestTCPingSignature(clientID) ? hit : null;
  }
  function prefetchTCPingHistory(clientID) {
    if (!clientID || !cachedTCPingConfig || !Array.isArray(cachedTCPingConfig.targets)
        || cachedTCPingConfig.targets.length === 0 || usableTCPingPrefetch(clientID)) return;
    const entry = { at: Date.now(), sig: latestTCPingSignature(clientID), promise: fetchTCPingHistory(clientID) };
    tcpingHistoryPrefetch.set(clientID, entry);
    // Rows that are only hovered must not keep their samples around.
    setTimeout(() => {
      if (tcpingHistoryPrefetch.get(clientID) === entry) tcpingHistoryPrefetch.delete(clientID);
    }, TCPING_PREFETCH_TTL_MS);
  }
  async function loadTCPingHistory(clientID, target) {
    if (!target) {
      const hit = usableTCPingPrefetch(clientID);
      tcpingHistoryPrefetch.delete(clientID);
      if (hit) {
        const data = await hit.promise;
        if (data && !data.__error) return data;
      }
    }
    return fetchTCPingHistory(clientID, target);
  }
  // An open chart's probes as the server sent them (oldest first), kept
  // while it is open (tcpingRawHistory, declared with the other chart
  // state). Each new probe used to fetch the whole day again (some 45 KB
  // compressed, 414 KB of JSON, every minute per open chart, for three new
  // points); now the chart asks for what came after its newest probe, less
  // a margin for probes that arrive late, and splices that in. The server
  // answers a since older than ten minutes (a tab that slept) with the
  // whole day, which splices the same way.
  const TCPING_TAIL_MARGIN_MS = 2 * 60 * 1000;
  async function loadTCPingHistoryTail(clientID, raw) {
    const newest = raw.length ? Date.parse(raw[raw.length - 1].timestamp) : NaN;
    if (!Number.isFinite(newest)) return loadTCPingHistory(clientID);
    const cut = newest - TCPING_TAIL_MARGIN_MS;
    const data = await fetchTCPingHistory(clientID, null, cut);
    if (!data || data.__error || !Array.isArray(data.results)) return data;
    // what is older than the cut stays (less what left the day), the
    // server's answer from the cut on replaces the rest
    let end = raw.length;
    while (end > 0 && !(Date.parse(raw[end - 1].timestamp) <= cut)) end--;
    const dayAgo = Date.now() - 24 * 60 * 60 * 1000;
    let start = 0;
    while (start < end && !(Date.parse(raw[start].timestamp) >= dayAgo)) start++;
    const fresh = data.results.filter((r) => Date.parse(r.timestamp) > cut);
    return { results: raw.slice(start, end).concat(fresh), stats: data.stats };
  }
  async function fetchTCPingHistory(clientID, target, since) {
    try {
      let url = `${apiBase}/api/tcping/history?client_id=${encodeURIComponent(clientID)}${target ? `&target=${encodeURIComponent(target)}` : ''}${since ? `&since=${Math.floor(since)}` : ''}`;
      const { res } = await authedFetch(url);
      if (res.ok) {
        const data = await res.json();
        return data;
      }
      return { __error: true };
    } catch (err) {
      return { __error: true };
    }
  }

  // Line colour of each target, by its position in the config: every line
  // has its own while no target is selected; a selected target keeps its
  // colour and the rest turn grey. Each tab carries a dot of its line's
  // colour, so the tab strip doubles as the chart's legend.
  // Blue, orange and teal come first. The old green, blue and purple turned
  // the second and third line into the same blue for red-green colour-blind
  // readers (OKLab ΔE 0.9 under deuteranopia), and the green read as the
  // "online" colour. These three stay apart from one another under
  // protanopia and deuteranopia (ΔE 13.8 or more). The fourth is fuchsia:
  // the violet it replaces was the first line's blue again under
  // deuteranopia (ΔE 0.4); the first four now stay apart pairwise (light
  // ΔE 9.7, dark 6.1 with the names beside them), and every colour from
  // its neighbours (12.4 or more; 15.8 or more with normal vision). Each
  // theme has its own steps, all at least 3:1 on its card.
  const TCPING_LINE_COLORS_LIGHT = [
    '#2563eb', // blue-600
    '#ea580c', // orange-600
    '#0d9488', // teal-600
    '#a21caf', // fuchsia-700
    '#db2777', // pink-600
    '#9333ea', // purple-600
    '#0891b2', // cyan-600
    '#4f46e5', // indigo-600
  ];
  const TCPING_LINE_COLORS_DARK = [
    '#3b82f6', // blue-500
    '#ea580c', // orange-600
    '#0d9488', // teal-600
    '#c026d3', // fuchsia-600
    '#db2777', // pink-600
    '#9333ea', // purple-600
    '#0891b2', // cyan-600
    '#6366f1', // indigo-500
  ];
  const tcpingLineColor = (index, dark = document.documentElement.classList.contains('dark')) => {
    const colors = dark ? TCPING_LINE_COLORS_DARK : TCPING_LINE_COLORS_LIGHT;
    return colors[index % colors.length];
  };
  // A line by its role: every target shown ('all'), the 'selected' one, or
  // an 'other' one while a target is selected. The others keep their own
  // colour, faded, as Beszel fades the sensors its chart filter leaves out
  // (stroke opacity 0.1), so each stays recognisable behind the selected
  // one, which is drawn on top. Every line is Beszel's 1.5 px.
  const TCPING_LINE_WIDTH = 1.5;
  function tcpingRoleColor(index, role, dark, alpha = 0.15) {
    const color = tcpingLineColor(index, dark);
    if (role !== 'other') return color;
    const n = parseInt(color.slice(1), 16);
    return `rgba(${n >> 16}, ${(n >> 8) & 255}, ${n & 255}, ${alpha})`;
  }

  // The chart's tooltip as HTML, like Beszel's: a card with the time on top
  // and a row per target, its colour, its name (muted) and its value (bold,
  // to the right); a target that timed out at that minute says so. Built
  // from what Chart.js collected, so the tooltip's filter (the selected
  // target only) still applies; a target split into several datasets is
  // listed once. Labels come from the config: textContent only.
  let tcpingTooltipEl = null;
  function hideTCPingTooltip() {
    if (tcpingTooltipEl) tcpingTooltipEl.style.opacity = '0';
  }
  function tcpingTooltipExternal(context) {
    const { chart, tooltip } = context;
    if (!tcpingTooltipEl) {
      tcpingTooltipEl = document.createElement('div');
      tcpingTooltipEl.className = 'tcping-tooltip';
      tcpingTooltipEl.setAttribute('aria-hidden', 'true');
      document.body.appendChild(tcpingTooltipEl);
      document.addEventListener('pointerdown', hideTCPingTooltip, true);
      window.addEventListener('scroll', hideTCPingTooltip, true);
    }
    const el = tcpingTooltipEl;
    if (!tooltip || tooltip.opacity === 0 || !tooltip.dataPoints || !tooltip.dataPoints.length) {
      hideTCPingTooltip();
      return;
    }
    const lang = getCurrentLanguage();
    const rows = [];
    const listed = new Set();
    tooltip.dataPoints.forEach((item) => {
      const dataset = item.dataset;
      const key = dataset.targetAddress !== undefined ? dataset.targetAddress : dataset.label;
      if (listed.has(key)) return;
      listed.add(key);
      const value = item.parsed.y;
      const timedOut = value === null || value === undefined;
      const order = dataset.targetIndex !== undefined ? dataset.targetIndex : item.datasetIndex;
      if (dataset.formatValue) {
        if (!timedOut) rows.push({ color: dataset.borderColor, name: dataset.label || '', order, value: dataset.formatValue(value), muted: false });
        return;
      }
      rows.push({ color: dataset.borderColor, name: dataset.label || '', order, value: timedOut ? translations.tcpingTimeout[lang] : `${value.toFixed(2)} ms`, muted: timedOut });
    });
    // In the legend's order, as Beszel's monitor tooltip: each row keeps its
    // place while the pointer moves (sorted by value, they swapped places at
    // almost every probe), and a timed-out target says so in its own place.
    rows.sort((a, b) => a.order - b.order);
    (tooltip.footer || []).forEach((line) => {
      const at = line.lastIndexOf(': ');
      if (at > 0) rows.push({ color: null, name: line.slice(0, at), value: line.slice(at + 2), muted: true });
    });
    el.replaceChildren();
    const title = document.createElement('div');
    title.className = 'tcping-tooltip-title';
    title.textContent = (tooltip.title && tooltip.title[0]) || '';
    el.appendChild(title);
    rows.forEach((r) => {
      const row = document.createElement('div');
      row.className = 'tcping-tooltip-row';
      const key = document.createElement('span');
      key.className = 'tcping-tooltip-key';
      if (r.color) key.style.backgroundColor = r.color;
      const name = document.createElement('span');
      name.className = 'tcping-tooltip-name';
      name.textContent = r.name;
      const value = document.createElement('span');
      value.className = r.muted ? 'tcping-tooltip-value is-muted' : 'tcping-tooltip-value';
      value.textContent = r.value;
      row.append(key, name, value);
      el.appendChild(row);
    });
    // Beside the crosshair (the other side when the right is short of room),
    // centred on the pointer, kept inside the chart and the window. It fades
    // in where it first shows, then glides from point to point (a CSS
    // transition on the transform, as the canvas tooltip did).
    const rect = chart.canvas.getBoundingClientRect();
    const appearing = el.style.opacity !== '1';
    const w = el.offsetWidth;
    const h = el.offsetHeight;
    const x = rect.left + tooltip.caretX;
    let left = x + 14;
    if (left + w > Math.min(window.innerWidth - 8, rect.right + 24)) left = x - 14 - w;
    left = Math.max(8, Math.min(left, window.innerWidth - 8 - w));
    let top = rect.top + tooltip.caretY - h / 2;
    top = Math.max(rect.top, Math.min(top, rect.bottom - h));
    top = Math.max(8, Math.min(top, window.innerHeight - 8 - h));
    const place = `translate(${Math.round(left)}px, ${Math.round(top)}px)`;
    if (appearing) {
      el.classList.add('is-placing');
      el.style.transform = place;
      void el.offsetWidth;
      el.classList.remove('is-placing');
    } else {
      el.style.transform = place;
    }
    el.style.opacity = '1';
  }

  function paintTCPingTabDots(tabsContainer, selectedTarget, dark) {
    tabsContainer.querySelectorAll('button').forEach((tab, index) => {
      const dot = tab.querySelector('[data-tcping-dot]');
      if (!dot) return;
      dot.style.backgroundColor = tcpingRoleColor(index, selectedTarget === null || tab.dataset.target === selectedTarget ? 'all' : 'other', dark, 0.35);
    });
  }

  // Tab appearance. Three inputs: selected or not, and whether the agent
  // reported this target as skipped.
  //
  // A skipped tab is muted and carries the translated "cannot reach" string
  // as its tooltip, so the state is legible from the legend without having
  // to open the tab. The mute is COLOUR ONLY — no added glyphs, no italics,
  // no weight — because the legend is `flex-wrap` under the chart: any
  // change to an entry's measured width could push it onto a second line and
  // change the height of the card. A target flipping between skipped and
  // measured therefore repaints in place and never moves anything.
  // The entries look like Beszel's legend (a square and the muted name, no
  // border); the selected one gets a light tint and the text colour, and
  // the pointer a tint on hover, so they read as controls. Every state has
  // the same box.
  const TCPING_TAB_BASE = 'inline-flex items-center gap-1.5 px-2 py-0.5 text-xs rounded-[8.8px] cursor-pointer transition-colors';
  const TCPING_TAB_ACTIVE = 'bg-black/[0.06] dark:bg-white/10 text-[#151515] dark:text-[#f5f5f5]';
  const TCPING_TAB_INACTIVE = 'bg-transparent text-[#595959] dark:text-[#ababab] hover:bg-[#f3efec]/70 dark:hover:bg-[#282828]/70 hover:text-[#1d1d20] dark:hover:text-[#e5e5e5]';
  // A skipped target is de-emphasised with an explicit muted grey rather than
  // `opacity-50`. Blending the normal colours to 50% measures 2.38:1 in light
  // mode (#525252 over the card's #ffffff) and 2.73:1 in dark (#a3a3a3 over
  // #151515) by the WCAG formula — far below the 4.5:1 AA floor, and this is
  // 12 px text. The greys below measure 5.33:1 / 5.29:1 on the card
  // background and 11.1:1 / 4.96:1 on the selected tab's tinted background.
  // Only the colour changes: padding, font-size and weight are untouched, so
  // the tab keeps exactly the same box and a target flipping between skipped
  // and measured still repaints in place without moving the row.
  //
  // The skipped variants REPLACE the normal colour classes instead of being
  // appended after them — two competing `text-*` utilities in one class list
  // resolve by stylesheet order, not by the order they appear in the
  // attribute, so layering would be a coin flip.
  const TCPING_TAB_SKIPPED_ACTIVE = 'bg-black/[0.06] dark:bg-white/10 text-[#333333] dark:text-[#9a9a9a]';
  const TCPING_TAB_SKIPPED_INACTIVE = 'bg-transparent text-[#6b6b6b] dark:text-[#8a8a8a] hover:bg-[#f3efec]/70 dark:hover:bg-[#282828]/70';

  function applyTCPingTabAppearance(tab, isActive, isSkipped) {
    const variant = isSkipped
      ? (isActive ? TCPING_TAB_SKIPPED_ACTIVE : TCPING_TAB_SKIPPED_INACTIVE)
      : (isActive ? TCPING_TAB_ACTIVE : TCPING_TAB_INACTIVE);
    tab.className = `${TCPING_TAB_BASE} ${variant}`;
    // The selected target, for screen readers too (not by colour only).
    tab.setAttribute('aria-pressed', String(!!isActive));
    if (isSkipped) {
      tab.setAttribute('data-translate-title', 'tcpingUnreachable');
      tab.setAttribute('title', translations.tcpingUnreachable[getCurrentLanguage()] || translations.tcpingUnreachable.en);
    } else {
      tab.removeAttribute('data-translate-title');
      tab.removeAttribute('title');
    }
  }

  // Re-apply tab appearance in place, without rebuilding the strip.
  //
  // createTCPingTabs() wipes and recreates every button, which would be far
  // too heavy to run on an SSE tick (and would drop the click listeners). This
  // only rewrites className/title on the existing buttons, and only for the
  // ones whose skipped state actually changed — so the common tick, where
  // nothing is skipped and nothing changed, touches no DOM at all.
  function refreshTCPingTabStates(systemId) {
    const container = document.querySelector(`[data-tcping-chart-container="${cssEscape(String(systemId))}"]`);
    if (!container) return;
    const tabsContainer = container.querySelector(`[data-tcping-tabs="${cssEscape(String(systemId))}"]`);
    if (!tabsContainer) return;

    const activeTargetInfo = tcpingActiveTargets.get(systemId);
    const selectedTarget = activeTargetInfo ? activeTargetInfo.target : null;

    tabsContainer.querySelectorAll('button').forEach(tab => {
      const address = tab.dataset.target;
      if (!address) return;
      const isSkipped = isTCPingTargetSkipped(systemId, address);
      const wasSkipped = tab.dataset.tcpingTargetSkipped === 'true';
      const isActive = selectedTarget === address;
      const wasActive = tab.dataset.tcpingActive === 'true';
      if (isSkipped === wasSkipped && isActive === wasActive) return;
      tab.dataset.tcpingTargetSkipped = isSkipped ? 'true' : 'false';
      tab.dataset.tcpingActive = isActive ? 'true' : 'false';
      applyTCPingTabAppearance(tab, isActive, isSkipped);
    });
  }

  // Helper function to create tabs for TCPing targets
  function createTCPingTabs(systemId, config, tabsContainer) {
    // Clear existing tabs
    tabsContainer.innerHTML = '';

    // Check if there's a previously selected target for this system
    const activeTargetInfo = tcpingActiveTargets.get(systemId);
    const previouslySelectedTarget = activeTargetInfo ? activeTargetInfo.target : null;

    // Create tabs for each target
    config.targets.forEach((target, index) => {
      const tab = document.createElement('button');
      // Without an explicit type a <button> inside a form defaults to
      // "submit"; these tabs only switch the chart, never submit anything.
      tab.type = 'button';

      // Check if this tab should be active (restore previous selection)
      const isActive = previouslySelectedTarget === target.address;
      const isSkipped = isTCPingTargetSkipped(systemId, target.address);

      // Set initial state based on previous selection
      tab.dataset.tcpingTargetSkipped = isSkipped ? 'true' : 'false';
      tab.dataset.tcpingActive = isActive ? 'true' : 'false';
      applyTCPingTabAppearance(tab, isActive, isSkipped);

      const dot = document.createElement('span');
      dot.setAttribute('data-tcping-dot', '');
      dot.setAttribute('aria-hidden', 'true');
      dot.className = 'inline-block w-2 h-2 shrink-0 rounded-[2px]';
      // The target's own average over the span shown after its name, and,
      // where the loss band is off, its loss where it counts
      // (updateTCPingTabAverages). Each stays on one line; on a phone the
      // legend wraps between targets.
      const average = document.createElement('span');
      average.setAttribute('data-tcping-tab-avg', '');
      average.className = 'tabular-nums whitespace-nowrap text-[#595959] dark:text-[#ababab] empty:hidden';
      const loss = document.createElement('span');
      loss.setAttribute('data-tcping-tab-loss', '');
      loss.className = 'tcping-tab-loss tabular-nums whitespace-nowrap text-[#595959] dark:text-[#ababab] empty:hidden';
      tab.append(dot, document.createTextNode(target.name || target.address), average, loss);
      tab.dataset.target = target.address;
      tab.dataset.targetName = target.name || target.address;

      tab.addEventListener('click', () => {
        // Check if this tab is already active
        const currentActiveTargetInfo = tcpingActiveTargets.get(systemId);
        const isCurrentlyActive = currentActiveTargetInfo && currentActiveTargetInfo.target === target.address;

        if (isCurrentlyActive) {
          // Clicking the active tab: deselect it and show all targets
          tab.dataset.tcpingActive = 'false';
          applyTCPingTabAppearance(tab, false, isTCPingTargetSkipped(systemId, target.address));

          // Clear active target to show all targets with distinct colors
          tcpingActiveTargets.delete(systemId);

          // Update chart colors to show all targets (don't reload data)
          updateTCPingChartColors(systemId, null);
          paintTCPingTabDots(tabsContainer, null);
        } else {
          // Clicking an inactive tab: select it
          // Update all tabs to inactive state
          tabsContainer.querySelectorAll('button').forEach(btn => {
            btn.dataset.tcpingActive = 'false';
            applyTCPingTabAppearance(btn, false, isTCPingTargetSkipped(systemId, btn.dataset.target));
          });
          // Set clicked tab as active
          tab.dataset.tcpingActive = 'true';
          applyTCPingTabAppearance(tab, true, isTCPingTargetSkipped(systemId, target.address));

        // Update current active target for this system
        tcpingActiveTargets.set(systemId, {
          target: target.address,
          targetName: target.name || target.address
        });

          // Update chart colors based on selected target (don't reload data)
          updateTCPingChartColors(systemId, target.address);
          paintTCPingTabDots(tabsContainer, target.address);
        }
      });

      tabsContainer.appendChild(tab);
    });
    paintTCPingTabDots(tabsContainer, previouslySelectedTarget);
    
    // Return the previously selected target (if any) to maintain state
    return previouslySelectedTarget;
  }

  // Initialize TCPing tabs immediately when details section expands
  async function initializeTCPingTabs(systemId) {
    const container = document.querySelector(`[data-tcping-chart-container="${cssEscape(String(systemId))}"]`);
    if (!container) {
      return;
    }

    const tabsContainer = container.querySelector(`[data-tcping-tabs="${cssEscape(String(systemId))}"]`);
    if (!tabsContainer) {
      return;
    }

    // Try to use cached config first for immediate tab display
    let config = cachedTCPingConfig;
    
    // If no cached config, fetch it
    if (!config) {
      config = await loadTCPingConfig();
    }
    
    if (!config || !config.targets || config.targets.length === 0) {
      container.style.display = 'none';
      return;
    }
    
    container.style.display = 'block';
    tcpingConfigs.set(systemId, config);

    // Create tabs immediately (no loading delay for tabs)
    // This will restore the previously selected target if any
    createTCPingTabs(systemId, config, tabsContainer);
    updateTCPingTabAverages(systemId);
    updateTCPingLastProbe(systemId);
  }

  // Initialize tcping chart for a system
  async function initializeTCPingChart(systemId) {
    const container = document.querySelector(`[data-tcping-chart-container="${cssEscape(String(systemId))}"]`);
    if (!container) {
      return;
    }

    const canvas = container.querySelector(`[data-tcping-chart="${cssEscape(String(systemId))}"]`);
    if (!canvas) {
      return;
    }

    // Set loading state
    tcpingLoadingStates.set(systemId, { loading: true, cancelled: false });

    // Show loading state for chart only (not tabs) - do this immediately without waiting
    const loadingElement = container.querySelector(`[data-tcping-loading="${cssEscape(String(systemId))}"]`);
    if (loadingElement) {
      loadingElement.style.display = 'flex';
    }
    if (canvas) {
      canvas.classList.add('opacity-0');
    }

    // Get config (should already be loaded by initializeTCPingTabs)
    const config = tcpingConfigs.get(systemId);
    if (!config) {
      // Fallback: load config if tabs weren't initialized
      const loadedConfig = cachedTCPingConfig || await loadTCPingConfig();
      if (!loadedConfig || !loadedConfig.targets || loadedConfig.targets.length === 0) {
        tcpingLoadingStates.delete(systemId);
        return;
      }
      tcpingConfigs.set(systemId, loadedConfig);
    }

    // Check if cancelled before proceeding
    const loadingState = tcpingLoadingStates.get(systemId);
    if (!loadingState || loadingState.cancelled) {
      tcpingLoadingStates.delete(systemId);
      return;
    }

    // Get previously selected target from tabs
    const activeTargetInfo = tcpingActiveTargets.get(systemId);
    const restoredTarget = activeTargetInfo ? activeTargetInfo.target : null;

    // Initialize chart with all targets
    // If there's a restored target, the chart will show single line highlight
    // Otherwise, all lines will be colored
    try {
      await updateTCPingChart(systemId, null, null); // null means load all targets
    } catch (_) {
      // Chart.js could not be loaded. Clearing the loading state lets the
      // next sample (the SSE refresh) try again, as does the next open.
      tcpingLoadingStates.delete(systemId);
      return;
    }
    
    // Check if cancelled after chart update
    if (!tcpingLoadingStates.get(systemId) || tcpingLoadingStates.get(systemId).cancelled) {
      tcpingLoadingStates.delete(systemId);
      return;
    }
    
    // If there was a restored target, update chart colors to match the button state
    if (restoredTarget) {
      updateTCPingChartColors(systemId, restoredTarget);
    }
    
    // Clear loading state
    tcpingLoadingStates.delete(systemId);
  }

  // Update tcping chart with data for all targets
  async function updateTCPingChart(systemId, target, targetName, incremental = false) {
    // Re-entrancy guard: if the previous incremental tick for this system is
    // still mid-fetch, drop this call rather than racing it. Two concurrent
    // updates on the same canvas was the most reproducible cause of the
    // "chart reloads itself" flicker on slow networks.
    if (incremental && tcpingIncrementalInFlight.has(systemId)) {
      return;
    }
    if (incremental) {
      tcpingIncrementalInFlight.add(systemId);
    }
    try {
      await _updateTCPingChartImpl(systemId, target, targetName, incremental);
    } finally {
      if (incremental) {
        tcpingIncrementalInFlight.delete(systemId);
      }
      // Reconcile the "unreachable target" overlay here rather than at each
      // of the impl's many return points (transient fetch error, no-data
      // early exit, incremental tail-merge, full rebuild). It is a handful of
      // class toggles against elements that already exist, costs no layout,
      // and is idempotent — so it is safe to run on every exit path, and it
      // is the single place that decides whether the chart or the notice is
      // visible. It runs LAST on purpose: the impl may have just written 0 ms
      // / 0.00% or "-" into the summary, and for a skipped target that has to
      // be replaced with N/A.
      try { applyTCPingUnreachableState(systemId); } catch (_) {}
    }
  }

  // The end of a new chart's draw-in (tcping-reveal): the class goes, so a
  // redraw of the same chart does not play it again.
  function tcpingRevealDone(e) {
    if (e.animationName === 'tcping-reveal') e.currentTarget.classList.remove('tcping-new');
  }

  async function _updateTCPingChartImpl(systemId, target, targetName, incremental) {
    const container = document.querySelector(`[data-tcping-chart-container="${cssEscape(String(systemId))}"]`);
    if (!container) return;

    const canvas = container.querySelector(`[data-tcping-chart="${cssEscape(String(systemId))}"]`);
    if (!canvas) return;
    
    // Check if loading was cancelled early
    const loadingState = tcpingLoadingStates.get(systemId);
    if (loadingState && loadingState.cancelled) {
      return;
    }
    
    // Get config for this system
    const config = tcpingConfigs.get(systemId);
    if (!config || !config.targets || config.targets.length === 0) {
      return;
    }
    
    // Show loading state if this is not an incremental update
    if (!incremental) {
      const loadingElement = container.querySelector(`[data-tcping-loading="${cssEscape(String(systemId))}"]`);
      if (loadingElement) {
        loadingElement.style.display = 'flex';
      }
      canvas.classList.add('opacity-0');
    }

    // Get system data to find client ID
    const systemRow = document.querySelector(`[data-system-id="${cssEscape(String(systemId))}"]`);
    if (!systemRow) return;

    // Get client ID from system data (assuming it's the same as system ID)
    const clientID = systemId;

    // Check if chart already exists for incremental update
    const chartKey = `${systemId}_all`;
    const existingChartData = tcpingCharts.get(chartKey);

    // Load history data for all targets in a single request (optimized for CPU)
    // This reduces HTTP requests from N (number of targets) to 1
    // Also leverages server-side caching for better performance
    // Response format: { results: [...], stats: { avg_latency, packet_loss_rate } }
    // The snapshot signature these samples belong to (see the SSE handler).
    // Recorded with a new chart, so the first broadcast after opening does
    // not fetch the same history again.
    const sigAtFetch = incremental ? null : latestTCPingSignature(systemId);
    // A live update of an open chart reads only the probes since its newest
    // (loadTCPingHistoryTail); an opening reads the whole day.
    const rawHistory = incremental ? tcpingRawHistory.get(systemId) : null;
    const apiResponse = rawHistory
      ? await loadTCPingHistoryTail(clientID, rawHistory)
      : await loadTCPingHistory(clientID); // No target parameter = fetch all

    // Check if loading was cancelled after data fetch (the state object
    // captured above keeps its flag even after cleanupTCPingChart dropped
    // the map entry), and never build into a row that has been removed.
    if ((loadingState && loadingState.cancelled) || !container.isConnected) {
      return;
    }
    if (apiResponse && !apiResponse.__error && Array.isArray(apiResponse.results)) {
      tcpingRawHistory.set(systemId, apiResponse.results);
    }

    // Transient fetch failure: keep whatever chart is already on screen
    // rather than tearing it down and showing "No data". Only the
    // *initial* load surfaces the empty state — incremental ticks ride out
    // the hiccup and try again at the next 30-s tick.
    if (apiResponse && apiResponse.__error === true) {
      if (incremental && existingChartData && existingChartData.chart) {
        return;
      }
      // Initial load with no chart yet: fall through to the !hasAnyData
      // branch so the "No data" state is rendered exactly once.
    }

    // Extract results and pre-calculated stats from API response
    // Backward compatible: if apiResponse is array (old format), use it directly
    // If apiResponse is object with results (new format), extract results and stats
    const allHistoryRaw = Array.isArray(apiResponse)
      ? apiResponse
      : (apiResponse && !apiResponse.__error ? (apiResponse.results || []) : []);
    const preCalculatedStats = (!Array.isArray(apiResponse) && apiResponse && !apiResponse.__error && apiResponse.stats)
      ? apiResponse.stats
      : null;
    
    // Group history data by target address
    const historyByTarget = new Map();
    config.targets.forEach(target => {
      historyByTarget.set(target.address, []);
    });
    
    // Distribute results to their respective targets
    if (Array.isArray(allHistoryRaw)) {
      allHistoryRaw.forEach(result => {
        if (result.target && historyByTarget.has(result.target)) {
          historyByTarget.get(result.target).push(result);
        }
      });
    }
    
    // Convert to array format matching previous implementation
    const allHistoryData = config.targets.map(target => 
      historyByTarget.get(target.address) || []
    );
    
    // Prepare chart data for all targets
    const PACKET_LOSS_THRESHOLD_MS = 1000;
    const now = new Date();
    const twentyFourHoursAgo = now.getTime() - (24 * 60 * 60 * 1000);
    
    // Get active target for color determination
    const activeTargetInfo = tcpingActiveTargets.get(systemId);
    const selectedTarget = activeTargetInfo ? activeTargetInfo.target : null; // null means no target selected (all colored)
    
    // Create datasets for each target
    const datasets = [];
    let hasAnyData = false;
    let minTime = null;
    let maxTime = null;
    
    config.targets.forEach((targetConfig, index) => {
      const historyData = allHistoryData[index];
      const safeHistoryData = Array.isArray(historyData) ? historyData : [];

      // The server returns results already (a) within the 24h window and
      // (b) sorted by timestamp ascending — `Store.GetTCPingResults` uses
      // a cursor-seek on a 10-digit-unix-prefixed key plus a final sort
      // pass. We therefore do a single linear pass that:
      //   • parses every `result.timestamp` exactly once,
      //   • collects chart points,
      //   • derives min/max time without re-iterating,
      //   • drops any rare out-of-window record as a defensive guard.
      // The previous code did `.filter` + `.sort` + `.forEach` per target,
      // each `new Date(...)` parse three times per row. Folding it into
      // one walk roughly halves the JS work for the chart open.
      //
      // We track per-dataset min/max time as actual extrema rather than
      // "first / last seen in iteration order" — both are equivalent for
      // the bundled server (which always returns sorted ascending), but
      // this keeps the X-axis range correct for forks that swap in a
      // backend with weaker ordering guarantees.
      const chartData = new Array(safeHistoryData.length);
      let chartIdx = 0;
      let dsMin = null;
      let dsMax = null;
      for (let i = 0; i < safeHistoryData.length; i++) {
        const result = safeHistoryData[i];
        const tsMs = Date.parse(result.timestamp);
        if (!Number.isFinite(tsMs) || tsMs < twentyFourHoursAgo) continue;

        let yValue = null;
        if (result.latency !== null && result.latency !== undefined) {
          if (result.latency > PACKET_LOSS_THRESHOLD_MS) {
            yValue = null; // Packet loss
          } else {
            yValue = result.latency;
          }
        }
        // x as epoch ms: the chart is created with parsing off (see below).
        chartData[chartIdx++] = { x: tsMs, y: yValue };
        if (dsMin === null || tsMs < dsMin) dsMin = tsMs;
        if (dsMax === null || tsMs > dsMax) dsMax = tsMs;
      }
      chartData.length = chartIdx; // shrink to actual size

      if (chartIdx > 0) {
        hasAnyData = true;
        if (minTime === null || dsMin < minTime) minTime = dsMin;
        if (maxTime === null || dsMax > maxTime) maxTime = dsMax;
      }

      // The selected target on top in its colour, the others faded; with
      // none selected every line in its own colour.
      const isSelected = selectedTarget !== null && targetConfig.address === selectedTarget;
      const role = selectedTarget === null ? 'all' : (isSelected ? 'selected' : 'other');
      const borderColor = tcpingRoleColor(index, role);

      datasets.push({
        // The tooltip adds the unit to each value ("CU: 231.67 ms").
        label: targetConfig.name || targetConfig.address,
        data: chartData,
        role,
        order: role === 'selected' ? 0 : 1,
        borderColor: borderColor,
        // Not filled: the colour of the dot under the pointer.
        backgroundColor: borderColor,
        borderWidth: TCPING_LINE_WIDTH,
        fill: false,
        tension: 0.1,
        spanGaps: true,
        segment: tcpingGapSegment(chartData),
        // 0, except a dot on an answered probe with no line to either side
        // (filled with backgroundColor, which follows the line's colour)
        pointRadius: tcpingPointRadius(chartData),
        pointBorderWidth: 0,
        // Beszel's active dot on the probes under the pointer.
        pointHoverRadius: 4,
        pointHoverBorderWidth: 0,
        pointHitRadius: 5,
        showLine: true,
        targetAddress: targetConfig.address, // Store target address for color updates
        targetIndex: index // Store index for color lookup
      });
    });
    
    // Calculate statistics for all targets (use pre-calculated stats if available from backend)
    if (preCalculatedStats && !selectedTarget && tcpingRangeHours() === 24) {
      // Use pre-calculated statistics from backend (much faster!)
      updateTCPingStats(systemId, preCalculatedStats.avg_latency, preCalculatedStats.packet_loss_rate);
    } else {
      // Calculate statistics on frontend (for selected target or if backend stats unavailable)
      calculateAndUpdateStats(systemId, selectedTarget);
    }
    
    // Check if there's no data - show "No data" state instead of empty chart.
    //
    // Subtle: during an *incremental* tick we may briefly see a payload
    // with no points (e.g. the server just rotated its cache, or the
    // client paused pinging for one window). If a healthy chart with
    // points is already on screen, tearing it down and flashing "No data"
    // for a few hundred ms is what the user perceived as "the chart
    // keeps reloading". Only the initial load — or genuinely empty
    // state from the start — surfaces "No data".
    if (!hasAnyData) {
      const existingChartHasPoints = !!(
        existingChartData &&
        existingChartData.chart &&
        existingChartData.chart.data &&
        Array.isArray(existingChartData.chart.data.datasets) &&
        existingChartData.chart.data.datasets.some(ds => Array.isArray(ds.data) && ds.data.length > 0)
      );
      if (incremental && existingChartHasPoints) {
        return;
      }

      const loadingElement = container.querySelector(`[data-tcping-loading="${cssEscape(String(systemId))}"]`);
      if (loadingElement) {
        loadingElement.style.display = 'none';
      }

      // "No data" only when the emptiness is genuinely unexplained. If every
      // configured target is one this node cannot reach, the history is empty
      // *by design* and the unreachable notice (applied by the caller's
      // finally block) is the honest message — showing "No data" first would
      // invite the reader to wait for samples that will never arrive.
      const unreachable = shouldShowTCPingUnreachable(systemId, selectedTarget, config);
      const noDataElement = container.querySelector(`[data-tcping-no-data="${cssEscape(String(systemId))}"]`);
      if (noDataElement && !unreachable) {
        noDataElement.classList.remove('hidden');
        noDataElement.style.display = 'flex';
      }

      if (canvas) {
        canvas.classList.add('opacity-0');
        canvas.style.display = 'none';
      }

      if (existingChartData && existingChartData.chart) {
        try {
          existingChartData.chart.destroy();
        } catch (err) {
          // Chart destroy failed silently
        }
        tcpingCharts.delete(chartKey);
      }

      updateTranslations();
      return;
    }
    
    // Hide "No data" state if we have data
    const noDataElement = container.querySelector(`[data-tcping-no-data="${cssEscape(String(systemId))}"]`);
    if (noDataElement) {
      noDataElement.classList.add('hidden');
      noDataElement.style.display = 'none';
    }
    
    // Show canvas if we have data
    if (canvas) {
      canvas.style.display = 'block';
    }
    
    // If chart exists and this is an incremental update, add only new data points
    if (incremental && existingChartData && existingChartData.chart) {
      const chart = existingChartData.chart;
      
      // Safety check: ensure chart and canvas are still valid
      if (!chart || !chart.canvas || !chart.canvas.parentElement) {
        return;
      }
      
      // Update each dataset with new data points.
      //
      // INVARIANTS (relied on for the O(K) tail-merge below):
      //   1. The server returns results sorted ascending by timestamp.
      //   2. We only ever append new points to the tail of currentData.
      //   3. We only ever drop expired points from the head of currentData.
      // So both arrays are sorted at the point we get here. The previous
      // implementation walked the whole new array with .filter(), then
      // rebuilt currentData.data with .filter().sort() — O(N log N) per
      // dataset per tick, executed every 3–30 s while the chart is open.
      //
      // The sweep below replaces both with O(K) walks:
      //   • finding new points: scan from the tail of newDataset.data
      //     backward until we land on a point at or before lastCurrentTime;
      //   • dropping stale points: scan from the head of currentDataset.data
      //     forward until we land on a point at or after the 24-h cutoff.
      // Typical K is 0–2, so the per-tick cost becomes effectively constant
      // even for charts with thousands of points already on screen.
      //
      // A changed dataset gets a new array rather than a push or splice of
      // the one on the chart: with parsing off, Chart.js applies an in-place
      // push or splice to its points at once, without the update() that
      // keeps its draw state in step, and the next draw (a hover) would
      // fail. A new array is taken up as a whole at the next update() —
      // just as an in-place change was while the chart parsed its data.
      let hasNewData = false;
      datasets.forEach((newDataset, index) => {
        if (index >= chart.data.datasets.length) return;

        const currentDataset = chart.data.datasets[index];
        const currentData = currentDataset.data || [];
        const newData = newDataset.data || [];
        let data = currentData;

        if (currentData.length === 0) {
          if (newData.length > 0) {
            data = newData.slice();
            hasNewData = true;
          }
        } else if (newData.length > 0) {
          const lastCurrentTime = currentData[currentData.length - 1].x;
          // Walk newData from the tail until we find a point we already
          // have. Everything to the right is brand-new and chronologically
          // sorted; we append that tail directly.
          let firstNewIdx = newData.length;
          for (let i = newData.length - 1; i >= 0; i--) {
            if (newData[i].x <= lastCurrentTime) {
              firstNewIdx = i + 1;
              break;
            }
            firstNewIdx = i;
          }
          if (firstNewIdx < newData.length) {
            data = currentData.concat(newData.slice(firstNewIdx));
            hasNewData = true;
          }
        }

        // Drop expired points from the head. Because the array is sorted
        // ascending, all expired points form a prefix, so one cut at the
        // boundary is enough — no sort.
        let dropTo = 0;
        while (dropTo < data.length && data[dropTo].x < twentyFourHoursAgo) {
          dropTo++;
        }
        if (dropTo > 0) {
          data = data.slice(dropTo);
        }
        if (data !== currentData) {
          currentDataset.data = data;
          currentDataset.segment = tcpingGapSegment(data);
          currentDataset.pointRadius = tcpingPointRadius(data);
        }
      });
        
      if (hasNewData) {
        try {
          if (chart && chart.canvas && chart.canvas.parentElement) {
            // Recalculate time range for all datasets after adding new data
            let updatedMinTime = null;
            let updatedMaxTime = null;
            
            chart.data.datasets.forEach(dataset => {
              if (dataset.data && dataset.data.length > 0) {
                // Data is now sorted, so first and last are min and max
                const firstTime = dataset.data[0].x;
                const lastTime = dataset.data[dataset.data.length - 1].x;
                if (updatedMinTime === null || firstTime < updatedMinTime) {
                  updatedMinTime = firstTime;
                }
                if (updatedMaxTime === null || lastTime > updatedMaxTime) {
                  updatedMaxTime = lastTime;
                }
              }
            });
            
            // Update x-axis range if we have valid time range
            if (updatedMinTime !== null && updatedMaxTime !== null && chart.options.scales && chart.options.scales.x) {
              const bounds = tcpingAxisBounds(updatedMinTime, updatedMaxTime);
              chart.options.scales.x.min = bounds.min;
              chart.options.scales.x.max = bounds.max;
            }
            
            chart.update('none');
            updateTCPingTabAverages(systemId);
            updateTCPingLastProbe(systemId);
            
            // Update statistics after incremental update
            // Use pre-calculated stats if available and no target is selected
            if (preCalculatedStats && !selectedTarget && tcpingRangeHours() === 24) {
              updateTCPingStats(systemId, preCalculatedStats.avg_latency, preCalculatedStats.packet_loss_rate);
            } else {
              calculateAndUpdateStats(systemId, selectedTarget);
            }
          }
        } catch (err) {
          // Chart update failed silently
        }
        }
        return;
    }
    
    // If incremental is true, we should have returned above (if chart exists)
    // However, if chart doesn't exist (e.g., transitioned from no-data to has-data),
    // we need to create a new chart, so continue with full chart creation
    if (incremental && existingChartData && existingChartData.chart) {
      // Chart exists and we've already handled incremental update above
      return;
    }
    
    // If we reach here with incremental=true but no existing chart,
    // it means we're transitioning from no-data to has-data
    // We need to create a new chart and show it properly, so treat it as full reload
    const isNewChartCreation = incremental && !existingChartData;
    
    // If no existing chart or full reload needed, destroy all charts for this system
    const chartsToDestroy = [];
    tcpingCharts.forEach((value, key) => {
      if (key.startsWith(`${systemId}_`)) {
        if (value.chart) {
          chartsToDestroy.push(value.chart);
        }
        tcpingCharts.delete(key);
      }
    });
    
    // Destroy all charts
    chartsToDestroy.forEach(chart => {
      try {
        chart.destroy();
      } catch (err) {
        // Chart destroy failed silently
      }
    });

    // Load Chart.js if not already loaded
    if (!window.Chart) {
      return new Promise((resolve, reject) => {
        // Check if script is already being loaded
        if (document.querySelector('script[data-chartjs]')) {
          const checkInterval = setInterval(() => {
            if (window.Chart && window._chartjsAdapterLoaded) {
              clearInterval(checkInterval);
              updateTCPingChart(systemId, target, targetName).then(resolve).catch(reject);
            }
          }, 100);
          setTimeout(() => {
            clearInterval(checkInterval);
            if (!window.Chart || !window._chartjsAdapterLoaded) {
              reject(new Error('Chart.js loading timeout'));
            }
          }, 10000);
          return;
        }
        
        // Load Chart.js first, then its date adapter. crossOrigin (set by
        // setChartScriptSource) matches the <link rel="preload"> so the
        // browser can reuse the warmed cache entry. A file that fails to
        // load is removed again, so the next open tries afresh.
        const script = document.createElement('script');
        setChartScriptSource(script, chartJsUrl);
        script.async = true;
        script.setAttribute('data-chartjs', 'true');
        script.onload = () => {
          // Then load the date adapter for time scale support
          const adapterScript = document.createElement('script');
          setChartScriptSource(adapterScript, chartJsAdapterUrl);
          adapterScript.async = true;
          adapterScript.setAttribute('data-chartjs-adapter', 'true');
          adapterScript.onload = () => {
            window._chartjsAdapterLoaded = true;
            updateTCPingChart(systemId, target, targetName).then(resolve).catch(reject);
          };
          adapterScript.onerror = () => {
            adapterScript.remove();
            reject(new Error('Failed to load Chart.js date adapter'));
          };
          document.head.appendChild(adapterScript);
        };
        script.onerror = () => {
          script.remove();
          reject(new Error('Failed to load Chart.js'));
        };
        document.head.appendChild(script);
      });
    }
    
    // Also check if adapter is loaded
    if (!window._chartjsAdapterLoaded) {
      return new Promise((resolve, reject) => {
        if (document.querySelector('script[data-chartjs-adapter]')) {
          const checkInterval = setInterval(() => {
            if (window._chartjsAdapterLoaded) {
              clearInterval(checkInterval);
              updateTCPingChart(systemId, target, targetName).then(resolve).catch(reject);
            }
          }, 100);
          setTimeout(() => {
            clearInterval(checkInterval);
            if (!window._chartjsAdapterLoaded) {
              reject(new Error('Chart.js adapter loading timeout'));
            }
          }, 10000);
          return;
        }
        
        const adapterScript = document.createElement('script');
        setChartScriptSource(adapterScript, chartJsAdapterUrl);
        adapterScript.async = true;
        adapterScript.setAttribute('data-chartjs-adapter', 'true');
        adapterScript.onload = () => {
          window._chartjsAdapterLoaded = true;
          updateTCPingChart(systemId, target, targetName).then(resolve).catch(reject);
        };
        adapterScript.onerror = () => {
          adapterScript.remove();
          reject(new Error('Failed to load Chart.js date adapter'));
        };
        document.head.appendChild(adapterScript);
      });
    }
    
    const ChartClass = window.Chart;

    // Slide first: a chart whose samples arrive while its section is still
    // sliding open waits for the slide to end, unless this device has shown
    // it builds a chart within a frame or two. Building one takes the main
    // thread for tens of ms, which the slide would otherwise stutter on.
    const detailsSection = container.closest('.system-details');
    const slideLeft = detailsSection && detailsSection._slideEndsAt ? detailsSection._slideEndsAt - performance.now() : 0;
    if (slideLeft > 0 && !(tcpingLastBuildMs !== null && tcpingLastBuildMs <= TCPING_FAST_BUILD_MS)) {
      await new Promise((resolve) => setTimeout(resolve, slideLeft));
      if ((loadingState && loadingState.cancelled) || !container.isConnected
          || detailsSection.classList.contains('hidden')) {
        return;
      }
    }

    // Check if we have data
    // Still create an empty chart to show the structure if no data

    // Check if there's an existing chart on this canvas and destroy it
    // This is a safety check in case the chart wasn't properly tracked
    if (ChartClass.getChart) {
      const existingChart = ChartClass.getChart(canvas);
      if (existingChart) {
        try {
          existingChart.destroy();
        } catch (err) {
          // Chart destroy failed silently
        }
      }
    }

    // While the section is still sliding open, the chart box size measured
    // when it started to open (handleRowToggle) stands in for measuring the
    // box now, which would force a layout of the whole table mid-slide.
    // Chart.js takes it too (the platform below); size changes after that
    // are Chart.js's own, as before.
    let presize = canvas._presize && canvas._presize.width > 0
      && detailsSection && detailsSection._slideEndsAt > performance.now() ? canvas._presize : null;
    canvas._presize = null;

    // Ensure canvas has proper dimensions
    // Use fixed dimensions from CSS (200px height) instead of getBoundingClientRect()
    // to avoid issues when container is still animating
    // Note: tabs are in external container, so they don't affect chart container height
    const parent = canvas.parentElement;
    if (parent) {
      const rect = presize || parent.getBoundingClientRect();
      // Use fixed 200px height from CSS, or getBoundingClientRect if available and stable
      const width = rect.width > 0 ? rect.width : parent.offsetWidth || 0;
      const height = 200; // Fixed height from CSS style="height: 200px"
      
      if (width > 0 && height > 0) {
        // Get device pixel ratio for high-DPI displays (Retina, etc.)
        const dpr = window.devicePixelRatio || 1;
        
        // Set the canvas internal size (backing store size) to match device pixel ratio
        // This prevents blurriness on high-DPI displays
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        
        // Set the canvas CSS size to match the container
        canvas.style.width = width + 'px';
        canvas.style.height = height + 'px';
        
        // Scale the context to match device pixel ratio
        // Chart.js will handle this automatically, but we need to set the dimensions
      }
    }

    // Create new chart
    const ctx = canvas.getContext('2d');
    if (!ctx) {
      return;
    }
    
    // Detect current theme for tooltip styling
    const isDarkMode = document.documentElement.classList.contains('dark');
    // Chart text in the page's font (Chart.js would use its own Helvetica /
    // Arial stack next to the system font of the rest of the card).
    if (window.Chart && !window.__pulseChartFont) {
      window.Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
      window.__pulseChartFont = true;
    }
    const tooltipBg = isDarkMode ? 'rgba(20, 21, 22, 0.95)' : 'rgba(250, 250, 250, 0.95)';
    const tooltipTextColor = isDarkMode ? '#f5f5f5' : '#272625';
    const tooltipBorderColor = isDarkMode ? '#3e3f42' : '#d7d4d1';
    
    registerPulseChartPlugins(ChartClass);

    const platform = presize ? class extends ChartClass.DomPlatform {
      getMaximumSize(element, width, height, aspectRatio) {
        if (presize && width === undefined && height === undefined) {
          return super.getMaximumSize(element, presize.width, presize.height, aspectRatio);
        }
        return super.getMaximumSize(element, width, height, aspectRatio);
      }
    } : undefined;

    const lossLaneOn = document.documentElement.classList.contains('loss-timeline');
    const builtAt = performance.now();
    const chart = new ChartClass(ctx, {
      type: 'line',
      platform,
      data: {
        datasets: datasets // All targets as separate datasets
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        devicePixelRatio: window.devicePixelRatio || 1, // Explicitly set for high-DPI displays
        // x is epoch ms, sorted ascending (the server's order).
        parsing: false,
        normalized: true,
        // A new chart is drawn once and revealed from left to right by the
        // tcping-reveal CSS animation (global styles below). Chart.js's own
        // entrance animation would redraw all 3 × 1440 points on every frame
        // for a second, and merely setting it up costs tens of ms. It is
        // switched back on right after the build, so the tooltip glides
        // between points as before; updates use chart.update('none').
        animation: false,
        plugins: {
          lossLane: lossLaneOn ? {} : false,
          legend: {
            display: false
          },
          tooltip: {
            // each target's probe nearest the pointer (registerPulseChartPlugins)
            mode: 'tcpingNear',
            intersect: false,
            // Drawn as HTML (tcpingTooltipExternal), Beszel's tooltip card.
            enabled: false,
            external: tcpingTooltipExternal,
            backgroundColor: tooltipBg,
            titleColor: tooltipTextColor,
            bodyColor: tooltipTextColor,
            borderColor: tooltipBorderColor,
            borderWidth: 1,
            padding: 12,
            titleFont: {
              size: 12,
              weight: '600'
            },
            bodyFont: {
              size: 11
            },
            // Each line starts with its target's colour dot, as on the tabs.
            displayColors: true,
            usePointStyle: true,
            boxWidth: 6,
            boxHeight: 6,
            boxPadding: 4,
            footerColor: tooltipTextColor,
            footerFont: {
              size: 11,
              weight: 'normal'
            },
            footerMarginTop: 4,
            filter: function(tooltipItem) {
              // Get active target for this system
              const systemId = canvas.dataset.tcpingChart;
              const activeTargetInfo = tcpingActiveTargets.get(systemId);
              const selectedTarget = activeTargetInfo ? activeTargetInfo.target : null;
              
              // If no target is selected, show all tooltips
              if (selectedTarget === null) {
                return true;
              }
              
              // If a target is selected, only show tooltip for that target
              const dataset = tooltipItem.dataset;
              return dataset.targetAddress === selectedTarget;
            },
            callbacks: {
              labelColor: (item) => ({ borderColor: item.dataset.borderColor, backgroundColor: item.dataset.borderColor }),
              labelPointStyle: () => ({ pointStyle: 'circle', rotation: 0 }),
              title: function(context) {
                if (context.length > 0 && context[0].label) {
                  return context[0].label;
                }
                return '';
              },
              label: function(context) {
                // Helper function to format label
                const formatLabel = (item) => {
                  const datasetLabel = item.dataset.label || '';
                  const value = item.parsed.y;
                  if (value === null || value === undefined) {
                    return `${datasetLabel}: ${translations.tcpingTimeout[getCurrentLanguage()]}`;
                  }
                  return `${datasetLabel}: ${value.toFixed(2)} ms`;
                };
                
                // Get all tooltip items for the current x position
                const allTooltipItems = context.chart.tooltip.dataPoints || [];
                
                // If no tooltip items or only one item, show it normally
                if (allTooltipItems.length <= 1) {
                  return formatLabel(context);
                }
                
                // Get the target address for the current item
                const currentTargetAddress = context.dataset.targetAddress;
                
                // Find the first item with the same target address
                const firstItemForTarget = allTooltipItems.find(item => 
                  item.dataset && item.dataset.targetAddress === currentTargetAddress
                );
                
                // If no matching target found, show current item (fallback)
                if (!firstItemForTarget) {
                  return formatLabel(context);
                }
                
                // Check if current item is the first one for this target
                // Compare by datasetIndex and dataIndex for reliable matching
                const isFirstItem = 
                  firstItemForTarget.datasetIndex === context.datasetIndex &&
                  firstItemForTarget.dataIndex === context.dataIndex;
                
                // Only show label if this is the first item for this target
                if (isFirstItem) {
                  return formatLabel(context);
                }
                
                // Return null to hide this label (duplicate for same target)
                return null;
              },
              // A target that timed out in this minute has no point here:
              // Chart.js leaves empty values out when it collects the tooltip
              // items, so the target was simply missing from the list. Name
              // it below the measured ones (in the footer, which has no
              // colour dots to line up with).
              footer: function(items) {
                if (!items.length) return [];
                const chart = items[0].chart;
                const x = items[0].parsed.x;
                const listed = new Set(items.map((item) => item.datasetIndex));
                const activeTargetInfo = tcpingActiveTargets.get(canvas.dataset.tcpingChart);
                const selectedTarget = activeTargetInfo ? activeTargetInfo.target : null;
                const lines = [];
                chart.data.datasets.forEach((dataset, i) => {
                  if (listed.has(i) || !chart.isDatasetVisible(i)) return;
                  if (selectedTarget !== null && dataset.targetAddress !== selectedTarget) return;
                  // Nearest sample in time (points are in time order).
                  const points = dataset.data;
                  let lo = 0, hi = points.length - 1;
                  while (lo < hi) {
                    const mid = (lo + hi) >> 1;
                    if (points[mid].x < x) lo = mid + 1; else hi = mid;
                  }
                  const near = [points[lo], points[lo - 1]].filter(Boolean)
                    .sort((a, b) => Math.abs(a.x - x) - Math.abs(b.x - x))[0];
                  // Half a probe interval: a target with no sample at all
                  // around this time is not reported as a timeout.
                  if (near && near.y === null && Math.abs(near.x - x) <= 30000) {
                    lines.push(`${dataset.label}: ${translations.tcpingTimeout[getCurrentLanguage()]}`);
                  }
                });
                return lines;
              }
            }
          }
        },
        scales: {
          x: {
            type: 'time', // Use time scale for proper time-based X-axis
            // The span of the data: a blank stretch would read like lost
            // probes, which the chart draws as gaps (stale data is named in
            // the subtitle instead, updateTCPingLastProbe).
            min: tcpingAxisBounds(minTime, maxTime).min,
            max: tcpingAxisBounds(minTime, maxTime).max,
            time: {
              // whole minutes at the finest (a new target's few probes
              // were labelled every few seconds)
              minUnit: 'minute',
              displayFormats: {
                second: 'HH:mm:ss',
                minute: 'HH:mm',
                hour: 'HH:mm',
                day: 'MM/dd HH:mm'
              },
              tooltipFormat: 'yyyy-MM-dd HH:mm:ss' // Tooltip format with date and seconds
            },
            ticks: {
              color: axisLabelColor(isDarkMode),
              font: {
                size: 12
              },
              maxRotation: 0,
              minRotation: 0,
              maxTicksLimit: 12,
              autoSkip: true,
              autoSkipPadding: 12,
              // Below the loss band when it is shown
              padding: lossLaneOn ? LOSS_LANE_LABEL_PADDING : 3
            },
            // No vertical grid lines; a short mark under each time, as
            // recharts draws them in Beszel's charts (6 px, #666 in either
            // theme), and no axis line. With the loss band the band is the
            // baseline, without the marks.
            grid: {
              display: true,
              drawOnChartArea: false,
              drawTicks: !lossLaneOn,
              tickLength: 6,
              tickColor: '#666666',
              tickWidth: 1
            },
            border: {
              display: false
            },
            bounds: 'ticks', // Use 'ticks' instead of 'data' to ensure proper tooltip positioning
            afterBuildTicks: roundTimeTicks,
            // Chart.js keeps the label padding free under the time labels as
            // well as above them: with the loss band's 28 px that was 24 px of
            // blank card under the times, taken from the plot. It adds the
            // padding to the plot's two ends as well (_calculatePadding),
            // where the regular 3 px are all the end labels need: with the
            // last time near the right edge, up to 25 px of blank card there
            // (14 px measured on a phone).
            afterFit: (scale) => {
              if (!lossLaneOn) return;
              const extra = LOSS_LANE_LABEL_PADDING - 3;
              scale.height = Math.max(0, scale.height - extra);
              scale.paddingLeft = Math.max(0, scale.paddingLeft - extra);
              scale.paddingRight = Math.max(0, scale.paddingRight - extra);
            }
          },
          // Fitted to the lines with room above them, never below 0 ms
          // (latencyTicks, from the visible lines' own range).
          y: {
            beginAtZero: false,
            afterDataLimits: (scale) => { scale.$dataMin = scale.min; scale.$dataMax = scale.max; },
            afterBuildTicks: latencyTicks,
            ticks: {
              color: axisLabelColor(isDarkMode),
              font: {
                size: 12
              },
              callback: function(value) {
                return value + ' ms';
              },
              // latencyTicks gives at most six; a lower limit would make
              // Chart.js skip every other label.
              maxTicksLimit: 6
            },
            grid: {
              color: gridLineColor(isDarkMode),
              display: true, // Show horizontal grid lines only
              // Make grid lines sparser by using stepSize
              drawOnChartArea: true
            },
            border: {
              display: false // Hide the Y-axis border line (left vertical line)
            }
          }
        },
        // the hover dots on the probes the readout lists
        interaction: {
          mode: 'tcpingNear',
          intersect: false
        },
        onHover: function(event, activeElements) {
          // Keep default cursor style (don't change to crosshair)
          // The crosshair line will be drawn by the plugin
        }
      }
    });
    presize = null;
    // Animation back on after the build (the hover dot grows, the readout
    // glides), except for a visitor who asked for reduced motion.
    chart.options.animation = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches ? false : ChartClass.defaults.animation;
    // The page's first chart runs Chart.js cold (not yet optimised by the JS
    // engine) and takes about three times as long as later ones.
    const buildMs = performance.now() - builtAt;
    tcpingLastBuildMs = tcpingBuildCount++ === 0 ? buildMs / 3 : buildMs;

    // Final check if loading was cancelled before storing chart. A section
    // that has been collapsed (hidden) meanwhile gets no chart either: its
    // teardown already ran, so nothing would ever destroy this one.
    if ((loadingState && loadingState.cancelled) || !container.isConnected
        || (detailsSection && detailsSection.classList.contains('hidden'))) {
      // Destroy the chart we just created since loading was cancelled
      try {
        chart.destroy();
      } catch (err) {
        // Ignore errors
      }
      return;
    }

    tcpingCharts.set(chartKey, { chart, target: 'all' });
    if (sigAtFetch !== null) tcpingDataSignatures.set(systemId, sigAtFetch);
    tcpingLastReadAt.set(systemId, Date.now());
    updateTCPingTabAverages(systemId);
    updateTCPingLastProbe(systemId);

    // The summary for a selected target, or for a span shorter than the
    // server's day statistics, is computed from the chart's datasets, which
    // did not exist yet when the stats were calculated above on a first
    // load: recompute it now that the chart is registered.
    const activeNow = tcpingActiveTargets.get(systemId);
    if ((activeNow && activeNow.target) || tcpingRangeHours() !== 24) {
      calculateAndUpdateStats(systemId, activeNow ? activeNow.target : null);
    }
    ensureTCPingRangeButton(container);
    
    // Hide loading state and show chart (for full reload or new chart creation)
    // If incremental update created a new chart (no-data to has-data transition), also show it
    if (!incremental || isNewChartCreation) {
      const loadingElement = container.querySelector(`[data-tcping-loading="${cssEscape(String(systemId))}"]`);
      if (loadingElement) {
        loadingElement.style.display = 'none';
      }
      if (canvas) {
        // A new chart draws in (tcping-reveal in the global styles); the same
        // chart shown again later, after a skipped target's notice, only
        // fades back in as before.
        canvas.classList.add('tcping-new');
        // One shared handler (adding it again is a no-op). A function made
        // here would share this call's scope, datasets included, and the
        // canvas, which stays with the built details after the row closes,
        // kept every opened server's day of probes alive (+11 MB for 20).
        canvas.addEventListener('animationend', tcpingRevealDone);
        canvas.addEventListener('animationcancel', tcpingRevealDone);
        canvas.classList.remove('opacity-0');
        
        // Hide "No data" state when chart is created
        const noDataElement = container.querySelector(`[data-tcping-no-data="${cssEscape(String(systemId))}"]`);
        if (noDataElement) {
          noDataElement.classList.add('hidden');
          noDataElement.style.display = 'none';
        }
      }
    }
  }
  
  // Update TCPing statistics display
  function updateTCPingStats(systemId, avgLatency, packetLossRate) {
    const statsContainer = document.querySelector(`[data-tcping-stats="${cssEscape(String(systemId))}"]`);
    if (!statsContainer) return;

    // Whose average: every target's together until one is selected.
    const avgLabel = statsContainer.querySelector('[data-translate-detail="avgLatency"], [data-translate-detail="avgLatencyAll"]');
    if (avgLabel) {
      const active = tcpingActiveTargets.get(systemId);
      const key = active && active.target ? 'avgLatency' : 'avgLatencyAll';
      if (avgLabel.getAttribute('data-translate-detail') !== key) {
        avgLabel.setAttribute('data-translate-detail', key);
        avgLabel.textContent = translations[key][getCurrentLanguage()];
      }
    }
    
    const avgElement = statsContainer.querySelector(`[data-tcping-avg="${cssEscape(String(systemId))}"]`);
    const lossElement = statsContainer.querySelector(`[data-tcping-loss="${cssEscape(String(systemId))}"]`);
    
    if (avgElement) {
      avgElement.removeAttribute('data-translate-detail');
      if (avgLatency > 0) {
        avgElement.textContent = `${avgLatency.toFixed(2)} ms`;
      } else {
        avgElement.textContent = '-';
      }
    }

    if (lossElement) {
      lossElement.removeAttribute('data-translate-detail');
      // Only show loss percentage if there's actual data (avgLatency > 0)
      // When avgLatency is 0, it means no data, so show '-' instead of '0.00%'
      if (avgLatency > 0) {
        lossElement.textContent = `${packetLossRate.toFixed(2)}%`;
      } else {
        lossElement.textContent = '-';
      }
    }
  }

  // Summary for a skipped target: "N/A" / "不适用" for BOTH avg and loss.
  //
  // We deliberately do not reuse the "-" (no data) rendering: "-" means "we
  // expect numbers here, they just haven't arrived", whereas a skipped target
  // will never produce numbers. Marking the two spans with
  // data-translate-detail="notApplicable" (instead of writing a literal
  // string) is what makes them follow a later language switch for free — the
  // existing updateTranslations() sweep picks them up. updateTCPingStats
  // strips the attribute again when real numbers come back, so a recovered
  // target cannot get its value overwritten by the next translation pass.
  function setTCPingStatsNotApplicable(systemId) {
    const statsContainer = document.querySelector(`[data-tcping-stats="${cssEscape(String(systemId))}"]`);
    if (!statsContainer) return;

    const label = translations.notApplicable[getCurrentLanguage()] || translations.notApplicable.en;
    const avgElement = statsContainer.querySelector(`[data-tcping-avg="${cssEscape(String(systemId))}"]`);
    const lossElement = statsContainer.querySelector(`[data-tcping-loss="${cssEscape(String(systemId))}"]`);

    if (avgElement) {
      avgElement.setAttribute('data-translate-detail', 'notApplicable');
      avgElement.textContent = label;
    }
    if (lossElement) {
      lossElement.setAttribute('data-translate-detail', 'notApplicable');
      lossElement.textContent = label;
    }
  }

  // Reconcile the chart area with the current skipped state for this system.
  //
  // Runs after every chart update and after every tab switch. It never
  // touches the Chart.js instance or the canvas geometry — only the overlay's
  // visibility and the canvas opacity — so the datasets stay live and fresh
  // underneath a shown notice, and deselecting the target reveals an
  // up-to-date chart with no refetch and no resize. The canvas keeps
  // `display: block` (we only fade it out) precisely so Chart.js never sees a
  // zero-sized canvas and never has to re-lay-out on the way back.
  //
  // Returns true when the notice is showing.
  function applyTCPingUnreachableState(systemId) {
    const container = document.querySelector(`[data-tcping-chart-container="${cssEscape(String(systemId))}"]`);
    if (!container || !container.isConnected) return false;

