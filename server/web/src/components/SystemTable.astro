     the list clips its left edge, so an item that starts a new line drops
     its divider instead of leading with one. A traffic pair is one value:
     down and up 10 px apart, no rule between them. Text 12 px on phones,
     13 px to 1279 px, then Beszel's 14 px with 16 px icons. */
  #monitor-root .detail-list { display: grid; grid-template-columns: 14px max-content minmax(0, 1fr); align-items: start; column-gap: 8px; row-gap: 8px; font-size: 12px; line-height: 18px; }
  #monitor-root .detail-list > [data-tag-strip] { grid-column: 1 / -1; }
  #monitor-root .detail-item { display: contents; }
  #monitor-root .detail-item[hidden] { display: none !important; }
  /* An opened row in the table wears its details' ground and loses the rule
     between them: one piece, as an opened card already is. */
  /* (the details' #f8f8f8 / #171717 as the build tints them) */
  /* (.is-closing: the same while the details close, see detailsFade) */
  html:not(.glass-enabled) #monitor-root:not(.layout-grid) #systems-body .system-row > [aria-expanded="true"],
  html:not(.glass-enabled) #monitor-root:not(.layout-grid) #systems-body .system-row.is-closing > [data-system-id] { background-color: #f9f8f7; }
  html.dark:not(.glass-enabled) #monitor-root:not(.layout-grid) #systems-body .system-row > [aria-expanded="true"],
  html.dark:not(.glass-enabled) #monitor-root:not(.layout-grid) #systems-body .system-row.is-closing > [data-system-id] { background-color: #161718; }
  #monitor-root:not(.layout-grid) #systems-body .system-row > [aria-expanded="true"] + .system-details,
  #monitor-root:not(.layout-grid) #systems-body .system-row.is-closing > .system-details { border-top-color: transparent; }
  #systems-body > .system-row { scroll-margin-top: 16px; }
  html.sticky-table-header #systems-body > .system-row { scroll-margin-top: 72px; }
  #monitor-root .detail-icon { width: 14px; height: 14px; margin-top: 2px; flex: none; color: #595959; }
  html.dark #monitor-root .detail-icon { color: #ababab; }
  #monitor-root .detail-label { color: #595959; white-space: nowrap; }
  html.dark #monitor-root .detail-label { color: #ababab; }
  #monitor-root .detail-value { min-width: 0; color: #1d1d20; overflow-wrap: anywhere; }
  #monitor-root .detail-value:not(:is([data-detail="location"], [data-detail="os"], [data-detail="cpu_model"])) { font-variant-numeric: tabular-nums; }
  html.dark #monitor-root .detail-value { color: #f5f5f5; }
  #monitor-root .detail-pair > span { white-space: nowrap; }
  @media (min-width: 768px) {
    #monitor-root .detail-list { display: flex; flex-wrap: wrap; column-gap: 25px; row-gap: 10px; font-size: 13px; line-height: 20px; overflow: hidden; }
    #monitor-root .detail-list > [data-tag-strip] { flex-basis: 100%; }
    #monitor-root .detail-item { display: flex; align-items: center; gap: 6px; position: relative; min-width: 0; }
    #monitor-root .detail-icon { margin-top: 0; }
    #monitor-root .detail-item + .detail-item::before { content: ''; position: absolute; top: 50%; left: -13px; width: 1px; height: 16px; margin-top: -8px; background: rgba(24, 24, 27, 0.3); }
    html.dark #monitor-root .detail-item + .detail-item::before { background: rgba(244, 245, 245, 0.3); }
  }
  /* The location and the OS stay out of the details wherever the row or
     card above shows them, as Beszel's info bar leaves out an item that
     would repeat what is on screen: the flag and the logo on phones and
     cards, the two columns of the table from 1024 px. They show in the table
     at 768-1023 px, which has neither column, and for a field hidden in the
     view menu. The next item's divider falls outside the list's edge. */
  #monitor-root:not(.hide-col-location) .detail-location,
  #monitor-root:not(.hide-col-os) .detail-os { display: none; }
  @media (min-width: 768px) and (max-width: 1023.98px) {
    #monitor-root:not(.layout-grid) .detail-location,
    #monitor-root:not(.layout-grid) .detail-os { display: flex; }
  }
  @media (min-width: 1280px) {
    #monitor-root .detail-list { font-size: 14px; }
    #monitor-root .detail-icon { width: 16px; height: 16px; }
  }

  /* The TCPing chart's tooltip (tcpingTooltipExternal), Beszel's chart
     tooltip: the page's ground, a light border, a deep soft shadow, 12 px
     text; the time in medium weight, each row a colour square, the target
     muted and the value in medium weight to the right. */
  /* The TCPing card's header: the title and its line left, the time range
     picker right (Beszel's chart time select: history icon, span, chevron;
     its list with a check by the span shown). */
  .tcping-tools { display: flex; flex: none; align-items: center; }
  /* Phones: the tabs (or the title) and the picker on the first row, the
     line under them on a row of its own across the card, as Beszel's phone
     chart cards. In the left column it was held to the tabs' 170 px and
     wrapped (English) beside the empty space under the picker. */
  @media (max-width: 639.98px) {
    html .tcping-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 12px; row-gap: 0; align-items: start; }
    html .tcping-head > .min-w-0 { display: contents; }
    html .tcping-head > .min-w-0 > :not(.mt-1) { grid-column: 1; grid-row: 1; justify-self: start; }
    html .tcping-head > .tcping-tools { grid-column: 2; grid-row: 1; }
    html .tcping-head > .min-w-0 > .mt-1 { grid-column: 1 / -1; grid-row: 2; }
  }
  /* 自定义设置 → 资源历史: 延迟 | 资源 in the chart card's title place
     (Beszel's tabs: a muted track, the chosen tab on the card's ground); the
     title stays for screen readers. */
  .chart-tabs { display: none; }
  html.resource-history .chart-tabs { display: inline-flex; align-items: center; height: 32px; padding: 3px; gap: 2px; border-radius: 10.8px; background: #f0f0f0; }
  html.dark.resource-history .chart-tabs { background: rgb(38, 40, 43); }
  .chart-tab { height: 26px; padding: 0 12px; border-radius: 8.8px; font-size: 13px; font-weight: 500; line-height: 26px; color: #595959; background: transparent; cursor: pointer; }
  /* Beszel's chosen tab: the page's ground (not white) */
  .chart-tab[aria-selected="true"] { background: rgb(250, 250, 249); color: #1d1d20; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05); cursor: default; }
  html.dark .chart-tab { color: #ababab; }
  html.dark .chart-tab[aria-selected="true"] { background: #171717; color: #f5f5f5; }
  .chart-tab:focus-visible { outline: none; box-shadow: 0 0 0 2px #ffffff, 0 0 0 4px #837e79; }
  html.dark .chart-tab:focus-visible { box-shadow: 0 0 0 2px #1a1a1a, 0 0 0 4px #cacbce; }
  html.resource-history [data-tcping-chart-container] .chart-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  /* the 资源 pane: four small charts, two a row from 640 px */
  .resource-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  /* no minutes yet, or the read failed: the note alone (display: grid
     outranked the hidden attribute and left four empty cards above it) */
  .resource-grid[hidden] { display: none; }
  @media (min-width: 640px) { .resource-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .resource-card { min-width: 0; padding: 12px 14px 8px; border: 1px solid rgba(212, 212, 212, 0.5); border-radius: 12.8px; background: #ffffff; }
  html.dark .resource-card { border-color: rgba(44, 44, 44, 0.6); background: #1a1a1a; }
  html.glass-enabled .resource-card { background: transparent; }
  .resource-card-title { font-size: 14px; line-height: 20px; font-weight: 600; letter-spacing: -0.01em; color: #1d1d20; }
  html.dark .resource-card-title { color: #f5f5f5; }
  .resource-card-desc { margin-top: 2px; font-size: 12px; line-height: 16px; color: #595959; }
  html.dark .resource-card-desc { color: #ababab; }
  .resource-plot { position: relative; height: 160px; margin-top: 8px; }
  .res-keys { display: flex; flex-wrap: wrap; column-gap: 12px; }
  .res-key-item { display: inline-flex; align-items: center; gap: 6px; }
  .res-unit:not(:empty)::before { content: '· '; }
  .res-key { width: 8px; height: 8px; border-radius: 2px; flex: none; background: var(--res-key); }
  html.dark .res-key { background: var(--res-key-dark); }
  /* phones: the charts span the card, one under another between hairlines
     (a frame in a frame in the opened row left them 216 px wide) */
  @media (max-width: 639.98px) {
    .resource-grid { gap: 0; }
    html .resource-card, html.dark .resource-card { padding: 14px 0 6px; border: 0; border-radius: 0; background: transparent; }
    html .resource-card + .resource-card { border-top: 1px solid rgba(212, 212, 212, 0.5); }
    html.dark .resource-card + .resource-card { border-top: 1px solid rgba(44, 44, 44, 0.6); }
    html .resource-card:first-child, html.dark .resource-card:first-child { padding-top: 4px; }
  }
  .resource-note { padding: 40px 8px; text-align: center; font-size: 13px; line-height: 20px; color: #595959; }
  html.dark .resource-note { color: #ababab; }
  .tcping-range-btn {
    display: inline-flex; flex: none; align-items: center; gap: 6px;
    height: 32px; padding: 0 8px 0 10px;
    border: 1px solid #dadada; border-radius: 10.8px; background: transparent;
    font-size: 13px; line-height: 1; color: #1d1d20; white-space: nowrap; cursor: pointer;
  }
  .tcping-range-btn:hover { background-color: rgba(243, 239, 236, 0.7); }
  .tcping-range-btn:focus-visible { outline: none; box-shadow: 0 0 0 2px #ffffff, 0 0 0 4px #837e79; }
  html.dark .tcping-range-btn { border-color: #2c2c2c; color: #f5f5f5; }
  html.dark .tcping-range-btn:hover { background-color: rgba(40, 40, 40, 0.7); }
  html.dark .tcping-range-btn:focus-visible { box-shadow: 0 0 0 2px #1a1a1a, 0 0 0 4px #cacbce; }
  .tcping-range-icon { width: 14px; height: 14px; flex: none; opacity: 0.85; }
  .tcping-range-chevron { width: 14px; height: 14px; flex: none; opacity: 0.5; }
  .tcping-range-menu {
    position: absolute; z-index: 60; padding: 4px;
    border: 1px solid #dadada; border-radius: 10.8px; background-color: #ffffff;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    animation: view-menu-in 150ms ease; transform-origin: top right;
  }
  html.dark .tcping-range-menu { border-color: #2c2c2c; background-color: #171717; }
  .tcping-range-menu .view-menu-item { padding: 6px 12px 6px 32px; font-size: 13px; white-space: nowrap; }
  /* The highlight is where the focus is, as with the keys: on the chosen
     span when the menu opens (a pointer's open showed none), then under the
     pointer (pointermove moves the focus). */
  .tcping-range-menu .view-menu-item:focus { background-color: rgba(243, 239, 236, 0.7); outline: none; }
  html.dark .tcping-range-menu .view-menu-item:focus { background-color: rgba(40, 40, 40, 0.7); }
  html.glass-enabled.light .tcping-range-menu .view-menu-item:focus { background-color: rgba(0, 0, 0, 0.05) !important; }
  html.glass-enabled.dark .tcping-range-menu .view-menu-item:focus { background-color: rgba(255, 255, 255, 0.06) !important; }
  @media (prefers-reduced-motion: reduce) { .tcping-range-menu { animation: none; } }

  .tcping-tooltip {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 60;
    display: grid;
    gap: 6px;
    /* upstream's 112 px: wider left a long gap between a short name and its value */
    min-width: 112px;
    padding: 6px 10px;
    border-radius: 12.8px;
    border: 1px solid rgba(218, 218, 218, 0.5);
    background: #fafafa;
    color: #1d1d20;
    font-size: 12px;
    line-height: 1;
    /* as the upstream chart tooltip measures (shadow-xl, both themes): it
       lifts the card off three lines of probes (11-05 removed it on the
       belief the upstream one had none) */
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease-out, transform 0.15s ease-out;
    will-change: transform;
  }
  .tcping-tooltip.is-placing { transition: opacity 0.15s ease-out; }
  @media (prefers-reduced-motion: reduce) {
    .tcping-tooltip { transition: none; }
  }
  html.dark .tcping-tooltip {
    border-color: rgba(44, 44, 44, 0.5);
    background: #161616;
    color: #f5f5f5;
  }
  .tcping-tooltip-title { font-weight: 500; padding-bottom: 2px; }
  .tcping-tooltip-row { display: flex; align-items: center; gap: 8px; }
  .tcping-tooltip-key { width: 10px; height: 10px; flex: none; border-radius: 2px; }
  .tcping-tooltip-name { flex: 1; color: #595959; }
  html.dark .tcping-tooltip-name { color: #ababab; }
  .tcping-tooltip-value { font-weight: 500; font-variant-numeric: tabular-nums; }
  .tcping-tooltip-value.is-muted { font-weight: 400; color: #595959; }
  html.dark .tcping-tooltip-value.is-muted { color: #ababab; }
  /* Touch screens (no hover, a coarse pointer; not a desktop whose pointer
     the browser cannot tell): the copy-link button after a server's name
     shows on hover only, yet an invisible 10 × 17 px button took the taps
     meant for the row (it copied the link and left the row closed). A
     closed row has none; an opened row shows it, with a 24 × 31 px target
     (a box of its own, so the icon keeps its place on the name's line),
     grown into the empty line after it rather than over the name. */
  @media (hover: none) and (pointer: coarse) {
    #systems-body .system-row > [data-system-id]:not([aria-expanded="true"]) .copy-btn { visibility: hidden; }
    #systems-body .system-row > [data-system-id][aria-expanded="true"] .copy-btn { opacity: 1; position: relative; }
    #systems-body .system-row > [data-system-id][aria-expanded="true"] .copy-btn::after { content: ''; position: absolute; inset: -7px -12px -7px -2px; }
  }
  /* the legend's loss after the average: a muted dot with even space on
     both sides (the button's 6 px gap before it) */
  .tcping-tab-loss::before { content: '·'; margin-right: 6px; color: #595959; }
  html.dark .tcping-tab-loss::before { color: #ababab; }

  /* A new TCPing chart draws in from left to right, oldest to newest:
     Chart.js renders it once and a soft-edged mask sweeps across the canvas
     in 400 ms, instead of Chart.js redrawing all 3 × 1440 points on every
     frame of its own entrance. Pulse's one flourish on a chart; Beszel's
     charts fade in (150 ms) and draw without animating. */
  @keyframes tcping-reveal {
    from {
      -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 33.4%, transparent 40%, transparent 100%);
              mask-image: linear-gradient(90deg, #000 0%, #000 33.4%, transparent 40%, transparent 100%);
      -webkit-mask-size: 300% 100%; mask-size: 300% 100%;
      -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
      -webkit-mask-position: 100% 0; mask-position: 100% 0;
    }
    to {
      -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 33.4%, transparent 40%, transparent 100%);
              mask-image: linear-gradient(90deg, #000 0%, #000 33.4%, transparent 40%, transparent 100%);
      -webkit-mask-size: 300% 100%; mask-size: 300% 100%;
      -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
      -webkit-mask-position: 0 0; mask-position: 0 0;
    }
  }
  [data-tcping-chart].tcping-new:not(.opacity-0) { animation: tcping-reveal 400ms cubic-bezier(0.16, 1, 0.3, 1); }
  @media (prefers-reduced-motion: reduce) {
    [data-tcping-chart].tcping-new:not(.opacity-0) { animation: none; }
    /* Rows open and close without the slide (beats the inline transition
       handleRowToggle sets; its timers still tidy up afterwards). */
    .system-details, .system-details > * { transition: none !important; }
  }

  /* An offline server: its last known values stay, muted (the bars turn
     grey in getProgressColor and a chip follows the name). */
  /* Pages: the other pages' rows stay in the list, hidden (the cards' rows
     are display: contents, which [hidden] alone would not override). The
     footer's buttons are Beszel's 36 px. */
  #systems-body > .system-row[hidden] { display: none !important; }
  #systems-pagination .toolbar-control { height: 36px; }
  #systems-pagination .pagination-btn { width: 36px; padding: 0; align-items: center; justify-content: center; color: inherit; }
  #systems-pagination .pagination-btn:disabled { opacity: 0.5; cursor: default; }
  /* The offline count is a button (it filters): a stronger tint under the
     pointer, a ring while it filters. */
  #systems-summary .summary-offline-chip { cursor: pointer; transition: background-color 50ms ease, box-shadow 50ms ease; }
  #systems-summary .summary-offline-chip:hover { background-color: rgb(239 68 68 / 0.16); }
  html.dark #systems-summary .summary-offline-chip:hover { background-color: rgb(248 113 113 / 0.22); }
  #systems-summary .summary-offline-chip[aria-pressed="true"] { box-shadow: 0 0 0 1.5px #ef4444; }
  /* On touch screens the summary's chips are 24 px tall, the smallest
     target a finger is given (WCAG 2.5.8): the offline one is a button. All
     of them, so they keep one height, the load placeholders too. */
  @media (pointer: coarse) { #systems-summary > * { min-height: 24px; } }
  html.dark #systems-summary .summary-offline-chip[aria-pressed="true"] { box-shadow: 0 0 0 1.5px #f87171; }
  .system-row.is-offline :is(.cell-uptime, .cell-net, .cell-cpu, .cell-memory, .cell-disk) :is(span.font-medium, .cell-value) {
    color: #595959;
  }
  html.dark .system-row.is-offline :is(.cell-uptime, .cell-net, .cell-cpu, .cell-memory, .cell-disk) :is(span.font-medium, .cell-value) {
    color: #ababab;
  }

  /* A row reached with Tab (Enter/Space opens it) shows Beszel's focus ring
     (its ring colour, 2 px) just inside the row; mouse and touch never show
     it. */
  .system-row > [data-system-id]:focus-visible {
    outline: 2px solid #837e79;
    outline-offset: -2px;
  }
  html.dark .system-row > [data-system-id]:focus-visible { outline-color: #cacbce; }
  .system-row > [data-system-id]:focus:not(:focus-visible) {
    outline: none;
  }

  /* 自定义设置 → 延迟视图, the 延迟 view (#monitor-root.view-latency,
     setListView): a column per TCPing target in place of the resource
     columns, the template from latencyColumns() (--lat-template, --lat-min;
     the selectors outrank the tiers' and a custom set of fields'), each with
     the target's last-hour average and, when it lost probes, its loss in the
     loss band's red. An offline server's values are grey, as its bars. Phones
     put the targets on the line under the name (--lat-areas), each with its
     colour and name over its value; cards give each target a row of their
     grid (the colour where the icons are, the name, the value). */
  /* No server matches the filter: Beszel's line, in its table's 148 px row
     (h-37); across the cards' grid and on phones 96 px, near the 88 px its
     cards view gives it */
  #systems-body .systems-none { grid-column: 1 / -1; display: flex; align-items: center; justify-content: center; height: 96px; padding: 0 16px; font-size: 14px; line-height: 20px; text-align: center; color: #1d1d20; }
  @media (min-width: 768px) { #monitor-root:not(.layout-grid) #systems-body .systems-none { height: 148px; } }
  html.dark #systems-body .systems-none { color: #f5f5f5; }
  .cell-latency { display: none; }
  /* 延迟's rows don't open: no pointer and no hover */
  html #monitor-root.view-latency #systems-body .system-row > [data-system-id] { cursor: default; }
  html #monitor-root.view-latency:not(.layout-grid) #systems-body .system-row > [data-system-id]:hover { background-color: transparent; }
  html #monitor-root.view-latency.layout-grid #systems-body .system-row > [data-system-id]:hover { box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05); }
  html #monitor-root.view-latency.view-latency #systems-body .system-row > [data-system-id] > :is(.cell-cpu, .cell-memory, .cell-disk, .cell-net, .cell-uptime),
  html #monitor-root.view-latency.view-latency #system-table-header-row > :is([data-col="cpu"], [data-col="memory"], [data-col="disk"], [data-col="net"], [data-col="uptime"]) { display: none !important; }
  .lat-key { display: inline-block; flex: none; width: 8px; height: 8px; border-radius: 2px; background: var(--lat-key); }
  html.dark .lat-key { background: var(--lat-key-dark); }
  .lat-item { min-width: 0; }
  .lat-value { display: inline-flex; align-items: baseline; gap: 6px; min-width: 0; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .lat-ms { color: #1d1d20; }
  html.dark .lat-ms { color: #f5f5f5; }
  .lat-ms.lat-none { color: #595959; }
  html.dark .lat-ms.lat-none { color: #ababab; }
  /* the loss in the 离线 chip's reds (red-700 / red-300): #fb2c36, the loss
     band's, was 3.8:1 on white as 12 px text */
  .lat-loss { color: #b91c1c; font-size: 12px; }
  html.dark .lat-loss { color: #fca5a5; }
  .system-row.is-offline :is(.lat-ms, .lat-loss) { color: #595959; }
  html.dark .system-row.is-offline :is(.lat-ms, .lat-loss) { color: #ababab; }
  #system-table-header-row .lat-head-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* a target keeps its colour while sorted (its only link to the chart):
     the arrow comes after the name */
  #system-table-header-row .lat-head .sort-header-arrow { order: 2; }
  /* the view menu: no resource fields or sorts in this view */
  html.list-latency #columns-dropdown :is(.sort-option, .column-option):is([data-sort="cpu"], [data-sort="memory"], [data-sort="disk"], [data-sort="net"], [data-sort="time"], [data-col="cpu"], [data-col="memory"], [data-col="disk"], [data-col="net"], [data-col="uptime"]) { display: none; }
  @media (min-width: 768px) {
    html #monitor-root.view-latency.view-latency:not(.layout-grid) #systems-body .system-row > [data-system-id],
    html #monitor-root.view-latency.view-latency:not(.layout-grid) #system-table-header-row { grid-template-columns: var(--lat-template) !important; }
    html #monitor-root.view-latency.view-latency:not(.layout-grid) .table-scroll-content { min-width: var(--lat-min) !important; }
    #monitor-root.view-latency:not(.layout-grid) .cell-latency { display: contents; }
    #monitor-root.view-latency:not(.layout-grid) .lat-item { display: flex; align-items: center; height: 20px; overflow: hidden; font-size: 12px; font-weight: 500; }
    #monitor-root.view-latency:not(.layout-grid) .lat-item > :is(.lat-key, .lat-name) { display: none; }
  }
  @media (min-width: 1024px) and (max-width: 1279.98px) {
    #monitor-root.view-latency:not(.layout-grid) .lat-item { font-size: 13px; font-weight: 400; letter-spacing: -0.025em; }
  }
  @media (min-width: 1280px) {
