  // TCPing chart instances storage
  const tcpingCharts = new Map(); // key: systemId_target, value: { chart: Chart, target: string }
  const tcpingConfigs = new Map(); // key: systemId, value: TCPingConfig
  // Map to store current active target for each system
  const tcpingActiveTargets = new Map(); // systemId -> { target: address, targetName: name }
  // Map to track loading state for each system to allow cancellation
  const tcpingLoadingStates = new Map(); // systemId -> { loading: boolean, cancelled: boolean }
  // Re-entrancy guard for incremental updates. updateTCPingChart is called both
  // by the per-row 30-s polling tick and by the metric_updated SSE handler when
  // a fresh tcping sample arrives, so on slow networks two fetches for the same
  // systemId can be in flight at once. Without this guard they race on the same
  // canvas: one finishes mid-render, the second one tears the in-progress chart
  // down (looks like a "reload"). Set membership is keyed by systemId and only
  // gates the *incremental* path — the initial / non-incremental load still
  // runs unconditionally.
  const tcpingIncrementalInFlight = new Set();

  // Map: systemId -> "target1@ts1|target2@ts2|..." signature of the last
  // tcping_data we rendered. Used by the SSE update handler to decide whether
  // a metric_updated event actually brought a fresh tcping sample, or is just
  // the 3-second state broadcast carrying the same tcping_data as before.
  // See the update handler below for the exact rationale.
  const tcpingDataSignatures = new Map();

  function computeTCPingSignature(system) {
    if (!system || !system.tcping_data) return '';
    const keys = Object.keys(system.tcping_data).sort();
    const parts = [];
    for (const k of keys) {
      const v = system.tcping_data[k];
      if (!v) continue;
      // Timestamp on TCPingTargetData advances only when the client actually
      // pushed a new sample for this target — i.e. exactly at the
      // admin-configured interval. If every timestamp matches what we
      // rendered last time, there is no new tcping point to draw.
      // The `skipped` flag is part of the signature too. A target that the
      // agent cannot probe at all (no route of the matching address family)
      // carries a marker entry whose timestamp still advances every push, so
      // timestamps alone would already trigger a redraw — but the reverse
      // matters more: when a real probe finally replaces the marker (route
      // restored, IPv6 enabled), the presentation has to flip from the
      // "unreachable" notice back to a live chart. Folding the flag in makes
      // that flip an explicit signature change, so it is picked up on the
      // very next 3-second broadcast rather than depending on the timestamp
      // happening to differ.
      parts.push(k + '@' + (v.timestamp || '') + (v.skipped === true ? '#skip' : ''));
    }
    return parts.join('|');
  }

  // Map: systemId -> Set of target addresses the agent reported as "skipped".
  //
  // A skipped target is one this node has no route to (an IPv6 target on a
  // v4-only node, or vice versa). The agent flags the probe instead of
  // reporting a failure, and the server keeps the marker out of history —
  // so `/api/tcping/history` returns no rows for it and the server-side
  // `stats` already exclude it. The frontend therefore must NOT read the
  // resulting absence as packet loss or as "no data yet": it is a third,
  // distinct state that gets its own notice and an N/A summary.
  const tcpingSkippedTargets = new Map(); // systemId -> Set<targetAddress>

  // Record (or clear) the skipped-target set for one system from a raw
  // /api/metrics or SSE `systems[]` entry. Cheap: one pass over the
  // tcping_data keys, and the map entry is dropped entirely in the common
  // case where nothing is skipped, so lookups stay a single Map.get miss.
  function noteTCPingSkippedTargets(system) {
    if (!system || system.id === undefined || system.id === null) return;
    const systemId = String(system.id);
    const data = system.tcping_data;
    if (!data || typeof data !== 'object') {
      tcpingSkippedTargets.delete(systemId);
      return;
    }
    let skipped = null;
    for (const address of Object.keys(data)) {
      const entry = data[address];
      if (entry && entry.skipped === true) {
        if (skipped === null) skipped = new Set();
        skipped.add(address);
      }
    }
    if (skipped === null) {
      tcpingSkippedTargets.delete(systemId);
    } else {
      tcpingSkippedTargets.set(systemId, skipped);
    }
  }

  function isTCPingTargetSkipped(systemId, targetAddress) {
    if (!targetAddress) return false;
    const skipped = tcpingSkippedTargets.get(String(systemId));
    return !!(skipped && skipped.has(targetAddress));
  }

  // Should the chart area show the "node cannot reach this target" notice?
  //
  //   * a target is selected  → only when THAT target is skipped;
  //   * the "all targets" view → only when EVERY configured target is
  //     skipped. With a mix, the remaining targets still have real lines to
  //     draw and real stats to show, so the all-targets view stays a normal
  //     chart and the skipped ones are simply absent from it (which is
  //     exactly what "no history rows" already produces).
  function shouldShowTCPingUnreachable(systemId, selectedTarget, config) {
    const skipped = tcpingSkippedTargets.get(String(systemId));
    if (!skipped || skipped.size === 0) return false;
    if (selectedTarget) return skipped.has(selectedTarget);
    const targets = (config && Array.isArray(config.targets)) ? config.targets : [];
    if (targets.length === 0) return false;
    return targets.every(t => t && skipped.has(t.address));
  }

  // Global cache for TCPing config (preloaded on page load)
  let cachedTCPingConfig = null;
  let tcpingConfigLoading = null; // Promise to prevent duplicate fetches

  // Cleanup function to destroy tcping chart for a system
  // A stretch with no samples at all (the agent was offline) is left as a
  // gap instead of a straight line across it: the piece of line between two
  // neighbouring samples more than 2.5 sampling intervals apart (the median
  // spacing) is not drawn. Lost samples are points with y=null and stay
  // bridged by spanGaps, as before. (A numeric spanGaps would break the line
  // at every lost sample too.)
  function tcpingGapSegment(points) {
    const d = [];
    for (let i = 1; i < points.length; i++) {
      const v = points[i].x - points[i - 1].x;
      if (v > 0) d.push(v);
    }
    if (d.length === 0) return undefined;
    d.sort((a, b) => a - b);
    const limit = d[d.length >> 1] * 2.5;
    // Without such a stretch: no per-piece styling, which costs ~20 ms per chart.
    if (d[d.length - 1] <= limit) return undefined;
    const hide = (ctx) => (ctx.p1.parsed.x - ctx.p0.parsed.x > limit ? 'transparent' : undefined);
    return { borderColor: hide, backgroundColor: hide };
  }

  function cleanupTCPingChart(systemId) {
    hideTCPingTooltip();
    // Cancel any ongoing loading for this system
    // The flag lives on the state object, which the in-flight build keeps a
    // reference to, so it still reads as cancelled after the map entry is
    // dropped below.
    const loadingState = tcpingLoadingStates.get(systemId);
    if (loadingState) {
      loadingState.cancelled = true;
    }
    
    // Find and destroy all charts for this system
    const chartsToDestroy = [];
    tcpingCharts.forEach((value, key) => {
      if (key.startsWith(`${systemId}_`)) {
        if (value.chart) {
          try {
            value.chart.destroy();
          } catch (err) {
