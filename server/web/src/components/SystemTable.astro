    </div>
        <div class="cell-uptime text-[10px] sm:text-xs font-medium text-[#262626] dark:text-[#f5f5f5] h-5 flex items-center">${cardLabel(1)}<span class="cell-value">${escapeHtml(item.time || '-')}</span></div>
