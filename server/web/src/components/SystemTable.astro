  `;
  };

  const translations = {
    'noSystemsFound': { en: 'No services found', zh: '未找到服务' },
    'systemsWillAppear': { en: 'Services will appear here once agents start reporting', zh: '代理开始报告后，服务将显示在这里' },
    'copySystemName': { en: 'Copy system name', zh: '复制服务名称' },
    'copied': { en: 'Copied!', zh: '已复制！' },
    // Empty state of a filter that matches nothing (the services exist).
    'noMatchingServices': { en: 'No matching services', zh: '没有匹配的服务' },
    'tryAnotherFilter': { en: 'Try a different filter', zh: '换个关键词试试' },
    'cpuInformation': { en: 'CPU:', zh: 'CPU:' },
    'memoryInfo': { en: 'Memory:', zh: '内存:' },
    'swapPartition': { en: 'Swap:', zh: '交换:' },
    'diskInformation': { en: 'Disk:', zh: '磁盘:' },
    'realtimeTraffic': { en: 'Traffic:', zh: '流量:' },
    'totalTraffic': { en: 'Total:', zh: '总量:' },
    'tcpingLatency': { en: 'TCPing Latency (24h)', zh: 'TCPing 延迟 (24 小时)' },
    'avgLatency': { en: 'Avg:', zh: '平均:' },
    'packetLoss': { en: 'Loss:', zh: '丢包:' },
    'loading': { en: 'Loading...', zh: '加载中...' },
    'noData': { en: 'No data', zh: '暂无数据' },
    // The agent reported this target as "skipped": the node has no route of
