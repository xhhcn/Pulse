      // its chart with no tab selected and every line grey; a renamed one
      // keeps its selection under the new name.
      const namesByAddress = new Map(((fresh && fresh.targets) || []).map((t) => [t.address, t.name]));
      for (const [id, info] of tcpingActiveTargets) {
