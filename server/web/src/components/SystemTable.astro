  // ticks one every 59 minutes. Spans too short for two round ticks keep
  // Chart.js's ticks.
  const TIME_TICK_STEPS_MIN = [1, 2, 5, 10, 15, 30, 60, 120, 180, 240, 360, 480, 720];
  function roundTimeTicks(scale) {
    const { min, max } = scale;
    if (!(max > min)) return;
    const fit = Math.max(2, Math.min(12, Math.floor(scale.width / 56)));
    const spanMin = (max - min) / 60000;
    let i = TIME_TICK_STEPS_MIN.findIndex((s) => Math.floor(spanMin / s) + 1 <= fit);
    if (i < 0) return;
    // the marks a step puts on the axis
    const marks = (step) => {
      const first = new Date(min);
      first.setSeconds(0, 0);
      const past = (first.getHours() * 60 + first.getMinutes()) % step;
      let t = first.getTime() + (past ? (step - past) * 60000 : 0);
      if (t < min) t += step * 60000;
      const ticks = [];
      for (; t <= max && ticks.length <= 12; t += step * 60000) ticks.push({ value: t });
      return ticks;
    };
    let ticks = marks(TIME_TICK_STEPS_MIN[i]);
    // A narrow axis left with two times (a phone's hour: 11:30, 12:00) takes
    // the next finer step whose marks, counted, fit at 48 px each
    // (11:15 … 12:00; "00:00" is about 32 px wide).
    const roomy = Math.max(fit, Math.floor(scale.width / 48));
    while (ticks.length < 3 && i > 0) {
      const finer = marks(TIME_TICK_STEPS_MIN[i - 1]);
      if (finer.length > roomy) break;
      ticks = finer;
      i -= 1;
    }
    if (ticks.length >= 2) scale.ticks = ticks;
  }

  // Latency-axis ticks: round steps (1, 2 or 5 × 10ⁿ ms, and 25, 250…), at
  // most six labels, fitted to the lines (Beszel's ["auto", "auto"] domain
  // for response times) and never below 0 ms. Above the highest point the
  // axis keeps a quarter of the lines' height free: the lines stay in the
  // lower four-fifths of the chart, clear of the top edge and its label
  // (lines up to 87 ms reach 120 ms, not 100 ms). Chart.js's own grace was
  // added after the 0 ms floor, so a target under a millisecond beside a slow
  // one took the axis to −50 ms.
  function latencyTicks(scale) {
    const lo = scale.$dataMin;
    const hi = scale.$dataMax;
    if (!Number.isFinite(lo) || !Number.isFinite(hi)) return;
    const span = Math.max(hi - lo, 0.1);
    for (let exp = Math.floor(Math.log10(span / 5)); exp < 12; exp++) {
      for (const m of exp >= 1 ? [1, 2, 2.5, 5] : [1, 2, 5]) {
        const step = m * 10 ** exp;
        const bottom = Math.max(0, Math.floor((lo - span * 0.025) / step) * step);
        const top = Math.ceil((bottom + (hi - bottom) / 0.8) / step - 1e-9) * step;
        const spaces = Math.round((top - bottom) / step);
        if (spaces > 5) continue;
        const round = (v) => Number(v.toFixed(Math.max(0, -exp)));
        scale.ticks = Array.from({ length: spaces + 1 }, (_, i) => ({ value: round(bottom + i * step) }));
        scale.min = round(bottom);
        scale.max = round(top);
        return;
      }
    }
  }

  // Function to update tooltip and axis label colours for all charts
  function updateChartTooltipStyles(theme) {
    const isDarkMode = theme === 'dark';
    const tooltipBg = isDarkMode ? 'rgba(20, 21, 22, 0.95)' : 'rgba(250, 250, 250, 0.95)';
    const tooltipTextColor = isDarkMode ? '#f5f5f5' : '#272625';
    const tooltipBorderColor = isDarkMode ? '#3e3f42' : '#d7d4d1';
    
    // Update all existing charts
    tcpingCharts.forEach((chartData, key) => {
      const chart = chartData.chart;
      if (chart && chart.options && chart.options.plugins && chart.options.plugins.tooltip) {
        // Safety check: ensure chart and canvas are still valid
        if (!chart.canvas || !chart.canvas.parentElement) {
          return;
        }
        
        chart.options.plugins.tooltip.backgroundColor = tooltipBg;
        chart.options.plugins.tooltip.titleColor = tooltipTextColor;
        chart.options.plugins.tooltip.bodyColor = tooltipTextColor;
        chart.options.plugins.tooltip.footerColor = tooltipTextColor;
        chart.options.plugins.tooltip.borderColor = tooltipBorderColor;
        if (chart.options.scales) {
          if (chart.options.scales.x && chart.options.scales.x.ticks) chart.options.scales.x.ticks.color = axisLabelColor(isDarkMode);
          if (chart.options.scales.y && chart.options.scales.y.ticks) chart.options.scales.y.ticks.color = axisLabelColor(isDarkMode);
          if (chart.options.scales.y && chart.options.scales.y.grid) chart.options.scales.y.grid.color = gridLineColor(isDarkMode);
        }
        // Each theme has its own line colours (faded ones included).
        chart.data.datasets.forEach((dataset, index) => {
          dataset.borderColor = tcpingRoleColor(dataset.targetIndex !== undefined ? dataset.targetIndex : index, dataset.role || 'all', isDarkMode);
          dataset.backgroundColor = dataset.borderColor;
        });

        try {
          chart.update('none'); // Update without animation
        } catch (err) {
          // Chart update failed silently
        }
      }
    });
    // The tab dots are the legend: same colours as the lines.
    const tabStrips = new Set([...document.querySelectorAll('#monitor-root [data-tcping-dot]')].map((dot) => dot.closest('button')?.parentElement).filter(Boolean));
    tabStrips.forEach((strip) => {
      const active = strip.querySelector('button[data-tcping-active="true"]');
      paintTCPingTabDots(strip, active ? active.dataset.target : null, isDarkMode);
    });
  }

  const showEmpty = () => {
    if (loadingIndicator) loadingIndicator.style.display = 'none';
    
    // Tear down the per-system chart state the way the row-removal path
    // does; otherwise an expanded row's Chart.js instance survives on the
    // detached DOM when the list empties (last system hidden or deleted).
    currentData.forEach((_, id) => {
      try { cleanupTCPingChart(id); } catch (_) {}
      tcpingConfigs.delete(id);
      tcpingActiveTargets.delete(id);
      tcpingSkippedTargets.delete(id);
    });

    // CRITICAL: Clear currentData to ensure next load triggers column width calculation
    // This fixes the issue where deleting all systems and re-adding doesn't recalculate width
    currentData.clear();
    
    // CRITICAL: Force reset column width to default (bypass "only increase" logic)
    // When showing empty state, we need to actually reset the width, not just try to set a smaller value
    // The applyServerNameColumnWidth function uses Math.max which prevents decreasing
    // So we directly set the CSS variable here to force a reset — only when
    // there are no services at all: a filter (the text or the status) that
    // matches nothing keeps the width, or the header's columns jumped left
    // and back with every keystroke that found nothing.
    const filtered = !!currentFilter.trim() || statusFilter !== 'all';
    const root = document.getElementById('monitor-root');
    if (root && !filtered) {
      root.style.setProperty('--first-col-width', '160px');
      void root.offsetHeight; // Force reflow to apply the reset immediately
    }
    
    if (body && filtered) {
      // A filter (the text or the status) that matches nothing is not an
      // empty deployment: Beszel's one line, "No systems found.", in its
      // table's 148 px row (96 px in cards and phone rows; .systems-none)
      body.innerHTML = `<div class="systems-none" data-empty-key="noMatchingLine">${translations.noMatchingLine[getCurrentLanguage()]}</div>`;
    } else if (body) {
      const lang = getCurrentLanguage();
      const [titleKey, hintKey] = emptyMessageKeys[0];
      body.innerHTML = `
        <div class="flex flex-col items-center justify-center py-12 text-center">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-[#595959] dark:text-[#ababab] mb-3">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
            <line x1="8" y1="21" x2="16" y2="21"/>
            <line x1="12" y1="17" x2="12" y2="21"/>
          </svg>
          <p class="text-sm font-medium text-[#1d1d20] dark:text-[#f5f5f5]">${translations[titleKey][lang]}</p>
          <p class="text-xs text-[#595959] dark:text-[#ababab] mt-1">${translations[hintKey][lang]}</p>
    </div>
  `;
    }
    // No rows: no pages.
    applyPagination();
  };

  // Normalize data for comparison (ensure consistent types)
  function normalizeItem(item) {
    return {
      id: String(item.id || ''),
      name: String(item.name || ''),
      time: String(item.time || ''),
      location: String(item.location || ''),
      cpu: Number(item.cpu || 0),
      cpu_model: String(item.cpu_model || ''),
      memory: Number(item.memory || 0),
      memory_info: String(item.memory_info || ''),
      swap_info: String(item.swap_info || ''),
      disk: Number(item.disk || 0),
      disk_info: String(item.disk_info || ''),
      net_in_mb_s: Number(item.net_in_mb_s || 0),
      net_out_mb_s: Number(item.net_out_mb_s || 0),
      total_net_in_bytes: Number(item.total_net_in_bytes || 0),
      total_net_out_bytes: Number(item.total_net_out_bytes || 0),
      os: String(item.os || ''),
      os_icon: String(item.os_icon || ''),
      alert: Boolean(item.alert || false),
      order: Number(item.order || 0),
      // Admin toggle: absent on the wire when false (omitempty)
      hide_tcping: item.hide_tcping === true,
      tags: Array.isArray(item.tags) ? item.tags.map(String).join('\u0000') : ''
    };
  }
  
  // Check if two system objects have changed (excluding updated_at)
  function hasChanged(oldItem, newItem) {
    if (!oldItem) return true; // New item
    if (!newItem) return false; // Deleted item
    
    // Normalize both items for consistent comparison
    const old = normalizeItem(oldItem);
    const new_ = normalizeItem(newItem);
    
    // A measure counts as changed when what the row shows changes: a
    // percentage's label or bar, a speed's text (the table shows in + out,
    // the details each). A fixed 0.1 step kept small changes off the screen
    // for good, as the stored values moved on: a speed up to 100 KB/s, a
    // percentage by a few hundredths (a sorted table then looked unsorted).
    const pctShown = (a, b) => pctLabel(a) !== pctLabel(b) || barWidth(a) !== barWidth(b);
    const speedShown = (a, b) => formatTrafficSpeed(a) !== formatTrafficSpeed(b);
    
    // Compare relevant fields - only return true if there's a meaningful change
    return (
      old.name !== new_.name ||
      old.time !== new_.time ||
      old.location !== new_.location ||
      pctShown(old.cpu, new_.cpu) ||
      old.cpu_model !== new_.cpu_model ||
      pctShown(old.memory, new_.memory) ||
      old.memory_info !== new_.memory_info ||
      old.swap_info !== new_.swap_info ||
      pctShown(old.disk, new_.disk) ||
      old.disk_info !== new_.disk_info ||
      speedShown(old.net_in_mb_s, new_.net_in_mb_s) ||
      speedShown(old.net_out_mb_s, new_.net_out_mb_s) ||
      speedShown(old.net_in_mb_s + old.net_out_mb_s, new_.net_in_mb_s + new_.net_out_mb_s) ||
      old.os !== new_.os ||
      old.os_icon !== new_.os_icon ||
      old.alert !== new_.alert ||
      old.order !== new_.order ||
      old.tags !== new_.tags
    );
  }
  
  // Update a single row in the DOM - only update changed cells
  function updateRow(rowElement, item, previousItem) {
    if (!rowElement) return;
    
    // Get cached old item for comparison (normalized)
    // Use previousItem if provided, otherwise fall back to currentData
    const oldItemNormalized = previousItem ? normalizeItem(previousItem) : (currentData.get(item.id) || normalizeItem({}));
    
    // Normalize new item for comparison
    const newItemNormalized = normalizeItem(item);
    
    // The row's cells by what they hold (their order is a matter of layout)
    const cell = (name) => rowElement.querySelector(`:scope > .cell-${name}`);
    if (rowElement.children.length < 8) return; // Safety check
    
    // If no old data, update all fields (treat as new item)
    const shouldUpdateAll = !previousItem && !currentData.get(item.id);

    // The row's own details panel (its sibling inside .system-row). Looked up
    // in the row, not the page: a page-wide attribute search ran for every
    // row on every live update and was most of the update's cost.
    const rowDetails = () => {
      const details = rowElement.parentElement?.querySelector(':scope > .system-details');
      return details && details.dataset.built === '1' ? details : null;
    };

    // Tags changed by the admin: the details' tag row is drawn again.
    if (!shouldUpdateAll && oldItemNormalized.tags !== newItemNormalized.tags) {
      const detailsSection = rowDetails();
      const column = detailsSection && detailsSection.querySelector('.detail-list');
      if (column) {
        const strip = column.querySelector(':scope > [data-tag-strip]');
        const html = renderTagStrip(item).trim();
        if (strip && html) strip.outerHTML = html;
        else if (strip) strip.remove();
        else if (html) column.insertAdjacentHTML('afterbegin', html);
      }
    }
    
    // Update traffic tags if they exist and network traffic changed
    const trafficTagTotalInChanged = oldItemNormalized.total_net_in_bytes !== newItemNormalized.total_net_in_bytes;
    const trafficTagTotalOutChanged = oldItemNormalized.total_net_out_bytes !== newItemNormalized.total_net_out_bytes;
    // For speed tags, always consider them changed (speed is real-time and should update every cycle)
    const speedTagInChanged = oldItemNormalized.net_in_mb_s !== newItemNormalized.net_in_mb_s;
    const speedTagOutChanged = oldItemNormalized.net_out_mb_s !== newItemNormalized.net_out_mb_s;
    
    if (shouldUpdateAll || trafficTagTotalInChanged || trafficTagTotalOutChanged || speedTagInChanged || speedTagOutChanged) {
      // Find all traffic and speed tags in the details section
      // Update them regardless of whether the section is expanded or collapsed
      // This ensures tags show latest data when user expands the section
      const detailsSection = rowDetails();
      if (detailsSection) {
        // Update traffic:in tags (total cumulative)
        if (trafficTagTotalInChanged || shouldUpdateAll) {
          const trafficInTags = detailsSection.querySelectorAll('[data-traffic-tag="in"]');
          trafficInTags.forEach(tag => {
            const valueSpan = tag.querySelector('.traffic-value');
            if (valueSpan) {
              valueSpan.textContent = formatTotalTraffic(item.total_net_in_bytes || 0);
            }
          });
        }
        
        // Update traffic:out tags (total cumulative)
        if (trafficTagTotalOutChanged || shouldUpdateAll) {
          const trafficOutTags = detailsSection.querySelectorAll('[data-traffic-tag="out"]');
          trafficOutTags.forEach(tag => {
            const valueSpan = tag.querySelector('.traffic-value');
            if (valueSpan) {
              valueSpan.textContent = formatTotalTraffic(item.total_net_out_bytes || 0);
            }
          });
        }
        
        // Update speed:in tags (current rate)
        if (speedTagInChanged || shouldUpdateAll) {
          const speedInTags = detailsSection.querySelectorAll('[data-speed-tag="in"]');
          speedInTags.forEach(tag => {
            const valueSpan = tag.querySelector('.speed-value');
            if (valueSpan) {
              valueSpan.textContent = formatTrafficSpeed(item.net_in_mb_s || 0);
            }
          });
        }
        
        // Update speed:out tags (current rate)
        if (speedTagOutChanged || shouldUpdateAll) {
          const speedOutTags = detailsSection.querySelectorAll('[data-speed-tag="out"]');
          speedOutTags.forEach(tag => {
            const valueSpan = tag.querySelector('.speed-value');
            if (valueSpan) {
              valueSpan.textContent = formatTrafficSpeed(item.net_out_mb_s || 0);
            }
          });
        }
      }
    }
    
    // Cell 0: System name (with status dot and copy button)
    const systemCell = cell('name');
    if (systemCell) {
      if (shouldUpdateAll || oldItemNormalized.alert !== newItemNormalized.alert
        || awaitingClient(oldItemNormalized) !== awaitingClient(newItemNormalized)) {
        // Use rounded-full to match the status dot (which has h-1.5 w-1.5 sm:h-2 sm:w-2)
        const statusDot = systemCell.querySelector('span.rounded-full.shrink-0');
        if (statusDot) {
          // Offline/paused state: red, waiting for its client: grey, online: green
          // Preserve responsive classes: h-1.5 w-1.5 sm:h-2 sm:w-2
          statusDot.className = `status-dot h-1.5 w-1.5 sm:h-2 sm:w-2 rounded-full ${statusDotColor(item)} shrink-0`;
        }
        const rowEl = systemCell.closest('.system-row');
        if (rowEl) rowEl.classList.toggle('is-offline', !!item.alert);
        // The chip says which (离线 or 等待接入): drawn again on any change.
        systemCell.querySelector('.offline-chip')?.remove();
        if (item.alert) {
          const nameSpan = systemCell.querySelector('.row-name');
          if (nameSpan) nameSpan.insertAdjacentHTML('afterend', statusChip(item));
        }
        // The details' 最后在线 line follows (shown while offline).
        const seenItem = rowEl && rowEl.querySelector('.detail-last-seen');
        if (seenItem) {
          seenItem.hidden = !showLastSeen(item);
          const value = seenItem.querySelector('[data-last-seen]');
          if (value) {
            value.dataset.lastSeen = item.updated_at || '';
            value.textContent = lastSeenText(item.updated_at);
          }
        }
        // The chip widens the name cell (the column only ever grows).
        if (item.alert) recalculateColumnWidthFromCurrentData();
      }
      if (shouldUpdateAll || oldItemNormalized.name !== newItemNormalized.name) {
        // Use font-medium to match the name span (which has text-[10px] sm:text-xs)
        // Exclude the status dot by checking it doesn't have rounded-full class
        const allSpans = systemCell.querySelectorAll('span.font-medium');
        for (const span of allSpans) {
          // The name span doesn't have rounded-full class, status dot does
          if (!span.classList.contains('rounded-full')) {
            span.textContent = item.name || 'unknown';
            if (span.classList.contains('row-name')) span.title = item.name || 'unknown';
            break; // Found the name span, no need to continue
          }
        }
        // Recalculate column width when name changes
        recalculateColumnWidthFromCurrentData();
      }
    }
    
    // Cell 1: Time - only update if changed
    if (shouldUpdateAll || oldItemNormalized.time !== newItemNormalized.time) {
      const timeCell = cell('uptime');
      if (timeCell) {
        // The value span, not the cell: the cell also holds the card label.
        (timeCell.querySelector('.cell-value') || timeCell).textContent = item.time || '-';
      }
    }
    
    // Cell 2: Location - only update if changed
    if (shouldUpdateAll || oldItemNormalized.location !== newItemNormalized.location) {
      const locationCell = cell('location');
      if (locationCell) {
        locationCell.innerHTML = locationCellHTML(item);
        locationCell.title = locationTitle(item.location);
        if (locationCell.querySelector('.flag-icon')) setTimeout(() => loadFlagIcons(), 0);
      }
    }
    
    // Check if system is offline/paused
    const isOffline = newItemNormalized.alert || false;
    
    // Cells 3-5 (CPU, memory, disk) are redrawn when what they show changes:
    // the label (one decimal) or the bar (whole percents). A step under 0.1
    // used to leave the label behind (0.84 → 0.86 kept "0.8"), so a table
    // sorted by the values could look out of order.
    const shownChanged = (a, b) => pctLabel(a) !== pctLabel(b) || barWidth(a) !== barWidth(b);
    const cpuChanged = shownChanged(oldItemNormalized.cpu, newItemNormalized.cpu);
    // Helper function for dynamic color updates (same logic as getProgressColor)
    const getDynamicProgressColor = getProgressColor;
    
    const cpuStatusChanged = oldItemNormalized.alert !== newItemNormalized.alert;
    if (shouldUpdateAll || cpuChanged || cpuStatusChanged) {
      const cpuCell = cell('cpu');
      if (cpuCell) {
        // Update progress bar and text directly
        // Use more flexible selector to match span with font-medium class (which has text-[10px] sm:text-xs)
        const textSpan = cpuCell.querySelector('span.font-medium');
        const progressBar = cpuCell.querySelector('div.absolute');
        const value = newItemNormalized.cpu;
        if (textSpan) {
          textSpan.textContent = pctLabel(value);
        }
        if (progressBar) {
          setBarScale(progressBar, value);
          // Update color based on threshold
          const barClass = `${BAR_FILL} ${getDynamicProgressColor(value, isOffline)}`;
          if (progressBar.className !== barClass) progressBar.className = barClass;
        }
      }
    }
    
    // Cell 4: Memory - only update if changed (with threshold)
    const memoryChanged = shownChanged(oldItemNormalized.memory, newItemNormalized.memory);
    const memoryStatusChanged = oldItemNormalized.alert !== newItemNormalized.alert;
    if (shouldUpdateAll || memoryChanged || memoryStatusChanged) {
      const memoryCell = cell('memory');
      if (memoryCell) {
        // Use more flexible selector to match span with font-medium class (which has text-[10px] sm:text-xs)
        const textSpan = memoryCell.querySelector('span.font-medium');
        const progressBar = memoryCell.querySelector('div.absolute');
        const value = newItemNormalized.memory;
        if (textSpan) {
          textSpan.textContent = pctLabel(value);
        }
        if (progressBar) {
          setBarScale(progressBar, value);
          // Update color based on threshold
          const barClass = `${BAR_FILL} ${getDynamicProgressColor(value, isOffline)}`;
          if (progressBar.className !== barClass) progressBar.className = barClass;
        }
      }
    }
    
    // Cell 5: Disk - only update if changed (with threshold)
    const diskChanged = shownChanged(oldItemNormalized.disk, newItemNormalized.disk);
    const diskStatusChanged = oldItemNormalized.alert !== newItemNormalized.alert;
    if (shouldUpdateAll || diskChanged || diskStatusChanged) {
      const diskCell = cell('disk');
      if (diskCell) {
        // Use more flexible selector to match span with font-medium class (which has text-[10px] sm:text-xs)
        const textSpan = diskCell.querySelector('span.font-medium');
        const progressBar = diskCell.querySelector('div.absolute');
        const value = newItemNormalized.disk;
        if (textSpan) {
          textSpan.textContent = pctLabel(value);
        }
        if (progressBar) {
          setBarScale(progressBar, value);
          // Update color based on threshold
          const barClass = `${BAR_FILL} ${getDynamicProgressColor(value, isOffline)}`;
          if (progressBar.className !== barClass) progressBar.className = barClass;
        }
      }
    }
    
    // Cell 6: Net - only update when the displayed text changes. The value
    // is shown in automatic units (B/s, KB/s, MB/s), so a fixed MB/s
    // threshold would freeze small speeds that still change on screen.
    // An offline server has no current speed: a dash, as Beszel leaves it out.
    const netText = (it) => (it.alert ? '-' : formatTrafficSpeed(it.net_in_mb_s + it.net_out_mb_s));
    const oldNetText = netText(oldItemNormalized);
    const newNetText = netText(newItemNormalized);
    if (shouldUpdateAll || oldNetText !== newNetText) {
      const netCell = cell('net');
      if (netCell) {
        (netCell.querySelector('.cell-value') || netCell).textContent = newNetText;
      }
    }
    
    // Cell 7: OS - only update if changed
    if (oldItemNormalized.os !== newItemNormalized.os || oldItemNormalized.os_icon !== newItemNormalized.os_icon) {
      const osCell = cell('os');
      if (osCell) {
        osCell.innerHTML = osCellHTML(item);
        if (item.os_icon) setTimeout(() => loadOSIcons(), 0);
      }
    }
    // The OS cell's tooltip adds the kind of machine (Debian · VPS), which
    // the details leave out where the cell is shown.
    const osTitleCell = cell('os');
    if (osTitleCell && osTitleCell.title !== osDetailText(item)) osTitleCell.title = osDetailText(item);
    
    // Update expandable details section if it exists and is visible
    // Always update the data, even if hidden, so it's ready when expanded
    const systemRow = rowElement.closest('.system-row');
    if (systemRow) {
      const detailsSection = rowDetails();
      if (detailsSection) {
        // Update details content - check if values changed
        const locationEl = detailsSection.querySelector('[data-detail="location"]');
        const newLocation = item.location ? countryName(item.location) : '-';
        if (locationEl && locationEl.textContent !== newLocation) locationEl.textContent = newLocation;
        const osEl = detailsSection.querySelector('[data-detail="os"]');
        const newOs = osDetailText(item);
        if (osEl && osEl.textContent !== newOs) osEl.textContent = newOs;
        const cpuModelEl = detailsSection.querySelector('[data-detail="cpu_model"]');
        const memoryInfoEl = detailsSection.querySelector('[data-detail="memory_info"]');
        const swapInfoEl = detailsSection.querySelector('[data-detail="swap_info"]');
        const diskInfoEl = detailsSection.querySelector('[data-detail="disk_info"]');
        
        // Update CPU model if changed
        if (cpuModelEl) {
          const newCpuModel = cpuModelText(item.cpu_model);
          const oldCpuModel = cpuModelEl.textContent;
          if (oldCpuModel !== newCpuModel) {
            // Update text
            cpuModelEl.textContent = newCpuModel;
            
          }
        }
        
        // Update memory info if changed
        if (memoryInfoEl) {
          const newMemoryInfo = String(item.memory_info || '-');
          if (memoryInfoEl.textContent !== newMemoryInfo) {
