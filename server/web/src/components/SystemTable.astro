      }
      
      // Don't expand/collapse if clicking inside the details section
      if (e.target.closest('.system-details')) {
        return;
      }
      
      // Find the clicked row - only trigger on the main row, not details section
      const rowElement = e.target.closest('[data-system-id]');
      if (!rowElement) return;
      
      // Make sure we're not clicking inside the details section
      const systemRow = rowElement.closest('.system-row');
      if (!systemRow) return;
      
      // Check if click is inside details section
      const detailsSection = systemRow.querySelector('.system-details');
      if (detailsSection && detailsSection.contains(e.target)) {
        return;
      }
      
      const systemId = rowElement.dataset.systemId;
      
      if (detailsSection) {
        // Toggle visibility with animation
        const isExpanding = detailsSection.classList.contains('hidden');
        // With reduced motion the section neither slides nor waits for a
        // slide (see the CSS at the end): it is shown and hidden at once.
        const reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        
        if (isExpanding) {
          ensureDetails(systemRow);
          // Each opening starts on 延迟: closing released the 资源 charts (and
          // the tab chosen then stayed chosen, over empty cards)
          const chartCard = detailsSection.querySelector('[data-tcping-chart-container]');
          if (chartCard && chartCard.querySelector('[data-chart-tab]')) selectChartPane(chartCard, 'latency');
          const resourceOnly = detailsSection.querySelector('[data-resource-only]');
          if (resourceOnly) requestAnimationFrame(() => openResourcePane(resourceOnly, systemId));
          // (a row whose TCPing card the admin hid has no history to show)
          if (detailsSection.dataset.tcping === '1') prefetchTCPingHistory(systemId);
          // IMPORTANT: Close all other expanded sections first to prevent CPU overload
          // Only keep one section expanded at a time
          const allExpandedSections = container.querySelectorAll('.system-details:not(.hidden)');
          allExpandedSections.forEach(section => {
            // A section that is already closing has its own timer; a second
            // one would hide it again later even if it is reopened meanwhile.
            if (section._closeTimer) return;
            // Skip the current section we're about to expand
            const sectionSystemRow = section.closest('.system-row');
            if (sectionSystemRow && sectionSystemRow.querySelector('[data-system-id]') !== rowElement) {
              // Get the system ID for cleanup
              const otherRowElement = sectionSystemRow.querySelector('[data-system-id]');
              const otherSystemId = otherRowElement ? otherRowElement.dataset.systemId : null;
              
              // Collapse this section
              sectionSystemRow.classList.add('is-closing');
              section.style.maxHeight = section.scrollHeight + 'px';
              detailsFade(section, '1');
              section.offsetHeight; // Trigger reflow
              
              detailsFade(section, '0', DETAILS_CLOSE);
              section.style.maxHeight = '0';
              
              section._closeTimer = setTimeout(() => {
                section._closeTimer = null;
                section.classList.add('hidden');
                section.style.maxHeight = '';
                detailsFadeClear(section);
                sectionSystemRow.classList.remove('is-closing');
                // Tear the chart down only once the section is hidden:
                // destroying it at click time blanked the chart while the
                // close animation was still showing it.
                if (otherSystemId) {
                  cleanupTCPingChart(otherSystemId);
                }
              }, reducedMotion ? 0 : 250);
              
              // Update aria-expanded attribute
              if (otherRowElement) {
                otherRowElement.setAttribute('aria-expanded', 'false');
              }
            }
          });
          
          // Expanding - show and animate in. A close still pending for this
          // section (scheduled before it was hidden) must not hide it again.
          if (detailsSection._closeTimer) {
            clearTimeout(detailsSection._closeTimer);
            detailsSection._closeTimer = null;
          }
          systemRow.classList.remove('is-closing');
          detailsSection.classList.remove('hidden');
          detailsSection.style.maxHeight = '0';
          detailsFade(detailsSection, '0');
          
          // Trigger reflow
          detailsSection.offsetHeight;
          // Same layout pass: a chart created while the section is sliding
          // open (0.3 s, see the transition below) takes this box size
          // instead of measuring it mid-slide, see _updateTCPingChartImpl.
          const tcpingCanvas = detailsSection.querySelector('[data-tcping-chart]');
          if (tcpingCanvas && tcpingCanvas.parentElement) {
            tcpingCanvas._presize = tcpingCanvas.parentElement.getBoundingClientRect();
          }
          detailsSection._slideEndsAt = performance.now() + (reducedMotion ? 0 : 320);
          
          // Initialize TCPing tabs and start animation in parallel for better UX
          // Start tabs initialization (don't wait)
          const tabsPromise = initializeTCPingTabs(systemId);
          
          // Start animation immediately to avoid perceived lag
          detailsFade(detailsSection, '1', DETAILS_OPEN);
          // Use a reasonable estimated height, it will adjust as content loads
          detailsSection.style.maxHeight = '800px'; // Temporary max height
          
          // Wait for tabs to finish loading, then adjust to actual height
          tabsPromise.then(() => {
            // Give DOM a moment to update
            requestAnimationFrame(() => {
              // closed again meanwhile: the close animation owns the section
              if (detailsSection._closeTimer || detailsSection.classList.contains('hidden')) return;
              // Update to actual scroll height
              detailsSection.style.maxHeight = detailsSection.scrollHeight + 'px';
              
              // Clean up after animation completes
              setTimeout(() => {
                if (detailsSection._closeTimer || detailsSection.classList.contains('hidden')) return;
                detailsSection.style.maxHeight = '';
                detailsFadeClear(detailsSection);
              }, 300);
            });
          });
          
          // Initialize tcping chart in the same frame the row starts
          // expanding. Using requestAnimationFrame instead of setTimeout(50)
          // means the chart fetch begins ~50 ms earlier on average — which
          // is visible on slow networks where the round-trip dominates.
          // The next-frame deferral is kept so the expand animation gets
          // its first paint before we kick off any heavy work.
          requestAnimationFrame(() => initializeTCPingChart(systemId));
          // (ensureDetails translated the panel when it was built, and a
          // language switch translates every panel, open or not: the
          // page-wide pass that ran here cost 47-81 ms at 4x CPU on each
          // opening, at the start of the open animation)
          
          rowElement.setAttribute('aria-expanded', 'true');
        } else {
          // Collapsing - animate out then hide. The chart is torn down
          // after the animation (below), not before it: destroying it at
          // click time blanked the chart while the section was still
          // visibly closing.
          systemRow.classList.add('is-closing');
          detailsSection.style.maxHeight = detailsSection.scrollHeight + 'px';
          detailsFade(detailsSection, '1');
          
          // Trigger reflow
          detailsSection.offsetHeight;
          
          // Animate to zero
          detailsFade(detailsSection, '0', DETAILS_CLOSE);
          detailsSection.style.maxHeight = '0';
          
          // Hide after animation, then release the chart
          if (detailsSection._closeTimer) clearTimeout(detailsSection._closeTimer);
          detailsSection._closeTimer = setTimeout(() => {
            detailsSection._closeTimer = null;
            detailsSection.classList.add('hidden');
            detailsSection.style.maxHeight = '';
            detailsFadeClear(detailsSection);
            systemRow.classList.remove('is-closing');
            cleanupTCPingChart(systemId);
          }, reducedMotion ? 0 : 250);
          
          rowElement.setAttribute('aria-expanded', 'false');
        }
      }
    };
    
    // How the details open and close. In the table (not the glass theme) they
    // slide on their ground, the opened row's colour, from the first frame to
    // the last, and only what they hold fades: the row and its details stay
    // one piece (.is-closing keeps the row's colour, and no rule, until the
    // details are gone). Cards and the glass theme fade the whole panel, a
    // box of its own.
    const DETAILS_OPEN = { height: 'max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1)', fade: 'opacity 0.25s ease-out' };
    const DETAILS_CLOSE = { height: 'max-height 0.25s cubic-bezier(0.4, 0, 0.2, 1)', fade: 'opacity 0.2s ease-in' };
    const fadesWhole = () => document.getElementById('monitor-root')?.classList.contains('layout-grid')
      || document.documentElement.classList.contains('glass-enabled');
    function detailsFade(section, opacity, timing = null) {
      const whole = fadesWhole();
      section.style.transition = timing ? (whole ? `${timing.height}, ${timing.fade}` : timing.height) : '';
      section.style.opacity = whole ? opacity : '';
      [...section.children].forEach((el) => {
        el.style.transition = timing && !whole ? timing.fade : '';
        el.style.opacity = whole ? '' : opacity;
      });
    }
    function detailsFadeClear(section) {
      section.style.opacity = '';
      section.style.transition = '';
      [...section.children].forEach((el) => { el.style.opacity = ''; el.style.transition = ''; });
    }

    // Start a collapsed row's history request before it is opened: when the
    // mouse is pressed on it, or once the mouse has rested on it for a
    // moment. A pointer that only passes over rows requests nothing, and
    // neither does a finger (it may be starting to scroll).
    const TCPING_HOVER_PREFETCH_MS = 150;
    let hoverPrefetchTimer = 0;
    let hoverPrefetchRow = null;
    const collapsedRowId = (target) => {
      if (listView === 'latency') return null;
      if (!target || !target.closest || target.closest('button') || target.closest('.system-details')) return null;
      const rowElement = target.closest('[data-system-id]');
      const systemRow = rowElement && rowElement.closest('.system-row');
      const details = systemRow && systemRow.querySelector('.system-details');
      return details && details.classList.contains('hidden')
        && details.dataset.tcping === '1' ? rowElement.dataset.systemId : null;
    };
    container.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      const id = collapsedRowId(e.target);
      if (id) prefetchTCPingHistory(id);
    }, { passive: true });
    container.addEventListener('pointerover', (e) => {
      if (e.pointerType !== 'mouse') return;
      const rowElement = e.target.closest && e.target.closest('[data-system-id]');
      if (rowElement === hoverPrefetchRow) return;
      clearTimeout(hoverPrefetchTimer);
      hoverPrefetchRow = rowElement;
      const target = e.target;
      if (!collapsedRowId(target)) return;
      // Checked again when it fires: the row may have been opened meanwhile.
      hoverPrefetchTimer = setTimeout(() => {
        const id = collapsedRowId(target);
        if (id) prefetchTCPingHistory(id);
      }, TCPING_HOVER_PREFETCH_MS);
    }, { passive: true });
    container.addEventListener('pointerleave', () => {
      clearTimeout(hoverPrefetchTimer);
      hoverPrefetchRow = null;
    }, { passive: true });

    // Use a simple approach: handle both touchstart and click, but prevent double-trigger
    let lastTouchTime = 0;
    let lastTouchTarget = null;
    
    // Track touch state to distinguish between tap and scroll
    let touchStartX = 0;
    let touchStartY = 0;
    let touchMoved = false;
    let touchTarget = null;
    let touchRowElement = null;
    
    // Handle touch events directly for mobile - distinguish between tap and scroll
    container.addEventListener('touchstart', (e) => {
      const touch = e.touches[0];
      if (!touch) return;
      
      // Reset touch state
      touchStartX = touch.clientX;
      touchStartY = touch.clientY;
      touchMoved = false;
      
      const target = document.elementFromPoint(touch.clientX, touch.clientY);
      if (!target) return;
      
      touchTarget = target;
      
      // Check if this is a row element
      const rowElement = target.closest('[data-system-id]');
      if (!rowElement) return;
      
      touchRowElement = rowElement;
      
      // Don't trigger if clicking on buttons
      if (target.closest('.copy-btn') || target.closest('button')) {
        touchTarget = null;
        touchRowElement = null;
        return;
      }
    }, { passive: true });
    
    // Detect if user is scrolling (not tapping)
    container.addEventListener('touchmove', (e) => {
      if (!touchTarget || !touchRowElement) return;
      
      const touch = e.touches[0];
      if (!touch) return;
      
      // Calculate movement distance
      const deltaX = Math.abs(touch.clientX - touchStartX);
      const deltaY = Math.abs(touch.clientY - touchStartY);
      
      // If moved more than 10px in any direction, consider it a scroll
      if (deltaX > 10 || deltaY > 10) {
        touchMoved = true;
        touchTarget = null;
        touchRowElement = null;
      }
    }, { passive: true });
    
    // Handle tap (only if no scrolling occurred)
    container.addEventListener('touchend', (e) => {
      if (!touchTarget || !touchRowElement || touchMoved) {
        touchTarget = null;
        touchRowElement = null;
        touchMoved = false;
        return;
      }
      
      const rowElement = touchRowElement;
      const target = touchTarget;
      
      // Reset touch state
      touchTarget = null;
      touchRowElement = null;
      touchMoved = false;
      
      // Prevent double-trigger: if we just handled a touch for this target, ignore click
      const now = Date.now();
      if (lastTouchTarget === rowElement && now - lastTouchTime < 500) {
        return;
      }
      
      lastTouchTime = now;
      lastTouchTarget = rowElement;
      
      // Create a synthetic event for handleRowToggle
      const syntheticEvent = {
        target: target,
        currentTarget: container,
        preventDefault: () => {},
        stopPropagation: () => {}
      };
      
      // Use setTimeout to ensure this happens after any potential click event
      setTimeout(() => {
        handleRowToggle(syntheticEvent);
      }, 50);
    }, { passive: true });
    
    // Handle click events (for desktop and as fallback)
    container.addEventListener('click', (e) => {
      // Skip if this was a touch event (prevent double-trigger)
      const now = Date.now();
      if (lastTouchTarget && now - lastTouchTime < 500) {
        const rowElement = e.target.closest('[data-system-id]');
        if (rowElement === lastTouchTarget) {
          lastTouchTime = 0;
          lastTouchTarget = null;
          return;
        }
      }
      
      handleRowToggle(e);
    });

    // Enter opens and closes a focused row, and so does Space when the row
    // was reached by keyboard: after a mouse click or a tap Space still
    // scrolls the page (:focus-visible cannot tell, any key press sets it).
    container.addEventListener('pointerdown', (e) => {
      const rowElement = e.target.closest && e.target.closest('.system-row > [data-system-id]');
      if (rowElement) rowElement._pointerFocus = true;
    });
    container.addEventListener('focusout', (e) => {
      if (e.target._pointerFocus) e.target._pointerFocus = false;
    });
    container.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const rowElement = e.target;
      if (!rowElement.matches || !rowElement.matches('.system-row > [data-system-id]')) return;
      if (e.key === ' ' && rowElement._pointerFocus) return;
      e.preventDefault();
      handleRowToggle({ target: rowElement, currentTarget: container, preventDefault: () => {}, stopPropagation: () => {} });
    });
  };
  
  // The indices of a longest strictly increasing run in seq (patience
  // sorting, O(n log n)): render() keeps those rows where they are.
  function longestIncreasingRun(seq) {
    const tails = [];
    const prev = new Array(seq.length);
    for (let i = 0; i < seq.length; i++) {
      let lo = 0;
      let hi = tails.length;
      while (lo < hi) {
        const mid = (lo + hi) >> 1;
        if (seq[tails[mid]] < seq[i]) lo = mid + 1;
        else hi = mid;
      }
      prev[i] = lo > 0 ? tails[lo - 1] : -1;
      tails[lo] = i;
    }
    const keep = new Set();
    for (let i = tails.length ? tails[tails.length - 1] : -1; i >= 0; i = prev[i]) keep.add(i);
    return keep;
  }

  // Smart render with incremental updates
  const render = async (items) => {
    if (!body) return;
    
    if (!items || items.length === 0) {
      if (loadingIndicator) loadingIndicator.style.display = 'none';
      showEmpty();
      currentData.clear();
      return;
    }
    
    // Check if tcping is configured before rendering
    let tcpingConfigured = false;
    // Whether the config was actually read: a failed read must not take the
    // TCPing panel off every row (see the rebuild check below).
    let tcpingConfigKnown = false;
    try {
      const config = await loadTCPingConfig();
      tcpingConfigKnown = !!config;
      tcpingConfigured = config && config.targets && config.targets.length > 0;
    } catch (err) {
      // Config check failed silently
    }
    
    // Create new data map with normalized items
    const newData = new Map();
    items.forEach(item => {
      const normalized = normalizeItem(item);
      normalized.original = item; // Keep original for rendering
      newData.set(item.id, normalized);
      // Keep the skipped-target index in step with every snapshot that
      // reaches the table — the initial /api/metrics fetch, the legacy
      // signal-only refetch path, and the SSE payloads alike. normalizeItem
      // deliberately does not carry tcping_data (it drives the row-diff, and
      // tcping changes must not by themselves repaint a row), so this reads
      // straight off the raw item.
      noteTCPingSkippedTargets(item);
    });
    
    // Initial render - if no existing data, render everything
    if (currentData.size === 0) {
      // Hide the loading placeholder FIRST, then populate the body in
      // the same synchronous tick. This ordering matters: if we did it
      // the other way around, there would be one paint frame in which
      // both the pulse bars and the real (opacity:0) rows occupy
      // layout, stacking the loading-indicator's 200 px min-height on
      // top of the row heights and causing the rest of the page
      // (footer, surrounding gaps) to briefly shift downward. By
      // hiding the placeholder first the body's natural flow height
      // takes over immediately, and because both operations happen
      // inside one microtask the browser only commits a single layout.
      if (loadingIndicator) loadingIndicator.style.display = 'none';

      body.innerHTML = items.map(item => renderRow(item, tcpingConfigured && item.hide_tcping !== true)).join('');
      currentData = newData;
      applyPagination();

      // The first data replaces the loading preview with one 150 ms fade
      // of the whole list, at the ALREADY-settled column width (locked in
      // STEP 1 of renderDataInternal), so nothing moves: the rows show
      // together, as Beszel's table does, without a cascade.
      //
      // Gated by `staggerAnimationPlayed` so a transient empty payload
      // mid-session does NOT replay the animation: that scenario was
      // visible to the user as the whole list flickering in from the
      // top every few seconds.
      const systemRows = body.querySelectorAll('.system-row');
      if (!staggerAnimationPlayed) {
        staggerAnimationPlayed = true;
        // No fade with reduced motion.
        const calm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!calm) systemRows.forEach((row) => {
          row.style.opacity = '0';
          row.style.animation = 'data-row-in 0.15s ease forwards';
          // Clean up after animation
          setTimeout(() => {
            row.style.opacity = '';
            row.style.animation = '';
          }, 200);
        });
      }

      setupCopyButtons(body);
      setupRowClickHandlers(body);
      openLinkedServer();
      // Icons fill in on their own. Waiting for them here held the click
      // handlers and every later update (renderData stays locked while this
      // runs) until the slowest icon arrived; the largest flags come from
      // api.iconify.design and can take seconds.
      loadOSIcons().catch(() => {});
      loadFlagIcons().catch(() => {});
      // Update translations after DOM is ready
      setTimeout(() => updateTranslations(), 0);
      return;
    }
    
    // Get existing rows - now looking for .system-row instead of [data-system-id]
    const existingRows = body.querySelectorAll('.system-row');
    const existingRowMap = new Map();
    existingRows.forEach(systemRow => {
      const rowElement = systemRow.querySelector('[data-system-id]');
      const id = rowElement?.dataset.systemId;
      if (id) {
        existingRowMap.set(id, rowElement);
      }
    });
    
    // Track which rows need updates
    let hasChanges = false;
    const rowsToUpdate = [];
    const rowsToAdd = [];
    const rowsToRemove = [];
    
    // Check for updates and new items
    items.forEach((item, index) => {
      const normalizedItem = newData.get(item.id);
      const oldItem = currentData.get(item.id);
      const existingRow = existingRowMap.get(item.id);
      
      if (!existingRow) {
        // New row needs to be added
        rowsToAdd.push({ item, index });
        hasChanges = true;
      } else if (oldItem && (oldItem.hide_tcping !== normalizedItem.hide_tcping
        || (tcpingConfigKnown && (existingRow.parentElement?.querySelector(':scope > .system-details')?.dataset.tcping === '1') !== (tcpingConfigured && item.hide_tcping !== true)))) {
        // Admin flipped "show TCPing", or the first TCPing target was added
        // (or the last removed): the panel is part of the row markup, so
        // rebuild the row (remove + add) instead of patching in place.
        rowsToRemove.push(item.id);
        rowsToAdd.push({ item, index });
        hasChanges = true;
      } else if (hasChanged(oldItem, normalizedItem)) {
        // Existing row needs update - use original item for rendering
        rowsToUpdate.push({ row: existingRow, item: item });
        hasChanges = true;
      } else if (oldItem && oldItem.order !== normalizedItem.order) {
        // Order changed, need to reorder
        hasChanges = true;
      }
    });
    
    // Check for removed items
    currentData.forEach((oldItem, id) => {
      if (!newData.has(id)) {
        rowsToRemove.push(id);
        hasChanges = true;
      }
    });
    
    // Check if order changed (for sorting) - check BEFORE early return
    const currentOrder = Array.from(body.children).map(systemRow => {
      const rowElement = systemRow.querySelector('[data-system-id]');
      return rowElement?.dataset.systemId;
    }).filter(Boolean);
    const desiredOrder = items.map(item => item.id);
    const orderChanged = currentOrder.length === desiredOrder.length && 
                         JSON.stringify(currentOrder) !== JSON.stringify(desiredOrder);
    
    // Always update currentData first, before any DOM operations
    // This ensures that updateRow has access to the correct old data
    const previousData = new Map(currentData);
    currentData = newData;
    
    // If no changes AND order hasn't changed, skip update completely
    if (!hasChanges && !orderChanged && existingRows.length === items.length) {
      // Cache already updated above, just return
      return; // Silent skip - no DOM operations
    }
    
    // Remove deleted rows. Tear down all per-system state first so the
    // Chart.js instance (which holds canvas references, dataset arrays,
    // and an active animation handle) becomes eligible for GC. Without
    // this, every system that was ever expanded before its deletion
    // would leave a ghost chart pinned in memory for the lifetime of
    // the page — a slow leak for browsers left open on the dashboard
    // through many admin add/delete cycles.
    rowsToRemove.forEach(id => {
      try { cleanupTCPingChart(id); } catch (_) {}
      tcpingConfigs.delete(id);
      tcpingActiveTargets.delete(id);
      tcpingSkippedTargets.delete(id);
      const rowElement = existingRowMap.get(id);
      if (rowElement) {
        const systemRow = rowElement.closest('.system-row');
        if (systemRow) {
          systemRow.remove();
        } else {
          rowElement.remove();
        }
      }
    });
    
    // Update existing rows (only changed cells) - batch updates
    if (rowsToUpdate.length > 0) {
      rowsToUpdate.forEach(({ row, item }) => {
        // Get previous item data before updating
        const previousItem = previousData.get(item.id);
        updateRow(row, item, previousItem);
      });
      // Only load OS icons if OS changed
      const osChanged = rowsToUpdate.some(({ item }) => {
        const old = currentData.get(item.id);
        return old && old.os_icon !== item.os_icon;
      });
      if (osChanged) {
        setTimeout(() => loadOSIcons(), 0);
      }
      
      // Load flag icons if location changed
      const locationChanged = rowsToUpdate.some(({ item }) => {
        const old = currentData.get(item.id);
        return old && old.location !== item.location;
      });
      if (locationChanged) {
        setTimeout(() => loadFlagIcons(), 0);
      }
    }
    
    // Add new rows
    if (rowsToAdd.length > 0) {
      rowsToAdd.forEach(({ item, index }, addIndex) => {
        // Find insertion point
        let insertBefore = null;
        for (let i = index + 1; i < items.length; i++) {
          const nextId = items[i].id;
          const nextRow = body.querySelector(`[data-system-id="${cssEscape(String(nextId))}"]`);
          if (nextRow) {
            insertBefore = nextRow;
            break;
          }
        }
        
        // Use cached tcping config status or check if needed
        const rowHTML = renderRow(item, tcpingConfigured && item.hide_tcping !== true);
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = rowHTML;
        const systemRowElement = tempDiv.firstElementChild;
        if (systemRowElement) {
          // Add entrance animation for new rows
          systemRowElement.classList.add('animate-scale-in');
          systemRowElement.style.animationDelay = `${addIndex * 50}ms`;
          
          // Find the system-row to insert before
          let insertBeforeSystemRow = null;
          if (insertBefore) {
            insertBeforeSystemRow = insertBefore.closest('.system-row');
          }
          if (insertBeforeSystemRow) {
            body.insertBefore(systemRowElement, insertBeforeSystemRow);
          } else {
            body.appendChild(systemRowElement);
          }
          
          // Clean up animation class after animation completes
          setTimeout(() => {
            systemRowElement.classList.remove('animate-scale-in');
            systemRowElement.style.animationDelay = '';
          }, 300 + addIndex * 50);
        }
      });
      
      setupCopyButtons(body);
      setupRowClickHandlers(body);
      // Icons fill in on their own (see the first render above).
      loadOSIcons().catch(() => {});
      loadFlagIcons().catch(() => {});
      // Update translations after DOM is ready
      setTimeout(() => updateTranslations(), 0);
      // Recalculate column width when new rows are added (names might be longer)
      setTimeout(() => recalculateColumnWidthFromCurrentData(), 0);
    }
    
    // Handle reordering if needed - ALWAYS check order, even if no other changes
    // This ensures sorting works correctly. Compared after the removals and
    // additions: when the number of rows changed too (the status filter, a
    // service added or removed), the rows that stayed kept their old order.
    const finalOrder = Array.from(body.children).map((systemRow) => systemRow.querySelector('[data-system-id]')?.dataset.systemId).filter(Boolean);
    if (JSON.stringify(finalOrder) !== JSON.stringify(desiredOrder)) {
      // Move only the rows out of place: the rows whose present order already
      // agrees with the wanted one (the longest increasing run of their
      // present positions) stay, each other row goes before the row that
      // must follow it. Re-appending every row moved all of them on each
      // live update of a list sorted by CPU, memory or net (style and layout
      // for the whole list every 3 s), and took the focus off a row.
      const rowOf = new Map();
      const position = new Map();
      Array.from(body.children).forEach((systemRow) => {
        const id = systemRow.querySelector('[data-system-id]')?.dataset.systemId;
        if (id) {
          rowOf.set(id, systemRow);
          position.set(systemRow, position.size);
        }
      });
      const wanted = items.map((item) => rowOf.get(item.id)).filter(Boolean);
      const keep = longestIncreasingRun(wanted.map((row) => position.get(row)));
      let next = null;
      for (let i = wanted.length - 1; i >= 0; i--) {
        if (!keep.has(i)) body.insertBefore(wanted[i], next);
        next = wanted[i];
      }
    }
    
    // Cache already updated at the beginning of the function
    
    // Recalculate column width if rows were added or names changed
    if (rowsToAdd.length > 0 || rowsToUpdate.some(({ item }) => {
      const old = previousData.get(item.id);
      return old && old.name !== item.name;
    })) {
      setTimeout(() => recalculateColumnWidthFromCurrentData(), 0);
    }
    // The pages follow the list (rows came, went or moved).
    applyPagination();
  };

  // renderData is the single, self-serialized render path for the table.
  //
  // Any number of callers (initial load, user filter/sort, SSE push, admin
  // mutations, refresh button, …) may invoke it concurrently. To keep DOM
  // updates atomic, renderData guards itself with an in-flight flag and a
  // "latest-wins" pending slot. If a second call arrives while one is still
  // running, its payload is stored in `pendingRenderData`, overwriting any
  // earlier pending payload. When the current render finishes, the loop
  // drains the pending slot and runs one more render with the newest data.
  //
  // This gives three important guarantees:
  //   1. DOM mutations never interleave from two concurrent renders.
  //   2. Rapid bursts of events collapse into at most 2 renders (current +
  //      latest pending), regardless of how many events fired.
  //   3. The freshest state always wins — a later event never gets shadowed
  //      by an earlier one that finishes render later.
  //
  // Because every SSE event we consume carries the FULL authoritative
  // systems list, simply overwriting pendingRenderData is always safe —
  // the newer payload fully supersedes the older one.
  let isRenderRunning = false;
  let pendingRenderData = null;
  /* Freshness guard: the page fetches /api/metrics and then opens the
     stream, and the stream may reconnect at any time; the first payload of
     a (re)connection can be slightly older than what is already on screen.
     Skip a payload strictly older than the current one while it describes
     the same set of systems (a changed set is always applied). */
  // Only the first stream payload after a (re)connection is checked: later
  // payloads come from the broadcast ticker in order, and judging them by
  // updated_at would freeze the table whenever that stamp legitimately goes
  // down (a system marked offline, a server clock step). REST results are
  // never dropped; they only refresh the baseline.
  let paintedFreshness = 0;
  let paintedIdKey = '';
  let primeGuardArmed = false;
  const streamPayloads = new WeakSet();
  function noteSnapshot(list) {
    let max = 0;
    for (const s of list) { const t = s && s.updated_at ? Date.parse(s.updated_at) : 0; if (t > max) max = t; }
    paintedIdKey = list.map((s) => (s && s.id) || '').sort().join('\u0000');
    paintedFreshness = max || paintedFreshness;
  }
  function isStaleSnapshot(list) {
    let max = 0;
    for (const s of list) { const t = s && s.updated_at ? Date.parse(s.updated_at) : 0; if (t > max) max = t; }
    const idKey = list.map((s) => (s && s.id) || '').sort().join('\u0000');
    // Not strictly newer than what is on screen (same systems): skip. An
    // equal stamp is the same data built at another instant and could only
    // flip derived state such as the offline flag.
    if (idKey === paintedIdKey && max && paintedFreshness && max <= paintedFreshness) return true;
    noteSnapshot(list);
    return false;
  }

  // The stream stopped delivering: the table showed the last data as if it
  // were live. A notice joins the summary when no stream message has come
  // for 12 s (the server sends one every 3 s) and goes with the next one.
  function noteStreamMessage() {
    lastStreamMessageAt = Date.now();
    if (connectionLost) {
      connectionLost = false;
      renderSystemsSummary();
    }
  }
  setInterval(() => {
    // (a stream closed on purpose while the page is hidden is not lost)
    const lost = !ssePaused && Date.now() - lastStreamMessageAt > 12_000;
    if (lost !== connectionLost) {
      connectionLost = lost;
      renderSystemsSummary();
    }
  }, 2000);

  // Summary beside the title: "131 台 · 128 在线 · 3 离线", from the same
  // list as the rows (the offline chip only when a server is offline).
  function updateSystemsSummary(list) {
    const awaiting = list.filter(awaitingClient).length;
    systemsSummary = { total: list.length, offline: list.filter((s) => s && s.alert).length - awaiting, awaiting };
    renderSystemsSummary();
  }
  function renderSystemsSummary() {
    const el = document.getElementById('systems-summary');
    if (!el || !systemsSummary) return;
    const lang = getCurrentLanguage();
    const { total, offline, awaiting = 0 } = systemsSummary;
    const chip = 'inline-flex items-center gap-1.5 rounded-full px-2 py-1';
    const quiet = `${chip} bg-black/5 dark:bg-white/[0.06] text-[#595959] dark:text-[#ababab]`;
    const dot = (c) => `<span class="status-dot h-1.5 w-1.5 rounded-full ${c}"></span>`;
    let html = `<span class="${quiet}">${total} ${translations.summaryTotal[lang]}</span>`
      + `<span class="${quiet}">${dot('bg-[#3db866]')}${total - offline - awaiting} ${translations.summaryOnline[lang]}</span>`;
    // The offline count is a button: it shows only the offline servers (the
    // view menu's 离线), and again everything.
    if (offline > 0) {
      const pressed = statusFilter === 'offline';
      html += `<button type="button" id="summary-offline-chip" class="${chip} summary-offline-chip bg-red-500/10 dark:bg-red-400/15 text-red-700 dark:text-red-300" aria-pressed="${pressed}" data-tooltip="${translations[pressed ? 'summaryShowAll' : 'summaryShowOffline'][lang]}">${dot('bg-[#fb2c36]')}${offline} ${translations.summaryOffline[lang]}</button>`;
    }
    if (awaiting > 0) {
      html += `<span class="${quiet}">${dot('bg-[#a3a3a3]')}${awaiting} ${translations.summaryAwaiting[lang]}</span>`;
    }
    if (connectionLost) {
      html += `<span class="${chip} summary-conn-lost bg-black/5 dark:bg-white/[0.06] text-[#595959] dark:text-[#ababab]" role="status">${dot('bg-[#a3a3a3]')}${translations.connectionLost[lang]}</span>`;
    }
    // phones say it on the line under the title instead (global.css)
    document.documentElement.classList.toggle('stream-lost', !!connectionLost);
    if (el.innerHTML !== html) {
      // A redraw replaces the offline button: keep the keyboard on it.
      const hadFocus = document.activeElement && document.activeElement.id === 'summary-offline-chip';
      el.innerHTML = html;
      if (hadFocus) document.getElementById('summary-offline-chip')?.focus({ preventScroll: true });
    }
    el.classList.remove('invisible');
    el.classList.toggle('hidden', total === 0);
    updateStatusCounts();
  }

  async function renderData(data) {
    if (!Array.isArray(data)) return;
    if (streamPayloads.has(data) && primeGuardArmed) {
      primeGuardArmed = false;
      if (isStaleSnapshot(data)) return;
    } else {
      noteSnapshot(data);
    }

    if (isRenderRunning) {
      // Latest-wins: drop any earlier pending payload in favour of this one.
      pendingRenderData = data;
      return;
    }

    isRenderRunning = true;
    try {
      let current = data;
      // Drain pending slot before returning — if new renders are requested
      // while the current one is in progress, we serve the newest one next
      // before releasing the lock.
      while (current) {
        try {
          await renderDataInternal(current);
        } catch (err) {
          if (loadingIndicator) {
            loadingIndicator.innerHTML = `
              <div class="text-center">
                <p class="text-sm text-red-500 dark:text-red-400">Failed to render data</p>
                <p class="text-xs text-[#595959] dark:text-[#ababab] mt-1">${escapeHtml(err.message)}</p>
              </div>
            `;
          }
        }
        current = pendingRenderData;
        pendingRenderData = null;
        // A payload taken from the pending slot is painted here without
        // having gone through the freshness bookkeeping at the top of
        // renderData, so paintedFreshness would lag what is actually on
        // screen and a later, older frame could be treated as new. Record
        // it before painting; noteSnapshot only ever moves the watermark
        // forward, so this is safe for REST payloads too.
        if (current) noteSnapshot(current);
      }
    } finally {
      isRenderRunning = false;
    }
  }

  // Latch set the first time we actually render ANY data (either from an
  // SSE push or a fallback loadData fetch). Used by the initial-load watcher
  // below to decide whether to fall back to a one-shot GET.
  let initialDataRendered = false;

  // The last payload painted, unfiltered. Filtering and sorting re-render
  // it: the stream keeps it current, and each keystroke in the filter box
  // used to download the whole list again.
  let lastRenderedPayload = null;
  function rerenderForView() {
    // A filter, a sort or a status: from the first page (as Beszel), at once
    // (a filter that keeps every row leaves the render nothing to redraw).
    pageIndex = 0;
    pageAnchor = 0;
    applyPagination();
    // A copy: the stream's own payload object would be taken for a stale
    // stream frame right after a reconnect, and not repainted.
    if (lastRenderedPayload) renderData(lastRenderedPayload.slice());
    else loadData();
  }

  // Internal render implementation — assumed to be called serially from
  // renderData() only. Never call this directly.
  // While the list loads, the header row waits invisible in its place (the
  // list below it doesn't move when it shows) and so does the page footer
  // (the rows would push it down the screen): both show with the first
  // answer, data, an empty list or an error. Nothing moves on the way in.
  function revealTableFrame(headerRow) {
    headerRow.style.visibility = 'visible';
    void headerRow.offsetHeight;
    headerRow.style.opacity = '1';
    document.documentElement.classList.add('pulse-list-ready');
  }
  // In case no answer ever comes, the footer shows anyway.
  setTimeout(() => document.documentElement.classList.add('pulse-list-ready'), 5000);

  async function renderDataInternal(data) {
    initialDataRendered = true;
    lastRenderedPayload = data;
    // Admin per-system toggle: `hide_on_home` systems stay in the API and
    // the admin page but never reach the public table.
    data = data.filter((sys) => !(sys && sys.hide_on_home === true));
    updateSystemsSummary(data);
    if (data.length === 0) {
      showEmpty();
      // Show the header (it waits invisible in its place during the
      // pulse phase — see STEP 2 below for the full rationale). Even
      // though there are no rows to measure, we still want the header
      // visible so the empty-state message is framed by the proper
      // column labels. The default 160 px --first-col-width is
      // appropriate here because no row ever forces it wider.
      const headerRow = document.getElementById('system-table-header-row');
      if (headerRow) {
        revealTableFrame(headerRow);
      }
      return;
    }

    // The names are measured in Inter: on the first render wait for it (it
    // is preloaded, so this is normally over at once; at most 0.8 s).
    if (currentData.size === 0 && document.fonts && document.fonts.load) {
      await Promise.race([
        document.fonts.load('500 14px InterVariable').catch(() => {}),
        new Promise((resolve) => setTimeout(resolve, 800)),
      ]);
    }

    // STEP 1 — Lock the column width BEFORE any pixels are painted that
    // depend on it. calculateServerNameColumnWidth measures every name
    // via an off-screen span, so the resulting --first-col-width is the
    // final value; it will only grow from here if/when a longer name
    // registers in a later SSE frame (which is a steady-state update,
    // not an initial-load concern). applyServerNameColumnWidth ends
    // with a forced reflow, so by the time this line returns the CSS
    // variable has been committed to the computed style tree.
    const preCalculatedWidth = calculateServerNameColumnWidth(data);
    applyServerNameColumnWidth(preCalculatedWidth);

    // STEP 2 — On the very first render, show the header.
    //
    // The header row ships with inline `visibility: hidden; opacity: 0`:
    // it keeps its place during the pulse phase (so the list below it
    // never moves when it shows) but the user never sees it at the wrong
    // (default 160 px) column width. STEP 1 above has already measured
    // every server name and committed the correct `--first-col-width` to
    // the style tree via a forced reflow, so the moment the header turns
    // visible its columns are drawn at their final, data-driven widths.
    // A second forced reflow makes sure that switch is committed BEFORE
    // we touch opacity, otherwise the browser is free to batch the two
    // style changes and skip the opacity transition entirely (rendering
    // the header as an abrupt pop-in). The sequence the user sees is:
    // pulse rows breathing → pulse vanishes → the table header fades in
    // at its correct width → rows fade in underneath at the same,
    // settled column positions; the footer shows with them.
    if (currentData.size === 0) {
      const headerRow = document.getElementById('system-table-header-row');
      if (headerRow) {
        revealTableFrame(headerRow);
      }

      // STEP 3 — Wait one paint frame before handing off to render().
      //
      // STEP 1 already forced a synchronous reflow, so the width is
      // authoritative in the style tree. But the *paint* of that new
      // width (i.e. the pixels the user actually sees) happens on the
      // next frame. By yielding one rAF here we guarantee that the
      // fresh column width has been rasterised to the screen before the
      // row-level `data-row-in` keyframe starts. The net effect for the
      // user is: nothing moves during the row fade-up — rows simply
      // materialise at their final, correct column positions.
      //
      // Cost: ~16 ms on a 60 Hz display. That is well below the
      // perception threshold and does not lengthen the feel of the load
      // (the pulsing placeholder bars in LoadingState keep filling the
      // space during this frame).
      await new Promise(resolve => requestAnimationFrame(() => resolve()));
    }

    // Apply filter first, then sorting
    const filteredData = filterSystems(data);
    const sortedData = sortSystems(filteredData);
    await render(sortedData);
    syncLatencyView();
  }

  // loadData is kept as the entry point for the cases where the browser
  // legitimately needs to fetch state on its own:
  //   * initial page load (before any SSE event has arrived)
  //   * user actions (filter / sort / refresh button / legacy signal events)
  //
  // The real-time realtime path (every 3 s, plus admin mutations) is the
  // SSE `metric_updated` event which embeds the systems array directly and
  // calls renderData() without any fetch.
  async function loadData() {
    try {
      const data = await fetchSystemMetrics(apiBase);
      await renderData(data);
      window.dispatchEvent(new Event('pulse:data'));
    } catch (err) {
      if (loadingIndicator) {
        // The empty state's form (icon, title, hint) in the page language:
        // what happened and that the page keeps trying (the live stream
        // reconnects, and its first answer replaces this). Red only on the
        // icon; the reason (HTTP 502, …) in brackets.
        const lang = getCurrentLanguage();
        const reason = err && err.message ? ` <span data-load-error-reason>(${escapeHtml(err.message)})</span>` : '';
        loadingIndicator.innerHTML = `
          <div class="flex flex-col items-center justify-center py-12 text-center">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-3 text-[#dc2626] dark:text-[#f87171]" aria-hidden="true"><path d="m2 2 20 20"/><path d="M5.782 5.782A7 7 0 0 0 9 19h8.5a4.5 4.5 0 0 0 1.307-.193"/><path d="M21.532 16.5A4.5 4.5 0 0 0 17 10h-1.79A7.008 7.008 0 0 0 10 5.07"/></svg>
            <p class="text-sm font-medium text-[#1d1d20] dark:text-[#f5f5f5]" data-translate-detail="loadFailed">${translations.loadFailed[lang]}</p>
            <p class="mt-1 text-xs text-[#595959] dark:text-[#ababab]"><span data-translate-detail="loadRetrying">${translations.loadRetrying[lang]}</span>${reason}</p>
          </div>
        `;
      }
      // Materialise the header at the default 160 px --first-col-width
      // so the error message has the proper column frame around it.
      // The same reveal as the happy-path STEP 2, so the failure UI
      // fades in with the same curve as success.
      const headerRow = document.getElementById('system-table-header-row');
      if (headerRow) {
        revealTableFrame(headerRow);
      }
    }
  }

  // debouncedRenderData collapses rapid-fire SSE events into a single render
  // with an 80 ms window. This is primarily a CPU optimisation — renderData
  // is already self-serialising, but we avoid scheduling 10 microtasks in a
  // row when several SSE frames arrive back-to-back.
  let renderTimeout = null;
  const debouncedRenderData = (data) => {
    // Pre-populate the latest-wins slot so the next renderData call — which
    // may be the one we schedule below, or one triggered by a user action —
    // always picks up this payload.
    pendingRenderData = data;
    if (renderTimeout) return;
    renderTimeout = setTimeout(() => {
      renderTimeout = null;
      const d = pendingRenderData;
      pendingRenderData = null;
      if (d) renderData(d);
    }, 80);
  };

  // Legacy fallback: older signal-only events (e.g. order_updated) still fall
  // back to a fetch + render. This is only used for events that do NOT carry
  // the systems array; the common metric_updated path never hits here.
  let loadDataTimeout = null;
  let isLoadDataRunning = false;
  const debouncedLoadData = () => {
    if (isLoadDataRunning) return;
    if (loadDataTimeout) {
      clearTimeout(loadDataTimeout);
    }
    loadDataTimeout = setTimeout(async () => {
      if (isLoadDataRunning) {
        loadDataTimeout = null;
        return;
      }
      isLoadDataRunning = true;
      try {
        await loadData();
      } finally {
        isLoadDataRunning = false;
        loadDataTimeout = null;
      }
    }, 200);
  };

  // Connect to SSE for real-time updates
  //
  // Reliability strategy:
  //   * Exponential backoff with jitter on reconnect, to avoid a thundering
  //     herd when the backend restarts and many browser tabs reconnect at once.
  //   * A liveness watchdog that forces a reconnect if we haven't seen any
  //     SSE traffic in 45 s. The server sends either an update (every ~3 s)
  //     or a keepalive ping (every 15 s), so 45 s of silence is a strong
  //     signal that the TCP stream is half-open (mobile network switch,
  //     NAT idle timeout, etc.) and needs to be re-established proactively —
  //     EventSource alone can take several minutes to notice.
  let sseReconnectAttempt = 0;
  let sseWatchdogTimer = null;
  // Handle for the queued reconnect, tracked in the same style as the
  // watchdog timer above so it can be coalesced and cancelled.
  let sseReconnectTimer = null;
  const SSE_WATCHDOG_MS = 45_000;

  let lastSSEActivityAt = Date.now();
  function markSSEAlive() {
    lastSSEActivityAt = Date.now();
    if (sseWatchdogTimer) {
      clearTimeout(sseWatchdogTimer);
    }
    sseWatchdogTimer = setTimeout(() => {
      // No update for SSE_WATCHDOG_MS (they come every 3 s; the server's
      // keepalive comments fire no event) — force a reconnect through the
      // error path's backoff, and read the data once meanwhile: a stream a
      // proxy holds open without passing anything left the table frozen.
      if (eventSource) {
        try { eventSource.close(); } catch (_) {}
        eventSource = null;
      }
      checkAccessAfterStreamError();
      scheduleSSEReconnect();
    }, SSE_WATCHDOG_MS);
  }

  function scheduleSSEReconnect() {
    // Coalesce: if a reconnect is already queued, do not stack another.
    // A flaky network fires `onerror` in bursts, and one timer per error
    // would have several `connectSSE()` calls land at once, each opening
    // an EventSource and claiming a subscriber slot on the server.
    if (sseReconnectTimer || ssePaused) return;
    // Exponential backoff: 1s, 2s, 4s, 8s, 16s, capped at 30s, + up to 1s jitter.
    const base = Math.min(30_000, 1000 * Math.pow(2, sseReconnectAttempt));
    const jitter = Math.floor(Math.random() * 1000);
    const delay = base + jitter;
    sseReconnectAttempt++;
    sseReconnectTimer = setTimeout(() => {
      sseReconnectTimer = null;
      connectSSE();
    }, delay);
  }

  function connectSSE() {
    // Not while the page is hidden with its stream paused; once it shows
    // again, every way back here (visibility, the bfcache, the network)
    // reopens the stream.
    if (ssePaused && document.hidden) return;
    ssePaused = false;
    // Close existing connection and remove all event listeners
    if (eventSource) {
      eventSource.close();
      eventSource = null;
    }
    if (sseWatchdogTimer) {
      clearTimeout(sseWatchdogTimer);
      sseWatchdogTimer = null;
    }
    // Connecting now satisfies any queued reconnect (e.g. the pageshow
    // handler below reconnecting ahead of the backoff timer).
    if (sseReconnectTimer) {
      clearTimeout(sseReconnectTimer);
      sseReconnectTimer = null;
    }

    // Share link token (it is in the page's own URL anyway), or the admin
    // session when privacy mode needs it (see sessionNeeded). EventSource
    // cannot send headers, so the session is traded for a single-use ticket
    // first: the session itself in the URL (?admin_token=) went into the logs
    // of every proxy and CDN on the way, where it was good for a day.
    const { shareToken, adminToken } = getAuthInfo();
    const gen = ++sseConnectGen;
    if (shareToken) {
      openSSE(`${apiBase}/api/events?token=${encodeURIComponent(shareToken)}`);
    } else if (adminToken) {
      fetchStreamTicket(adminToken).then((ticket) => {
        if (gen !== sseConnectGen || (ssePaused && document.hidden)) return;
        openSSE(`${apiBase}/api/events?ticket=${encodeURIComponent(ticket)}`);
      }, () => {
        // The network or the session failed: the stream's backoff applies,
        // and a plain request tells which. A refused ticket is an ended
        // session (a server restart ends every one): that request is refused
        // too and goes to the login, as the stream's own refusal did before
        // tickets (no stream opened, so nothing else ever checked).
        if (gen !== sseConnectGen) return;
        scheduleSSEReconnect();
        checkAccessAfterStreamError();
      });
    } else {
      openSSE(`${apiBase}/api/events`);
    }
  }

  let sseConnectGen = 0;
  async function fetchStreamTicket(token) {
    const ctl = new AbortController();
    const timer = setTimeout(() => ctl.abort(), 10_000);
    try {
      const res = await fetch(`${apiBase}/api/auth/stream-ticket`, { method: 'POST', headers: { 'Authorization': `Bearer ${token}` }, cache: 'no-store', signal: ctl.signal });
      if (!res.ok) { const e = new Error(`HTTP ${res.status}`); e.status = res.status; throw e; }
      const data = await res.json();
      if (!data || typeof data.ticket !== 'string' || !data.ticket) throw new Error('no ticket');
      return data.ticket;
    } finally {
      clearTimeout(timer);
    }
  }

  let sseStreamOpenedAt = 0;
  let sseUpdatesOnStream = 0;
  function openSSE(sseUrl) {
    sseStreamOpenedAt = Date.now();
    sseUpdatesOnStream = 0;
    primeGuardArmed = true;
    eventSource = new EventSource(sseUrl);
    markSSEAlive();

    // 'connected' only says the request was answered: the backoff and the
    // connection notice wait for data (updateHandler). A stream that a proxy
    // cut right after it opened reconnected about once a second, forever,
    // without a notice, while it was reset here.
    eventSource.addEventListener('connected', (e) => {
      markSSEAlive();
    });

    // onmessage fires for untyped messages (the server's keepalive is an SSE
    // comment, which fires no event); it only resets the watchdog. Typed
    // events have their own listeners below.
    eventSource.onmessage = () => {
      markSSEAlive();
      noteStreamMessage();
    };

    // Store the handler function so we can remove it if needed.
    //
    // Backend-push model:
    //   * metric_updated events now embed the full systems list in
    //     `update.systems`. When present, the browser renders directly from
    //     that data and does NOT issue GET /api/metrics. This eliminates the
    //     redundant fetch round-trip and makes the server the single source
    //     of truth for what each tab displays.
    //   * metric_deleted / order_updated remain signal-only events. They
    //     don't carry data on the wire, so we keep the legacy fallback of
    //     fetching once before rendering for those two. (Newer server
    //     versions also emit a full-data metric_updated right after the
    //     signal, which will arrive within a few ms and supersede the
    //     fetched result.)
    const updateHandler = (e) => {
      // data: the stream works, the next disconnect starts over at 1 s, once
      // this connection has carried a second update or lasted 10 s (a stream
      // cut right after its first snapshot reconnected every 1–2 s, forever)
      sseUpdatesOnStream++;
      if (sseUpdatesOnStream >= 2 || Date.now() - sseStreamOpenedAt >= 10_000) sseReconnectAttempt = 0;
      markSSEAlive();
      noteStreamMessage();
      try {
        const update = JSON.parse(e.data);

        if (update.type === 'metric_updated') {
          if (Array.isArray(update.systems)) {
            // Backend-pushed full state — render directly, no GET.
            streamPayloads.add(update.systems);
            debouncedRenderData(update.systems);
            // Fresh data: the navbar logo beats (NavBar).
            window.dispatchEvent(new Event('pulse:data'));
          } else {
            // Legacy signal-only event from an older server — fall back.
            debouncedLoadData();
          }
        } else if (update.type === 'order_updated' || update.type === 'metric_deleted') {
          // Signal-only events → fetch once to converge. (On newer servers
          // the following metric_updated will land within milliseconds and
          // refresh again with embedded data; that's harmless.)
          debouncedLoadData();
        } else if (update.type === 'tcping_config_updated') {
          // Admin changed the tcping config (added/removed/renamed a
          // target). Our cachedTCPingConfig is now stale, and any
          // currently-expanded chart is drawing a target set that no
          // longer matches reality. Drop the cache, re-fetch the fresh
          // config, and redraw tabs + chart for every expanded row so
          // deleted targets disappear immediately (no "ghost first
          // point" left over) and newly added targets show up without
          // a page reload.
          handleTCPingConfigUpdated();
          return;
        } else {
          return; // unknown event type — ignore
        }

        // Refresh tcping charts for visible expanded rows, but ONLY when the
        // underlying tcping_data has actually changed.
        //
        // Why this matters: metric_updated events are broadcast every 3 s
        // (the service uptime / CPU / RAM cadence), while tcping latency is
        // sampled at the admin-configured interval (default 60 s, can be
        // 10 s / 30 s / etc.). Calling updateTCPingChart on EVERY 3 s frame
        // would cause the chart to re-fetch history and redraw 3–20× more
        // often than there is actual new data, producing visible flicker
        // and wasted HTTP traffic. Instead we hash the tcping_data
        // timestamps of each expanded system and only refresh when that
        // signature changes — giving us "exactly as often as there is new
        // tcping data", which IS the admin-configured interval.
        // If a tcping_config_updated just landed, handleTCPingConfigUpdated
        // is already tearing down and rebuilding every expanded chart.
        // Racing a second redraw from this branch would double-fetch the
        // history and risk creating two Chart.js instances on the same
        // canvas, so defer to the in-flight rebuild.
        if (tcpingConfigUpdatePending) {
          return;
        }
        const expandedSections = document.querySelectorAll('.system-details:not(.hidden)');
        if (expandedSections.length > 0) {
          // Build a quick lookup only when we actually need it.
          const systemsById = (update && Array.isArray(update.systems))
            ? new Map(update.systems.map(s => [s.id, s]))
            : null;
          expandedSections.forEach(detailsSection => {
            const systemId = detailsSection.dataset.detailsId;
            if (!systemId) return;

            const loadingState = tcpingLoadingStates.get(systemId);
            if (loadingState && loadingState.loading) return;

            const systemData = systemsById ? systemsById.get(systemId) : null;
            if (!systemData) {
              // Legacy signal-only event (no systems array) — fall back to a
              // single refresh so user edits propagate at least once.
              updateTCPingChart(systemId, null, null, true);
              return;
            }

            // Refresh the skipped-target index BEFORE the signature compare
            // and the redraw. debouncedRenderData() also does this, but on an
            // 80 ms timer, so at this point currentData can still hold the
            // previous snapshot — and updateTCPingChart below reads the index
            // to decide between the chart and the "unreachable" notice. Doing
            // it here makes a skipped↔measured flip visible on the very tick
            // that carried it.
            noteTCPingSkippedTargets(systemData);

            const newSig = computeTCPingSignature(systemData);
            const oldSig = tcpingDataSignatures.get(systemId) || '';
            // No target has a new answered probe: nothing fresh, except that
            // a lost probe changes no "latest" (the server keeps the last
            // answered one there). So the tail is read at least once per
            // probe interval as well: a stretch where every probe failed left
            // the open chart (its gaps, the loss band, the averages) as it was
            // until the first answer. One small since= read per probe
            // interval (5 s after it, 20 s at the shortest), and only then.
            const cfg = tcpingConfigs.get(systemId);
            const every = (Math.max(15, (cfg && Number(cfg.interval_secs)) || 60) + 5) * 1000;
            if (newSig === oldSig && Date.now() - (tcpingLastReadAt.get(systemId) || 0) < every) return;
            tcpingDataSignatures.set(systemId, newSig);
            tcpingLastReadAt.set(systemId, Date.now());
            updateTCPingChart(systemId, null, null, true);
          });
        }
      } catch (err) {
        // SSE parse error silently
      }
    };
    
    eventSource.addEventListener('update', updateHandler);

    eventSource.onerror = (err) => {
      if (eventSource) {
        eventSource.close();
        eventSource = null;
      }
      if (sseWatchdogTimer) {
        clearTimeout(sseWatchdogTimer);
        sseWatchdogTimer = null;
      }
      scheduleSSEReconnect();
      checkAccessAfterStreamError();
    };
  }

  // EventSource reports a refused stream (401: the session or share link has
  // ended, or privacy mode needs the session) only as an error, and used to
  // retry forever behind a table that no longer changed. A plain request
  // tells: fetchSystemMetrics sends a refusal to the login page, switches the
  // session on when privacy mode asks for it, and otherwise repaints.
  let lastStreamAccessCheck = 0;
  function checkAccessAfterStreamError() {
    const now = Date.now();
    if (now - lastStreamAccessCheck < 15_000) return;
    lastStreamAccessCheck = now;
    const hadSession = sessionNeeded;
    loadData().then(() => {
      // The stream needs the session now: reconnect with it at once rather
      // than after the backoff.
      if (!hadSession && sessionNeeded && sseReconnectTimer) {
        clearTimeout(sseReconnectTimer);
        sseReconnectTimer = null;
        connectSSE();
      }
    });
  }

  // Setup filter input handler - prevent duplicate event listeners
  let filterInputHandlersSetup = false;
  function setupFilterInput() {
    const filterInput = document.getElementById('system-filter-input');
    if (!filterInput || filterInputHandlersSetup) return; // Already setup, skip

    const clearBtn = document.getElementById('system-filter-clear');
    const syncClear = () => clearBtn?.classList.toggle('hidden', !filterInput.value);
    // A reload starts unfiltered even where a browser puts back what the
    // field held (form restoration), so the field never shows text the
    // list does not apply.
    filterInput.value = '';
    syncClear();
    const inputHandler = (e) => {
      currentFilter = e.target.value;
      syncClear();
      rerenderForView();
    };
    clearBtn?.addEventListener('click', () => {
      filterInput.value = '';
      currentFilter = '';
      syncClear();
      rerenderForView();
      filterInput.focus();
    });
    // Ctrl K / ⌘K, or /, go to the filter (Beszel's search shortcut), unless
    // the key is meant for a field being typed in.
    document.addEventListener('keydown', (e) => {
      const typing = e.target instanceof HTMLElement && (e.target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName));
      const combo = (e.ctrlKey || e.metaKey) && !e.altKey && e.key.toLowerCase() === 'k';
      if (combo || (e.key === '/' && !typing && !e.ctrlKey && !e.metaKey && !e.altKey)) {
        if (!combo && typing) return;
        e.preventDefault();
        filterInput.focus();
        filterInput.select();
      }
    });

    const keydownHandler = (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        currentFilter = e.target.value;
        rerenderForView();
      }
    };

    filterInput.addEventListener('input', inputHandler);
    filterInput.addEventListener('keydown', keydownHandler);
    filterInputHandlersSetup = true;
  }

  // Initial bootstrap. The data source is 100% server-push: when the SSE
  // connection opens, the server immediately sends an authoritative snapshot
  // and then pushes every 3 s plus on every admin mutation. The browser
  // therefore has ZERO self-initiated polling; the only thing we add here is
  // a one-shot safety net in case the SSE stream fails to deliver within a
  // short grace window (proxy that strips SSE, firewall, or server hiccup),
  // in which case we fall back to a single GET /api/metrics.
  const INITIAL_SSE_FALLBACK_MS = 2500;
  // Sticky header option: a sentinel just above the header row tells when the
  // header is stuck to the top of the window (see the CSS above).
  function setupStickyHeader() {
    if (!document.documentElement.classList.contains('sticky-table-header')) return;
    const headerRow = document.getElementById('system-table-header-row');
    if (!headerRow || typeof IntersectionObserver !== 'function') return;
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText = 'height: 1px; margin-bottom: -1px;';
    headerRow.before(sentinel);
    new IntersectionObserver(([entry]) => {
      headerRow.classList.toggle('is-stuck', !entry.isIntersecting && entry.boundingClientRect.top < 0);
    }).observe(sentinel);
    // Safari ignores scroll-padding when focus scrolls a row into view, so a
    // row reached with Tab could end up under the stuck header.
    document.getElementById('systems-body')?.addEventListener('focusin', (e) => {
      const row = e.target && e.target.closest ? e.target.closest('[data-system-id]') : null;
      if (!row || !headerRow.classList.contains('is-stuck')) return;
      const overlap = headerRow.getBoundingClientRect().bottom - row.getBoundingClientRect().top;
      if (overlap > 0) window.scrollBy(0, -(overlap + 8));
    });
  }

  async function bootstrap() {
    setupFilterInput();
    setupStickyHeader();
    await loadTrafficSetting();
    await sessionDecision;
    connectSSE();
    updateTranslations();
    preloadTCPingConfig();

    // One-shot fallback: if no render has happened by the deadline, pull
    // once so the page isn't stuck on "loading". On a healthy connection
    // the SSE initial snapshot fires within ~100–200 ms and this timer
    // never triggers.
    setTimeout(() => {
      if (!initialDataRendered) {
        loadData();
      }
    }, INITIAL_SSE_FALLBACK_MS);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootstrap);
  } else {
    bootstrap();
  }

  // Recalculate column width on window resize (with debounce)
  let resizeTimeout = null;
  window.addEventListener('resize', () => {
    if (resizeTimeout) {
      clearTimeout(resizeTimeout);
    }
    resizeTimeout = setTimeout(() => {
      recalculateColumnWidthFromCurrentData();
      // Rotating the phone / resizing the browser changes the chart's CSS
      // box width (inside horizontally-scrollable table). Chart.js does not
      // always observe that layout shift reliably on mobile Safari — give it
      // an explicit resize after column math settles.
      tcpingCharts.forEach(({ chart }) => {
        try {
          if (chart && typeof chart.resize === 'function') chart.resize();
        } catch (_) {}
      });
      resizeTimeout = null;
    }, 250);
  });

  window.addEventListener('orientationchange', () => {
    // Same rationale as resize — orientation fires slightly ahead of layout
    // on some WebViews; trigger after the next paint.
    requestAnimationFrame(() => {
      setTimeout(() => {
        tcpingCharts.forEach(({ chart }) => {
          try {
            if (chart && typeof chart.resize === 'function') chart.resize();
          } catch (_) {}
        });
      }, 100);
    });
  });

  // Back/forward-cache restore: `beforeunload` below already closed the
  // stream, so a page served from the bfcache would sit frozen on stale
  // data forever with nothing to wake it. Reopen the stream (and drop any
  // reconnect queued before the page was frozen, which would otherwise
  // fire a second connect right after this one).
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    if (sseReconnectTimer) {
      clearTimeout(sseReconnectTimer);
      sseReconnectTimer = null;
    }
    sseReconnectAttempt = 0;
    connectSSE();
  });

  // The network came back, or a tab whose stream went quiet is shown
  // again: reconnect now instead of when the 45 s watchdog or the backoff
  // next fires (that took up to half a minute).
  function reconnectIfQuiet(force) {
    if (!force && eventSource && Date.now() - lastSSEActivityAt < 10_000) return;
    if (sseReconnectTimer) {
      clearTimeout(sseReconnectTimer);
      sseReconnectTimer = null;
    }
    sseReconnectAttempt = 0;
    connectSSE();
  }
  window.addEventListener('online', () => reconnectIfQuiet(true));

  // Out of sight for a minute (a background tab, a minimised window), the
  // page closes its stream: it used to receive every snapshot all the same,
  // about 27 MB an hour with 130 servers, and redraw rows nobody saw. Shown
  // again, it reopens at once; the stream's first message is a whole
  // snapshot, and an open chart then reads the probes it missed.
  const SSE_HIDDEN_PAUSE_MS = 60_000;
  let sseHiddenTimer = null;
  function pauseSSEWhileHidden() {
    sseHiddenTimer = null;
    if (!document.hidden) return;
    ssePaused = true;
    if (eventSource) {
      eventSource.close();
      eventSource = null;
    }
    if (sseWatchdogTimer) {
      clearTimeout(sseWatchdogTimer);
      sseWatchdogTimer = null;
    }
    if (sseReconnectTimer) {
      clearTimeout(sseReconnectTimer);
      sseReconnectTimer = null;
    }
  }
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') {
      if (sseHiddenTimer) {
        clearTimeout(sseHiddenTimer);
        sseHiddenTimer = null;
      }
      // the pause was no outage: no connection notice while it reopens
      if (ssePaused) lastStreamMessageAt = Date.now();
      reconnectIfQuiet(false);
      // the per-minute reads skip a hidden page: what they show is read
      // again now if it is older than a minute (they waited for their next
      // tick, beside rows already fresh)
      const stale = (t) => !t || Date.now() - t > 60_000;
      resourcePanes.forEach((entry, id) => { if (stale(entry.readAt)) refreshResourcePane(id); });
      if (listView === 'latency' && stale(latencySummaryReadAt)) refreshLatencySummary();
    } else if (!sseHiddenTimer && !ssePaused) {
      sseHiddenTimer = setTimeout(pauseSSEWhileHidden, SSE_HIDDEN_PAUSE_MS);
    }
  });
  // (a page opened in a background tab gets no visibilitychange until shown)
  if (document.hidden) sseHiddenTimer = setTimeout(pauseSSEWhileHidden, SSE_HIDDEN_PAUSE_MS);

  window.addEventListener('beforeunload', () => {
    if (eventSource) {
      eventSource.close();
    }
    // Also drop any queued reconnect timer so a bfcache-restored tab
    // doesn't fire a stray `connectSSE()` against a torn-down page.
    if (sseReconnectTimer) {
      clearTimeout(sseReconnectTimer);
      sseReconnectTimer = null;
    }
  });
</script>

<style is:global>
  /* Column width management for table */
