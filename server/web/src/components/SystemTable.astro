  const TCPING_LEGEND_LOSS_MIN_PCT = 1;
  const TCPING_LEGEND_LOSS_MIN_PROBES = 2;
  function updateTCPingTabAverages(systemId) {
    const entry = tcpingCharts.get(`${systemId}_all`);
