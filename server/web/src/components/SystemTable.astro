---
import SystemTableHeader from './SystemTableHeader.astro';
import SystemTableHeaderRow from './SystemTableHeaderRow.astro';
import LoadingState from './LoadingState.astro';
import { Icon as AstroIcon } from 'astro-icon/components';

const { apiBase: apiBaseProp } = Astro.props ?? {};
const apiBase = apiBaseProp ?? '';
---

<div 
  id="monitor-root"
  data-api-base={apiBase}
  class="glass-card mx-auto max-w-[1568px] rounded-[12.8px] border border-[#404040]/50 dark:border-[#2c2c2c]/60 border-[#d4d4d4]/50 bg-[#1c1c1c] dark:bg-[#1a1a1a] bg-white shadow-[0_1px_2px_0_rgba(0,0,0,0.05)] px-3 py-5 sm:p-6"
  style="--first-col-width: 160px;"
>
  <SystemTableHeader />

  <!-- 表格容器 - 独立边框 -->
  <div class="glass-inner rounded-[10.8px] border border-[#404040]/50 dark:border-[#2c2c2c] border-[#dadada] dark:bg-transparent bg-white overflow-x-auto" style="scrollbar-width: none; -ms-overflow-style: none;">
    <style>
      #monitor-root .overflow-x-auto::-webkit-scrollbar {
        display: none;
      }
      /* CSS variable --first-col-width is now defined inline on #monitor-root element
         This avoids timing issues between <style> rules and inline style modifications */
      /* A row's grid needs the name column plus the other columns'
         minimums, the gaps and the left padding: 715 + 42 + 24 px. The name
         column is as wide as the longest name (--first-col-width) when there
         is room, and gives way down to 160 px, with an ellipsis, before the
         last columns would be pushed past the card's edge; below that the
         table scrolls. With min-w-[1000px] alone a long name pushed the last
         columns past the rows' borders, backgrounds and detail panels on
         screens narrower than the table. */
      #monitor-root .table-scroll-content {
        min-width: max(1000px, calc(min(var(--first-col-width), 160px) + 803px));
      }
    </style>
    <div class="min-w-[1000px] table-scroll-content">
      <SystemTableHeaderRow />

      <!-- 表格主体 -->
      <div id="systems-body" class="divide-y divide-[#dadada]/60 dark:divide-[#2c2c2c]/60">
        <LoadingState />
      </div>
    </div>
  </div>

  <!-- Pages (自定义设置 → 分页) under the list, after Beszel's: which servers
       this page holds, which page, and the way to the others. The page size
       is the site's, so there is no picker. Hidden while the list is one
       page (applyPagination). -->
  <nav id="systems-pagination" class="mt-3.5 hidden items-center gap-4 ps-1 text-sm tabular-nums lg:gap-6" aria-label="Pages">
    <p id="pagination-range" class="hidden flex-1 text-[#595959] dark:text-[#ababab] lg:block"></p>
    <p id="pagination-page" class="whitespace-nowrap font-medium text-[#1d1d20] dark:text-[#f5f5f5]"></p>
    <div class="ms-auto flex items-center gap-2 lg:ms-0">
      <button type="button" class="pagination-btn toolbar-control hidden md:inline-flex" data-page="first" title="First page" data-translate-title="firstPage">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 17-5-5 5-5"/><path d="m18 17-5-5 5-5"/></svg>
      </button>
      <button type="button" class="pagination-btn toolbar-control inline-flex" data-page="prev" title="Previous page" data-translate-title="prevPage">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button type="button" class="pagination-btn toolbar-control inline-flex" data-page="next" title="Next page" data-translate-title="nextPage">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </button>
      <button type="button" class="pagination-btn toolbar-control hidden md:inline-flex" data-page="last" title="Last page" data-translate-title="lastPage">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 17 5-5-5-5"/><path d="m13 17 5-5-5-5"/></svg>
      </button>
    </div>
  </nav>
</div>

<script>
  import { iconSvgUrl, flagIconForCode, flagIconForSlug } from '../utils/icons.ts';
  import { getLanguage } from '../utils/i18n.ts';
  import chartJsUrl from '../../vendor/chart.js/chart.umd.js?url';
  import chartJsAdapterUrl from '../../vendor/chartjs-adapter-date-fns/chartjs-adapter-date-fns.bundle.min.js?url';

  // Import utility functions (inline for Astro compatibility)
  const getApiBase = (root) => {
    if (root?.dataset.apiBase && root.dataset.apiBase.trim() !== '') {
      return root.dataset.apiBase.trim();
    }
    // Use current origin (works with nginx reverse proxy)
    return window.location.origin;
  };

  // The admin session goes along only when the dashboard is private
  // (privacy mode). The server answers it with the admin view: every
  // server's addresses and secret, never compressed (about six times the
  // bytes of the public stream), and the session token in every stream URL;
  // this page shows none of it. A refused request (401) switches it on.
  let sessionNeeded = false;
  const storedAdminToken = () => localStorage.getItem('admin_auth_token');
  const urlShareToken = () => new URLSearchParams(window.location.search).get('token');

  // Helper function to get authentication info (share token or admin token)
  const getAuthInfo = () => {
    const shareToken = urlShareToken();
    const adminToken = sessionNeeded ? storedAdminToken() : null;
    return { shareToken, adminToken };
  };

  // Helper function to build authenticated fetch options
  const buildAuthOptions = (url) => {
    const { shareToken, adminToken } = getAuthInfo();
    let requestUrl = url;
    const headers = {};
    
    if (shareToken) {
      // Use share token from URL
      const separator = url.includes('?') ? '&' : '?';
      requestUrl += `${separator}token=${encodeURIComponent(shareToken)}`;
    } else if (adminToken) {
      // Use admin token in Authorization header
      headers['Authorization'] = `Bearer ${adminToken}`;
    }
    
    return { url: requestUrl, headers };
  };

  // fetch with the share link's token, or with the admin session when
  // privacy mode asks for it: a 401 to a request without the session sends
  // it again with the session (privacy switched on while the page is open).
  // sentSession says whether the answer is to a request that carried the
  // session — a parallel request may have switched it on in the meantime.
  async function authedFetch(url, init = {}) {
    await sessionDecision;
    const attempt = async () => {
      const { url: authUrl, headers } = buildAuthOptions(url);
      const res = await fetch(authUrl, { ...init, headers: { ...(init.headers || {}), ...headers } });
      return { res, sentSession: !!headers['Authorization'] };
    };
    let answer = await attempt();
    if (answer.res.status === 401 && !answer.sentSession && !urlShareToken() && storedAdminToken()) {
      sessionNeeded = true;
      answer = await attempt();
    }
    return answer;
  }

  // Global flag to control traffic display in detail section
  let showTrafficInfo = false;

  // Fetch show_traffic setting from navbar config
  async function loadTrafficSetting() {
    try {
      // Use preloaded config if available
      if (window.__navbarConfig) {
        showTrafficInfo = window.__navbarConfig.show_traffic || false;
        return;
      }
      const apiBase = getApiBase(document.getElementById('monitor-root'));
      const res = await fetch(`${apiBase}/api/navbar/config`);
      if (res.ok) {
        const config = await res.json();
        showTrafficInfo = config.show_traffic || false;
      }
    } catch (err) {
      // Silently fail, default to false
    }
  }

  const fetchSystemMetrics = async (apiBase) => {
    const { res, sentSession } = await authedFetch(`${apiBase}/api/metrics`, {
      cache: 'no-store',
      headers: { 'Cache-Control': 'no-store' }
    });
    if (!res.ok) {
      if (res.status === 401) {
        if (urlShareToken() && storedAdminToken()) {
          // The share link has ended, but this browser holds an admin
          // session: open the dashboard without the link instead of
          // logging the admin out.
          const url = new URL(window.location.href);
          url.searchParams.delete('token');
          window.location.replace(url.toString());
          throw new Error('Share link ended - reopening without it');
        }
        // The session (if this request sent it) was refused: drop it and log
        // in; a share link that ended while open says so on the login page.
        if (sentSession) localStorage.removeItem('admin_auth_token');
        window.location.href = urlShareToken() ? '/login?redirect=/&reason=link' : '/login?redirect=/';
        throw new Error('Unauthorized - redirecting to login');
      }
      throw new Error(`HTTP ${res.status}`);
    }
    const data = await res.json();
    if (Array.isArray(data)) return data;
    if (data === null) return [];
    return [];
  };

  // A copied name or link: the check for a second, and the tooltip saying
  // so (data-tooltip, which the tooltip prefers, and the tooltip shown again
  // while the pointer is on the button: a click hides it). The button's own
  // name is left alone: changing the title made "Copied!" its lasting
  // aria-label when the tooltip took the title within that second.
  const confirmCopied = (btn, key) => {
    const copyIcon = btn.querySelector('.copy-icon');
    const checkIcon = btn.querySelector('.check-icon');
    if (!copyIcon || !checkIcon) return;
    copyIcon.style.display = 'none';
    checkIcon.style.display = 'block';
    btn.dataset.tooltip = translations[key][getCurrentLanguage()];
    if (btn.matches(':hover') && typeof PointerEvent === 'function') {
      btn.dispatchEvent(new PointerEvent('pointerover', { bubbles: true, pointerType: 'mouse' }));
    }
    clearTimeout(btn._copiedTimer);
    btn._copiedTimer = setTimeout(() => {
      copyIcon.style.display = 'block';
      checkIcon.style.display = 'none';
      delete btn.dataset.tooltip;
    }, 1000);
  };
  // A link that opens this server (?server=id: its page, opened, in view),
  // keeping a share link's token so it opens a private dashboard too.
  function serverLink(id) {
    const url = new URL(window.location.pathname || '/', window.location.origin);
    const token = new URLSearchParams(window.location.search).get('token');
    if (token) url.searchParams.set('token', token);
    url.searchParams.set('server', id);
    return url.toString();
  }
  const setupCopyButtons = (container) => {
    if (!container || container.dataset.copySetup) return;
    // The copy button beside a name copies the server's link (copying the
    // name was little use; Beszel keeps Copy name / Copy host in a row menu
    // and makes the name itself the link).
    container.addEventListener('click', async (e) => {
      const copyBtn = e.target.closest('.copy-btn');
      if (!copyBtn) return;
      e.stopPropagation();
      if (copyBtn.dataset.linkId && await copyToClipboard(serverLink(copyBtn.dataset.linkId))) confirmCopied(copyBtn, 'linkCopied');
    });
    container.dataset.copySetup = 'true';
  };

  const copyToClipboard = async (text) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch (err) {
      try {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.opacity = '0';
        document.body.appendChild(textArea);
        textArea.select();
        document.execCommand('copy');
        document.body.removeChild(textArea);
        return true;
      } catch (fallbackErr) {
        return false;
      }
    }
  };

  // Country names for the location's tooltip, the details and the filter
  // (the cells show the code): the browser's own region names in the page
  // language, in full (United States, not the US the cell already shows),
  // and the territories named as the rest of Pulse names them. Anything
  // that is not a two-letter code (an admin's own text) stays as written.
  const REGION_ALIASES = { UK: 'GB', EL: 'GR' };
  const REGION_NAMES = {
    zh: { HK: '香港', MO: '澳门', TW: '台湾', AE: '阿联酋' },
    en: { HK: 'Hong Kong', MO: 'Macao', TW: 'Taiwan' },
  };
  const regionNamers = {};
  function countryName(location, lang = getCurrentLanguage()) {
    const raw = String(location || '').trim();
    if (!/^[A-Za-z]{2}$/.test(raw)) return raw;
    const code = REGION_ALIASES[raw.toUpperCase()] || raw.toUpperCase();
    const named = REGION_NAMES[lang] && REGION_NAMES[lang][code];
    if (named) return named;
    try {
      regionNamers[lang] = regionNamers[lang] || new Intl.DisplayNames([lang === 'zh' ? 'zh-CN' : 'en'], { type: 'region' });
      return regionNamers[lang].of(code) || code;
    } catch (_) {
      return code;
    }
  }
  const regionCollators = {};
  const regionCollator = (lang = getCurrentLanguage()) =>
    (regionCollators[lang] = regionCollators[lang] || new Intl.Collator(lang === 'zh' ? 'zh-CN' : 'en', { sensitivity: 'base' }));
  const locationCode = (location) => {
    const raw = String(location || '').trim();
    return /^[A-Za-z]{2}$/.test(raw) ? (REGION_ALIASES[raw.toUpperCase()] || raw.toUpperCase()) : raw;
  };
  const locationTitle = (location) => {
    const raw = String(location || '').trim();
    const code = locationCode(raw);
    const name = countryName(raw);
    return !raw ? '-' : name !== code ? `${name} (${code})` : code;
  };

  // Country → Emoji One (v1) flag icon. Location is an ISO 3166-1 alpha-2
  // code (what the backend stores); its icon comes from the table generated
  // from Unicode's flag list (utils/icon-manifest.ts). Free-text names from
  // older data or manual entries go through the slug fallback below.
  const countryToFlag = (country) => {
    if (!country) return null;
    
    const countryTrimmed = country.trim();
    
    // Country code (2 uppercase letters, e.g. "US", "CN", "HK")
    if (countryTrimmed.length === 2 && /^[A-Z]{2}$/.test(countryTrimmed)) {
      // If the code has no flag, return null to show text fallback
      return flagIconForCode(countryTrimmed);
    }
    
    // Fallback: if it's a country name, convert to flag format
    // This handles legacy data or manual entries. Only names Emoji One
    // really has become icons; anything else ("Unknown", a typo, a city)
    // is shown as text rather than requested and left as an empty box.
    let countryLower = countryTrimmed.toLowerCase();
    if (countryLower === 'unknown') return null;
    
    // Remove common prefixes that don't appear in flag names
    const prefixesToRemove = [
      'the ',
      'republic of ',
      'kingdom of ',
      'state of ',
      'island of ',
      'islands of ',
      'federation of ',
      'union of ',
      'commonwealth of ',
      'democratic republic of ',
      'democratic republic of the ',
      'people\'s republic of ',
      'republic of the ',
      'united states of ',
      'united kingdom of ',
    ];
    
    // Remove prefixes
    for (const prefix of prefixesToRemove) {
      if (countryLower.startsWith(prefix)) {
        countryLower = countryLower.substring(prefix.length);
        break; // Only remove one prefix
      }
    }
    
    // Special mappings for countries that need specific flag names
    const specialFlagMap = {
      'hong kong': 'hong-kong-sar-china',
      'hongkong': 'hong-kong-sar-china',
      'macau': 'macau-sar-china',
      'macao': 'macau-sar-china',
      'netherlands': 'netherlands',
      'usa': 'united-states',
      'us': 'united-states',
      'united states': 'united-states',
      'uk': 'united-kingdom',
      'united kingdom': 'united-kingdom',
      'uae': 'united-arab-emirates',
      'united arab emirates': 'united-arab-emirates',
      'korea': 'south-korea',
      'south korea': 'south-korea',
      'north korea': 'north-korea',
      'czech republic': 'czechia',
      'russian federation': 'russia',
      'myanmar': 'myanmar',
      'burma': 'myanmar',
      'bosnia': 'bosnia-and-herzegovina',
      'bosnia and herzegovina': 'bosnia-and-herzegovina',
      'guinea bissau': 'guinea-bissau',
    };
    
    // Check if there's a special mapping (after prefix removal)
    if (specialFlagMap[countryLower]) {
      return flagIconForSlug(specialFlagMap[countryLower]);
    }
    
    // Convert country name to flag icon path:
    // 1. Convert to lowercase (already done)
    // 2. Replace spaces with hyphens
    // 3. Remove commas
    // 4. Keep sar, china, territories, etc. as they are (no special handling needed)
    let flagName = countryLower
      .replace(/\s+/g, '-')  // Replace spaces with hyphens
      .replace(/,/g, '')      // Remove commas
      .replace(/--+/g, '-')  // Replace multiple hyphens with single hyphen
      .replace(/^-|-$/g, ''); // Remove leading/trailing hyphens
    
    return flagIconForSlug(flagName);
  };

  // Module-level cache for iconify SVG text, keyed by the full cache key
  // (iconName + size). Every row re-render previously re-fetched every
  // icon from api.iconify.design — with N systems × 2 icons (OS + flag)
  // that was 2N external requests per SSE push. The cache collapses
  // duplicates to a single network request per unique icon across the
  // entire session.
  //
  // We store Promise<string|null> rather than the resolved text so
  // concurrent calls for the same icon (common on first paint) only
  // fire one fetch — all callers `await` the same in-flight promise.
  // A 404 is cached as '' so a missing icon is not refetched on every
  // render; a transient failure is dropped from the cache and retried.
  //
  // The cache key encodes the requested `height=` param because
  // iconify serves different viewBox sizes; re-using a 26px SVG where
  // a 32px one was asked for is safe visually (SVGs scale) but the
  // raw bytes differ — keying by size keeps the two callers consistent
  // with their original behaviour.
  // Icons come from the copies shipped with the dashboard, or the Iconify
  // API for the few that are not (utils/icons.ts). Icon names reach the URL
  // from agent-reported fields (os_icon) and from the country -> flag
  // lookup; iconSvgUrl only accepts the plain "prefix:name" shape, so a
  // hostile agent can never steer the request at a different path.

  // SECURITY: escape an id before it is interpolated into a CSS selector.
  // Ids come from agent-reported data and may contain quotes or other
  // characters that would make querySelector throw a SyntaxError and abort
  // the whole render. The fallback covers browsers without CSS.escape.
  function cssEscape(s) {
    if (window.CSS && window.CSS.escape) return window.CSS.escape(s);
    return String(s).replace(/[^a-zA-Z0-9_-]/g, (c) => '\\' + c);
  }

  /* The icon response is third-party markup that ends up in the page.
     Accept only a plain <svg> tree: drop scripts, foreignObject, event
     handler attributes and non-image hrefs. Returns null when anything
     looks off so the icon is simply not shown. */
  function sanitizedSvgElement(markup) {
    if (!markup || typeof markup !== 'string') return null;
    let doc;
    try { doc = new DOMParser().parseFromString(markup, 'image/svg+xml'); } catch (_) { return null; }
    const root = doc.documentElement;
    // Names are compared on the element's namespace and local name: nodeName
    // carries the prefix in an XML document, so <s:script> or <h:script>
    // (xmlns:h = XHTML) read as "s:script" and were kept, and ran. Anything
    // outside the SVG namespace goes.
    const SVG_NS = 'http://www.w3.org/2000/svg';
    if (!root || root.namespaceURI !== SVG_NS || root.localName !== 'svg' || doc.querySelector('parsererror')) return null;
    const banned = /^(script|foreignobject|iframe|object|embed|use|style|animate|set|animatetransform|animatemotion)$/i;
    // Every node, not only elements: comments, CDATA sections and processing
    // instructions are dropped as well.
    const walker = doc.createTreeWalker(root, NodeFilter.SHOW_ALL);
    const toRemove = [];
    let node = walker.currentNode;
    while (node) {
      if (node.nodeType !== Node.ELEMENT_NODE) {
        if (node.nodeType !== Node.TEXT_NODE) toRemove.push(node);
      } else if (node.namespaceURI !== SVG_NS || banned.test(node.localName)) toRemove.push(node);
      else {
        Array.from(node.attributes).forEach((attr) => {
          const n = attr.localName.toLowerCase(), v = String(attr.value || '');
          // event handlers; links and sources other than a #fragment or a data:
          // image; url(…) of anything else (a paint server or a style fetched
          // from another site, which learns who views the page)
          if (n.startsWith('on') || (/href|src/.test(n) && !/^#|^data:image\//i.test(v.trim())) || /url\(\s*['"]?\s*(?!#|data:image\/)/i.test(v)) node.removeAttributeNode(attr);
        });
      }
      node = walker.nextNode();
    }
    toRemove.forEach((n) => n.remove());
    // Handed over as nodes. Serialising and assigning innerHTML re-parsed the
    // XML as HTML, where a comment or CDATA section could turn into live markup.
    return document.importNode(root, true);
  }

  const iconSvgCache = new Map();
  // An icon request that hangs (api.iconify.design unreachable) is given up
  // after this long and tried again on a later render.
  const ICON_FETCH_TIMEOUT_MS = 8000;
  const fetchIconSvg = (iconName, height) => {
    const url = iconSvgUrl(iconName, height);
    if (!url) return Promise.resolve(null);
    const key = `${iconName}@${height}`;
    let pending = iconSvgCache.get(key);
    if (pending) return pending;
    pending = (async () => {
      const ctrl = typeof AbortController === 'function' ? new AbortController() : null;
      const timer = ctrl ? setTimeout(() => ctrl.abort(), ICON_FETCH_TIMEOUT_MS) : null;
      try {
        const response = await fetch(url, ctrl ? { signal: ctrl.signal } : undefined);
        // A missing icon stays missing for the session (no refetch on every
        // render); a network error or 5xx is dropped below and retried.
        if (response.status === 404) return '';
        if (!response.ok) return null;
        return await response.text();
      } catch (e) {
        return null;
      } finally {
        if (timer) clearTimeout(timer);
      }
    })();
    pending = pending.then((svg) => { if (svg == null) iconSvgCache.delete(key); return svg; });
    iconSvgCache.set(key, pending);
    return pending;
  };

  // An icon that does not exist (the CDN answered 404) is replaced by the
  // text it stands for — the OS name or the location — instead of leaving
  // an empty box in the cell.
  const showIconText = (el) => {
    const own = el.parentElement && el.parentElement.querySelector(':scope > .loc-text, :scope > .os-text');
    if (own) { own.classList.add('cell-text-only'); el.remove(); return; }
    const text = document.createElement('span');
    text.className = 'text-[10px] sm:text-xs text-[#595959] dark:text-[#ababab] whitespace-nowrap';
    text.textContent = el.dataset.fallback || '-';
    el.replaceWith(text);
  };

  const loadOSIcons = async () => {
    const iconElements = document.querySelectorAll('.os-icon');
    await Promise.all(Array.from(iconElements).map(async (el) => {
      const iconName = el.dataset.icon;
      if (!iconName) return;
      // Skip elements that already have an SVG rendered for the same
      // icon — prevents flicker and avoids re-styling on every render.
      if (el.dataset.iconLoaded === iconName && el.querySelector('svg')) return;
      const svg = await fetchIconSvg(iconName, 26);
      if (svg === '') { showIconText(el); return; }
      if (!svg) return;
      // Third-party markup: only a sanitized <svg> tree is inserted.
      const safeSvg = sanitizedSvgElement(svg);
      if (!safeSvg) return;
      el.replaceChildren(safeSvg);
      el.dataset.iconLoaded = iconName;
      const svgEl = el.querySelector('svg');
      if (svgEl) {
        svgEl.setAttribute('class', 'block leading-none w-5 h-5 sm:w-[26px] sm:h-[26px]');
        svgEl.style.margin = '0';
        svgEl.style.padding = '0';
        svgEl.style.display = 'block';
        svgEl.style.verticalAlign = 'middle';
        svgEl.style.lineHeight = '1';
        svgEl.style.width = '100%';
        svgEl.style.height = '100%';
        svgEl.style.maxWidth = '100%';
        svgEl.style.maxHeight = '100%';
      }
    }));
  };

  const loadFlagIcons = async () => {
    const flagElements = document.querySelectorAll('.flag-icon');
    await Promise.all(Array.from(flagElements).map(async (el) => {
      const iconName = el.dataset.icon;
      if (!iconName) return;
      if (el.dataset.iconLoaded === iconName && el.querySelector('svg')) return;
      const svg = await fetchIconSvg(iconName, 32);
      if (svg === '') { showIconText(el); return; }
      if (!svg) return;
      // Third-party markup: only a sanitized <svg> tree is inserted.
      const safeSvg = sanitizedSvgElement(svg);
      if (!safeSvg) return;
      el.replaceChildren(safeSvg);
      el.dataset.iconLoaded = iconName;
      const svgEl = el.querySelector('svg');
      if (svgEl) {
        svgEl.setAttribute('class', 'block leading-none w-6 h-6 sm:w-8 sm:h-8');
        svgEl.style.margin = '0';
        svgEl.style.padding = '0';
        svgEl.style.display = 'block';
        svgEl.style.verticalAlign = 'middle';
        svgEl.style.lineHeight = '1';
        svgEl.style.width = '100%';
        svgEl.style.height = '100%';
        svgEl.style.maxWidth = '100%';
        svgEl.style.maxHeight = '100%';
      }
    }));
  };

  // Detect CPU brand from CPU model string

  const root = document.getElementById('monitor-root');
  const apiBase = getApiBase(root);

  // A signed-in admin first learns whether the dashboard is private, so no
  // request goes out without the session only to be refused (a 401 in the
  // console and a round trip lost). One /api/privacy/config request per
  // page, shared with the page's access check.
  const privacyConfigOnce = () => {
    window.__pulsePrivacyConfig = window.__pulsePrivacyConfig
      || fetch(`${apiBase}/api/privacy/config`, { cache: 'no-store' }).then((r) => (r.ok ? r.json() : null)).catch(() => null);
    return window.__pulsePrivacyConfig;
  };
  const sessionDecision = (!urlShareToken() && storedAdminToken())
    ? privacyConfigOnce().then((cfg) => { if (cfg && cfg.enabled) sessionNeeded = true; })
    : Promise.resolve();

  const body = document.getElementById('systems-body');
  const loadingIndicator = document.getElementById('loading-indicator');
  
  // SSE connection for real-time updates
  let eventSource = null;
  
  // Cache current data for comparison
  let currentData = new Map(); // key: system ID, value: system data

  // Latched the FIRST time the table renders rows. Without this latch,
  // every transient empty payload (server hiccup, all clients momentarily
  // unreported, …) would clear `currentData` and cause the list's fade-in
  // (`data-row-in`) to replay the next time data comes back — which the
  // user perceives as "the dashboard keeps fading in". It only softens the
  // loading preview's exit, not a refresh signal, so it runs exactly once
  // per page session.
  let staggerAnimationPlayed = false;

  // The view settings last for the visit: every load starts from the site's
  // defaults — the order the admin set (sort field null), 全部 and an empty
  // filter, the admin's layout (自定义设置 → 卡片布局: html.card-layout, set
  // in the page head before the first paint; else the table) and every
  // field. Beszel keeps them per account, its dashboard being a signed-in
  // user's own; this page is the site's, and a layout kept in one browser
  // hid the admin's default from it. Measures sort the largest first, names
  // from A.
  const SORT_FIELDS = ['name', 'time', 'location', 'cpu', 'memory', 'disk', 'net', 'os'];
  const SORT_DESC_FIRST = ['time', 'cpu', 'memory', 'disk', 'net'];
  // What earlier versions kept in the browser.
  try { ['pulse-sort', 'pulse-status-filter', 'pulse-layout', 'pulse-hidden-cols'].forEach((key) => localStorage.removeItem(key)); } catch (_) {}
  let currentSort = { field: null, direction: 'asc' };
  let statusFilter = 'all';
  // 资源 | 延迟 (自定义设置 → 延迟视图): the list's view, the targets' last
  // hour (GET /api/tcping/summary) and its minute timer; see setListView.
  let listView = 'resources';
  let latencySummary = null;
  let latencyTimer = 0;
  // Layout (the table — on phones its compact rows — or Beszel's cards, at
  // every width as in Beszel) and the fields shown; the name stays.
  const HIDEABLE_COLS = ['uptime', 'location', 'cpu', 'memory', 'disk', 'net', 'os'];
  let layoutChoice = null;
  const layoutMode = () => layoutChoice
    || (document.documentElement.classList.contains('card-layout') ? 'grid' : 'table');
  let hiddenCols = [];

  // Filter state
  let currentFilter = '';

  // Filter systems function - filters systems based on search query
  function filterSystems(systems) {
    if (statusFilter !== 'all') {
      // 离线 leaves out a server still waiting for its client (only 全部 has it).
      systems = systems.filter((system) => (statusFilter === 'offline'
        ? !!(system && system.alert) && !awaitingClient(system)
        : !(system && system.alert)));
    }
    if (!currentFilter || currentFilter.trim() === '') {
      return systems; // No filter
    }

    const filterLower = currentFilter.trim().toLowerCase();
    return systems.filter(system => {
      // Search in name
      const name = (system.name || '').toLowerCase();
      if (name.includes(filterLower)) return true;

      // Search in location: the code (as stored and as shown) and the
      // country's name in either language
      const location = (system.location || '').toLowerCase();
      if (location.includes(filterLower) || locationCode(location).toLowerCase().includes(filterLower)) return true;
      if (system.location && ['zh', 'en'].some((l) => countryName(system.location, l).toLowerCase().includes(filterLower))) return true;

      // Search in OS
      const os = (system.os || '').toLowerCase();
      if (os.includes(filterLower)) return true;

      // Search in CPU model
      const cpuModel = (system.cpu_model || '').toLowerCase();
      if (cpuModel.includes(filterLower)) return true;

      // Search in IP addresses
      const ipv4 = (system.ipv4 || '').toLowerCase();
      const ipv6 = (system.ipv6 || '').toLowerCase();
      if (ipv4.includes(filterLower) || ipv6.includes(filterLower)) return true;

      // Search in the tags as they read (a coloured tag without its spr: /
      // spy: / spb: prefix); the traffic and speed tags show numbers only
      if (Array.isArray(system.tags) && system.tags.some((tag) => {
        if (typeof tag !== 'string' || /^(traffic|speed):(in|out)$/.test(tag)) return false;
        const label = /^sp[ryb]:/i.test(tag) && tag.slice(4).trim() ? tag.slice(4).trim() : tag;
        return label.toLowerCase().includes(filterLower);
      })) return true;

      return false;
    });
  }

  // Sort systems function - sorts ALL systems regardless of alert/status
  function sortSystems(systems) {
    if (!currentSort.field) {
      return systems; // No sorting
    }

    const sorted = [...systems].sort((a, b) => {
      let aVal, bVal;
      let aIsEmpty = false;
      let bIsEmpty = false;

      switch (currentSort.field) {
        case 'name':
          aVal = (a.name || '').trim().toLowerCase();
          bVal = (b.name || '').trim().toLowerCase();
          aIsEmpty = !aVal;
          bIsEmpty = !bVal;
          break;
        case 'time':
          // Parse time string (format: "HH:MM:SS" or "X hours" or "X days")
          aVal = (a.time || '').trim();
          bVal = (b.time || '').trim();
          aIsEmpty = !aVal;
          bIsEmpty = !bVal;
          
          // If both are non-empty, try to parse for better sorting
          if (!aIsEmpty && !bIsEmpty) {
            // Try to extract numeric values for comparison
            const aNum = extractTimeValue(aVal);
            const bNum = extractTimeValue(bVal);
            if (aNum !== null && bNum !== null) {
              // Both have numeric values, compare numerically
              if (aNum < bNum) return currentSort.direction === 'asc' ? -1 : 1;
              if (aNum > bNum) return currentSort.direction === 'asc' ? 1 : -1;
              return 0;
            }
          }
          break;
        case 'os':
          aVal = (a.os || '').trim().toLowerCase();
          bVal = (b.os || '').trim().toLowerCase();
          aIsEmpty = !aVal;
          bIsEmpty = !bVal;
          break;
        case 'location': {
          // By what the column shows: the country code (an admin's own text as written).
          aVal = locationCode(a.location);
          bVal = locationCode(b.location);
          aIsEmpty = !aVal;
          bIsEmpty = !bVal;
          if (!aIsEmpty && !bIsEmpty) {
            const order = regionCollator().compare(aVal, bVal);
            if (order) return currentSort.direction === 'asc' ? order : -order;
            return 0;
          }
          break;
        }
        case 'cpu':
        case 'memory':
        case 'disk':
        case 'net': {
          // An offline server's speed is not current: it sorts last.
          const measure = (s) => currentSort.field === 'net'
            ? (s.alert ? NaN : (Number(s.net_in_mb_s) || 0) + (Number(s.net_out_mb_s) || 0))
            : Number(s[currentSort.field]);
          aVal = measure(a);
          bVal = measure(b);
          aIsEmpty = !Number.isFinite(aVal);
          bIsEmpty = !Number.isFinite(bVal);
          break;
        }
        default: {
          // 延迟 view: a TCPing target's last-hour average ("lat:<address>")
          if (!currentSort.field.startsWith('lat:')) return 0;
          const addr = currentSort.field.slice(4);
          aVal = latencyAvg(a.id, addr);
          bVal = latencyAvg(b.id, addr);
          aIsEmpty = !Number.isFinite(aVal);
          bIsEmpty = !Number.isFinite(bVal);
          break;
        }
      }

      // Handle empty values: empty values go to the end (or beginning for desc)
      if (aIsEmpty && bIsEmpty) return 0;
      if (aIsEmpty) return currentSort.direction === 'asc' ? 1 : -1; // Empty goes to end for asc, beginning for desc
      if (bIsEmpty) return currentSort.direction === 'asc' ? -1 : 1; // Empty goes to end for asc, beginning for desc

      // String comparison for non-empty values
      if (aVal < bVal) return currentSort.direction === 'asc' ? -1 : 1;
      if (aVal > bVal) return currentSort.direction === 'asc' ? 1 : -1;
      return 0;
    });

    return sorted;
  }

  // Helper function to extract numeric value from time string
  function extractTimeValue(timeStr) {
    if (!timeStr) return null;
    
    // Try to match patterns like "5h", "2d", "5 hours", "2 days", "12:34:56", etc.
    // First try compact format (no space): "0h", "11d", "120d"
    const compactHoursMatch = timeStr.match(/(\d+)h/i);
    if (compactHoursMatch) {
      return parseInt(compactHoursMatch[1], 10); // Return hours as number
    }
    
    const compactDaysMatch = timeStr.match(/(\d+)d/i);
    if (compactDaysMatch) {
      return parseInt(compactDaysMatch[1], 10) * 24; // Convert days to hours for comparison
    }
    
    // Try to match patterns with space: "5 hours", "2 days"
    const hoursMatch = timeStr.match(/(\d+)\s*hours?/i);
    if (hoursMatch) {
      return parseInt(hoursMatch[1], 10); // Return hours as number
    }
    
    const daysMatch = timeStr.match(/(\d+)\s*days?/i);
    if (daysMatch) {
      return parseInt(daysMatch[1], 10) * 24; // Convert days to hours for comparison
    }
    
    // Try to parse as HH:MM:SS
    const timeMatch = timeStr.match(/(\d+):(\d+):(\d+)/);
    if (timeMatch) {
      const hours = parseInt(timeMatch[1], 10);
      const minutes = parseInt(timeMatch[2], 10);
      const seconds = parseInt(timeMatch[3], 10);
      return hours + minutes / 60 + seconds / 3600; // Convert to hours
    }
    
    return null; // Could not parse
  }

  // Sort marks, as in Beszel: the arrow points to where the larger values
  // go (up when the largest come first). The view menu marks the field;
  // the column header of the field is highlighted with its arrow, and the
  // other headers show ⇅ on hover.
  const ARROW_UP = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>';
  const ARROW_DOWN = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>';
  const ARROW_UP_DOWN = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 16-4 4-4-4"/><path d="M17 20V4"/><path d="m3 8 4-4 4 4"/><path d="M7 4v16"/></svg>';
  const CHECK = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
  // Beszel marks a choice of one (layout, status) with a dot and a field
  // shown with a check, as Radix's radio and checkbox items.
  const DOT = '<svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>';
  function updateSortUI() {
    const arrow = currentSort.direction === 'desc' ? ARROW_UP : ARROW_DOWN;
    document.querySelectorAll('.sort-option').forEach((btn) => {
      const field = btn.dataset.sort || null;
      const active = field === currentSort.field;
      btn.setAttribute('aria-checked', active ? 'true' : 'false');
      const mark = btn.querySelector('.sort-indicator');
      if (mark) mark.innerHTML = active ? (field ? arrow : DOT) : '';
    });
    // The sorted column says so to screen readers in its button's name
    // ("CPU，降序"): aria-sort belongs to a table's column header, and on the
    // header's plain div it was never read. (The first call comes before the
    // translations are defined, with nothing sorted; the next 'translate'
    // fills the text in.)
    const stateText = () => {
      try { return translations[currentSort.direction === 'asc' ? 'sortStateAsc' : 'sortStateDesc'][getCurrentLanguage()]; } catch (_) { return ''; }
    };
    document.querySelectorAll('.sort-header').forEach((btn) => {
      const active = btn.dataset.sort === currentSort.field;
      btn.dataset.active = active ? 'true' : 'false';
      const cell = btn.parentElement;
      if (cell) cell.removeAttribute('aria-sort');
      let state = btn.querySelector('.sort-state');
      if (!state) {
        state = document.createElement('span');
        state.className = 'sort-state sr-only';
        btn.appendChild(state);
      }
      const text = active ? stateText() : '';
      if (state.textContent !== text) state.textContent = text;
      const mark = btn.querySelector('.sort-header-arrow');
      if (mark) mark.innerHTML = active ? arrow : ARROW_UP_DOWN;
    });
  }

  function setSort(field) {
    if (!field) {
      currentSort = { field: null, direction: 'asc' };
    } else if (currentSort.field === field) {
      currentSort = { field, direction: currentSort.direction === 'asc' ? 'desc' : 'asc' };
    } else {
      currentSort = { field, direction: SORT_DESC_FIRST.includes(field) ? 'desc' : 'asc' };
    }
    updateSortUI();
    rerenderForView();
  }

  function updateStatusUI() {
    document.querySelectorAll('.status-option').forEach((btn) => {
      const active = btn.dataset.status === statusFilter;
      btn.setAttribute('aria-checked', active ? 'true' : 'false');
      const mark = btn.querySelector('.status-indicator');
      if (mark) mark.innerHTML = active ? DOT : '';
    });
  }

  function updateStatusCounts() {
    if (!systemsSummary) return;
    const { total, offline, awaiting = 0 } = systemsSummary;
    const counts = { all: total, online: total - offline - awaiting, offline };
    document.querySelectorAll('.status-count').forEach((el) => {
      const value = String(counts[el.dataset.count] ?? '');
      if (el.textContent !== value) el.textContent = value;
    });
  }

  // View menu
  const columnsBtn = document.getElementById('columns-btn');
  const columnsDropdown = document.getElementById('columns-dropdown');
  const columnsContainer = document.getElementById('columns-dropdown-container');
  function setViewMenuOpen(open) {
    if (!columnsDropdown) return;
    columnsDropdown.classList.toggle('hidden', !open);
    columnsBtn?.setAttribute('aria-expanded', open ? 'true' : 'false');
    placeViewMenu();
  }
  // The menu opens leftwards from its button and moves right by as much as it
  // must to stay in the window (as Beszel's dropdown shifts): where the
  // toolbar wraps to a line of its own from 900 px (a long line under the
  // title), the room left of the button is less than the menu's 640 px.
  function placeViewMenu() {
    if (!columnsDropdown) return;
    columnsDropdown.style.right = '';
    if (columnsDropdown.classList.contains('hidden') || !columnsContainer) return;
    // from the layout box (the opening zoom scales the drawn one): the menu's
    // right edge sits on its container's
    const left = columnsContainer.getBoundingClientRect().right - columnsDropdown.offsetWidth;
    if (left < 8) columnsDropdown.style.right = `${Math.round(left - 8)}px`;
  }
  window.addEventListener('resize', placeViewMenu);

  // Keys as in Beszel's menu (Radix): Enter, Space or ↓ on the button open
  // it on its first item (↑ on its last); ↑ ↓ go from item to item, through
  // every section in turn, Home and End to the ends; Escape (below) and Tab
  // close it back on the button. Its items are one stop for Tab, reached
  // with the arrows. The pointer works as before.
  const viewMenuItems = () => (columnsDropdown
    ? [...columnsDropdown.querySelectorAll('.view-menu-item')].filter((el) => el.offsetParent !== null && !el.disabled)
    : []);
  columnsDropdown?.querySelectorAll('.view-menu-item').forEach((el) => el.setAttribute('tabindex', '-1'));
  // (the phone menu scrolls inside: the item is brought into view, the page
  // moves only when the item is off screen)
  const focusViewMenuItem = (item) => {
    if (!item) return;
    item.focus({ preventScroll: true });
    item.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  };

  columnsBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const opening = columnsDropdown?.classList.contains('hidden');
    setViewMenuOpen(opening);
    // opened from the keyboard (a click without a pointer): onto the first item
    if (opening && e.detail === 0) focusViewMenuItem(viewMenuItems()[0]);
  });
  columnsBtn?.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
    e.preventDefault();
    if (columnsDropdown?.classList.contains('hidden')) setViewMenuOpen(true);
    const items = viewMenuItems();
    focusViewMenuItem(e.key === 'ArrowDown' ? items[0] : items[items.length - 1]);
  });
  columnsDropdown?.addEventListener('keydown', (e) => {
    const items = viewMenuItems();
    if (!items.length) return;
    const at = items.indexOf(document.activeElement);
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      const next = at < 0 ? 0 : (at + (e.key === 'ArrowDown' ? 1 : items.length - 1)) % items.length;
      focusViewMenuItem(items[next]);
    } else if (e.key === 'Home' || e.key === 'End') {
      e.preventDefault();
      focusViewMenuItem(items[e.key === 'Home' ? 0 : items.length - 1]);
    } else if (e.key === 'Tab') {
      e.preventDefault();
      setViewMenuOpen(false);
      columnsBtn?.focus();
    }
  });

  // Close the menu when clicking outside
  document.addEventListener('click', (e) => {
    if (columnsContainer && !columnsContainer.contains(e.target)) setViewMenuOpen(false);
  });

  // Close the menu on Escape for keyboard users, back on its button. Only
  // when it is open, so Escape still reaches other widgets (the expanded
  // row's chart).
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (columnsDropdown && !columnsDropdown.classList.contains('hidden')) {
      setViewMenuOpen(false);
      columnsBtn?.focus();
    }
  });

  document.querySelectorAll('.sort-option').forEach((btn) => {
    btn.addEventListener('click', () => setSort(btn.dataset.sort || null));
  });
  document.querySelectorAll('.sort-header').forEach((btn) => {
    btn.addEventListener('click', () => setSort(btn.dataset.sort));
  });
  const setStatusFilter = (status) => {
    statusFilter = status || 'all';
    updateStatusUI();
    renderSystemsSummary();
    rerenderForView();
  };
  document.querySelectorAll('.status-option').forEach((btn) => {
    btn.addEventListener('click', () => setStatusFilter(btn.dataset.status));
  });
  document.getElementById('systems-summary')?.addEventListener('click', (e) => {
    if (e.target.closest('#summary-offline-chip')) setStatusFilter(statusFilter === 'offline' ? 'all' : 'offline');
  });

  // Pages (自定义设置 → 分页): the list N servers at a time, with a footer
  // under it after Beszel's. The admin sets N (html.dataset.pageSize, from
  // the site config in the page head; 0 keeps one list). Unlike Beszel, whose
  // dashboard each signed-in user sets up, visitors get no page-size picker:
  // the size is the site's. Filtering, sorting or a status choice go back to
  // the first page (rerenderForView); a live update keeps the page, and a
  // list that shrank under it shows its last page. The other pages' rows
  // stay in the list, hidden: their updates cost no layout, and the name
  // column keeps one width across the pages.
  let pageIndex = 0;
  const currentPageSize = () => Math.min(200, Math.max(0, parseInt(document.documentElement.dataset.pageSize || '0', 10) || 0));
  // Cards: a page ends on a full row. The size is rounded up to whole rows
  // of the columns the cards have now (1, 2 or 3: the grid's breakpoints at
  // 640 and 1024 px in the styles below, keep the two in step), so a page
  // other than the last never ends with a hole (20 a page in 3 columns: 21).
  // The table keeps the admin's size. Beszel's card view pages by the same
  // count as its table, holes and all.
  const cardColumnQueries = [window.matchMedia('(min-width: 1024px)'), window.matchMedia('(min-width: 640px)')];
  const cardColumns = () => (cardColumnQueries[0].matches ? 3 : cardColumnQueries[1].matches ? 2 : 1);
  const effectivePageSize = () => {
    const size = currentPageSize();
    if (!size || !document.getElementById('monitor-root')?.classList.contains('layout-grid')) return size;
    const cols = cardColumns();
    return Math.ceil(size / cols) * cols;
  };
  let lastPageSize = 0;
  // The first server of the page the visitor turned to (or a link opened):
  // when the cards take another number of columns, the page that holds it,
  // so going back and forth between widths comes back to the same cards.
  let pageAnchor = 0;
  const pagedRows = () => [...(document.getElementById('systems-body')?.children || [])].filter((r) => r.classList.contains('system-row'));
  function applyPagination() {
    const nav = document.getElementById('systems-pagination');
    const rows = pagedRows();
    const size = effectivePageSize();
    // A new size (the cards took another number of columns, or the layout
    // changed): the page that holds the anchor, so the view keeps its place.
    if (size && lastPageSize && size !== lastPageSize) pageIndex = Math.floor(pageAnchor / size);
    lastPageSize = size;
    const pages = size ? Math.max(1, Math.ceil(rows.length / size)) : 1;
    if (pageIndex > pages - 1) pageIndex = pages - 1;
    const start = size ? pageIndex * size : 0;
    rows.forEach((row, i) => {
      const off = !!size && (i < start || i >= start + size);
      if (row.hidden !== off) row.hidden = off;
    });
    // Shown only while there is more than one page.
    const show = pages > 1;
    if (nav) {
      nav.classList.toggle('hidden', !show);
      nav.classList.toggle('flex', show);
    }
    if (show && nav) {
      const lang = getCurrentLanguage();
      const fill = (key, values) => Object.entries(values).reduce((text, [k, v]) => text.replace(`{${k}}`, String(v)), translations[key][lang]);
      nav.setAttribute('aria-label', translations.paginationLabel[lang]);
      document.getElementById('pagination-range').textContent = fill('paginationRange', { from: start + 1, to: Math.min(start + size, rows.length), total: rows.length });
      document.getElementById('pagination-page').textContent = fill('paginationPage', { page: pageIndex + 1, pages });
      nav.querySelectorAll('.pagination-btn').forEach((btn) => {
        const back = btn.dataset.page === 'first' || btn.dataset.page === 'prev';
        btn.disabled = back ? pageIndex === 0 : pageIndex >= pages - 1;
      });
    }
  }

  // A link to one server (?server=id, from the copy button beside a name;
  // or the server a private dashboard was asked for before the login sent
  // the visitor away, kept for the visit): its page, the server opened and
  // brought into view, once. An id not in the list is let go.
  let linkedServerHandled = false;
  function openLinkedServer() {
    if (linkedServerHandled) return;
    linkedServerHandled = true;
    let id = new URLSearchParams(window.location.search).get('server');
    try {
      if (!id) id = sessionStorage.getItem('pulse-open-server');
      sessionStorage.removeItem('pulse-open-server');
    } catch (_) {}
    if (!id) return;
    const rows = pagedRows();
    const index = rows.findIndex((r) => r.dataset.systemId === id);
    if (index < 0) return;
    const size = effectivePageSize();
    if (size) {
      pageIndex = Math.floor(index / size);
      pageAnchor = index;
      applyPagination();
    }
    const row = rows[index];
    const head = row.querySelector(':scope > [data-system-id]');
    if (head && head.getAttribute('aria-expanded') !== 'true') head.click();
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    requestAnimationFrame(() => row.scrollIntoView({ block: 'start', behavior: calm ? 'auto' : 'smooth' }));
  }

  // Turned at the footer, the new page starts above the window (on a phone
  // some 1400 px up), so the view goes back to where the list begins: the
  // filter row above it, as when the page opened. Only when the list's top
  // is out of sight; smooth unless the visitor asks for less motion. (Beszel
  // leaves the view where it was.)
  function revealListTop() {
    const anchor = document.getElementById('system-filter-input');
    const list = document.getElementById('systems-body');
    if (!anchor || !list || list.getBoundingClientRect().top >= 0) return;
    const top = Math.max(0, anchor.getBoundingClientRect().top + window.scrollY - 16);
    const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top, behavior: smooth ? 'smooth' : 'auto' });
  }
  document.querySelectorAll('#systems-pagination .pagination-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const size = effectivePageSize();
      if (!size) return;
      const last = Math.max(0, Math.ceil(pagedRows().length / size) - 1);
      const to = { first: 0, prev: pageIndex - 1, next: pageIndex + 1, last }[btn.dataset.page];
      const before = pageIndex;
      pageIndex = Math.min(Math.max(0, to), last);
      pageAnchor = pageIndex * size;
      applyPagination();
      if (pageIndex !== before) revealListTop();
    });
  });
  window.addEventListener('navbarconfigready', () => applyPagination());
  // The cards change columns at those widths: whole rows again.
  cardColumnQueries.forEach((q) => q.addEventListener('change', () => applyPagination()));
  updateStatusUI();

  // The column tracks of each width tier with every field shown: the same
  // as the tier rules in the styles below (keep the two in step). A tier
  // leaves out the fields it has no room for. With fields hidden, the rows
  // and the header take the template built from the rest (--cols-template)
  // and the scroller's minimum width follows (--cols-min: the minimums, a
  // 6 px gap each and the 24 px left padding; 1000 px at least from 1280).
  const NAME_TRACK = 'minmax(min(var(--first-col-width, 100px), 160px), var(--first-col-width, 100px))';
  const COLUMN_TIERS = [
    { min: 1280, floor: 1000, cols: [['location', 104, '1fr'], ['cpu', 130, '1.8fr'], ['memory', 130, '1.8fr'], ['disk', 130, '1.8fr'], ['net', 78, '0.9fr'], ['uptime', 85, '1fr'], ['os', 80, '1fr']] },
    { min: 1024, cols: [['location', 88, '0.9fr'], ['cpu', 108, '1.8fr'], ['memory', 108, '1.8fr'], ['disk', 108, '1.8fr'], ['net', 72, '0.9fr'], ['uptime', 72, '0.9fr'], ['os', 76, '1fr']] },
    { min: 900, cols: [['cpu', 116, '1.8fr'], ['memory', 116, '1.8fr'], ['disk', 116, '1.8fr'], ['net', 70, '0.9fr'], ['uptime', 85, '1fr']] },
    { min: 768, cols: [['cpu', 108, '1.8fr'], ['memory', 108, '1.8fr'], ['disk', 108, '1.8fr'], ['net', 70, '0.9fr']] },
  ];
  // Cards (phones, and the card layout): a hidden field's slot goes to its
  // neighbours, a line with nothing left goes.
  function cardAreas() {
    const shown = (c) => !hiddenCols.includes(c);
    const spread = (areas) => areas.map((a) => Array(6 / areas.length).fill(a).join(' ')).join(' ');
    const top = ['name', 'name', 'name', 'name', 'name', 'name'];
    if (shown('os')) top[5] = 'os';
    if (shown('location')) top[shown('os') ? 4 : 5] = 'loc';
    const lines = [top.join(' ')];
    const bars = [['cpu', 'cpu'], ['memory', 'mem'], ['disk', 'disk']].filter(([c]) => shown(c)).map(([, a]) => a);
    if (bars.length) lines.push(spread(bars));
    const bottom = [['net', 'net'], ['uptime', 'up']].filter(([c]) => shown(c)).map(([, a]) => a);
    if (bottom.length) lines.push(spread(bottom));
    return lines.map((l) => `"${l}"`).join(' ');
  }
  function applyViewLayout() {
    const root = document.getElementById('monitor-root');
    if (!root) return;
    HIDEABLE_COLS.forEach((c) => root.classList.toggle(`hide-col-${c}`, hiddenCols.includes(c)));
    const wasGrid = root.classList.contains('layout-grid');
    root.classList.toggle('layout-grid', layoutMode() === 'grid');
    // Cards and the table have their own page sizes (cards end on full rows).
    if (wasGrid !== root.classList.contains('layout-grid')) applyPagination();
    root.classList.toggle('cols-custom', hiddenCols.length > 0);
    applyLatencyTemplate();
    if (!hiddenCols.length) return;
    const tier = COLUMN_TIERS.find((t) => window.innerWidth >= t.min);
    if (tier) {
      const shown = tier.cols.filter(([c]) => !hiddenCols.includes(c));
      root.style.setProperty('--cols-template', [NAME_TRACK, ...shown.map(([, min, fr]) => `minmax(${min}px,${fr})`)].join(' '));
      const reserve = shown.reduce((sum, [, min]) => sum + min, 0) + 6 * shown.length + 24;
      const total = `calc(min(var(--first-col-width), 160px) + ${reserve}px)`;
      root.style.setProperty('--cols-min', tier.floor ? `max(${tier.floor}px, ${total})` : total);
    }
    root.style.setProperty('--card-areas', cardAreas());
  }
  ['(min-width: 768px)', '(min-width: 900px)', '(min-width: 1024px)', '(min-width: 1280px)'].forEach((query) => {
    window.matchMedia(query).addEventListener('change', applyViewLayout);
  });
  window.addEventListener('navbarconfigready', () => { if (!layoutChoice) { updateLayoutUI(); applyViewLayout(); } });

  function updateLayoutUI() {
    document.querySelectorAll('.layout-option').forEach((btn) => {
      const active = btn.dataset.layout === layoutMode();
      btn.setAttribute('aria-checked', active ? 'true' : 'false');
      const mark = btn.querySelector('.layout-indicator');
      if (mark) mark.innerHTML = active ? DOT : '';
    });
    document.querySelectorAll('.column-option').forEach((btn) => {
      const shown = !hiddenCols.includes(btn.dataset.col);
      btn.setAttribute('aria-checked', shown ? 'true' : 'false');
      const mark = btn.querySelector('.column-indicator');
      if (mark) mark.innerHTML = shown ? CHECK : '';
    });
  }
  document.querySelectorAll('.layout-option').forEach((btn) => {
    btn.addEventListener('click', () => {
      layoutChoice = btn.dataset.layout === 'grid' ? 'grid' : 'table';
      updateLayoutUI();
      applyViewLayout();
    });
  });
  document.querySelectorAll('.column-option').forEach((btn) => {
    btn.addEventListener('click', () => {
      const col = btn.dataset.col;
      hiddenCols = hiddenCols.includes(col) ? hiddenCols.filter((c) => c !== col) : [...hiddenCols, col];
      updateLayoutUI();
      applyViewLayout();
    });
  });
  updateLayoutUI();
  applyViewLayout();

  // Initialize sort UI (no sort by default - shows backend order)
  updateSortUI();

  const pct = (val) => Math.min(Math.max(val || 0, 0), 100);
  // Bars follow whole percents (the label keeps one decimal): a tenth of a
  // percent is a sub-pixel step, yet each one restarted the bar's
  // transition on nearly every update. A long step eases in 150 ms (the
  // length only, a colour changes at once); Beszel's meters jump.
  const barWidth = (val) => `${Math.round(pct(val))}%`;
  // The fill spans its track and is scaled from the left (the same length
  // as a width), and only a step of five points or more eases: under that
  // (under 6 px on a desktop bar, 4 px on a phone's) it is set at once. A
  // live update mostly moves bars by such small steps; easing every one of
  // them by its width, as before, laid the page out again on each frame of
  // each move, most of the main thread's work on a live list. Measured on
  // xhh.li's data, 20 a page, main thread per minute: desktop 1.35 s →
  // 0.5 s, a phone at a quarter speed 4.5 s → 2.7 s (every step eased by
  // scale: 0.9 s / 3.8 s; none eased: 0.48 s / 2.4 s).
  const BAR_FILL = 'absolute inset-0 origin-left transition-transform duration-150 ease-out';
  const barScale = (val) => `scaleX(${Math.round(pct(val)) / 100})`;
  const BAR_EASE_MIN_POINTS = 5;
  const setBarScale = (bar, val) => {
    const scale = barScale(val);
    if (bar.style.transform === scale) return;
    // (in whole points: 0.43 - 0.38 is 0.04999… in floating point)
    const from = Math.round(parseFloat(bar.style.transform.slice(7)) * 100);
    bar.style.transition = Number.isFinite(from) && Math.abs(Math.round(pct(val)) - from) < BAR_EASE_MIN_POINTS ? 'none' : '';
    bar.style.transform = scale;
  };
  // Usage label, one decimal. "100.0%" is wider than the w-8 / sm:w-10
  // label slot and ran under the start of the bar; a full bar reads "100%".
  const pctLabel = (val) => {
    const s = val.toFixed(1);
    return s === '100.0' ? '100%' : `${s}%`;
  };

  // Text widths by size and text, kept between renders. Every live update
  // renders the rows again, and measuring every name each time cost one
  // layout per name (131 names: ~45 ms of each update on a desktop, several
  // times that on a phone). Texts not measured yet are measured together, in
  // one layout. Emptied when a web font finishes loading: the widths change
  // with it.
  const textWidths = new Map();
  if (document.fonts && document.fonts.addEventListener) {
    document.fonts.addEventListener('loadingdone', () => textWidths.clear());
  }

  // Pre-calculate server name column width from data (before rendering DOM)
  // This prevents visual jitter by setting the correct width from the start
  function calculateServerNameColumnWidth(items) {
    if (!items || items.length === 0) return 100;

    let maxWidth = 100; // Minimum width in pixels (reduced for better mobile experience)

    // The rows' name size: 10 px below 640 px (text-[10px] sm:text-xs),
    // 12 px, and 14 px from 1280 px (the Beszel tier in the styles below).
    const isSmallScreen = window.innerWidth < 640;
    const isWide = window.matchMedia('(min-width: 1280px)').matches;
    // 13 px in the 1024-1279 table (its tier in the styles below)
    const isMid = !isWide && window.matchMedia('(min-width: 1024px)').matches;
    const nameFontSize = isSmallScreen ? '10px' : isWide ? '14px' : isMid ? '13px' : '12px';
    const nameKey = (item) => `${nameFontSize} 500 ${item.name || 'unknown'}`;

    // An offline row also carries the "离线 / Offline" chip after its name:
    // its 10 px semibold label plus 12 px of padding and the gap (4 px, 8 px
    // from 1280 px).
    const chipText = translations.offlineChip[getCurrentLanguage()];
    const chipKey = `10px 600 ${chipText}`;
    const awaitingText = translations.awaitingChip[getCurrentLanguage()];
    const awaitingKey = `10px 600 ${awaitingText}`;

    const missing = new Map();
    if (!textWidths.has(chipKey)) missing.set(chipKey, ['10px', '600', chipText]);
    if (!textWidths.has(awaitingKey)) missing.set(awaitingKey, ['10px', '600', awaitingText]);
    for (const item of items) {
      const key = nameKey(item);
      if (!textWidths.has(key)) missing.set(key, [nameFontSize, '500', item.name || 'unknown']);
    }
    if (missing.size > 0) {
      // A hidden span per text, all in place before the first width is read.
      const box = document.createElement('div');
      // Measure in the body's own font (read from the page) so the widths
      // match what the rows render. A generic sans-serif here would make the
      // measurement silently drift from the real row width
      // (different glyph metrics → first column too wide or too narrow → the
      // very column-jitter we went to great lengths to eliminate).
      box.style.cssText = `
        position: absolute;
        visibility: hidden;
        white-space: nowrap;
        font-family: ${getComputedStyle(document.body).fontFamily};
        letter-spacing: normal;
      `;
      const spans = [];
      for (const [key, [size, weight, text]] of missing) {
        const span = document.createElement('span');
        span.style.fontSize = size;
        span.style.fontWeight = weight;
        span.textContent = text;
        box.append(span, document.createElement('br'));
        spans.push([key, span]);
      }
      document.body.appendChild(box);
      for (const [key, span] of spans) textWidths.set(key, span.offsetWidth);
      box.remove();
    }
    const chipWidth = textWidths.get(chipKey) + (isWide ? 20 : isMid ? 18 : 16);
    const awaitingWidth = textWidths.get(awaitingKey) + (isWide ? 20 : isMid ? 18 : 16);

    // Measure each server name
    items.forEach(item => {
      const textWidth = textWidths.get(nameKey(item));

      // Add space for UI elements and ensure complete text display:
      // - Status dot: ~8px (w-1.5 sm:w-2)
      // - Gap after dot: 6px (gap-1.5)
      // - Gap before button: 6px (gap-1.5)
      // - Copy button: ~14px (w-2.5 sm:w-3)
      // - Extra buffer for font rendering variations: ~16px
      // From 1280 px the dot is 8 px and both gaps 8 px: 58 px.
      const uiElementsWidth = isSmallScreen ? 44 : isWide ? 58 : isMid ? 52 : 50; // Mobile: 44px, Desktop: 50px (1024-1279: 6 px gaps)
      const estimatedCellWidth = textWidth + uiElementsWidth + (item.alert ? (awaitingClient(item) ? awaitingWidth : chipWidth) : 0);
      maxWidth = Math.max(maxWidth, estimatedCellWidth);
    });

    // Return the calculated width based on longest name
    // Table container has overflow-x-auto for horizontal scrolling on mobile if needed
    return Math.ceil(maxWidth);
  }
  
  // Apply the pre-calculated column width to all rows and header
  function applyServerNameColumnWidth(columnWidth) {
    // Update CSS variable at root level - this automatically affects all elements using var(--first-col-width)
    // Including: header row, loading skeleton rows, and all data rows
    const root = document.getElementById('monitor-root');
    if (root) {
      // CRITICAL: Only increase width, never decrease
      // This prevents LoadingState from being too narrow during SSE updates
      // When adding a system with a longer name, the LoadingState will expand correctly
      const currentWidthStr = root.style.getPropertyValue('--first-col-width');
      const currentWidth = parseInt(currentWidthStr) || 160;
      
      // Use the larger of current width or new calculated width
      const newWidth = Math.max(currentWidth, columnWidth);
      // Unchanged (most live updates): nothing to commit, no reflow.
      if (currentWidthStr && newWidth === currentWidth) return;

      root.style.setProperty('--first-col-width', `${newWidth}px`);
      
      // CRITICAL: Force browser to immediately recalculate styles (trigger reflow)
      // Reading offsetHeight forces a synchronous layout recalculation
      // This ensures the CSS variable change is applied immediately
      void root.offsetHeight;
    }
  }
  
  // Recalculate column width from current data (used for incremental updates)
  function recalculateColumnWidthFromCurrentData() {
    if (currentData.size === 0) return;
    const items = Array.from(currentData.values());
    const width = calculateServerNameColumnWidth(items);
    applyServerNameColumnWidth(width);
  }

  // The names change size at 1280 px (12 ↔ 14 px), and their width changes
  // once Inter has loaded if it came after the first rows: measure again,
  // and let the column shrink as well as grow.
  function remeasureNameColumn() {
    const root = document.getElementById('monitor-root');
    if (!root || currentData.size === 0) return;
    root.style.setProperty('--first-col-width', `${calculateServerNameColumnWidth(Array.from(currentData.values()))}px`);
  }

  window.matchMedia('(min-width: 1280px)').addEventListener('change', remeasureNameColumn);
  window.matchMedia('(min-width: 1024px)').addEventListener('change', remeasureNameColumn);
  if (document.fonts) document.fonts.addEventListener('loadingdone', remeasureNameColumn);

  // Get color class based on value threshold
  // An offline server keeps its last known values, in grey: red means high
  // load only. Pulse's steps (yellow from 70 %, orange from 80 %, red from
  // 90 %: one more than Beszel's 65/90, for the load getting close) in
  // Beszel's colours: its green hsl(140 50% 48%) and Tailwind 4's
  // yellow-500, orange-500 and red-500. The status dots use the same green
  // and red.
  const OFFLINE_BAR = 'bg-[#a3a3a3] dark:bg-[#525252]';
  // 最后在线 (Last seen) of an offline server: its last report (updated_at),
  // as HH:mm today and MM-DD HH:mm before, with how long ago. The time is
  // kept on the element (data-last-seen) and the text written again every
  // minute (refreshLastSeen); a server never heard from has none.
  function lastSeenText(iso, lang = getCurrentLanguage()) {
    const ms = Date.parse(iso || '');
    if (!Number.isFinite(ms) || ms <= 0) return '';
    const at = new Date(ms);
    const p2 = (n) => String(n).padStart(2, '0');
    const hm = `${p2(at.getHours())}:${p2(at.getMinutes())}`;
    const when = at.toDateString() === new Date().toDateString() ? hm : `${p2(at.getMonth() + 1)}-${p2(at.getDate())} ${hm}`;
    const min = Math.floor(Math.max(0, Date.now() - ms) / 60000);
    const ago = min < 1 ? translations.justNow[lang]
      : min < 60 ? translations.minutesAgo[lang].replace('{n}', min)
      : min < 1440 ? translations.hoursAgo[lang].replace('{n}', Math.floor(min / 60))
      : translations.daysAgo[lang].replace('{n}', Math.floor(min / 1440));
    return lang === 'zh' ? `${when}（${ago}）` : `${when} (${ago})`;
  }
  const lastSeenTip = (iso, lang = getCurrentLanguage()) => `${translations.lastSeen[lang]} ${lastSeenText(iso, lang)}`;
  const offlineChip = (item) => {
    const seen = item && lastSeenText(item.updated_at) ? ` data-last-seen="${escapeHtmlAttr(item.updated_at)}" data-tooltip="${escapeHtmlAttr(lastSeenTip(item.updated_at))}"` : '';
    return `<span class="offline-chip shrink-0 rounded-full px-1.5 text-[11px] font-semibold leading-4 bg-red-500/10 text-red-700 dark:bg-red-400/15 dark:text-red-300" data-translate-detail="offlineChip"${seen}>${translations.offlineChip[getCurrentLanguage()]}</span>`;
  };
  // A server added in the admin page whose client has never reported (no
  // OS, CPU or memory yet) is waiting for it, not down: grey, not red, and
  // not counted as offline (Beszel's pending systems).
  const awaitingClient = (item) => !!(item && item.alert && !item.os && !item.cpu_model && !item.memory_info);
  const awaitingChip = () => `<span class="offline-chip awaiting-chip shrink-0 rounded-full px-1.5 text-[11px] font-semibold leading-4 bg-black/5 text-[#595959] dark:bg-white/[0.06] dark:text-[#ababab]" data-translate-detail="awaitingChip">${translations.awaitingChip[getCurrentLanguage()]}</span>`;
  const statusChip = (item) => (awaitingClient(item) ? awaitingChip() : offlineChip(item));
  // The details' 最后在线 line: an offline server heard from before, not one waiting for its client.
  const showLastSeen = (item) => !!(item && item.alert && !awaitingClient(item) && lastSeenText(item.updated_at));
  const statusDotColor = (item) => (awaitingClient(item) ? 'bg-[#a3a3a3]' : item.alert ? 'bg-[#fb2c36]' : 'bg-[#3db866]');
  const getProgressColor = (value, isOffline = false) => {
    if (isOffline) return OFFLINE_BAR;
    if (value >= 90) return 'bg-[#fb2c36]';
    if (value >= 80) return 'bg-[#ff6900]';
    if (value >= 70) return 'bg-[#f0b100]';
    return 'bg-[#3db866]';
  };

  const progress = (value, warn = false, isOffline = false, label = '') => `
    <div class="flex items-center gap-0.5 pr-2 sm:pr-3 min-w-0 w-full">${label}
      <span class="text-[10px] sm:text-xs font-medium text-[#1d1d20] dark:text-[#f5f5f5] w-8 sm:w-10 shrink-0">${pctLabel(value)}</span>
      <div class="progress-track relative h-2.5 sm:h-3 flex-1 min-w-[60px] overflow-hidden rounded-full dark:bg-[#292929] bg-[#f0f0f0]">
        <div class="${BAR_FILL} ${getProgressColor(value, isOffline)}" style="transform:${barScale(value)}"></div>
    </div>
    </div>
  `;

  // SECURITY: HTML escape function to prevent XSS attacks
  function escapeHtml(text) {
    if (text == null) return '';
    const map = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;'
    };
    return String(text).replace(/[&<>"']/g, m => map[m]);
  }

  // Format total traffic bytes to appropriate unit: steps of 1024, named so
  // (KiB … TiB), as memory and disk beside it and the admin page name them.
  function formatTotalTraffic(bytes) {
    if (bytes === 0 || bytes == null) return '0 B';
    
    if (bytes < 1024) {
      return `${bytes} B`;
    } else if (bytes < 1024 * 1024) {
      return `${(bytes / 1024).toFixed(2)} KiB`;
    } else if (bytes < 1024 * 1024 * 1024) {
      return `${(bytes / (1024 * 1024)).toFixed(2)} MiB`;
    } else if (bytes < 1024 * 1024 * 1024 * 1024) {
      return `${(bytes / (1024 * 1024 * 1024)).toFixed(2)} GiB`;
    } else {
      return `${(bytes / (1024 * 1024 * 1024 * 1024)).toFixed(2)} TiB`;
    }
  }

  // Format traffic speed from MB/s to appropriate unit
  // At most four digits: one decimal from 100, the next unit before a value
  // would print 1000. "110.20 MB/s" and "1023.99 MB/s" ran into the uptime
  // column, and 1023.96 KB/s printed as "1024.0 KB/s".
  function formatTrafficSpeed(mbps) {
    if (mbps === 0 || mbps == null) return '0 B/s';
    const bytes = mbps * 1024 * 1024; // Convert MB/s to Bytes/s
    if (bytes < 1024) return `${bytes.toFixed(0)} B/s`;
    const kb = bytes / 1024;
    if (kb < 999.95) return `${kb.toFixed(1)} KB/s`;
    const dec = (v) => v.toFixed(v >= 99.995 ? 1 : 2);
    const mb = kb / 1024;
    if (mb < 999.95) return `${dec(mb)} MB/s`;
    return `${dec(mb / 1024)} GB/s`;
  }

  // SECURITY: HTML attribute escape function
  function escapeHtmlAttr(text) {
    if (text == null) return '';
    const map = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;'
    };
    return String(text).replace(/[&<>"']/g, m => map[m]);
  }

  // Backgrounds used by "spr:<label>" / "spy:<label>" / "spb:<label>" tags.
  //
  // Three user-selectable gradient families, one per prefix. The `sp*`
  // namespace marks all three as "special coloured badges"; the final
  // letter (r/y/b) picks which of the three pre-tuned gradient families
  // paints the badge, letting the operator emphasize a tag as warm /
  // neutral / cool without changing the label wording.
  //
  // Why a 3-letter `sp*` namespace rather than bare `r:` / `y:` / `b:`:
  // a bare single-letter prefix is brittle — a future business tag like
  // `b:backup` or `r:region-us` would accidentally light up with a
  // gradient. `spr:` / `spy:` / `spb:` reserves a dedicated namespace
  // that is unlikely to collide with real-world tag words.
  //
  // Shared design rules across all three families (keep in sync):
  //   • Saturation band: Tailwind **600**, or **700** where white text on
  //     the 600 shade stays under 4.5:1 (the text minimum for the badges'
  //     12 px, 10 px on phones). Every stop now gives white text 4.6:1 or
  //     more, without a text-shadow, and still reads as a coloured badge
  //     rather than a muddy pill. The 700s are the lighter yellow, green,
  //     teal and orange, where 600 gave only 2.9–3.7:1.
  //   • Stop count: **3** only. Each stop gets ~9 px of a ~28 px short
  //     badge ("vip", "pro"), which is the maximum the eye reads as
  //     smooth flow rather than discrete bands.
  //   • Direction: 90deg horizontal, so the spectrum is laid across
  //     the badge's width rather than diagonally compressed into a
  //     middle-hue blob on short labels.
  //   • Family choice: every family starts on its prefix-named hue
  //     (r → red, y → yellow/amber, b → blue) and travels roughly 60°
  //     of hue in a direction that keeps all three stops in one tonal
  //     story (not a full rainbow). That is the compromise that
  //     satisfied earlier feedback: rainbow feel without banding, and
  //     tonal coherence so the badge reads as "one coloured object"
  //     not "three stripes".
  const RAINBOW_GRADIENTS = {
    // r: warm sunset — red → orange → pink. Energetic / warning-adjacent
    // feel but still decorative (pink end pulls it away from pure alert
    // red). Good for "hot", "priority", "danger"-flavoured labels.
    r: 'linear-gradient(90deg, ' +
      '#dc2626 0%, '   + // red-600 (4.8:1)
      '#c2410c 50%, '  + // orange-700 (5.2:1; orange-600 was 3.6:1)
      '#db2777 100%'   + // pink-600 (4.6:1)
      ')',
    // y: golden meadow — amber → green → teal. Warm-to-cool neutral
    // bridge; feels "natural" / "balanced". Good for "standard",
    // "staff", "maintenance"-flavoured labels that are neither warning
    // nor premium.
    y: 'linear-gradient(90deg, ' +
      '#a16207 0%, '   + // yellow-700, deep gold (4.9:1; 600 was 2.9:1)
      '#15803d 50%, '  + // green-700 (5.0:1; 600 was 3.3:1)
      '#0f766e 100%'   + // teal-700 (5.5:1; 600 was 3.7:1)
      ')',
    // b: cosmic — blue → purple → fuchsia. Cool iridescent / "premium"
    // feel in line with Apple achievements / GitHub Sponsor badges.
    // Good for "vip", "pro", "enterprise"-flavoured labels.
    b: 'linear-gradient(90deg, ' +
      '#2563eb 0%, '   + // blue-600
      '#9333ea 50%, '  + // purple-600
      '#c026d3 100%'   + // fuchsia-600
      ')',
  };

  // Phones show each row as a card (styles at the end of this file), where
  // the column header is hidden, so the uptime / CPU / memory / disk / net
  // cells carry their header's own icon and label. Both are copied from the
  // header row at render time: the same icons, and a [data-translate] span
  // that the header's script retranslates on a language change. Hidden on
  // wider screens, where the header row is visible.
  const cardLabel = (col) => {
    const cell = document.querySelector(`#system-table-header-row > [data-col="${col}"]`);
    if (!cell) return '';
    const icon = cell.querySelector('svg');
    const text = cell.querySelector('span[data-translate]');
    return `<span class="cell-label hidden items-center gap-1 shrink-0 text-[#595959] dark:text-[#ababab]">${icon ? icon.outerHTML : ''}${text ? text.outerHTML : ''}</span>`;
  };

  // The tag row at the top of a row's details: built with the row, and again
  // by updateRow when the admin changes the tags (open dashboards used to
  // keep the old ones until a reload).
  function renderTagStrip(item) {
    if (!(item.tags && Array.isArray(item.tags) && item.tags.length > 0)) return '';
    const safeId = escapeHtmlAttr(item.id || '');
    return `
            <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 w-full" data-tag-strip>
              ${item.tags.map(tag => {
                // SECURITY: Escape tag to prevent XSS
                const safeTag = escapeHtml(tag);
                
                // Check for special traffic tags
                if (tag === 'traffic:in') {
                  // Format total network in traffic (cumulative)
                  const totalNetIn = item.total_net_in_bytes || 0;
                  const formattedIn = formatTotalTraffic(totalNetIn);
                  return `
                  <span class="inline-flex items-center gap-1 rounded-[8.8px] bg-black/5 dark:bg-[#262626] px-2 py-0.5 text-xs font-medium text-[#595959] dark:text-[#ababab]" data-traffic-tag="in" data-system-id="${safeId}">
                    <svg class="w-3 h-3" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>
                    </svg>
                    <span class="traffic-value">${formattedIn}</span>
                  </span>
                  `;
                } else if (tag === 'traffic:out') {
                  // Format total network out traffic (cumulative)
                  const totalNetOut = item.total_net_out_bytes || 0;
                  const formattedOut = formatTotalTraffic(totalNetOut);
                  return `
                  <span class="inline-flex items-center gap-1 rounded-[8.8px] bg-black/5 dark:bg-[#262626] px-2 py-0.5 text-xs font-medium text-[#595959] dark:text-[#ababab]" data-traffic-tag="out" data-system-id="${safeId}">
                    <svg class="w-3 h-3" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/>
                    </svg>
                    <span class="traffic-value">${formattedOut}</span>
                  </span>
                  `;
                } else if (tag === 'speed:in') {
                  // Format current network in speed (rate)
                  const netInSpeed = item.net_in_mb_s || 0;
                  const formattedSpeed = formatTrafficSpeed(netInSpeed);
                  return `
                  <span class="inline-flex items-center gap-1 rounded-[8.8px] bg-black/5 dark:bg-[#262626] px-2 py-0.5 text-xs font-medium text-[#595959] dark:text-[#ababab]" data-speed-tag="in" data-system-id="${safeId}">
                    <svg class="w-3 h-3" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m7 13 5 5 5-5"/><path d="m7 6 5 5 5-5"/>
                    </svg>
                    <span class="speed-value">${formattedSpeed}</span>
                  </span>
                  `;
                } else if (tag === 'speed:out') {
                  // Format current network out speed (rate)
                  const netOutSpeed = item.net_out_mb_s || 0;
                  const formattedSpeed = formatTrafficSpeed(netOutSpeed);
                  return `
                  <span class="inline-flex items-center gap-1 rounded-[8.8px] bg-black/5 dark:bg-[#262626] px-2 py-0.5 text-xs font-medium text-[#595959] dark:text-[#ababab]" data-speed-tag="out" data-system-id="${safeId}">
                    <svg class="w-3 h-3" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m17 11-5-5-5 5"/><path d="m17 18-5-5-5 5"/>
                    </svg>
                    <span class="speed-value">${formattedSpeed}</span>
                  </span>
                  `;
                } else if (
                  typeof tag === 'string' &&
                  tag.length > 4 &&
                  tag[3] === ':' &&
                  (tag[0] === 's' || tag[0] === 'S') &&
                  (tag[1] === 'p' || tag[1] === 'P') &&
                  (tag[2] === 'r' || tag[2] === 'R' ||
                   tag[2] === 'y' || tag[2] === 'Y' ||
                   tag[2] === 'b' || tag[2] === 'B') &&
                  tag.slice(4).trim().length > 0
                ) {
                  // Coloured-prefix tag: "spr:<label>" / "spy:<label>" /
                  // "spb:<label>". The third letter of the prefix (r/y/b,
                  // case-insensitive) selects which of the three
                  // pre-tuned gradient families (RAINBOW_GRADIENTS)
                  // paints the badge; the remainder of the tag (after
                  // the colon, with surrounding whitespace trimmed for
                  // display) is the visible label.
                  //
                  // Guards on the else-if:
                  //   • length > 4 — requires at least one character
                  //     after the colon, so "spr:" alone never matches.
                  //   • tag.slice(4).trim() non-empty — protects against
                  //     "spr:   " rendering as a blank coloured pill.
                  //   • per-character case-insensitive prefix check so
                  //     "Spr:VIP" / "SPR:VIP" also pick up the gradient;
                  //     matches the spirit of the admin placeholder's
                  //     free-form input.
                  //
                  // Style: gradient is set via inline style because
                  // Tailwind's JIT scanner only picks up class names
                  // that appear LITERALLY in the source and cannot
                  // compile in a runtime-assembled multi-stop gradient.
                  // Layout classes (`rounded-[8.8px] px-2 py-0.5 text-[10px]
                  // sm:text-xs font-medium`) match the regular-tag
                  // branch below, so a spr:/spy:/spb: badge is
                  // pixel-identical in height, padding, corner radius
                  // and font weight to a Python / traffic:* badge. The
                  // only differences are the coloured gradient
                  // background and white text (required for contrast;
                  // grey would be illegible on every gradient stop).
                  // No text-shadow, no box-shadow, no border — the
                  // gradients' 600 / 700 stops are dark enough on their
                  // own that white text reads cleanly (4.6:1 or more).
                  const colorKey = tag[2].toLowerCase(); // 'r' | 'y' | 'b'
                  const gradient = RAINBOW_GRADIENTS[colorKey];
                  const label = tag.slice(4).trim();
                  const safeLabel = escapeHtml(label);
                  return `
                  <span class="inline-flex items-center rounded-[8.8px] px-2 py-0.5 text-xs font-medium text-white" style="background-image: ${gradient};" data-color-tag="${colorKey}" data-color-tag-label="${escapeHtmlAttr(label)}">
                    ${safeLabel}
                  </span>
                  `;
                }
                
                // Regular tag
                return `
                <span class="inline-flex items-center rounded-[8.8px] bg-black/5 dark:bg-[#262626] px-2 py-0.5 text-xs font-medium text-[#595959] dark:text-[#ababab]">
                  ${safeTag}
                </span>
              `;
              }).join('')}
            </div>
`;
  }

  // Location and OS cells. From 768 px the table shows the flag with the
  // country's two-letter code (the same width in every language, so the
  // column lines up and never cuts a name; the tooltip and the details give
  // the name) and the OS logo with its name. Phone rows and cards show the
  // flag and the logo alone, and the text where there is no icon
  // (.cell-text-only).
  const locationCellHTML = (item) => {
    const flagIcon = item.location ? countryToFlag(item.location) : null;
    const flag = flagIcon ? `<span class="flag-icon block leading-none w-5 h-5" data-icon="${escapeHtmlAttr(flagIcon)}" data-fallback="${escapeHtmlAttr(item.location)}"></span>` : '';
    return `${flag}<span class="loc-text${flagIcon ? '' : ' cell-text-only'}${item.location ? '' : ' cell-empty'}">${escapeHtml(item.location ? locationCode(item.location) : '-')}</span>`;
  };
  const osCellHTML = (item) => {
    const logo = item.os_icon ? `<span class="os-icon block leading-none w-[18px] h-[18px]" data-icon="${escapeHtmlAttr(item.os_icon)}" data-fallback="${escapeHtmlAttr(item.os || '-')}"></span>` : '';
    return `${logo}<span class="os-text${item.os_icon ? '' : ' cell-text-only'}${item.os ? '' : ' cell-empty'}">${escapeHtml(item.os || '-')}</span>`;
  };
  // A CPU name's core count stays with its words ("1 Virtual Core" was
  // broken after the 1 on phones).
  const cpuModelText = (s) => String(s || '-').replace(/(\d+) (Virtual|Physical) (Cores?)/g, '$1\u00a0$2\u00a0$3');
  // A swap of 0 B / 0 B: the server has none.
  const noSwap = (s) => /^\s*0(\.0+)?\s*B\s*\/\s*0(\.0+)?\s*B\s*$/.test(String(s || ''));
  const osDetailText = (item) => [item.os, item.virtualization_type].map((v) => String(v || '').trim()).filter(Boolean).join(' · ') || '-';

  const renderRow = (item, showTCPing = true) => {
    // Determine if system is offline/paused (alert = true means offline/paused)
    const isOffline = item.alert || false;
    // SECURITY: Escape all user-controlled data
    const safeId = escapeHtmlAttr(item.id || '');
    const safeName = escapeHtml(item.name || 'unknown');
    const safeNameAttr = escapeHtmlAttr(item.name || 'unknown');
    return `
    <div class="system-row${isOffline ? ' is-offline' : ''}" data-system-id="${safeId}">
      <div class="group grid items-center gap-1.5 px-3 sm:px-4 md:px-6 py-2 sm:py-3 hover:bg-[#222]/50 dark:hover:bg-[#222]/50 hover:bg-[#f5f5f5] cursor-pointer" data-system-id="${safeId}" role="button" tabindex="0" aria-expanded="false" style="grid-template-columns: minmax(min(var(--first-col-width, 100px), 160px), var(--first-col-width, 100px)) minmax(104px,1fr) minmax(130px,1.8fr) minmax(130px,1.8fr) minmax(130px,1.8fr) minmax(78px,0.9fr) minmax(85px,1fr) minmax(80px,1fr);">
        <div class="cell-name flex items-center gap-1 min-h-[20px]">
          <span class="status-dot h-1.5 w-1.5 sm:h-2 sm:w-2 rounded-full ${statusDotColor(item)} shrink-0"></span>
          <span class="row-name text-[10px] sm:text-xs font-medium text-[#1d1d20] dark:text-[#f5f5f5] whitespace-nowrap" title="${safeNameAttr}">${safeName}</span>${isOffline ? statusChip(item) : ''}
          <button class="copy-btn text-[#595959] dark:text-[#ababab] hover:text-[#151515] dark:hover:text-[#d4d4d4] opacity-0 group-hover:opacity-100 focus-visible:opacity-100 transition-opacity shrink-0" tabindex="-1" aria-hidden="true" data-link-id="${safeId}" title="${translations.copyServerLink[getCurrentLanguage()]}" data-translate-title="copyServerLink">
            <svg class="copy-icon w-2.5 h-2.5 sm:w-3 sm:h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            <svg class="check-icon w-2.5 h-2.5 sm:w-3 sm:h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M20 6L9 17l-5-5"/></svg>
          </button>
    </div>
        <div class="cell-location text-[10px] sm:text-xs font-medium text-[#1d1d20] dark:text-[#f5f5f5] h-5 flex items-center min-w-0" title="${escapeHtmlAttr(locationTitle(item.location))}">${locationCellHTML(item)}</div>
        <div class="cell-cpu h-5 flex items-center pr-2 sm:pr-3 min-w-0 w-full">${progress(item.cpu || 0, false, isOffline, cardLabel('cpu'))}</div>
        <div class="cell-memory h-5 flex items-center pr-2 sm:pr-3 min-w-0 w-full">${progress(item.memory || 0, false, isOffline, cardLabel('memory'))}</div>
        <div class="cell-disk h-5 flex items-center pr-2 sm:pr-3 min-w-0 w-full">${progress((item.disk || 0), (item.disk || 0) > 65, isOffline, cardLabel('disk'))}</div>
        <div class="cell-net text-[10px] sm:text-xs font-medium text-[#1d1d20] dark:text-[#f5f5f5] h-5 flex items-center whitespace-nowrap">${cardLabel('net')}<span class="cell-value">${isOffline ? '-' : formatTrafficSpeed((item.net_in_mb_s || 0) + (item.net_out_mb_s || 0))}</span></div>
        <div class="cell-uptime text-[10px] sm:text-xs font-medium text-[#1d1d20] dark:text-[#f5f5f5] h-5 flex items-center">${cardLabel('uptime')}<span class="cell-value">${escapeHtml(item.time || '-')}</span></div>
        <div class="cell-os text-[10px] sm:text-xs font-medium text-[#1d1d20] dark:text-[#f5f5f5] h-5 flex items-center w-full min-w-0" title="${escapeHtmlAttr(osDetailText(item))}">${osCellHTML(item)}</div>
    </div>
      <!-- Expandable details: built the first time the row is opened
           (ensureDetails), so the page holds no details for rows nobody
           opens: they were more than half of its elements. -->
      <div class="system-details hidden border-t border-[#dadada]/60 dark:border-[#2c2c2c]/60 dark:bg-[#171717] bg-[#f8f8f8] overflow-hidden" data-details-id="${safeId}" data-tcping="${showTCPing ? '1' : '0'}" style="width: 100%;"></div>
</div>
  `;
  };

  // A row's details (info bar, and the TCPing card where it shows): built
  // the first time the row is opened, from the newest data, then kept up to
  // date by updateRow like the row itself.
  const renderDetailsContent = (item, showTCPing = true) => {
    const safeId = escapeHtmlAttr(item.id || '');
    return `
        <div class="details-content px-3 sm:px-4 md:px-6 py-3 sm:py-4">
          <div class="detail-list">
            <!-- Tags (first row) -->
            ${renderTagStrip(item)}
            <!-- 最后在线 (Last seen), first, while the server is offline -->
            <div class="detail-item detail-last-seen"${showLastSeen(item) ? '' : ' hidden'}>
              <svg class="detail-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></g></svg>
              <div class="detail-label shrink-0" data-translate-detail="lastSeenInfo">${translations.lastSeenInfo[getCurrentLanguage()]}</div>
              <div class="detail-value" data-detail="last_seen" data-last-seen="${escapeHtmlAttr(item.updated_at || '')}">${escapeHtml(lastSeenText(item.updated_at))}</div>
            </div>
            <!-- Location and OS with the kind of machine, as Beszel's info bar
                 carries the OS, only where the row doesn't show them (the
                 styles leave them out where it does): the table at 768-1023 px
                 has no such columns, and a field can be hidden in the view menu. -->
            <div class="detail-item detail-location">
              <svg class="detail-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></g></svg>
              <div class="detail-label shrink-0" data-translate-detail="locationInfo">Location:</div>
              <div class="detail-value" data-detail="location">${escapeHtml(item.location ? countryName(item.location) : '-')}</div>
            </div>
            <div class="detail-item detail-os">
              <svg class="detail-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect width="14" height="8" x="5" y="2" rx="2"/><rect width="20" height="8" x="2" y="14" rx="2"/><path d="M6 18h2m4 0h6"/></g></svg>
              <div class="detail-label shrink-0" data-translate-detail="osInfo">OS:</div>
              <div class="detail-value" data-detail="os">${escapeHtml(osDetailText(item))}</div>
            </div>
            <!-- CPU Info -->
            <div class="detail-item">
              <svg class="detail-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M12 20v2m0-20v2m5 16v2m0-20v2M2 12h2m-2 5h2M2 7h2m16 5h2m-2 5h2M20 7h2M7 20v2M7 2v2"/><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="8" height="8" x="8" y="8" rx="1"/></g></svg>
              <div class="detail-label shrink-0" data-translate-detail="cpuInformation">CPU:</div>
              <div class="detail-value" data-detail="cpu_model">${escapeHtml(cpuModelText(item.cpu_model))}</div>
            </div>
            <!-- Memory Info -->
            <div class="detail-item">
              <svg class="detail-icon" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M12 12v-2m0 8v-2m4-4v-2m0 8v-2M2 11h1.5M20 18v-2m.5-5H22M4 18v-2m4-4v-2m0 8v-2"/><rect width="20" height="10" x="2" y="6" rx="2"/></g></svg>
              <div class="detail-label shrink-0" data-translate-detail="memoryInfo">Memory:</div>
              <div class="detail-value" data-detail="memory_info">${escapeHtml(item.memory_info || '-')}</div>
            </div>
            <!-- Swap Info (none when the server has no swap, as Beszel) -->
            <div class="detail-item detail-swap"${noSwap(item.swap_info) ? ' hidden' : ''}>
              <svg class="detail-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 3L4 7l4 4M4 7h16m-4 14l4-4l-4-4m4 4H4"/></svg>
              <div class="detail-label shrink-0" data-translate-detail="swapPartition">Swap:</div>
              <div class="detail-value" data-detail="swap_info">${escapeHtml(item.swap_info || '-')}</div>
            </div>
            <!-- Disk Info -->
            <div class="detail-item">
              <svg class="detail-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 12H2m3.45-6.89L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11M6 16h.01M10 16h.01"/></svg>
              <div class="detail-label shrink-0" data-translate-detail="diskInformation">Disk:</div>
              <div class="detail-value" data-detail="disk_info">${escapeHtml(item.disk_info || '-')}</div>
            </div>
            ${showTrafficInfo ? `
            <!-- Real-time Traffic -->
            <div class="detail-item" data-traffic-row="speed">
              <svg class="detail-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/></svg>
              <div class="detail-label shrink-0" data-translate-detail="realtimeTraffic">Speed:</div>
              ${(item.alert || (!item.cpu_model && !item.memory_info && !item.disk_info)) ? `
              <div class="detail-value" data-traffic-placeholder="speed">-</div>
              ` : `
              <div class="detail-value detail-pair flex items-center gap-2.5" data-traffic-values="speed">
                <span class="flex items-center gap-[3px]" data-detail-speed="in">
                  <svg class="w-[10px] h-[10px] sm:w-3 sm:h-3 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12l7 7 7-7"/></svg>
                  <span>${formatTrafficSpeed(item.net_in_mb_s || 0)}</span>
                </span>
                <span class="flex items-center gap-[3px]" data-detail-speed="out">
                  <svg class="w-[10px] h-[10px] sm:w-3 sm:h-3 text-blue-600 dark:text-blue-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg>
                  <span>${formatTrafficSpeed(item.net_out_mb_s || 0)}</span>
                </span>
              </div>
              `}
            </div>
            <!-- Total Traffic -->
            <div class="detail-item" data-traffic-row="total">
              <svg class="detail-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 7V5a1 1 0 0 0-1-1H6.5a.5.5 0 0 0-.4.8l4.5 6a2 2 0 0 1 0 2.4l-4.5 6a.5.5 0 0 0 .4.8H17a1 1 0 0 0 1-1v-2"/></svg>
              <div class="detail-label shrink-0" data-translate-detail="totalTraffic" data-translate-title="totalTrafficHint" title="Since the server last booted">Traffic:</div>
              ${(!item.cpu_model && !item.memory_info && !item.disk_info) ? `
              <div class="detail-value" data-traffic-placeholder="total">-</div>
              ` : `
              <div class="detail-value detail-pair flex items-center gap-2.5" data-traffic-values="total">
                <span class="flex items-center gap-[3px]" data-detail-total="in">
