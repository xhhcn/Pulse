---
import Icon from './Icon.astro';
---

<div id="system-table-header-container" class="mt-3 sm:mt-0 mb-4 flex flex-wrap items-end justify-between gap-3 sm:gap-4">
  <div id="system-table-header-text">
    <div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1.5">
      <p id="all-systems-title" class="text-[1.4rem] sm:text-2xl font-semibold tracking-tight text-[#1d1d20] dark:text-[#f5f5f5] leading-none sm:leading-none">All Services</p>
      <!-- Live summary (SystemTable fills it from the same list as the rows). -->
      <p id="systems-summary" class="hidden flex flex-wrap items-center gap-1.5 text-xs font-medium leading-none"></p>
    </div>
    <p id="all-systems-desc" class="text-sm text-[#595959] dark:text-[#ababab] leading-tight pb-0.5">Updated in real time. Click on a service to view information.</p>
  </div>
  <!-- Filter and view menu, as in Beszel: one height, radius, border and
       ground for both; the menu sorts by any column (also a click on a column
       header) and shows all, online or offline services. -->
  <div class="flex items-center gap-2 w-full sm:w-auto pb-0.5">
    <div class="relative flex-1 sm:flex-none">
      <input
        id="system-filter-input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        class="toolbar-control w-full sm:w-56 md:w-[272px] pl-4 pr-10 text-sm leading-normal"
        aria-keyshortcuts="Control+K Meta+K /"
        placeholder="Filter..."
        data-placeholder-en="Filter..."
        data-placeholder-zh="筛选..."
      />
      <button id="system-filter-clear" type="button" class="hidden absolute right-1 top-1/2 -translate-y-1/2 h-7 w-7 items-center justify-center rounded-[10.8px] text-[#595959] dark:text-[#ababab] hover:bg-[#f3efec]/70 dark:hover:bg-[#282828]/70 hover:text-[#1d1d20] dark:hover:text-[#f5f5f5]" aria-label="Clear" title="Clear">
        <Icon name="x" size={16} class="w-4 h-4" />
      </button>
    </div>
    <div class="relative" id="columns-dropdown-container">
      <button id="columns-btn" type="button" class="toolbar-control toolbar-icon-btn flex items-center justify-center text-[#1d1d20] dark:text-[#f5f5f5]" aria-haspopup="menu" aria-expanded="false" aria-controls="columns-dropdown" aria-label="View options" title="View options">
        <Icon name="settings-2" size={16} class="w-4 h-4 opacity-80" />
      </button>
      <div id="columns-dropdown" class="view-menu absolute right-0 top-full mt-2 hidden z-10" role="menu" aria-labelledby="columns-btn">
        <div class="view-menu-grid">
          <div class="view-menu-section view-menu-layout">
            <div class="view-menu-label"><Icon name="layout-grid" size={14} class="w-3.5 h-3.5" /><span data-translate="layout">Layout</span></div>
            <button type="button" role="menuitemradio" class="layout-option view-menu-item" data-layout="table"><span class="layout-indicator view-menu-mark"></span><Icon name="layout-list" size={14} class="w-3.5 h-3.5 view-menu-icon" /><span data-translate="layoutTable">Table</span></button>
            <button type="button" role="menuitemradio" class="layout-option view-menu-item" data-layout="grid"><span class="layout-indicator view-menu-mark"></span><Icon name="layout-grid" size={14} class="w-3.5 h-3.5 view-menu-icon" /><span data-translate="layoutGrid">Cards</span></button>
          </div>
          <div class="view-menu-section">
            <div class="view-menu-label"><Icon name="filter" size={14} class="w-3.5 h-3.5" /><span data-translate="status">Status</span></div>
            <button type="button" role="menuitemradio" class="status-option view-menu-item" data-status="all"><span class="status-indicator view-menu-mark"></span><span data-translate="statusAll">All</span><span class="status-count" data-count="all"></span></button>
            <button type="button" role="menuitemradio" class="status-option view-menu-item" data-status="online"><span class="status-indicator view-menu-mark"></span><span data-translate="statusOnline">Online</span><span class="status-count" data-count="online"></span></button>
            <button type="button" role="menuitemradio" class="status-option view-menu-item" data-status="offline"><span class="status-indicator view-menu-mark"></span><span data-translate="statusOffline">Offline</span><span class="status-count" data-count="offline"></span></button>
          </div>
          <div class="view-menu-section">
            <div class="view-menu-label"><Icon name="arrow-up-down" size={14} class="w-3.5 h-3.5" /><span id="sort-by-label">Sort by</span></div>
            <button type="button" role="menuitemradio" class="sort-option view-menu-item" data-sort=""><span class="sort-indicator view-menu-mark"></span><span data-translate="defaultOrder">Default order</span></button>
            <button type="button" role="menuitemradio" class="sort-option view-menu-item" data-sort="name"><span class="sort-indicator view-menu-mark"></span><span data-translate="name">Name</span></button>
            <button type="button" role="menuitemradio" class="sort-option view-menu-item" data-sort="time"><span class="sort-indicator view-menu-mark"></span><span data-translate="time">Uptime</span></button>
            <button type="button" role="menuitemradio" class="sort-option view-menu-item" data-sort="location"><span class="sort-indicator view-menu-mark"></span><span data-translate="location">Location</span></button>
            <button type="button" role="menuitemradio" class="sort-option view-menu-item" data-sort="cpu"><span class="sort-indicator view-menu-mark"></span><span data-translate="cpu">CPU</span></button>
            <button type="button" role="menuitemradio" class="sort-option view-menu-item" data-sort="memory"><span class="sort-indicator view-menu-mark"></span><span data-translate="memory">Memory</span></button>
            <button type="button" role="menuitemradio" class="sort-option view-menu-item" data-sort="disk"><span class="sort-indicator view-menu-mark"></span><span data-translate="disk">Disk</span></button>
            <button type="button" role="menuitemradio" class="sort-option view-menu-item" data-sort="net"><span class="sort-indicator view-menu-mark"></span><span data-translate="net">Net</span></button>
            <button type="button" role="menuitemradio" class="sort-option view-menu-item" data-sort="os"><span class="sort-indicator view-menu-mark"></span><span data-translate="os">OS</span></button>
          </div>
          <div class="view-menu-section">
            <div class="view-menu-label"><Icon name="eye" size={14} class="w-3.5 h-3.5" /><span data-translate="visibleFields">Visible fields</span></div>
            <button type="button" role="menuitemcheckbox" class="column-option view-menu-item" data-col="uptime"><span class="column-indicator view-menu-mark"></span><span data-translate="time">Uptime</span></button>
            <button type="button" role="menuitemcheckbox" class="column-option view-menu-item" data-col="location"><span class="column-indicator view-menu-mark"></span><span data-translate="location">Location</span></button>
            <button type="button" role="menuitemcheckbox" class="column-option view-menu-item" data-col="cpu"><span class="column-indicator view-menu-mark"></span><span data-translate="cpu">CPU</span></button>
            <button type="button" role="menuitemcheckbox" class="column-option view-menu-item" data-col="memory"><span class="column-indicator view-menu-mark"></span><span data-translate="memory">Memory</span></button>
            <button type="button" role="menuitemcheckbox" class="column-option view-menu-item" data-col="disk"><span class="column-indicator view-menu-mark"></span><span data-translate="disk">Disk</span></button>
            <button type="button" role="menuitemcheckbox" class="column-option view-menu-item" data-col="net"><span class="column-indicator view-menu-mark"></span><span data-translate="net">Net</span></button>
            <button type="button" role="menuitemcheckbox" class="column-option view-menu-item" data-col="os"><span class="column-indicator view-menu-mark"></span><span data-translate="os">OS</span></button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  #system-filter-clear:not(.hidden) { display: inline-flex; }

  /* The menu: Beszel's popover (card ground, hairline border, soft shadow),
     sort and status side by side from 640 px. */
  /* Beszel's dropdown: radius-md, the popover ground (in dark the page's,
     a step below the card), shadow-md; section labels in the text colour
     at 0.95 em, semibold, with their icon and a separator; items at 0.95 em
     with the check in a 32 px gutter, their hover Beszel's accent. */
  .view-menu {
    width: min(92vw, 640px);
    max-height: min(70vh, 560px);
    overflow-y: auto;
    padding: 4px;
    border-radius: 10.8px;
    border: 1px solid #dadada;
    background-color: #ffffff;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
  }
  html.dark .view-menu {
    border-color: #2c2c2c;
    background-color: #171717;
  }
  /* Beszel's dropdown entrance (tw-animate-css): a fade from 95 % and 8 px
     above, 150 ms, grown from the corner by its button. */
  .view-menu:not(.hidden) { animation: view-menu-in 150ms ease-out; transform-origin: top right; }
  @keyframes view-menu-in { from { opacity: 0; transform: translateY(-8px) scale(0.95); } }
  @media (prefers-reduced-motion: reduce) {
    .view-menu:not(.hidden) { animation: none; }
  }
  /* Beszel's four sections side by side from 640 px (layout, status, sort,
     visible fields), stacked below; the layout choice only matters from
     768 px, where the table is shown (phones always get cards). */
  .view-menu-grid { display: grid; grid-template-columns: 1fr; }
  .view-menu-section { padding: 0 2px 2px; min-width: 0; }
  @media (min-width: 640px) {
    .view-menu-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .view-menu-section + .view-menu-section { border-left: 1px solid #dadada; }
    html.dark .view-menu-section + .view-menu-section { border-left-color: #2c2c2c; }
  }
  @media (max-width: 639.98px) {
    .view-menu-section + .view-menu-section { border-top: 1px solid #dadada; margin-top: 2px; padding-top: 2px; }
    html.dark .view-menu-section + .view-menu-section { border-top-color: #2c2c2c; }
  }
  @media (max-width: 767.98px) {
    .view-menu-layout { display: none; }
    .view-menu-layout + .view-menu-section { border-left: 0; border-top: 0; margin-top: 0; padding-top: 0; }
  }
  @media (min-width: 640px) and (max-width: 767.98px) {
    .view-menu-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .view-menu-icon { flex: none; width: 16px; height: 16px; }
  .view-menu-label {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px 6px;
    margin: 0 -2px 4px;
    border-bottom: 1px solid #f0f0f0;
    font-size: 0.95rem;
    line-height: 1.5;
    font-weight: 600;
    color: #1d1d20;
  }
  .view-menu-label svg { width: 16px; height: 16px; flex: none; }
  html.dark .view-menu-label { border-bottom-color: #292929; color: #f5f5f5; }
  .view-menu-item {
    position: relative;
    display: flex;
    width: 100%;
    align-items: center;
    gap: 8px;
    padding: 6px 10px 6px 32px;
    border-radius: 8.8px;
    font-size: 0.95rem;
    line-height: 1.5;
    text-align: left;
    color: #1d1d20;
  }
  html.dark .view-menu-item { color: #f5f5f5; }
  .view-menu-item:hover,
  .view-menu-item:focus-visible { background-color: rgba(243, 239, 236, 0.7); outline: none; }
  html.dark .view-menu-item:hover,
  html.dark .view-menu-item:focus-visible { background-color: rgba(40, 40, 40, 0.7); }
  .view-menu-mark { position: absolute; left: 8px; top: 50%; transform: translateY(-50%); display: inline-flex; width: 16px; height: 16px; align-items: center; justify-content: center; color: currentColor; }
  .status-count { margin-left: auto; font-size: 12px; color: #595959; font-variant-numeric: tabular-nums; }
  html.dark .status-count { color: #ababab; }
</style>

<script>
  // initI18n() wires the global `languagechange` event onto a
  // `translate` event — the inline dictionary below listens for both
  // to stay in sync with NavBar / SystemTable language switches.
  // `t()` is handled locally so we don't import it; getLanguage()
  // decides which side of the dictionary to show.
  import { getLanguage, initI18n } from '../utils/i18n.ts';

  initI18n();
  
  // Translation map for this component
  const translations = {
    'allSystems': { en: 'All Services', zh: '所有服务' },
    'updatedInRealTime': { en: 'Updated in real time. Click on a service to view information.', zh: '实时更新，点击服务查看详细信息。' },
    'filter': { en: 'Filter...', zh: '筛选...' },
    'viewOptions': { en: 'View options', zh: '视图选项' },
    'clear': { en: 'Clear', zh: '清除' },
    'sortBy': { en: 'Sort by', zh: '排序方式' },
    'defaultOrder': { en: 'Default order', zh: '默认顺序' },
    'name': { en: 'Name', zh: '名称' },
    'time': { en: 'Uptime', zh: '运行时间' },
    'location': { en: 'Location', zh: '位置' },
    'cpu': { en: 'CPU', zh: 'CPU' },
    'memory': { en: 'Memory', zh: '内存' },
    'disk': { en: 'Disk', zh: '磁盘' },
    'net': { en: 'Net', zh: '网络' },
    'os': { en: 'OS', zh: '系统' },
    'status': { en: 'Status', zh: '状态' },
    'layout': { en: 'Layout', zh: '布局' },
    'layoutTable': { en: 'Table', zh: '表格' },
    'layoutGrid': { en: 'Cards', zh: '卡片' },
    'visibleFields': { en: 'Visible fields', zh: '显示的列' },
    'statusAll': { en: 'All', zh: '全部' },
    'statusOnline': { en: 'Online', zh: '在线' },
    'statusOffline': { en: 'Offline', zh: '离线' },
  };
  
  function updateTranslations() {
    const lang = getLanguage();
    
    // Update title
    const title = document.getElementById('all-systems-title');
    if (title) title.textContent = translations.allSystems[lang];
    
    // Update description
    const desc = document.getElementById('all-systems-desc');
    if (desc) desc.textContent = translations.updatedInRealTime[lang];
    
    // Update filter placeholder
    const filterInput = document.getElementById('system-filter-input');
    if (filterInput) {
      filterInput.placeholder = translations.filter[lang];
    }
    
    // View menu button and the filter's clear button
    const columnsBtn = document.getElementById('columns-btn');
    if (columnsBtn) {
      columnsBtn.setAttribute('aria-label', translations.viewOptions[lang]);
      columnsBtn.setAttribute('title', translations.viewOptions[lang]);
    }
    const clearBtn = document.getElementById('system-filter-clear');
    if (clearBtn) {
      clearBtn.setAttribute('aria-label', translations.clear[lang]);
      clearBtn.setAttribute('title', translations.clear[lang]);
    }
    
    // Update sort by label
    const sortByLabel = document.getElementById('sort-by-label');
    if (sortByLabel) sortByLabel.textContent = translations.sortBy[lang];
    
    // Update sort options
    document.querySelectorAll('[data-translate]').forEach(el => {
      const key = el.getAttribute('data-translate');
      if (key && translations[key]) {
        el.textContent = translations[key][lang];
      }
    });
  }
  
  // Listen for language changes
  window.addEventListener('languagechange', updateTranslations);
  window.addEventListener('translate', updateTranslations);
  
  // Initial translation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateTranslations);
  } else {
    updateTranslations();
  }
</script>
