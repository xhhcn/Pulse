  // Pages (分页显示): the switch, and with it on, the page size, typed
  // (1–200). Off, the field is disabled as well as hidden: the browser checks
  // only enabled fields, and a hidden one it cannot point at would block Save.
  function syncPageSizeRow() {
    const on = !!document.getElementById('page-size-toggle')?.checked;
    const row = document.getElementById('page-size-row');
    const input = document.getElementById('page-size-input');
    row?.classList.toggle('hidden', !on);
    row?.classList.toggle('flex', on);
    if (input) {
      input.disabled = !on;
      if (on && !input.value) input.value = '20';
    }
  }
  function showPageSize(size) {
    const toggle = document.getElementById('page-size-toggle');
    const input = document.getElementById('page-size-input');
    if (toggle) toggle.checked = size > 0;
    if (input) input.value = String(size > 0 ? size : 20);
