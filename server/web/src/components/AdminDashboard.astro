  if (logoutBtn) {
    logoutBtn.addEventListener('click', () => {
      // Revoke the session server-side too. Dropping the token from
      // localStorage only blinds this browser — the bearer token stays
      // valid until it expires, so anyone who captured it keeps admin
      // access. Best effort: `keepalive` lets the POST outlive the
      // navigation below, and a failure must never block the logout.
      const token = localStorage.getItem('admin_auth_token');
      if (token) {
        try {
          fetch(`${apiBase}/api/auth/logout`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}` },
            keepalive: true
          }).catch(() => {});
        } catch (_) {
          // Ignore — the local logout below must still happen.
        }
      }
      // Clear admin token and redirect to login
      localStorage.removeItem('admin_auth_token');
      window.location.href = '/login?redirect=/admin';
    });
