---
import Icon from './Icon.astro';
import { FLAG_ICONS, LOCAL_ICONS } from '../utils/icon-manifest.ts';

// The flags shipped with the dashboard, by country code ("DE" → "germany"),
// for the inline script's location badges (it cannot import modules).
const localFlags = Object.fromEntries(
  Object.entries(FLAG_ICONS)
    .filter(([, name]) => LOCAL_ICONS.has(`emojione-v1:${name}`))
    .map(([code, name]) => [code, name.replace(/^flag-for-/, '')])
);

const { apiBase: apiBaseProp } = Astro.props ?? {};
const apiBase = apiBaseProp ?? '';

// Build the custom-CSS/JS textarea placeholder in the frontmatter rather
// than inlining the literal HTML attribute. The dev-time dependency
// scanner that astro dev runs (via Vite/esbuild) does a regex pass for
// script blocks in .astro source. If it sees the matching open and
// close tags anywhere -- even inside a JS string constant -- it pulls
// every line between them as JS and chokes on whatever that turns out
// to be. The production astro build path uses a different pipeline and
// was never affected, but devs running npm run dev would hit a crash
// on first start. Splitting the angle bracket off into its own
// concatenation keeps the rendered output identical while keeping the
// scanner blind to the example tags. Note: this same constraint
// applies to comments in this file -- never put the matching tags
// literally next to each other; reference them via parts instead.
const lt = '<';
const customCodePlaceholder = [
	'/* Custom CSS */',
	lt + 'style>',
	"body { font-family: 'Arial', sans-serif; }",
	'#all-systems-title { color: #ff6b6b; }',
	lt + '/style>',
	'',
	'/* Inline JavaScript */',
	lt + 'script>',
	"console.log('Custom code loaded!');",
	lt + '/script>',
	'',
	'/* External Libraries */',
	lt + 'script src="https://cdn.jsdelivr.net/...">' + lt + '/script>',
].join('\n');
---

<div class="mx-auto max-w-[1568px]">
  <!-- System List -->
  <div class="glass-card mb-4 sm:mb-6 rounded-xl border border-[#404040]/50 dark:border-[#2c2c2c]/60 border-[#d4d4d4]/50 bg-[#1c1c1c] dark:bg-[#1a1a1a] bg-white px-3 py-5 sm:p-6">
    <div class="mb-3 sm:mb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div class="px-2 sm:px-1">
        <h1 id="system-list-title" class="text-[1.4rem] sm:text-2xl font-semibold tracking-tight leading-none sm:leading-none text-[#1d1d20] dark:text-[#f5f5f5]" data-translate="systemList">Server List</h1>
        <p class="mt-1.5 text-sm text-[#595959] dark:text-[#ababab] [text-wrap:pretty]" data-translate="systemListDesc">Drag to reorder; the dashboard shows the servers in this order.</p>
      </div>
      <!-- Beszel's toolbar: outline buttons with labels (its "Add System"),
           the settings and the sign-out in one menu of labelled items, and
           refresh as an icon. The items keep the buttons' ids (their
           dialogs bind to them). -->
      <div class="flex items-center gap-2 px-1 sm:px-0">
        <button id="refresh-btn" type="button" class="toolbar-control toolbar-icon-btn inline-flex items-center justify-center" title="Refresh" aria-label="Refresh" data-title-en="Refresh" data-title-zh="刷新">
          <Icon name="refresh-cw" size={16} class="w-4 h-4" />
        </button>
        <div class="relative">
          <button id="admin-menu-btn" type="button" class="toolbar-control toolbar-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="admin-menu">
            <Icon name="settings" size={16} class="w-4 h-4" />
            <span data-translate="settingsMenu">Settings</span>
            <Icon name="chevron-down" size={16} class="w-4 h-4 -me-1 opacity-60" />
          </button>
          <div id="admin-menu" class="admin-menu hidden" role="menu" aria-labelledby="admin-menu-btn">
            <button id="navbar-config-btn" type="button" role="menuitem" class="admin-menu-item"><Icon name="settings" size={16} class="w-4 h-4" /><span data-translate="customizationSettings">Customization Settings</span></button>
            <button id="tcping-config-btn" type="button" role="menuitem" class="admin-menu-item"><Icon name="activity" size={16} class="w-4 h-4" /><span data-translate="tcpingSettings">TCPing Settings</span></button>
            <button id="privacy-config-btn" type="button" role="menuitem" class="admin-menu-item"><Icon name="shield" size={16} class="w-4 h-4" /><span data-translate="privacySettings">Privacy Settings</span></button>
            <div class="admin-menu-sep" role="separator"></div>
            <button id="backup-btn" type="button" role="menuitem" class="admin-menu-item"><Icon name="download" size={16} class="w-4 h-4" /><span data-translate="downloadBackup">Download Backup</span></button>
            <button id="change-password-btn" type="button" role="menuitem" class="admin-menu-item"><Icon name="lock" size={16} class="w-4 h-4" /><span data-translate="changePassword">Change Password</span></button>
            <div class="admin-menu-sep" role="separator"></div>
            <button id="logout-btn" type="button" role="menuitem" class="admin-menu-item"><Icon name="log-out" size={16} class="w-4 h-4" /><span data-translate="logout">Log Out</span></button>
          </div>
        </div>
        <button id="add-system-btn" type="button" class="toolbar-control toolbar-btn">
          <Icon name="plus" size={16} class="w-4 h-4 -ms-1" />
          <span data-translate="addSystem">Add Server</span>
        </button>
      </div>
    </div>

    <!-- One list in a box, as the dashboard's table and Beszel's: rows with
         hairline dividers, scrolling with the page. -->
    <p id="reorder-status" class="sr-only" role="status" aria-live="polite"></p>
    <div id="systems-list" class="glass-inner rounded-[10.8px] border border-[#dadada]/60 dark:border-[#2c2c2c]/60 divide-y divide-[#dadada]/60 dark:divide-[#2c2c2c]/60" data-draggable-list>
      <div class="flex items-center justify-center py-12">
        <div id="loading-systems-text" class="text-sm text-[#595959] dark:text-[#ababab]" data-translate="loadingSystems">Loading systems...</div>
      </div>
    </div>
  </div>

  <!-- Add System Modal -->
  <div id="add-system-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40" role="dialog" aria-modal="true" aria-labelledby="add-new-system-title" data-modal>
    <div class="mx-4 w-full max-w-lg rounded-xl border border-[#404040]/50 dark:border-[#2c2c2c]/60 border-[#d4d4d4]/50 bg-[#1c1c1c] dark:bg-[#1a1a1a] bg-white p-6 shadow-lg" data-modal-content>
      <div class="mb-4 flex items-center justify-between">
        <h2 id="add-new-system-title" class="text-lg font-semibold leading-none tracking-tight text-[#1d1d20] dark:text-[#f5f5f5]" data-translate="addNewSystem">Add New System</h2>
        <button id="close-add-modal-btn" class="rounded-lg p-1 text-[#595959] dark:text-[#ababab] transition-colors hover:bg-[#282828] dark:hover:bg-[#282828] hover:bg-[#f0f0f0] hover:text-[#1d1d20] dark:hover:text-[#e5e5e5]" title="Close" aria-label="Close" data-title-en="Close" data-title-zh="关闭">
          <Icon name="x" size={20} />
        </button>
      </div>

      <form id="add-system-form" class="space-y-4">
        <div>
          <label for="add-system-name-input" class="mb-1.5 block text-sm font-medium text-[#1d1d20] dark:text-[#f5f5f5]"><span data-translate="systemName">System Name</span> <span class="text-red-500 dark:text-red-400">*</span></label>
          <input id="add-system-name-input"
            type="text"
            name="name"
            required
            placeholder=""
            data-placeholder-en="My Server"
            data-placeholder-zh="我的服务器"
            class="w-full toolbar-control px-3 text-sm"
          />
          <p class="mt-1 text-xs text-[#595959] dark:text-[#ababab]" data-translate="displayNameForThisSystem">Display name for this server</p>
        </div>

        <div class="rounded-lg bg-[#282828] dark:bg-[#282828] bg-[#f5f5f5] p-3">
          <p class="text-xs text-[#595959] dark:text-[#ababab]">
            <strong data-translate="note">Note:</strong> <span data-translate="noteContent">IP addresses, location, OS and metrics are automatically updated by the agent and cannot be edited manually.</span>
          </p>
        </div>

        <div id="add-form-message" class="hidden text-sm"></div>

        <div class="flex gap-3">
          <button
            type="button"
            id="cancel-add-btn"
            class="flex-1 toolbar-control toolbar-btn"
          >
            <span data-translate="cancel">Cancel</span>
          </button>
          <button
            type="submit"
            class="flex-1 h-10 rounded-lg bg-[#171717] px-4 text-sm font-medium text-white transition-colors hover:bg-[#2a2a2a] dark:bg-[#f5f5f5] dark:text-[#171717] dark:hover:bg-[#e0e0e0]"
          >
            <span data-translate="addSystem">Add System</span>
          </button>
        </div>
      </form>

      <!-- Once the server is added: how to install its client, in place of the
           form (Beszel's Add System dialog carries the agent's command too).
           The commands are the ones the row's Linux and Windows buttons copy. -->
      <div id="add-system-install" class="hidden space-y-4">
        <p id="add-install-desc" class="text-sm text-[#595959] dark:text-[#ababab] [text-wrap:pretty]"></p>
        <pre id="add-install-command" class="max-h-40 overflow-auto whitespace-pre-wrap break-all rounded-lg bg-[#f5f5f5] dark:bg-[#282828] p-3 font-mono text-xs leading-5 text-[#1d1d20] dark:text-[#d4d4d4]"></pre>
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          <button type="button" id="copy-install-linux-btn" class="toolbar-control toolbar-btn min-w-0" data-kind="linux">
            <svg class="shrink-0" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24">
                <g fill="none" fill-rule="evenodd"><path d="m12.594 23.258l-.012.002l-.071.035l-.02.004l-.014-.004l-.071-.036q-.016-.004-.024.006l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.016-.018m.264-.113l-.014.002l-.184.093l-.01.01l-.003.011l.018.43l.005.012l.008.008l.201.092q.019.005.029-.008l.004-.014l-.034-.614q-.005-.019-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.003-.011l.018-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M8.264 15.29a1 1 0 0 1 .822.522l1.892 3.493a1.809 1.809 0 0 1-1.856 2.65l-3.93-.582a1 1 0 0 1-.672-1.563l.623-.89l-.174-.984a1 1 0 0 1 .811-1.159l.985-.173l.623-.89a1 1 0 0 1 .876-.425Zm6.347-.024a1 1 0 0 1 .858-.043l.116.057l.94.543l.966-.259a1 1 0 0 1 1.188.596l.037.111l.259.966l.94.543a1 1 0 0 1 .154 1.623l-.103.078l-3.315 2.188a1.809 1.809 0 0 1-2.805-1.46l.003-.158l.238-3.965a1 1 0 0 1 .524-.82M12 2a4 4 0 0 1 4 4v1c0 1.214.502 2.267 1.166 3.354l.736 1.165c.1.16.195.315.28.457c.32.541.628 1.14.788 1.781a7 7 0 0 1 .194 1.358a2 2 0 0 0-1.932-.516l-.565.151l-.582-.336a2 2 0 0 0-2.996 1.613l-.238 3.965c-.021.345.022.684.121 1.003l-.269.005h-.406q-.114 0-.226-.004c.22-.71.152-1.492-.214-2.167l-1.891-3.493a2 2 0 0 0-3.397-.195l-.385.55l-.33.058a5.4 5.4 0 0 1 .024-1.16c.037-.285.086-.567.152-.832c.198-.792.535-1.459.857-2.02l.437-.74C7.74 10.28 8 9.722 8 9V6a4 4 0 0 1 4-4m-1.438 5.778l-.822.41c.224.597.572 1.156.897 1.6l.204.269l.184.225l.081.094l.25-.141l.329-.197c.176-.109.368-.232.566-.367c.604-.412 1.225-.91 1.662-1.427l-2.316-.58a1.5 1.5 0 0 0-1.035.114"/></g>
              </svg>
            <span class="min-w-0 truncate" data-copy-label data-translate="installCopyLinux">Copy for Linux</span>
          </button>
          <button type="button" id="copy-install-windows-btn" class="toolbar-control toolbar-btn min-w-0" data-kind="windows">
            <svg class="shrink-0" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24">
                <g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M21 13v7.434a1.5 1.5 0 0 1-1.553 1.499l-.133-.011L12 21.008V13zm-11 0v7.758l-5.248-.656A2 2 0 0 1 3 18.117V13zm9.314-10.922a1.5 1.5 0 0 1 1.68 1.355l.006.133V11h-9V2.992zM10 3.242V11H3V5.883a2 2 0 0 1 1.752-1.985z"/></g>
              </svg>
            <span class="min-w-0 truncate" data-copy-label data-translate="installCopyWindows">Copy for Windows</span>
          </button>
        </div>
        <div class="flex justify-end">
          <button type="button" id="add-install-done-btn" class="h-10 min-w-24 rounded-lg bg-[#171717] px-6 text-sm font-medium text-white transition-colors hover:bg-[#2a2a2a] dark:bg-[#f5f5f5] dark:text-[#171717] dark:hover:bg-[#e0e0e0]">
            <span data-translate="done">Done</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit System Modal -->
  <div id="edit-system-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40" role="dialog" aria-modal="true" aria-labelledby="edit-system-title" data-modal>
    <div class="mx-4 w-full max-w-lg rounded-xl border border-[#404040]/50 dark:border-[#2c2c2c]/60 border-[#d4d4d4]/50 bg-[#1c1c1c] dark:bg-[#1a1a1a] bg-white p-6 shadow-lg" data-modal-content>
      <div class="mb-4 flex items-center justify-between">
        <h2 id="edit-system-title" class="text-lg font-semibold leading-none tracking-tight text-[#1d1d20] dark:text-[#f5f5f5]" data-translate="editSystem">Edit System</h2>
        <button id="close-edit-modal-btn" class="rounded-lg p-1 text-[#595959] dark:text-[#ababab] transition-colors hover:bg-[#282828] dark:hover:bg-[#282828] hover:bg-[#f0f0f0] hover:text-[#1d1d20] dark:hover:text-[#e5e5e5]" title="Close" aria-label="Close" data-title-en="Close" data-title-zh="关闭">
          <Icon name="x" size={20} />
        </button>
      </div>

      <form id="edit-system-form" class="space-y-4">
        <input type="hidden" name="original-id" value="" />
        
        <div>
          <label for="edit-system-name-input" class="mb-1.5 block text-sm font-medium text-[#1d1d20] dark:text-[#f5f5f5]"><span data-translate="systemName">System Name</span> <span class="text-red-500 dark:text-red-400">*</span></label>
          <input id="edit-system-name-input"
            type="text"
            name="name"
            required
            placeholder=""
            data-placeholder-en="My Server"
            data-placeholder-zh="我的服务器"
            class="w-full toolbar-control px-3 text-sm"
          />
        </div>

        <div>
          <label for="edit-tags-input" class="mb-1.5 block text-sm font-medium text-[#1d1d20] dark:text-[#f5f5f5]"><span data-translate="tags">Tags</span> <span class="text-xs text-[#595959] dark:text-[#ababab]" data-translate="tagsCommaSeparated">(comma-separated)</span></label>
          <input
            type="text"
            name="tags"
            id="edit-tags-input"
            placeholder="Python, traffic:in, speed:in, spr:VIP, spy:staff, spb:pro"
            class="w-full toolbar-control px-3 text-sm"
          />
          <p class="mt-1 text-xs text-[#595959] dark:text-[#ababab]" data-translate="tagsHint">Enter tags separated by commas (e.g., Python, traffic:in, speed:in, spr:VIP, spy:staff, spb:pro)</p>
        </div>

        <!-- Per-system visibility toggles (admin-only; agents never touch them),
             in one list as the settings dialog's display switches -->
        <div class="rounded-[10.8px] border border-[#dadada]/60 dark:border-[#2c2c2c]/60 divide-y divide-[#dadada]/60 dark:divide-[#2c2c2c]/60">
          <div class="flex items-center justify-between gap-3 px-3 py-2.5">
            <div class="flex-1 pr-3">
              <label for="edit-show-on-home" class="block text-sm font-medium text-[#1d1d20] dark:text-[#f5f5f5]" data-translate="showOnHomeLabel">首页展示该服务器</label>
              <p class="text-xs text-[#595959] dark:text-[#ababab]" data-translate="showOnHomeDesc">关闭后首页不再展示该服务器，API 与管理页仍然可见。</p>
            </div>
            <label class="relative inline-flex shrink-0 items-center cursor-pointer">
              <input type="checkbox" id="edit-show-on-home" name="show_on_home" class="sr-only peer" checked>
              <div class="w-11 h-6 bg-[#d4d4d4] dark:bg-[#404040] peer-focus-visible:outline-none peer-focus-visible:ring-2 peer-focus-visible:ring-[#837e79] dark:peer-focus-visible:ring-[#cacbce] peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white dark:peer-focus-visible:ring-offset-[#1a1a1a] rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#171717] dark:peer-checked:bg-[#f5f5f5] dark:peer-checked:after:bg-[#171717] dark:peer-checked:after:border-[#171717]"></div>
            </label>
          </div>
          <div class="flex items-center justify-between gap-3 px-3 py-2.5">
            <div class="flex-1 pr-3">
              <label for="edit-show-tcping" class="block text-sm font-medium text-[#1d1d20] dark:text-[#f5f5f5]" data-translate="showTcpingLabel">展示 TCPing</label>
              <p class="text-xs text-[#595959] dark:text-[#ababab]" data-translate="showTcpingDesc">关闭后首页不再展示该服务器的 TCPing 图表。</p>
            </div>
            <label class="relative inline-flex shrink-0 items-center cursor-pointer">
              <input type="checkbox" id="edit-show-tcping" name="show_tcping" class="sr-only peer" checked>
              <div class="w-11 h-6 bg-[#d4d4d4] dark:bg-[#404040] peer-focus-visible:outline-none peer-focus-visible:ring-2 peer-focus-visible:ring-[#837e79] dark:peer-focus-visible:ring-[#cacbce] peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-white dark:peer-focus-visible:ring-offset-[#1a1a1a] rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#171717] dark:peer-checked:bg-[#f5f5f5] dark:peer-checked:after:bg-[#171717] dark:peer-checked:after:border-[#171717]"></div>
            </label>
          </div>
        </div>

        <div class="rounded-lg bg-[#282828] dark:bg-[#282828] bg-[#f5f5f5] p-3">
          <p class="text-xs text-[#595959] dark:text-[#ababab]">
            <strong data-translate="note">Note:</strong> <span data-translate="noteContent">IP addresses, location, OS and metrics are automatically updated by the agent and cannot be edited manually.</span>
          </p>
        </div>

        <div id="edit-form-message" class="hidden text-sm"></div>

        <div class="flex gap-3">
          <button
            type="button"
            id="cancel-edit-btn"
            class="flex-1 toolbar-control toolbar-btn"
          >
            <span data-translate="cancel">Cancel</span>
          </button>
          <button
            type="submit"
            class="flex-1 h-10 rounded-lg bg-[#171717] px-4 text-sm font-medium text-white transition-colors hover:bg-[#2a2a2a] dark:bg-[#f5f5f5] dark:text-[#171717] dark:hover:bg-[#e0e0e0]"
          >
            <span data-translate="updateSystem">Save</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="delete-confirm-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40" role="dialog" aria-modal="true" aria-labelledby="delete-system-title" data-modal>
    <div class="mx-4 w-full max-w-lg rounded-xl border border-[#404040]/50 dark:border-[#2c2c2c]/60 border-[#d4d4d4]/50 bg-[#1c1c1c] dark:bg-[#1a1a1a] bg-white p-6 shadow-lg" data-modal-content>
      <div class="mb-4">
        <div class="mb-3 flex items-center gap-3">
          <div class="rounded-full bg-red-500/10 p-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-red-500 dark:text-red-400">
              <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
            </svg>
          </div>
          <h2 id="delete-system-title" class="text-lg font-semibold leading-none tracking-tight text-[#1d1d20] dark:text-[#f5f5f5]" data-translate="deleteSystem">Delete System</h2>
        </div>
        <p class="text-sm text-[#595959] dark:text-[#ababab]">
          <span data-translate="areYouSureYouWantToDelete">Are you sure you want to delete</span> <span class="font-medium text-[#1d1d20] dark:text-[#d4d4d4]" id="delete-system-name"></span>?
        </p>
        <!-- Which one, when names repeat: its location and address -->
        <p id="delete-system-meta" class="mt-1.5 hidden flex-wrap items-center gap-x-1 text-xs text-[#595959] dark:text-[#ababab]"></p>
        <p class="mt-3 flex items-center gap-1.5 text-xs text-red-600 dark:text-red-400">
          <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
          <span data-translate="thisActionCannotBeUndone">This action cannot be undone.</span>
        </p>
      </div>

      <div class="flex gap-3">
        <button
          id="cancel-delete-btn"
