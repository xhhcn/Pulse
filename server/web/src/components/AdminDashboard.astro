<style>
  /* The services list: rows inside one box (the box's corners round the
     first and last row's hover tint). A row is moved by its handle —
     dragged with a mouse, a finger or a pen, or with ↑ / ↓ when the handle
     has focus; the row being dragged lifts above the others. */
  #systems-list > :global(.draggable-item:first-child) { border-top-left-radius: 10.8px; border-top-right-radius: 10.8px; }
  #systems-list > :global(.draggable-item:last-child) { border-bottom-left-radius: 10.8px; border-bottom-right-radius: 10.8px; }
  #systems-list :global(.drag-handle) {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    width: 28px; height: 36px; margin-left: -6px; border-radius: 8.8px;
    color: #595959; cursor: grab; touch-action: none;
  }
  #systems-list :global(.drag-handle:hover) { color: #1d1d20; background-color: rgba(243, 239, 236, 0.7); }
  :global(html.dark) #systems-list :global(.drag-handle) { color: #ababab; }
  :global(html.dark) #systems-list :global(.drag-handle:hover) { color: #f5f5f5; background-color: rgba(40, 40, 40, 0.5); }
  #systems-list :global(.draggable-item.is-dragging) {
    position: relative; z-index: 5; cursor: grabbing;
    background-color: #ffffff; border-radius: 10.8px;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
  }
  :global(html.dark) #systems-list :global(.draggable-item.is-dragging) { background-color: #222222; box-shadow: 0 10px 24px -6px rgba(0, 0, 0, 0.6); }
  #systems-list :global(.draggable-item.is-dragging .drag-handle) { cursor: grabbing; }
  :global(body.is-reordering) { cursor: grabbing; user-select: none; -webkit-user-select: none; }

  /* Rows from 640 to 1023 px. The address column was as wide as each row's
     longest IPv6 address, so the columns started at a different x on every
     row and a long address squeezed the name into a few letters a line. Now
     the name takes 30 % of the row, the traffic totals 7.5rem and the
     address the rest; a long IPv6 address ends in "…" (its tooltip and copy
     button keep all of it). Below 768 px the traffic totals make room for
     the other two. From 1024 px the template's lg: widths apply. The rows
     are built by script, hence :global. */
  @media (min-width: 640px) and (max-width: 1023.98px) {
    #systems-list :global(.admin-name-col) { flex: 0 0 30% !important; }
    #systems-list :global(.ip-info-container) { flex: 1 1 0; min-width: 0; }
    #systems-list :global(.ip-info-container > div) { min-width: 0; }
    #systems-list :global(.system-ipv4),
    #systems-list :global(.system-ipv6) { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    #systems-list :global(.traffic-info-container) { flex: 0 0 7.5rem; }
  }
  @media (min-width: 640px) and (max-width: 767.98px) {
    #systems-list :global(.admin-name-col) { flex-basis: 36% !important; }
    #systems-list :global(.traffic-info-container) { display: none !important; }
  }
  
  /* A dialog that scrolls shows a thin grey scrollbar (it was hidden, so
     nothing told that more was below). Standard properties for Firefox and
     Chromium, ::-webkit-scrollbar for Safari. */
  [data-modal-content],
  .dialog-scroll {
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.22) transparent;
  }
  [data-modal-content]::-webkit-scrollbar,
  .dialog-scroll::-webkit-scrollbar {
    width: 8px;
  }
  [data-modal-content]::-webkit-scrollbar-track,
  .dialog-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  [data-modal-content]::-webkit-scrollbar-thumb,
  .dialog-scroll::-webkit-scrollbar-thumb {
    background-color: rgba(0, 0, 0, 0.22);
    background-clip: padding-box;
    border: 2px solid transparent;
    border-radius: 8px;
  }
  :global(html.dark) [data-modal-content],
  :global(html.dark) .dialog-scroll {
    scrollbar-color: rgba(255, 255, 255, 0.22) transparent;
  }
  :global(html.dark) [data-modal-content]::-webkit-scrollbar-thumb,
  :global(html.dark) .dialog-scroll::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.22);
  }
</style>

<script is:inline>
  // Everything here runs in its own scope. This is a classic script, and so
  // is the site's custom code (run in <head>): a top-level `const root` in
  // the custom code and the declarations below used to collide, and the
  // whole dashboard failed to start ("Identifier 'root' has already been
  // declared"), the dialog where the custom code is edited included.
  (() => {
  const root = document.getElementById('admin-root');
  
  const getApiBase = () => {
    if (root?.dataset.apiBase && root.dataset.apiBase.trim() !== '') {
      return root.dataset.apiBase.trim();
    }
    // Use current origin (works with nginx reverse proxy)
    return window.location.origin;
  };

  // ========================================
  // Modal Animation Utilities
  // ========================================
  
  // Store original parent for modals (to restore after closing)
  const modalOriginalParents = new Map();
  
  // Open modal with animation - moves modal to body to avoid transform issues
  // Keyboard focus follows the dialogs: into a dialog when it opens (it used
  // to stay on the page behind the backdrop, hundreds of Tab presses away),
  // and back to the control that opened it when it closes.
  const MODAL_FOCUSABLE = [
    'input:not([type="hidden"])', 'select', 'textarea', 'button', 'a[href]',
    '[tabindex]:not([tabindex="-1"])',
  ].map((s) => s + ':not([disabled])').join(', ');

  function modalFocusables(modal) {
    const scope = modal.querySelector('[data-modal-content]') || modal;
    return Array.from(scope.querySelectorAll(MODAL_FOCUSABLE)).filter((el) =>
      !el.hidden && !el.closest('[hidden]') && (el.offsetParent !== null || el === document.activeElement));
  }

  function focusFirstInModal(modal) {
    const target = modalFocusables(modal)[0];
    if (target) {
      try { target.focus({ preventScroll: true }); } catch (_) { target.focus(); }
      return;
    }
    if (!modal.hasAttribute('tabindex')) modal.setAttribute('tabindex', '-1');
    try { modal.focus({ preventScroll: true }); } catch (_) { modal.focus(); }
  }

  function restoreFocusAfterModal(modal) {
    const prev = modal._restoreFocus;
    modal._restoreFocus = null;
    if (!prev || typeof prev.focus !== 'function') return;
    // The opener can be gone (the systems list re-renders on save/delete).
    if (!prev.isConnected) return;
    try { prev.focus({ preventScroll: true }); } catch (_) { prev.focus(); }
  }

  function openModalWithAnimation(modal) {
    if (!modal) return;
    
    const content = modal.querySelector('[data-modal-content]');

    // Remember the control that opened this dialog so closing it can hand
    // focus back (not when it is reopened while open).
    const opener = document.activeElement;
    if (opener && opener !== document.body && !modal.contains(opener)) {
      modal._restoreFocus = opener;
    }
    
    // Store original parent if not already stored
    if (!modalOriginalParents.has(modal) && modal.parentElement) {
      modalOriginalParents.set(modal, {
        parent: modal.parentElement,
        nextSibling: modal.nextSibling
      });
    }
    
    // A close animation may still be pending from a click ~150 ms ago;
    // cancel it, otherwise its timer hides the freshly opened modal and
    // runs the reset callback over the user's new input.
    if (modal._closeTimer) { clearTimeout(modal._closeTimer); modal._closeTimer = null; }
    modal.classList.remove('modal-backdrop-exit');
    if (content) content.classList.remove('modal-content-exit');

    // Move modal to body to avoid transform stacking context issues
    document.body.appendChild(modal);
    
    // Show modal
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    
    // Apply entrance animations
    modal.classList.add('modal-backdrop-enter');
    if (content) {
      content.classList.add('modal-content-enter');
    }

    focusFirstInModal(modal);
    
    // Clean up animation classes after animation completes
    setTimeout(() => {
      modal.classList.remove('modal-backdrop-enter');
      if (content) {
        content.classList.remove('modal-content-enter');
      }
    }, 250);
  }
  
  // Close modal with animation
  function closeModalWithAnimation(modal, callback) {
    if (!modal) return;
    
    const content = modal.querySelector('[data-modal-content]');

    // Hand focus back to the opener before the dialog is hidden (focus on a
    // control that turns display:none falls to <body>).
    if (modal.contains(document.activeElement)) restoreFocusAfterModal(modal);
    else modal._restoreFocus = null;
    
    // Apply exit animations
    modal.classList.add('modal-backdrop-exit');
    if (content) {
      content.classList.add('modal-content-exit');
    }
    
    // Hide modal after animation completes (Beszel's 200 ms dialog exit,
    // global.css). The handle is kept on the element so a re-open within
    // the window can cancel it.
    modal._closeTimer = setTimeout(() => {
      modal._closeTimer = null;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modal.classList.remove('modal-backdrop-exit');
      if (content) {
        content.classList.remove('modal-content-exit');
      }
      
      // Move modal back to original parent (optional, helps keep DOM clean)
      const originalInfo = modalOriginalParents.get(modal);
      if (originalInfo && originalInfo.parent) {
        if (originalInfo.nextSibling) {
          originalInfo.parent.insertBefore(modal, originalInfo.nextSibling);
        } else {
          originalInfo.parent.appendChild(modal);
        }
      }
      
      // Execute callback if provided
      if (callback && typeof callback === 'function') {
        callback();
      }
    }, 200);
  }

  // Close the topmost visible modal on Escape.
  //
  // All nine admin modals (add / edit / delete / tcping / navbar /
  // regenerate-secret / privacy / change-password) share the
  // [data-modal] marker and are hidden via the "hidden" class. We
  // look them up *live* on every keypress (not at init time) because
  // openModalWithAnimation moves the modal node under <body>, which
  // means a cached querySelectorAll from init would still work but
  // any future modal added to the markup would be missed.
  //
  // If multiple modals happen to be visible (e.g. the regenerate-
  // secret confirmation opened on top of the navbar-config modal),
  // we close only the last one in DOM order — the one visually on
  // top — and leave the underlying modal open. This matches the
  // user expectation of "Escape closes the thing I just opened".
  // Tab stays inside the topmost open dialog (aria-modal): past its last
  // control it used to walk on through the page behind the backdrop.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const open = Array.from(document.querySelectorAll('[data-modal]')).filter((m) => !m.classList.contains('hidden'));
    const top = open[open.length - 1];
    if (!top) return;
    const items = modalFocusables(top);
    if (items.length === 0) return;
    const first = items[0], last = items[items.length - 1];
    const active = document.activeElement;
    if (!top.contains(active) || (e.shiftKey ? active === first : active === last)) {
      e.preventDefault();
      (e.shiftKey ? last : first).focus();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const openModals = Array.from(document.querySelectorAll('[data-modal]'))
      .filter((m) => !m.classList.contains('hidden'));
    if (openModals.length === 0) return;
    const topModal = openModals[openModals.length - 1];
    // Route through the modal's own close/cancel button so the per-modal
    // reset callback runs (clears stale messages, pending delete ids, an
    // unsaved regenerated secret...). Fall back to a plain close.
    const closer = topModal.querySelector('button[id^="close-"], button[id^="cancel-"]');
    if (closer) closer.click(); else closeModalWithAnimation(topModal);
  });

  // Format bytes to human readable format (B, KiB, MiB, GiB, TiB)
  function formatBytes(bytes) {
    if (!bytes || bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KiB', 'MiB', 'GiB', 'TiB'];
    const i = Math.min(sizes.length - 1, Math.max(0, Math.floor(Math.log(bytes) / Math.log(k))));
    const value = bytes / Math.pow(k, i);
    // CRITICAL: width-stable formatting.
    //
    // Earlier we did `value.toFixed(2).replace(/\.?0+$/, '')`, which
    // produces "1 KiB", "1.5 KiB" and "1.55 KiB" — three different
    // widths for the same column. Combined with a proportional body
    // font, the traffic cell jitters horizontally on
    // every 3 s push, dragging neighbouring cells with it. Always
    // emitting two decimals plus tabular-nums on the wrapping span
    // (see renderSystemItem / updateSystemItem) keeps every traffic
    // value the same number of glyphs and the same on-screen width.
    return `${value.toFixed(2)} ${sizes[i]}`;
  }

  // Get CPU brand icon based on CPU model.
  //
  // Detection order matters:
  //   1. Apple Silicon is technically ARM but we want the Apple logo, so it
  //      must be matched BEFORE the generic ARM rules below.
  //   2. Intel / AMD come next — the safe, well-known x86_64 vendors.
  //   3. Everything else falls through to a broad ARM family detector that
  //      covers Ampere Altra, AWS Graviton (Neoverse), Raspberry Pi
  //      (Broadcom BCM / Cortex-A), Rockchip / Allwinner SBCs, Qualcomm
  //      Snapdragon, Samsung Exynos, HiSilicon Kirin, MediaTek Dimensity,
  //      as well as plain "aarch64" / "ARMv8" kernel strings that Linux
  //      reports on generic ARM servers.
  function getCPUBrandIcon(cpuModel) {
    if (!cpuModel) return null;
    const modelLower = cpuModel.toLowerCase();
    if (modelLower.includes('apple')) {
      return 'logos:apple';
    }
    if (modelLower.includes('intel')) {
      return 'logos:intel';
    }
    if (modelLower.includes('amd') || modelLower.includes('epyc') || modelLower.includes('ryzen')) {
      return 'logos:amd';
    }
    if (
      modelLower.includes('arm') ||
      modelLower.includes('aarch64') ||
      modelLower.includes('cortex') ||
      modelLower.includes('neoverse') ||
      modelLower.includes('ampere') ||
      modelLower.includes('graviton') ||
      modelLower.includes('snapdragon') ||
      modelLower.includes('kirin') ||
      modelLower.includes('exynos') ||
      modelLower.includes('mediatek') ||
      modelLower.includes('dimensity') ||
      modelLower.includes('rockchip') ||
      modelLower.includes('allwinner') ||
      modelLower.includes('broadcom bcm')
    ) {
      return 'logos:arm';
    }
    return null;
  }

  // Module-level cache for iconify SVG text, keyed by icon name.
  // The admin list re-renders on every admin refresh or drag reorder,
  // and previously each render re-fetched the CPU brand logo for every
  // visible row — with ~20 rows that was 20 external requests to
  // api.iconify.design per render. The cache collapses duplicates to
  // a single network request per unique icon across the session.
  // Storing Promise<string|null> means concurrent callers for the same
  // icon share one in-flight fetch, and a failed fetch caches `null`
  // so we don't retry a broken icon on every subsequent render.
  // Icon names must be a plain iconify "prefix:name" pair before they can
  // influence the CDN URL path.
  const ICONIFY_NAME_RE = /^[a-z0-9-]+:[a-z0-9-]+$/i;

  /* The icon response is third-party markup that ends up in the page.
     Accept only a plain <svg> tree: drop scripts, foreignObject, event
     handler attributes and non-image hrefs. Returns null when anything
     looks off so the icon is simply not shown. */
  function sanitizedSvgElement(markup) {
    if (!markup || typeof markup !== 'string') return null;
    let doc;
    try { doc = new DOMParser().parseFromString(markup, 'image/svg+xml'); } catch (_) { return null; }
    const root = doc.documentElement;
    if (!root || root.nodeName.toLowerCase() !== 'svg' || doc.querySelector('parsererror')) return null;
    const banned = /^(script|foreignobject|iframe|object|embed|use|style|animate|set|animatetransform|animatemotion)$/i;
    // Every node, not only elements: comments, CDATA sections and processing
    // instructions are dropped as well.
    const walker = doc.createTreeWalker(root, NodeFilter.SHOW_ALL);
    const toRemove = [];
    let node = walker.currentNode;
    while (node) {
      if (node.nodeType !== Node.ELEMENT_NODE) {
        if (node.nodeType !== Node.TEXT_NODE) toRemove.push(node);
      } else if (banned.test(node.nodeName)) toRemove.push(node);
      else {
        Array.from(node.attributes).forEach((attr) => {
          const n = attr.name.toLowerCase(), v = String(attr.value || '');
          if (n.startsWith('on') || (/href|src/.test(n) && !/^#|^data:image\//i.test(v.trim()))) node.removeAttribute(attr.name);
        });
      }
      node = walker.nextNode();
    }
    toRemove.forEach((n) => n.remove());
    // Handed over as nodes. Serialising and assigning innerHTML re-parsed the
    // XML as HTML, where a comment or CDATA section could turn into live markup.
    return document.importNode(root, true);
  }

  // CPU brand logos are shipped with the dashboard (public/icons, see
  // utils/icons.ts; this inline script cannot import it). Anything else
  // comes from the Iconify API as `prefix/name.svg`: the `prefix:name`
  // form this used to request now answers 404.
  const LOCAL_CPU_ICONS = new Set(['logos:amd', 'logos:apple', 'logos:arm', 'logos:intel']);
  const cpuIconSvgUrl = (iconName) => {
    const [prefix, name] = iconName.split(':');
    return LOCAL_CPU_ICONS.has(iconName)
      ? `/icons/${prefix}/${name}.svg`
      : `https://api.iconify.design/${prefix}/${name}.svg?height=32`;
  };
  const cpuIconSvgCache = new Map();
  const fetchCpuIconSvg = (iconName) => {
    if (!ICONIFY_NAME_RE.test(String(iconName || ''))) return Promise.resolve(null);
    let pending = cpuIconSvgCache.get(iconName);
    if (pending) return pending;
    pending = (async () => {
      try {
        const response = await fetch(cpuIconSvgUrl(iconName));
        if (!response.ok) return null;
        return await response.text();
      } catch (e) {
        return null;
      }
    })();
    cpuIconSvgCache.set(iconName, pending);
    return pending;
  };

  const loadCPUBrandIcons = async () => {
    const cpuIconElements = document.querySelectorAll('.cpu-brand-icon');
    await Promise.all(Array.from(cpuIconElements).map(async (el) => {
      const iconName = el.dataset.icon;
      if (!iconName) return;
      // Skip elements already showing the correct icon to avoid
      // re-styling on every render (causes flicker on slow clients).
      if (el.dataset.iconLoaded === iconName && el.querySelector('svg')) return;
      const svg = await fetchCpuIconSvg(iconName);
      if (!svg) return;
      // Third-party markup: only a sanitized <svg> tree is inserted.
      const safeSvg = sanitizedSvgElement(svg);
      if (!safeSvg) return;
      el.replaceChildren(safeSvg);
      el.dataset.iconLoaded = iconName;
      const svgEl = el.querySelector('svg');
      if (svgEl) {
        svgEl.setAttribute('class', 'block leading-none');
        svgEl.style.margin = '0';
        svgEl.style.padding = '0';
        svgEl.style.display = 'block';
        svgEl.style.verticalAlign = 'middle';
        svgEl.style.lineHeight = '0';
        svgEl.style.height = '32px';
        svgEl.style.width = 'auto';
        el.style.margin = '0';
        el.style.padding = '0';
        el.style.lineHeight = '0';
        el.style.display = 'flex';
        el.style.alignItems = 'center';
        el.style.justifyContent = 'center';
        el.style.height = '32px';
        el.style.overflow = 'visible';
      }
    }));
  };

  const apiBase = getApiBase();

  // SSE connection for real-time updates
  let eventSource = null;

  // Cache current data for comparison (incremental updates)
  let currentData = new Map(); // key: system ID, value: system data

  // Add Modal controls
  const addModal = document.getElementById('add-system-modal');
  const addBtn = document.getElementById('add-system-btn');
  const closeAddBtn = document.getElementById('close-add-modal-btn');
  const cancelAddBtn = document.getElementById('cancel-add-btn');

  // The dialog's second step, once the server is added: installing its
  // client (see the markup). addedSystemId is the server it is about.
  const addInstall = document.getElementById('add-system-install');
  let addedSystemId = null;
  function showAddDialogStep(system) {
    const form = document.getElementById('add-system-form');
    const title = document.getElementById('add-new-system-title');
    addedSystemId = system ? String(system.id) : null;
    form?.classList.toggle('hidden', !!system);
    addInstall?.classList.toggle('hidden', !system);
    if (title) {
      // The step's own title, which a language switch must not undo.
      if (system) title.removeAttribute('data-translate');
      else title.setAttribute('data-translate', 'addNewSystem');
      title.textContent = adminT(system ? 'installClientTitle' : 'addNewSystem');
    }
    if (!system || !addInstall) return;
    addInstall.dataset.system = JSON.stringify({ id: system.id, secret: system.secret || '' });
    const desc = document.getElementById('add-install-desc');
    if (desc) desc.textContent = adminT('installClientDesc').replace('{name}', system.name || '');
    const command = document.getElementById('add-install-command');
    if (command) command.textContent = linuxInstallCommand(system);
