  }

  function openAddModal() {
    if (addModal) {
      const form = document.getElementById('add-system-form');
      if (form) form.reset();
      showAddDialogStep(null);
      openModalWithAnimation(addModal);
    }
  }

  function closeAddModal() {
    // Closed after adding a server: show its row, where the dashboard will
    // list it once the client reports.
    const added = addedSystemId;
    addedSystemId = null;
    closeModalWithAnimation(addModal, () => {
      const form = document.getElementById('add-system-form');
      if (form) {
        form.reset();
