          newBtn.title = adminT('copyFailed');
          setTimeout(() => {
            newBtn.title = originalTitle;
          }, 2000);
        }
      });
    });

    // Setup edit buttons
    container.querySelectorAll('.edit-btn').forEach(btn => {
      // Remove existing listeners by cloning
      if (btn.dataset.wired === '1') return; // already has its listener
