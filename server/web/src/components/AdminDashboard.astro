  // The expiry line under the link, from the server's answer (its clock
  // decides whether the link still works).
  function showShareExpiry(cfg) {
    if (!tokenExpiresInfo || !cfg || !cfg.token_expires) return;
    const serverTime = cfg.server_time ? new Date(cfg.server_time) : new Date();
    const expiresDate = new Date(cfg.token_expires);
    const timeDiff = expiresDate.getTime() - serverTime.getTime();
    if (isNaN(timeDiff) || cfg.token_expired === true || timeDiff <= 1000) {
      tokenExpiresInfo.textContent = adminTranslations[isNaN(timeDiff) ? 'shareExpiryInvalid' : 'shareExpired'][adminLang()];
      tokenExpiresInfo.className = 'mt-1 text-xs text-red-500 dark:text-red-400';
      return;
    }
    tokenExpiresInfo.textContent = shareExpiresText(formatDate(cfg.token_expires));
    tokenExpiresInfo.className = 'mt-1 text-xs text-[#595959] dark:text-[#ababab]';
    scheduleExpiryLabel(timeDiff);
