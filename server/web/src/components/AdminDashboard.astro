    });
  }

  // The step's copy buttons: the command shown is the one copied.
  addInstall?.querySelectorAll('button[data-kind]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      let system = {};
      try { system = JSON.parse(addInstall.dataset.system || '{}'); } catch (_) {}
      const text = btn.dataset.kind === 'windows' ? windowsInstallCommand(system) : linuxInstallCommand(system);
      const command = document.getElementById('add-install-command');
