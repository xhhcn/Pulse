  // Privacy Config Modal
  const privacyConfigModal = document.getElementById('privacy-config-modal');
  const privacyConfigBtn = document.getElementById('privacy-config-btn');
  const closePrivacyConfigBtn = document.getElementById('close-privacy-config-modal-btn');
  const cancelPrivacyConfigBtn = document.getElementById('cancel-privacy-config-btn');
  const privacyConfigForm = document.getElementById('privacy-config-form');
  const privacyEnabledCheckbox = document.getElementById('privacy-enabled');
  const shareSection = document.getElementById('share-section');
  const generateShareLinkBtn = document.getElementById('generate-share-link-btn');
  const currentShareLinkContainer = document.getElementById('current-share-link-container');
  const currentShareLinkInput = document.getElementById('current-share-link');
  const copyShareLinkBtn = document.getElementById('copy-share-link-btn');
  const revokeShareLinkBtn = document.getElementById('revoke-share-link-btn');
  const tokenExpiresInfo = document.getElementById('token-expires-info');
  const tokenExpiresHoursInput = document.getElementById('token-expires-hours');

  /* One timer for the "Expired" flip. setTimeout silently overflows above
     2^31-1 ms (~24.8 days) and fires immediately, which mislabelled every
     link longer than ~596 h as expired; and each modal open used to arm
     another untracked timer that could stamp a newer, valid link. */
  let tokenExpiryTimer = null;
  function scheduleExpiryLabel(msUntilExpiry) {
    if (tokenExpiryTimer) { clearTimeout(tokenExpiryTimer); tokenExpiryTimer = null; }
    const MAX_DELAY = 2147483647;
    const delay = Math.min(msUntilExpiry, MAX_DELAY);
    tokenExpiryTimer = setTimeout(() => {
      tokenExpiryTimer = null;
      if (msUntilExpiry > MAX_DELAY) { scheduleExpiryLabel(msUntilExpiry - MAX_DELAY); return; }
      if (tokenExpiresInfo) {
        tokenExpiresInfo.textContent = adminTranslations.shareExpired[adminLang()];
        tokenExpiresInfo.className = 'mt-1 text-xs text-red-500 dark:text-red-400';
      }
    }, delay);
  }

  /* Hidden inputs the privacy Save handler reads. Seeded from the stored
     config so saving without generating a new link keeps the existing
     one (an empty share_token is an explicit revoke server-side). */
  function ensurePrivacyHidden(id, name) {
    let el = document.getElementById(id);
    if (!el && privacyConfigForm) {
      el = document.createElement('input'); el.type = 'hidden'; el.id = id; el.name = name;
      privacyConfigForm.appendChild(el);
    }
    return el || { value: '' };
  }

  // Function to generate random token
  function generateToken() {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    // This token grants dashboard access without a login: use the CSPRNG,
    // never Math.random() (predictable, and operator custom_js shares the realm).
    const bytes = new Uint8Array(32);
    crypto.getRandomValues(bytes);
    let token = '';
    for (let i = 0; i < 32; i++) {
      token += chars.charAt(bytes[i] % chars.length);
    }
    return token;
  }

  // Function to format date
  function formatDate(date) {
    if (!date || date === '') return '';
    const d = new Date(date);
    return d.toLocaleString();
  }

  // "Expires: <date>" in the page's language.
  function shareExpiresText(date) {
    return adminTranslations.shareExpires[adminLang()] + date;
  }

  // Function to load and display current privacy config
  async function loadPrivacyConfig() {
    try {
      const res = await fetch(`${apiBase}/api/privacy/config`);
      if (res.ok) {
        const config = await res.json();
        if (!config || typeof config !== 'object') return false;
        
        // Update privacy enabled checkbox
        if (privacyEnabledCheckbox) {
          privacyEnabledCheckbox.checked = config.enabled || false;
        }
        lastLoadedPrivacyEnabled = config.enabled === true;
        
        // Update expiration hours input with saved value (convert seconds to hours)
        if (tokenExpiresHoursInput) {
          const hours = Math.round((config.expires_in_seconds || 3600) / 3600);
          tokenExpiresHoursInput.value = hours;
        }
        
        // Update share section visibility
        if (shareSection) {
          shareSection.style.display = config.enabled ? 'block' : 'none';
        }

        ensurePrivacyHidden('temp-share-token', 'share_token').value = config.share_token || '';
        ensurePrivacyHidden('temp-expires-in-seconds', 'expires_in_seconds').value = '0';
        ensurePrivacyHidden('temp-token-expires', 'token_expires').value = config.token_expires || '';
        
        // Update current share link if exists
        if (config.share_token && config.share_token !== '') {
          const shareUrl = `${window.location.origin}/?token=${config.share_token}`;
          if (currentShareLinkInput) {
            currentShareLinkInput.value = shareUrl;
          }
          if (currentShareLinkContainer) {
            currentShareLinkContainer.classList.remove('hidden');
          }
          revokeShareLinkBtn?.classList.remove('hidden');
          if (tokenExpiresInfo && config.token_expires) {
            // Use server time if available, otherwise fall back to client time
            const serverTime = config.server_time ? new Date(config.server_time) : new Date();
            const expiresDate = new Date(config.token_expires);
            
            // Check if token is expired based on server time
            if (config.token_expired === true) {
              // Token is already expired according to server
              tokenExpiresInfo.textContent = adminTranslations.shareExpired[adminLang()];
              tokenExpiresInfo.className = 'mt-1 text-xs text-red-500 dark:text-red-400';
            } else {
              // Calculate time difference using server time
              const timeDiff = expiresDate.getTime() - serverTime.getTime();
              if (timeDiff > 1000) {
                // Token is still valid (more than 1 second remaining)
                tokenExpiresInfo.textContent = shareExpiresText(formatDate(config.token_expires));
                tokenExpiresInfo.className = 'mt-1 text-xs text-[#595959] dark:text-[#ababab]';
                
                // Set up a timer to update the status when it actually expires
                // Use the calculated time difference
                scheduleExpiryLabel(timeDiff);
              } else {
                // Token is expired or will expire within 1 second
                tokenExpiresInfo.textContent = adminTranslations.shareExpired[adminLang()];
                tokenExpiresInfo.className = 'mt-1 text-xs text-red-500 dark:text-red-400';
              }
            }
          }
        } else {
          if (currentShareLinkContainer) {
            currentShareLinkContainer.classList.add('hidden');
          }
          // Nothing to stop.
          revokeShareLinkBtn?.classList.add('hidden');
        }
        return true;
      }
    } catch (err) {
      // Reported by guardSettingsDialog
    }
    return false;
  }

