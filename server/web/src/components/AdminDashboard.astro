  // Function to generate a random secret (client-side)
  function generateRandomSecret() {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';
    let secret = '';
    const randomValues = new Uint8Array(12);
    crypto.getRandomValues(randomValues);
    for (let i = 0; i < 12; i++) {
      secret += chars[randomValues[i] % chars.length];
    }
    return secret;
  }

  // A refused password change in the page's language: the server answers in
  // English ("invalid current password", "unauthorized", "... too long ...").
  function changePasswordError(status, body) {
    const t = (key) => adminTranslations[key][adminLang()];
    if (status === 401) return t(/current password/i.test(body) ? 'currentPasswordIncorrect' : 'sessionExpired');
    if (/too long/i.test(body)) return t('newPasswordTooLong');
    if (/at least/i.test(body)) return t('newPasswordTooShort');
    return t('changePasswordFailed');
  }

