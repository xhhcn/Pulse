      // Fill tags input - system object from data-system should have tags
      const tagsInput = document.getElementById('edit-tags-input');
      if (tagsInput) {
        // The system object from data-system attribute should have tags from the original data
        const tags = system.tags;
        if (tags && Array.isArray(tags) && tags.length > 0) {
          tagsInput.value = tags.join(', ');
        } else {
          tagsInput.value = '';
        }
