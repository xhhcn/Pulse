  // Delete Confirmation Modal controls
  const deleteModal = document.getElementById('delete-confirm-modal');
  const cancelDeleteBtn = document.getElementById('cancel-delete-btn');
  const confirmDeleteBtn = document.getElementById('confirm-delete-btn');
  let pendingDeleteId = null;
  let pendingDeleteName = null;

  function openDeleteModal(systemId, systemName) {
    if (deleteModal) {
      pendingDeleteId = systemId;
      pendingDeleteName = systemName;
      document.getElementById('delete-system-name').textContent = `"${systemName}"`;
      const meta = document.getElementById('delete-system-meta');
      const cached = currentData.get(String(systemId));
      const system = cached && cached.original;
      if (meta) {
        const parts = system ? [adminLocationHTML(system.location), escapeHtml(system.ipv4 || system.ipv6 || '')].filter(Boolean) : [];
