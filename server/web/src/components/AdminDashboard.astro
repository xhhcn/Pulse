    // Setup copy Linux command buttons
    container.querySelectorAll('.copy-linux-cmd-btn').forEach(btn => {
      if (btn.dataset.wired === '1') return; // already has its listener
      btn.dataset.wired = '1';
      const newBtn = btn;
      
      newBtn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const systemId = newBtn.dataset.systemId;
        // The server's secret from the row's data
        const system = JSON.parse(newBtn.closest('.draggable-item').querySelector('.edit-btn').dataset.system);
        const command = linuxInstallCommand({ ...system, id: systemId });
        
        const linuxIcon = newBtn.querySelector('.linux-icon');
        const checkIcon = newBtn.querySelector('.check-icon');
        const originalTitle = newBtn.title;
        
        const success = await copyToClipboard(command);
        
        if (success) {
          if (linuxIcon && checkIcon) {
            linuxIcon.style.display = 'none';
            checkIcon.style.display = 'block';
            newBtn.classList.add('text-green-600', 'dark:text-green-400');
            newBtn.title = adminT('copied');
            setTimeout(() => {
              linuxIcon.style.display = 'block';
              checkIcon.style.display = 'none';
              newBtn.classList.remove('text-green-600', 'dark:text-green-400');
              newBtn.title = originalTitle;
            }, 1500);
          }
        } else {
          newBtn.title = adminT('copyFailed');
          setTimeout(() => {
            newBtn.title = originalTitle;
          }, 2000);
        }
      });
    });

    // Setup copy Windows command buttons
    container.querySelectorAll('.copy-windows-cmd-btn').forEach(btn => {
      if (btn.dataset.wired === '1') return; // already has its listener
      btn.dataset.wired = '1';
      const newBtn = btn;
      
      newBtn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const systemId = newBtn.dataset.systemId;
        // The server's secret from the row's data
        const system = JSON.parse(newBtn.closest('.draggable-item').querySelector('.edit-btn').dataset.system);
        const command = windowsInstallCommand({ ...system, id: systemId });
        
        const windowsIcon = newBtn.querySelector('.windows-icon');
        const checkIcon = newBtn.querySelector('.check-icon');
        const originalTitle = newBtn.title;
        
        // The command is pasted into PowerShell or cmd.exe, which expand
        // $( ), $var, backticks and %VAR% inside the double quotes (and stop
        // at a ") before powershellQuote's single quotes apply: only plain
        // values are embedded, anything else is refused as a failed copy.
        const plainValues = [systemId, serverUrl, secret].every((v) => /^[A-Za-z0-9._~:\/\[\]-]*$/.test(String(v ?? '')));
        const success = plainValues && await copyToClipboard(command);
        
        if (success) {
          if (windowsIcon && checkIcon) {
            windowsIcon.style.display = 'none';
            checkIcon.style.display = 'block';
            newBtn.classList.add('text-green-600', 'dark:text-green-400');
