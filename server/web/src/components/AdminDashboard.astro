      }
    }
  });


  // Normalize data for comparison (ensure consistent types)
  function normalizeItem(item) {
    return {
      id: String(item.id || ''),
      name: String(item.name || ''),
      location: String(item.location || ''),
      virtualization_type: String(item.virtualization_type || ''),
      os: String(item.os || ''),
      ipv4: String(item.ipv4 || ''),
      ipv6: String(item.ipv6 || ''),
      total_net_in_bytes: Number(item.total_net_in_bytes || 0),
      total_net_out_bytes: Number(item.total_net_out_bytes || 0),
      cpu_model: String(item.cpu_model || ''),
      memory_info: String(item.memory_info || ''),
      agent_version: String(item.agent_version || ''),
      order: Number(item.order || 0),
      tags: Array.isArray(item.tags) ? item.tags : [],
      // Admin visibility toggles (absent on the wire when false: omitempty)
      hide_on_home: item.hide_on_home === true,
      hide_tcping: item.hide_tcping === true,
      // Rotated by the shared-secret editor; the copy-install-command
      // buttons read it from the row snapshot.
      secret: String(item.secret || '')
    };
  }

  // Check if two system objects have changed
  function hasChanged(oldItem, newItem) {
    if (!oldItem) return true; // New item
    if (!newItem) return false; // Deleted item
    
    // Normalize both items for consistent comparison
    const old = normalizeItem(oldItem);
    const new_ = normalizeItem(newItem);
    
    // Compare tags arrays (deep comparison)
    // IMPORTANT: Use slice() to create a copy before sorting to avoid mutating the original array
    const oldTags = Array.isArray(old.tags) ? old.tags.slice().sort().join(',') : '';
    const newTags = Array.isArray(new_.tags) ? new_.tags.slice().sort().join(',') : '';
    const tagsChanged = oldTags !== newTags;
    
    // Compare relevant fields
    return (
      old.name !== new_.name ||
      old.location !== new_.location ||
      old.virtualization_type !== new_.virtualization_type ||
      old.os !== new_.os ||
      old.ipv4 !== new_.ipv4 ||
      old.ipv6 !== new_.ipv6 ||
      old.total_net_in_bytes !== new_.total_net_in_bytes ||
      old.total_net_out_bytes !== new_.total_net_out_bytes ||
      old.cpu_model !== new_.cpu_model ||
      old.memory_info !== new_.memory_info ||
      old.agent_version !== new_.agent_version ||
      old.order !== new_.order ||
      old.hide_on_home !== new_.hide_on_home ||
      old.hide_tcping !== new_.hide_tcping ||
      old.secret !== new_.secret ||
      tagsChanged // Include tags in change detection
    );
  }

  // Render a single system item
  // SECURITY: HTML escape function to prevent XSS attacks
  function escapeHtml(text) {
    if (text == null) return '';
    const map = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;'
    };
    return String(text).replace(/[&<>"']/g, m => map[m]);
  }

  // SECURITY: escape an id before it is interpolated into a CSS selector.
  // Ids come from agent-reported data and may contain quotes or other
  // characters that would make querySelector throw a SyntaxError and abort
  // the whole render. The fallback covers browsers without CSS.escape.
  function cssEscape(s) {
    if (window.CSS && window.CSS.escape) return window.CSS.escape(s);
    return String(s).replace(/[^a-zA-Z0-9_-]/g, (c) => '\\' + c);
  }

  // SECURITY: HTML attribute escape function
  function escapeHtmlAttr(text) {
    if (text == null) return '';
    const map = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;'
    };
    return String(text).replace(/[&<>"']/g, m => map[m]);
  }

  function shellQuote(value) {
    return `'${String(value ?? '').replace(/'/g, `'\\''`)}'`;
  }

  function powershellQuote(value) {
    return `'${String(value ?? '').replace(/'/g, `''`)}'`;
  }

  // The flags the dashboard ships (public/icons), by country code: the page
  // hands them over (data-flags), as this inline script cannot import
  // utils/icons.ts. A code without one is shown alone.
  const LOCAL_FLAGS = (() => { try { return JSON.parse(root?.dataset.flags || '{}'); } catch (_) { return {}; } })();
  // Location as the dashboard's table shows it: the flag and the two-letter
  // code (UK and EL are GB and GR), anything else as entered.
  function adminLocationHTML(location) {
    const raw = String(location || '').trim();
    if (!raw) return '';
    if (!/^[A-Za-z]{2}$/.test(raw)) return `<span class="min-w-0 truncate">${escapeHtml(raw)}</span>`;
    let code = raw.toUpperCase();
    if (code === 'UK') code = 'GB';
    else if (code === 'EL') code = 'GR';
    const slug = LOCAL_FLAGS[code];
    const flag = typeof slug === 'string' && /^[a-z0-9-]+$/.test(slug)
      ? `<img class="h-3.5 w-3.5 shrink-0" src="/icons/emojione-v1/flag-for-${slug}.svg" alt="" aria-hidden="true" decoding="async">` : '';
    return `<span class="inline-flex items-center gap-1">${flag}${code}</span>`;
  }

  // A server whose client has never reported (added, not yet installed): it
  // has no OS, CPU or memory to show. Beszel calls the state pending.
  const isAwaitingClient = (s) => !s.os && !s.cpu_model && !s.memory_info;
  // The newest client version among the servers that report. A client
  // older than it is marked for an update (the agents of this release are
  // what the install command fetches).
  const versionCompare = (a, b) => String(a).localeCompare(String(b), undefined, { numeric: true });
  let newestAgentVersion = '';
  function noteNewestAgent(list) {
    newestAgentVersion = (list || [])
      .filter((s) => s && !isAwaitingClient(s) && /^\d+(\.\d+)+$/.test(String(s.agent_version || '')))
      .map((s) => String(s.agent_version))
      .sort(versionCompare)
      .pop() || '';
  }

  // The line under a server's name: its location, the kind of machine, the
  // OS and the client. Phones leave out the kind and an up-to-date client.
  // Each item carries the dot before it, so a wrapped line never ends on one.
  // A client that needs attention (an update, or none has reported yet) is
  // a line of its own, in amber.
  function adminSublineHTML(s) {
    const items = [];
    let status = '';
    const location = adminLocationHTML(s.location);
    if (location) items.push({ html: location, phone: true });
    if (s.virtualization_type) items.push({ html: escapeHtml(s.virtualization_type), phone: false });
    if (s.os) items.push({ html: escapeHtml(s.os), phone: true });
    if (isAwaitingClient(s)) {
      status = adminT('agentPending');
    } else if (s.agent_version) {
      if (newestAgentVersion && versionCompare(s.agent_version, newestAgentVersion) < 0) {
        status = `${adminT('agentLabel')} ${escapeHtml(s.agent_version)} · ${adminT('agentUpdate')}`;
      } else {
        items.push({ html: `${adminT('agentLabel')} ${escapeHtml(s.agent_version)}`, phone: false });
      }
    }
    const statusLine = status ? `<span class="basis-full text-[#b45309] dark:text-[#fbbf24]">${status}</span>` : '';
    if (!items.length) return statusLine || '<span class="invisible">-</span>';
    let first = { all: true, phone: true };
    return items.map((item) => {
      const dotAll = first.all ? '' : '· ';
      const dotPhone = first.phone ? '' : '· ';
      first.all = false;
      if (item.phone) first.phone = false;
      // the dot can differ on phones, where an item before it may be left out
      return item.phone
        ? `<span class="inline-flex items-center gap-1 whitespace-nowrap"><span class="hidden sm:inline" aria-hidden="true">${dotAll}</span><span class="sm:hidden" aria-hidden="true">${dotPhone}</span>${item.html}</span>`
        : `<span class="hidden sm:inline-flex items-center gap-1 whitespace-nowrap"><span aria-hidden="true">${dotAll}</span>${item.html}</span>`;
    }).join('') + statusLine;
  }
  const adminSublineKey = (s) => [s.location, s.virtualization_type, s.os, s.agent_version, isAwaitingClient(s), newestAgentVersion, adminLang()].join('|');
  function refreshAdminSubline(row, s) {
    const line = row.querySelector('.admin-subline');
    if (!line) return;
    const key = adminSublineKey(s);
    if (line.dataset.key === key) return;
    line.dataset.key = key;
    line.innerHTML = adminSublineHTML(s);
  }
  // A long name breaks before a bracket rather than inside a price ("V.PS(€94.98/5Y)").
  const adminNameHTML = (name) => escapeHtml(name || '').replace(/\(/g, '<wbr>(');

  function renderSystemItem(system, index) {
