              newBtn.title = originalTitle;
            }, 1500);
          }
        } else {
          newBtn.title = adminT('copyFailed');
          setTimeout(() => {
            newBtn.title = originalTitle;
          }, 2000);
        }
      });
    });
  }

  // Load systems list
  async function loadSystems() {
    const container = document.getElementById('systems-list');
    if (!container) return;

    try {
      // Get auth token for authenticated requests (to show IP addresses)
      const token = localStorage.getItem('admin_auth_token');
      const headers = {
        'Content-Type': 'application/json',
      };
      if (token) {
        headers['Authorization'] = `Bearer ${token}`;
      }
      
      const res = await fetch(`${apiBase}/api/metrics?t=${Date.now()}`, {
        headers: headers
      });
      
      // Check response status before parsing JSON
      if (!res.ok) {
        if (res.status === 401) {
          // Unauthorized - redirect to login
          window.location.href = '/login?redirect=/admin';
          return;
        }
        throw new Error(`HTTP ${res.status}: ${res.statusText}`);
      }
      
      const data = await res.json();
      
      // Validate data structure
      if (!Array.isArray(data)) {
        throw new Error('Invalid data format received');
      }

      // Backend already returns data sorted by order field. Funnel every
      // render through the serialiser so concurrent loadSystems + SSE
      // updates cannot interleave DOM mutations.
      await renderSystemsSerialized(data);
      return data;
    } catch (err) {
      console.error('Failed to load systems:', err);
      // The list DOM is replaced below; forget the diff cache too, otherwise
      // the next SSE frame appends rows underneath this banner forever.
      currentData = new Map();
      markListReady();
      container.innerHTML = `
        <div class="text-center py-12">
          <p class="text-sm text-red-500 dark:text-red-400">${adminT('loadServicesError')}</p>
          <p class="text-xs text-[#595959] dark:text-[#ababab] mt-2">${escapeHtml(err.message || adminT('unknownError'))}</p>
        </div>
      `;
    }
  }

  // Save order to backend
  // While an order save is in flight, SSE snapshots (which still carry the
  // old order for up to one tick) are held back so the row the admin just
  // dropped does not jump back and forth. The reload at the end renders the
  // confirmed order, or reverts the optimistic move if the save failed.
  let orderSaveInFlight = false;
  // A drag (or a run of ↑ / ↓) in progress: live snapshots wait too.
  let reorderActive = false;
  async function saveOrderToBackend(order) {
    orderSaveInFlight = true;
    try {
      const response = await fetch(`${apiBase}/api/metrics/order`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ order }),
      });

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }
    } catch (error) {
      showMessage((adminLang() === 'zh' ? '保存排序失败：' : 'Failed to save order: ') + error.message, 'error');
      // The drop already moved the row; make the reload repaint the list
      // from the server's order instead of taking the "nothing changed"
      // shortcut (currentData still holds the pre-drag order).
      currentData = new Map();
    } finally {
      orderSaveInFlight = false;
      pendingSystemsData = null;
      // Reload systems to update all data-index attributes
      // This is crucial for subsequent drag operations
      await loadSystems();
    }
  }

  // Show temporary message
  function showMessage(text, type = 'info') {
    const messageEl = document.createElement('div');
    // Beszel's toast: a card with an icon (red only for an error).
    messageEl.setAttribute('role', type === 'error' ? 'alert' : 'status');
    messageEl.className = `fixed top-4 right-4 z-50 flex max-w-[min(92vw,380px)] items-center gap-2.5 rounded-[10px] border px-4 py-3 text-sm font-medium shadow-lg ${
      type === 'error'
        ? 'border-[#dc2626] bg-[#dc2626] text-white'
        : 'pulse-toast border-[#e5e5e5] dark:border-[#2b2b2b] bg-white dark:bg-[#1a1a1a] text-[#1d1d20] dark:text-[#f5f5f5]'
    }`;
    const icon = type === 'success'
      ? '<svg class="w-4 h-4 shrink-0 text-[#3db866]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>'
      : type === 'error'
        ? '<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>'
        : '<svg class="w-4 h-4 shrink-0 text-[#595959] dark:text-[#ababab]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>';
    messageEl.innerHTML = icon;
    const label = document.createElement('span');
    label.textContent = text;
    messageEl.appendChild(label);
    document.body.appendChild(messageEl);

    setTimeout(() => {
      messageEl.remove();
    }, 3000);
  }

  // The settings menu (Beszel's dropdown): opened by its button (↓, Enter or
  // Space from the keyboard focus the first item), closed by Escape, Tab, a
  // click elsewhere or picking an item. Picking one first hands the focus
  // back to the button, so the dialog it opens returns the focus there.
  {
    const menuBtn = document.getElementById('admin-menu-btn');
    const menu = document.getElementById('admin-menu');
    if (menuBtn && menu) {
      const items = () => [...menu.querySelectorAll('[role="menuitem"]:not(:disabled)')];
      const isOpen = () => !menu.classList.contains('hidden');
      const open = (focusFirst) => {
        menu.classList.remove('hidden');
        menuBtn.setAttribute('aria-expanded', 'true');
        if (focusFirst) items()[0]?.focus();
      };
      const close = (refocus) => {
        if (!isOpen()) return;
        menu.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        if (refocus) menuBtn.focus();
      };
      // A click from the keyboard (Enter / Space) has detail 0.
      menuBtn.addEventListener('click', (e) => (isOpen() ? close(false) : open(e.detail === 0)));
      menuBtn.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' && !isOpen()) { e.preventDefault(); open(true); }
      });
      menu.addEventListener('keydown', (e) => {
        const list = items();
        const i = list.indexOf(document.activeElement);
        if (e.key === 'ArrowDown') { e.preventDefault(); list[(i + 1) % list.length]?.focus(); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); list[(i - 1 + list.length) % list.length]?.focus(); }
        else if (e.key === 'Home') { e.preventDefault(); list[0]?.focus(); }
        else if (e.key === 'End') { e.preventDefault(); list[list.length - 1]?.focus(); }
        else if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); close(true); }
        else if (e.key === 'Tab') close(false);
      });
      menu.addEventListener('click', (e) => {
        if (e.target.closest('[role="menuitem"]')) close(true);
      }, true);
      document.addEventListener('pointerdown', (e) => {
        if (isOpen() && !menu.contains(e.target) && !menuBtn.contains(e.target)) close(false);
      });
      // Escape with the focus anywhere else (the button keeps it after a
      // click) closes the menu too, before the dialogs' own Escape.
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen() && !menu.contains(document.activeElement)) {
          e.preventDefault();
          e.stopImmediatePropagation();
          close(true);
        }
      }, true);
    }
  }

  // Reordering by the rows' handles: drag one with a mouse, a finger or a
  // pen (pointer events; the handle has touch-action: none, so on a phone it
  // moves the row instead of scrolling the page), or focus it and press
  // ↑ / ↓. The row moves in the list at once and the page scrolls when the
  // pointer nears its top or bottom edge; the order is saved when the drag
  // ends, or 700 ms after the last key press, and live updates wait until
  // then (renderSystemsSerialized). Escape (or a cancelled touch) puts the
  // row back. A screen reader hears the new place (#reorder-status).
  const listOrder = (container) => [...container.querySelectorAll(':scope > .draggable-item')].map((row) => row.dataset.systemId);
  function announceRowPosition(row) {
    const status = document.getElementById('reorder-status');
    if (!status || !row.parentNode) return;
    const rows = [...row.parentNode.querySelectorAll(':scope > .draggable-item')];
    status.textContent = adminT('movedTo').replace('{n}', String(rows.indexOf(row) + 1)).replace('{total}', String(rows.length));
  }
  function releaseHeldRender() {
    reorderActive = false;
    if (pendingSystemsData && !orderSaveInFlight) {
      const held = pendingSystemsData;
      pendingSystemsData = null;
      renderSystemsSerialized(held);
    }
  }
  function setupDragAndDrop(container) {
    if (!container || container.dataset.reorderBound === '1') return;
    container.dataset.reorderBound = '1';
    let drag = null;
    let scrollFrame = 0;
    let keyboardSaveTimer = null;
    const rowById = (id) => container.querySelector(`:scope > .draggable-item[data-system-id="${cssEscape(String(id))}"]`);
    // Keep the row under the pointer: past half of a neighbour's height it
    // takes the neighbour's place. It is always the neighbour that moves:
    // taking the dragged row out of the page, even to put it straight back,
    // ends its pointer capture, and with it the drag (it stopped one row up).
    const follow = (clientY) => {
      if (!drag) return;
      const { row } = drag;
      const y = clientY + window.scrollY;
      let dy = y - drag.startY;
      for (;;) {
        const next = row.nextElementSibling;
        const prev = row.previousElementSibling;
        if (dy > 0 && next && next.classList.contains('draggable-item') && dy > next.offsetHeight / 2) {
          container.insertBefore(next, row);
          drag.startY += next.offsetHeight;
        } else if (dy < 0 && prev && prev.classList.contains('draggable-item') && -dy > prev.offsetHeight / 2) {
          container.insertBefore(prev, row.nextSibling);
          drag.startY -= prev.offsetHeight;
        } else {
          break;
        }
        dy = y - drag.startY;
      }
      row.style.transform = `translateY(${dy}px)`;
    };
    const autoScroll = () => {
      scrollFrame = 0;
      if (!drag) return;
      const edge = 64;
      const y = drag.clientY;
      const step = y < edge ? -Math.ceil((edge - y) / 4)
        : y > window.innerHeight - edge ? Math.ceil((y - (window.innerHeight - edge)) / 4) : 0;
      if (step) {
        window.scrollBy(0, step);
        follow(y);
      }
      scrollFrame = requestAnimationFrame(autoScroll);
    };
    const end = (cancel) => {
      if (!drag) return;
      const { row, before } = drag;
      drag = null;
      cancelAnimationFrame(scrollFrame);
      row.style.transform = '';
      row.classList.remove('is-dragging');
      document.body.classList.remove('is-reordering');
      if (cancel) before.forEach((id) => { const r = rowById(id); if (r) container.appendChild(r); });
      const order = listOrder(container);
      if (!cancel && order.join('\n') !== before.join('\n')) {
        announceRowPosition(row);
        reorderActive = false;
        saveOrderToBackend(order);
      } else {
        releaseHeldRender();
      }
    };
    container.addEventListener('pointerdown', (e) => {
      const handle = e.target.closest('.drag-handle');
      if (!handle || drag || keyboardSaveTimer || (e.pointerType === 'mouse' && e.button !== 0)) return;
      const row = handle.closest('.draggable-item');
      if (!row) return;
      e.preventDefault();
      try { handle.setPointerCapture(e.pointerId); } catch (_) {}
      drag = { row, pointerId: e.pointerId, startY: e.clientY + window.scrollY, clientY: e.clientY, before: listOrder(container) };
      reorderActive = true;
      row.classList.add('is-dragging');
      document.body.classList.add('is-reordering');
      scrollFrame = requestAnimationFrame(autoScroll);
    });
    container.addEventListener('pointermove', (e) => {
      if (!drag || e.pointerId !== drag.pointerId) return;
      drag.clientY = e.clientY;
      follow(e.clientY);
    });
    container.addEventListener('pointerup', (e) => { if (drag && e.pointerId === drag.pointerId) end(false); });
    container.addEventListener('pointercancel', (e) => { if (drag && e.pointerId === drag.pointerId) end(true); });
    container.addEventListener('lostpointercapture', (e) => { if (drag && e.pointerId === drag.pointerId) end(false); });
    container.addEventListener('keydown', (e) => {
      const handle = e.target.closest('.drag-handle');
      if (!handle) return;
      if (e.key === 'Escape' && drag) { e.preventDefault(); e.stopPropagation(); end(true); return; }
      if ((e.key !== 'ArrowUp' && e.key !== 'ArrowDown') || drag) return;
      e.preventDefault();
      const row = handle.closest('.draggable-item');
      const sibling = e.key === 'ArrowUp' ? row.previousElementSibling : row.nextElementSibling;
      if (!sibling || !sibling.classList.contains('draggable-item')) return;
      // The neighbour moves, so the focused handle stays in the page.
      if (e.key === 'ArrowUp') container.insertBefore(sibling, row.nextSibling);
      else container.insertBefore(sibling, row);
      handle.focus();
      reorderActive = true;
      announceRowPosition(row);
      clearTimeout(keyboardSaveTimer);
      const id = row.dataset.systemId;
      keyboardSaveTimer = setTimeout(() => {
        keyboardSaveTimer = null;
        reorderActive = false;
        // The save's reload re-appends the rows, which drops the focus:
        // give it back to the moved row's handle.
        saveOrderToBackend(listOrder(container)).then(() => {
          if (document.activeElement === document.body || !document.activeElement) rowById(id)?.querySelector('.drag-handle')?.focus();
        });
      }, 700);
    });
  }

  // Add system
  const addForm = document.getElementById('add-system-form');
  if (addForm) {
    addForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(addForm);
      const messageEl = document.getElementById('add-form-message');

      const systemName = formData.get('name')?.trim();
      if (!systemName) {
        if (messageEl) {
          messageEl.className = 'text-sm text-red-500 dark:text-red-400';
          messageEl.textContent = '❌ ' + adminT('serviceNameRequired');
          messageEl.classList.remove('hidden');
        }
        return;
      }

      // Get existing systems to generate unique numeric ID
      const addSubmitBtn = addForm.querySelector('button[type="submit"]');
      if (addSubmitBtn && addSubmitBtn.disabled) return; // a submit is already in flight
      if (addSubmitBtn) addSubmitBtn.disabled = true;
      const releaseSubmit = () => { if (addSubmitBtn) addSubmitBtn.disabled = false; };

      let existingIds = [];
      try {
        const existingRes = await fetch(`${apiBase}/api/metrics`);
        if (!existingRes.ok) throw new Error(`HTTP ${existingRes.status}`);
        const existingData = await existingRes.json();
        if (!Array.isArray(existingData)) throw new Error('unexpected response');
        existingIds = existingData.map(s => {
          // Extract numeric part from ID (handle both "123" and "server-123" formats)
          const match = String(s.id).match(/\d+/);
          return match ? parseInt(match[0]) : 0;
        });
      } catch (err) {
        /* Without the current list we cannot pick a free id; guessing
           "1" would silently overwrite an existing system. */
        if (messageEl) {
          messageEl.className = 'text-sm text-red-500 dark:text-red-400';
          messageEl.textContent = '❌ ' + adminT('loadServicesFailed') + err.message;
          messageEl.classList.remove('hidden');
        }
        releaseSubmit();
        return;
      }

      // Generate unique numeric ID
      let systemId = 1;
      if (existingIds.length > 0) {
        const maxId = Math.max(...existingIds);
        systemId = maxId + 1;
      }

      const data = {
        id: systemId.toString(),
        name: systemName,
        cpu: 0,
        memory: 0,
        disk: 0,
        net_in_mb_s: 0,
        net_out_mb_s: 0,
        agent_version: '1.0.0',
        alert: false,
