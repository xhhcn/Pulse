  // Handle privacy config form submission
  privacyConfigForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const messageEl = document.getElementById('privacy-config-message');
    const submitBtn = privacyConfigForm.querySelector('button[type="submit"]');
    
    const enabled = privacyEnabledCheckbox?.checked || false;
    const shareToken = document.getElementById('temp-share-token')?.value || '';
    // Get seconds from hidden input (converted from hours)
    const expiresInSeconds = parseInt(document.getElementById('temp-expires-in-seconds')?.value || '0');

    const storedTokenExpires = document.getElementById('temp-token-expires')?.value || '';
    const data = {
      enabled: enabled,
      share_token: shareToken,
      expires_in_seconds: expiresInSeconds,
    };
    // No freshly generated link in this session: keep the existing absolute
    // expiry (the server only recomputes when expires_in_seconds > 0).
    if (!(expiresInSeconds > 0) && storedTokenExpires) data.token_expires = storedTokenExpires;

    // Set button to saving state
    if (submitBtn) {
      submitBtn.disabled = true;
      setButtonLabel(submitBtn, 'saving');
    }

    try {
      const res = await fetch(`${apiBase}/api/privacy/config`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        lastLoadedPrivacyEnabled = data.enabled;
        // Get the saved config from response to update UI with server-calculated expiration
        const responseData = await res.json();
        if (responseData.config && responseData.config.share_token && responseData.config.token_expires) {
          // Update expiration info with server time
          if (tokenExpiresInfo) {
            // Use server time if available, otherwise fall back to client time
            const serverTime = responseData.config.server_time ? new Date(responseData.config.server_time) : new Date();
            const expiresDate = new Date(responseData.config.token_expires);
            
            // Check if date is valid
            if (isNaN(expiresDate.getTime())) {
              // Invalid expiration date from server
              tokenExpiresInfo.textContent = adminTranslations.shareExpiryInvalid[adminLang()];
              tokenExpiresInfo.className = 'mt-1 text-xs text-red-500 dark:text-red-400';
            } else if (responseData.config.token_expired === true) {
              // Token is already expired according to server
              tokenExpiresInfo.textContent = adminTranslations.shareExpired[adminLang()];
              tokenExpiresInfo.className = 'mt-1 text-xs text-red-500 dark:text-red-400';
            } else {
              // Calculate time difference using server time
              const timeDiff = expiresDate.getTime() - serverTime.getTime();
              if (timeDiff > 1000) {
                // Token is still valid (more than 1 second remaining)
                tokenExpiresInfo.textContent = shareExpiresText(formatDate(responseData.config.token_expires));
                tokenExpiresInfo.className = 'mt-1 text-xs text-[#595959] dark:text-[#ababab]';
                
                // Set up timer to update when expired (using server time difference)
                scheduleExpiryLabel(timeDiff);
              } else {
                // Token is expired or will expire within 1 second
                tokenExpiresInfo.textContent = adminTranslations.shareExpired[adminLang()];
                tokenExpiresInfo.className = 'mt-1 text-xs text-red-500 dark:text-red-400';
              }
            }
          }
        }
        
        // Reset button state before closing modal
        if (submitBtn) {
          submitBtn.disabled = false;
          setButtonLabel(submitBtn, 'save');
        }
        // Close modal immediately on success
        closePrivacyConfigModal();
        // Show success message briefly (outside modal)
        // Note: messageEl is inside modal, so it will be hidden when modal closes
      } else {
        const error = await res.text();
        throw new Error(error || `HTTP ${res.status}`);
      }
    } catch (err) {
      // Reset button state on error
      if (submitBtn) {
        submitBtn.disabled = false;
        setButtonLabel(submitBtn, 'save');
      }
      if (messageEl) {
        messageEl.className = 'text-sm text-red-500 dark:text-red-400';
        messageEl.textContent = '❌ ' + adminT('savePrivacyFailed') + err.message;
        messageEl.classList.remove('hidden');
