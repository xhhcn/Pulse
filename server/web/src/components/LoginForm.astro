---
// Login form component for admin authentication
---

<div class="min-h-screen flex items-center justify-center bg-[#fafafa] dark:bg-[#171717] glass-login-wrapper px-4">
  <div class="w-full max-w-md">
    <div class="glass-login bg-white dark:bg-[#1a1a1a] rounded-xl border border-[#d4d4d4]/50 dark:border-[#2c2c2c]/60 p-4 sm:p-6 md:p-8 shadow-[0_1px_2px_0_rgba(0,0,0,0.05)] animate-login-card">
      <!-- Logo/Title -->
      <!-- As Beszel's sign-in: the mark above the title, fields with an icon
           and no visible label, a dark primary button. -->
      <div class="text-center mb-6 sm:mb-8">
        <div id="login-mark" class="mx-auto mb-4 w-8 h-8 flex items-center justify-center"><svg class="w-8 h-8 text-[#1d1d20] dark:text-[#f5f5f5]" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.5 12h2l2-6 3 18 2.5-12h2"></path>
          <path stroke="currentColor" stroke-linecap="round" stroke-width="1.5" opacity="0.8" d="M3 12h2M19 12h2"></path>
          <path stroke="currentColor" stroke-linecap="round" stroke-width="1.5" opacity="0.5" d="M1 12h1M22 12h1"></path>
          <circle stroke="currentColor" cx="12" cy="12" r="9" stroke-width="1.5" opacity="0.3"></circle>
          <circle stroke="currentColor" cx="12" cy="12" r="5" stroke-width="1.5" opacity="0.6"></circle>
        </svg></div>
        <h1 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#0a0a0a] dark:text-[#f5f5f5] mb-2" data-translate-login="title">Admin Login</h1>
        <p class="text-xs sm:text-sm text-[#595959] dark:text-[#ababab]" data-translate-login="subtitle">Enter your password to access the admin panel</p>
      </div>

      <!-- Error message -->
      <div id="login-error" class="hidden mb-4 p-3 rounded-lg bg-red-500/10 border border-red-500/50 animate-scale-in">
        <p class="text-sm text-red-500" id="login-error-text"></p>
      </div>

      <!-- Success message (for password setup) -->
      <div id="login-success" class="hidden mb-4 p-3 rounded-lg bg-emerald-500/10 border border-emerald-500/50 animate-scale-in">
        <p class="text-sm text-emerald-500" id="login-success-text"></p>
      </div>

      <!-- Login Form -->
      <!-- method="post": a submit before the script is ready (slow link,
           script blocked) reloads this page instead of putting the
           password into the address bar, history and access logs. -->
      <form id="login-form" method="post" class="space-y-4">
        <div>
          <label for="password" class="sr-only" data-translate-login="password">Password</label>
          <div class="relative">
          <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[#595959] dark:text-[#ababab]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <input
            type="password"
            id="password"
            name="password"
            required
            autocomplete="current-password"
            class="toolbar-control w-full pl-9 pr-3 text-sm"
            placeholder="Enter password"
            data-translate-login-placeholder="passwordPlaceholder"
          />
          </div>
        </div>

        <div id="confirm-password-field" class="hidden">
          <label for="confirm-password" class="sr-only" data-translate-login="confirmPassword">Confirm Password</label>
          <div class="relative">
          <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[#595959] dark:text-[#ababab]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <input
            type="password"
            id="confirm-password"
            name="confirm-password"
            autocomplete="new-password"
            class="toolbar-control w-full pl-9 pr-3 text-sm"
            placeholder="Confirm password"
            data-translate-login-placeholder="confirmPasswordPlaceholder"
          />
          </div>
        </div>

        <div>
          <button
            type="submit"
            id="login-submit"
            class="w-full h-10 px-4 inline-flex items-center justify-center gap-2 rounded-[10.8px] bg-[#171717] hover:bg-[#2a2a2a] text-white dark:bg-[#f5f5f5] dark:hover:bg-[#e0e0e0] dark:text-[#171717] text-sm font-medium outline-none transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#a3a3a3] dark:focus-visible:ring-offset-[#1a1a1a]"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10 17 5-5-5-5"/><path d="M15 12H3"/><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/></svg>
            <span data-translate-login="submit">Login</span>
          </button>
        </div>
      </form>
    </div>
    <!-- The login page has no navbar: a way back to the dashboard. Shown only
         when the dashboard is public (with privacy mode on it would just
         send the visitor back here). -->
    <div id="login-home" class="hidden mt-4 sm:mt-5 text-center">
      <a href="/" class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs sm:text-sm text-[#595959] dark:text-[#ababab] hover:text-[#1d1d20] dark:hover:text-[#e5e5e5] transition-colors">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m12 19-7-7 7-7" />
          <path d="M19 12H5" />
        </svg>
        <span data-translate-login="backHome">Back to dashboard</span>
      </a>
    </div>
  </div>
</div>

<script>
  // Get API base URL - same logic as other components
  function getApiBase() {
    const root = document.documentElement;
    if (root?.dataset?.apiBase && root.dataset.apiBase.trim() !== '') {
      return root.dataset.apiBase.trim();
    }
    // Use current origin (works with nginx reverse proxy)
    return window.location.origin;
  }
  
  const apiBase = getApiBase();
  
  // Translations
  const translations = {
    en: {
      title: 'Admin Login',
      subtitle: 'Enter your password to access the admin panel',
      password: 'Password',
      confirmPassword: 'Confirm Password',
      passwordPlaceholder: 'Enter password',
      confirmPasswordPlaceholder: 'Confirm password',
      submit: 'Login',
      setupPassword: 'Setup Password',
      setupSubtitle: 'Set up your admin password (first time only)',
      error: 'Error',
      invalidPassword: 'Invalid password',
      tooManyAttempts: 'Too many wrong passwords. Try again in {n} min.',
      serverUnreachable: 'Could not reach the server, please try again',
      storageBlocked: 'This browser blocks site data for this page, so the login cannot be kept. Allow cookies and site data for this site.',
      passwordMismatch: 'Passwords do not match',
      passwordTooShort: 'Password must be at least 6 characters',
      setupSuccess: 'Password set successfully! Redirecting...',
      loginSuccess: 'Login successful! Redirecting...',
      backHome: 'Back to dashboard',
      visitorTitle: 'Sign in to view',
      visitorSubtitle: 'This dashboard is private. Sign in with the admin password, or open it with a share link from its owner.',
      linkEnded: 'This share link no longer works. Ask the owner for a new one, or sign in.'
    },
    zh: {
      title: '管理员登录',
      subtitle: '输入密码以访问管理面板',
      password: '密码',
      confirmPassword: '确认密码',
      passwordPlaceholder: '输入密码',
      confirmPasswordPlaceholder: '再次输入密码',
      submit: '登录',
      setupPassword: '设置密码',
      setupSubtitle: '设置您的管理员密码（仅首次）',
      error: '错误',
      invalidPassword: '密码错误',
      tooManyAttempts: '密码错误次数过多，请 {n} 分钟后再试。',
      serverUnreachable: '无法连接服务器，请稍后再试',
      storageBlocked: '浏览器禁止了本站存储数据，无法保持登录。请允许本站使用 Cookie 和网站数据。',
      passwordMismatch: '密码不匹配',
      passwordTooShort: '密码至少需要 6 个字符',
      setupSuccess: '密码设置成功！正在跳转...',
      loginSuccess: '登录成功！正在跳转...',
      backHome: '返回首页',
      visitorTitle: '登录后查看',
      visitorSubtitle: '此监控面板为私有，请输入管理员密码登录，或使用站长提供的分享链接打开。',
      linkEnded: '分享链接已失效，请向站长索取新的链接，或登录查看。'
    }
  };

  function getSystemLanguage() {
    const sysLang = navigator.language || (navigator.languages && navigator.languages[0]) || 'en';
    // Check if system language is Chinese (zh, zh-CN, zh-TW, etc.)
    if (sysLang.toLowerCase().startsWith('zh')) {
      return 'zh';
    }
    return 'en';
  }

  // Reading storage throws when the browser blocks site data.
  function readStored(key) {
    try { return localStorage.getItem(key); } catch (_) { return null; }
  }

  function getCurrentLanguage() {
    const stored = readStored('preferred-language');
    if (stored === 'zh' || stored === 'en') {
      return stored;
    }
    // Default to system language
    return getSystemLanguage();
  }

  // SECURITY: Validate redirect parameter to prevent open redirect attacks
  // Only allow relative paths (starting with /) and prevent protocol-relative or absolute URLs
  function validateRedirect(redirect) {
    if (!redirect || typeof redirect !== 'string') return '/admin';
    redirect = redirect.trim();
    if (!redirect.startsWith('/') || redirect.startsWith('//')) return '/admin';
    /* Resolve with the same parser the browser will use: "/\\evil.com" and
       "/<tab>/evil.com" pass naive string checks but leave the origin. */
    try {
      const u = new URL(redirect, window.location.origin);
      if (u.origin !== window.location.origin) return '/admin';
      /* The WHATWG parser resolves "." / ".." segments BEFORE we get to look
         at the result, so "/..//evil.com", "/.//evil.com", "/a/../..//evil.com"
         and "/%2e%2e//evil.com" all collapse to the pathname "//evil.com".
         Handing that to location.href is a protocol-relative navigation to
         another origin. Re-check the *resolved* pathname: it must be a single
         "/" followed by a character that is neither "/" nor "\\". */
      const path = u.pathname;
      if (path.length > 1 && (path[1] === '/' || path[1] === '\\')) return '/admin';
      if (path.includes('..')) return '/admin';
      /* Belt and braces: restrict the resolved path to unreserved URL
         characters, so nothing exotic (backslashes, control characters,
         encoded separators) survives into location.href. */
      if (!/^\/[A-Za-z0-9._~\-\/]*$/.test(path)) return '/admin';
      return path + u.search + u.hash;
    } catch (_) {
      return '/admin';
    }
  }

  function updateTranslations() {
    const lang = getCurrentLanguage();
    const t = translations[lang];
    
    document.querySelectorAll('[data-translate-login]').forEach(el => {
      const key = el.getAttribute('data-translate-login');
      if (key && t[key]) {
        el.textContent = t[key];
      }
    });
    document.querySelectorAll('[data-translate-login-placeholder]').forEach(el => {
      const key = el.getAttribute('data-translate-login-placeholder');
      if (key && t[key]) {
        el.placeholder = t[key];
      }
    });
    applyHeading();
  }

  // The heading and the button follow the form's mode, also across a
  // language switch (which used to put the login heading on the first-run
  // setup form). A visitor sent here by a private dashboard (redirect=/) is
  // told why instead of being asked for the admin panel, and one whose
  // share link stopped working (reason=link) is told that.
  let setupMode = false;
  const loginParams = new URLSearchParams(window.location.search);
  const forDashboard = loginParams.get('redirect') === '/';
  const linkEnded = forDashboard && loginParams.get('reason') === 'link';
  function applyHeading() {
    const t = translations[getCurrentLanguage()];
    const title = document.querySelector('[data-translate-login="title"]');
    const subtitle = document.querySelector('[data-translate-login="subtitle"]');
    const submit = document.querySelector('#login-submit [data-translate-login="submit"]');
    if (title) title.textContent = setupMode ? t.setupPassword : forDashboard ? t.visitorTitle : t.title;
    if (subtitle) subtitle.textContent = setupMode ? t.setupSubtitle : linkEnded ? t.linkEnded : forDashboard ? t.visitorSubtitle : t.subtitle;
    if (submit) submit.textContent = setupMode ? t.setupPassword : t.submit;
  }

  // Check if password is already set
  // Returns true / false, or null when the status could not be read: an
  // unreachable or failing endpoint must not turn an initialised site into
  // the two-field first-run setup form.
  async function checkPasswordStatus() {
    try {
      const res = await fetch(`${apiBase}/api/auth/status`, { cache: 'no-store' });
      if (res.ok) {
        const data = await res.json();
        return data.set === true;
      }
    } catch (err) {
      // Status check failed silently
    }
    return null;
  }

  // Setup password (first time)
  async function setupPassword(password) {
    try {
      const res = await fetch(`${apiBase}/api/auth/setup`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password })
      });
      
      if (!res.ok) {
        const errorText = await res.text();
        return { success: false, error: errorText || 'Failed to setup password' };
      }
      
      return { success: true };
    } catch (err) {
      return { success: false, error: err.message || 'Network error' };
    }
  }

  // The server refuses every attempt for 15 minutes after the fifth wrong
  // password in a row, answering just as for a wrong one (by design). The
  // same count is kept here, so the form can say why even the right
  // password is refused instead of repeating 密码错误. Returns the time the
  // lock ends, or 0.
  const LOCK_KEY = 'pulse-login-lock';
  function noteLoginFailure() {
    const now = Date.now();
    let lock = { count: 0, last: 0, until: 0 };
    try { lock = { ...lock, ...JSON.parse(localStorage.getItem(LOCK_KEY) || '{}') }; } catch (_) {}
    if (now >= lock.until) {
      if (now - lock.last > 15 * 60e3) lock.count = 0;
      lock.count += 1;
      lock.last = now;
      if (lock.count >= 5) lock.until = now + 15 * 60e3;
    }
    try { localStorage.setItem(LOCK_KEY, JSON.stringify(lock)); } catch (_) {}
    return now < lock.until ? lock.until : 0;
  }

  // Login with password. Returns true, or the message to show: only a 4xx
  // answer means a wrong password (the server answers a lockout the same
  // way); a dropped request or a 5xx from the server or a CDN does not.
  async function login(password) {
    const lang = getCurrentLanguage();
    let res;
    try {
      res = await fetch(`${apiBase}/api/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password })
      });
    } catch (err) {
      return translations[lang].serverUnreachable;
    }
    if (!res.ok) {
      if (res.status === 401) {
        const until = noteLoginFailure();
        if (until) return translations[lang].tooManyAttempts.replace('{n}', String(Math.max(1, Math.ceil((until - Date.now()) / 60e3))));
      }
      return res.status >= 400 && res.status < 500 ? translations[lang].invalidPassword : translations[lang].serverUnreachable;
    }
    let data = null;
    try { data = await res.json(); } catch (_) { /* not the API */ }
    if (!data || !data.success) return translations[lang].serverUnreachable;
    try { localStorage.removeItem(LOCK_KEY); } catch (_) {}
    // Site data blocked: the session could not reach the admin page, which
    // would send the visitor straight back here without a word.
    if (window.__pulseStorageBlocked) return translations[lang].storageBlocked;
    try {
      localStorage.setItem('admin_auth_token', data.token);
    } catch (_) {
      return translations[lang].storageBlocked;
    }
    return true;
  }

  // A stored session the server still accepts. The admin page sends the
  // visitor here when it could not reach the server to check the session;
  // asking for the password again then was needless.
  async function storedSessionValid() {
    const token = readStored('admin_auth_token');
    if (!token) return false;
    try {
      const res = await fetch(`${apiBase}/api/auth/verify`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token })
      });
      if (!res.ok) return false;
      const data = await res.json();
      return !!(data && data.valid === true);
    } catch (_) {
      return false;
    }
  }

  function showError(message) {
    const errorDiv = document.getElementById('login-error');
    const errorText = document.getElementById('login-error-text');
    errorText.textContent = message;
    errorDiv.classList.remove('hidden');
    setTimeout(() => {
      errorDiv.classList.add('hidden');
    }, 5000);
  }

  function showSuccess(message) {
    const successDiv = document.getElementById('login-success');
    const successText = document.getElementById('login-success-text');
    successText.textContent = message;
    successDiv.classList.remove('hidden');
  }

  // Theme management - just apply stored theme, no toggle button
  function getSystemTheme() {
    if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
      return 'dark';
    }
    return 'light';
  }

  function getCurrentTheme() {
    const stored = readStored('preferred-theme');
    if (stored === 'dark' || stored === 'light') {
      return stored;
    }
    // Default to system theme
    return getSystemTheme();
  }

  function applyTheme(theme) {
    const html = document.documentElement;
    const body = document.body;
    if (theme === 'dark') {
      html.classList.add('dark');
      html.classList.remove('light');
      body.classList.add('dark');
      body.classList.remove('light');
    } else {
      html.classList.add('light');
      html.classList.remove('dark');
      body.classList.add('light');
      body.classList.remove('dark');
    }
  }

  // Initialize
  (async () => {
    // Initialize theme from localStorage
    const currentTheme = getCurrentTheme();
    applyTheme(currentTheme);
    // With no theme chosen the page follows the system, also while it is open.
    if (window.matchMedia) {
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        const stored = readStored('preferred-theme');
        if (stored !== 'dark' && stored !== 'light') {
          applyTheme(getSystemTheme());
          document.documentElement.style.colorScheme = getSystemTheme();
          if (window.__pulseSyncThemeColor) window.__pulseSyncThemeColor();
        }
      });
    }
    
    updateTranslations();
    
    // Listen for language changes
    window.addEventListener('languagechange', updateTranslations);
    window.addEventListener('translate', updateTranslations);

    // "Back to dashboard" only when the dashboard is public; an unreadable
    // privacy setting shows it, as the dashboard itself fails open.
    fetch(`${apiBase}/api/privacy/config`)
      .then((res) => (res.ok ? res.json() : null))
      .catch(() => null)
      .then((privacy) => {
        if (!privacy || !privacy.enabled) document.getElementById('login-home')?.classList.remove('hidden');
      });

    // The real submit handler is attached once /api/auth/status has
    // answered; a submit (Enter after autofill) before that is held here
    // and replayed, instead of being sent natively.
    const form = document.getElementById('login-form');
    let heldSubmit = false;
    const holdSubmit = (e) => { e.preventDefault(); heldSubmit = true; };
    form.addEventListener('submit', holdSubmit);

    if (await storedSessionValid()) {
      const urlParams = new URLSearchParams(window.location.search);
      window.location.replace(validateRedirect(urlParams.get('redirect') || '/admin'));
      return;
    }

    let isPasswordSet = await checkPasswordStatus();
    const passwordField = document.getElementById('password');
    const confirmPasswordField = document.getElementById('confirm-password-field');
    const confirmPasswordInput = document.getElementById('confirm-password');
    const submitButton = document.getElementById('login-submit');

    // Switch the form between first-time setup and login. Kept as a
    // function because setup can complete while the follow-up login fails,
    // and the form must then behave as a login form instead of re-posting
    // /api/auth/setup (which the server rejects once a password exists).
    function applyLoginMode(setup) {
      setupMode = setup;
      applyHeading();
      if (setup) {
        confirmPasswordField.classList.remove('hidden');
        confirmPasswordInput.required = true;
      } else {
        confirmPasswordField.classList.add('hidden');
        confirmPasswordInput.required = false;
        confirmPasswordInput.value = '';
      }
    }
    applyLoginMode(isPasswordSet === false);

    // Guard against double-submission. On slow networks a fast double
    // click on the submit button would fire two /api/auth/login requests
    // (the server rate-limits, but the UI still felt unresponsive). We
    // disable the button for the duration of the async flow and always
    // re-enable it in finally so a failed login doesn't permanently
    // lock the user out of retrying.
    let submitInFlight = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitInFlight) return;

      const password = passwordField.value.trim();
      const confirmPassword = confirmPasswordInput.value.trim();

      // Validation
      if (password.length < 6) {
        const lang = getCurrentLanguage();
        showError(translations[lang].passwordTooShort);
        return;
      }

      submitInFlight = true;
      submitButton.disabled = true;
      submitButton.classList.add('opacity-60', 'cursor-not-allowed');

      try {
        if (isPasswordSet === false) {
          // Setup password
          if (password !== confirmPassword) {
            const lang = getCurrentLanguage();
            showError(translations[lang].passwordMismatch);
            return;
          }

          const result = await setupPassword(password);
          if (result && result.success) {
            // After setup, automatically login
            const loginResult = await login(password);
            if (loginResult === true) {
              // SECURITY: Validate redirect parameter to prevent open redirect
              const urlParams = new URLSearchParams(window.location.search);
              const redirect = validateRedirect(urlParams.get('redirect') || '/admin');
              window.location.href = redirect;
            } else {
              // Password is stored; only the follow-up login failed (lockout
              // / network). Become a login form so the retry does not re-post
              // /api/auth/setup, and say so instead of bouncing off /admin.
              isPasswordSet = true;
              applyLoginMode(false);
              showError(loginResult);
            }
          } else {
            const lang = getCurrentLanguage();
            const errorMsg = (result && result.error) ? result.error : translations[lang].error;
            if (/password already set/i.test(errorMsg)) {
              // The status endpoint was stale (cache layer): a password
              // exists, so fall back to login mode and try the password.
              isPasswordSet = true;
              applyLoginMode(false);
              const retry = await login(password);
              if (retry === true) {
                const urlParams = new URLSearchParams(window.location.search);
                window.location.href = validateRedirect(urlParams.get('redirect') || '/admin');
              } else {
                showError(retry);
              }
            } else {
              showError(errorMsg);
            }
          }
        } else {
          // Login
          const success = await login(password);
          if (success === true) {
            // SECURITY: Validate redirect parameter to prevent open redirect
            const urlParams = new URLSearchParams(window.location.search);
            const redirect = validateRedirect(urlParams.get('redirect') || '/admin');
            window.location.href = redirect;
          } else {
            showError(success);
          }
        }
      } finally {
        submitInFlight = false;
        submitButton.disabled = false;
        submitButton.classList.remove('opacity-60', 'cursor-not-allowed');
      }
    });
    form.removeEventListener('submit', holdSubmit);
    if (heldSubmit) {
      if (form.requestSubmit) form.requestSubmit();
      else form.dispatchEvent(new Event('submit', { cancelable: true }));
    }
  })();
</script>